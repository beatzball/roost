#!/usr/bin/env bash
# roost-banner — print the roost owl as text art.
#
# Four renderings of the same logo. Which one you get is random, so the tool
# has a little life in it without anyone having to choose a favourite.
#
#   color     the logo in full colour, half-block cells, 24-bit
#   braille   densest detail (2x4 dots per cell), needs a font with U+28xx
#   blocks    shaded, uses the widely-supported quadrant blocks
#   outline   hollow line art, plain ASCII only
#
# Two are dropped from the draw when the terminal cannot be trusted to render
# them: braille needs the U+28xx glyphs, and colour needs 24-bit support.
# A missing glyph renders as a row of boxes and 24-bit escapes on an 8-colour
# terminal render as mud -- both look broken rather than charming. blocks and
# outline always work, so the draw is never empty.
#
# Usage:
#   roost-banner              # random, capability-aware
#   roost-banner braille      # force one
#   ROOST_BANNER=blocks ...   # force one via the environment (used by tests)
set -u

# Directory holding this script, so the colour art -- the one rendering too
# large to inline -- is found no matter where roost was invoked from.
# BASH_SOURCE rather than $0, so this still works when the file is sourced.
roost_banner_dir() {
  CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd
}

ROOST_BANNER_COLOR_FILE_NAME=roost-banner-color.ans

# Can this terminal draw 24-bit colour?
#
# COLORTERM is the only signal that is widely set and widely honoured. Unset
# does not prove the terminal cannot -- it proves we cannot tell, and guessing
# wrong here produces a smear of the eight nearest colours.
#
# NO_COLOR is respected: someone who asked for no colour gets one of the plain
# renderings instead.
roost_banner_supports_color() {
  case "${ROOST_BANNER_TRUECOLOR:-}" in
    1|yes|true) ;;
    0|no|false) return 1 ;;
    *)
      [ -z "${NO_COLOR:-}" ] || return 1
      case "${COLORTERM:-}" in
        truecolor|24bit) ;;
        *) return 1 ;;
      esac
      ;;
  esac
  [ -f "$(roost_banner_dir)/$ROOST_BANNER_COLOR_FILE_NAME" ] || return 1
  return 0
}

# Can this terminal draw braille (U+2800..U+28FF)?
#
# There is no way to interrogate the font, so this is a proxy: braille needs a
# UTF-8 locale, and the Linux virtual console has no braille glyphs whatever
# the locale says. Both checks are cheap and wrong only in the safe direction
# -- a capable terminal that fails them merely gets one of the other two.
roost_banner_supports_braille() {
  case "${ROOST_BANNER_BRAILLE:-}" in
    1|yes|true) return 0 ;;
    0|no|false) return 1 ;;
  esac
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8*|*UTF8*|*utf-8*|*utf8*) ;;
    *) return 1 ;;
  esac
  case "${TERM:-}" in
    linux|dumb|'') return 1 ;;
  esac
  return 0
}

# Which renderings may be drawn right now, newline separated.
roost_banner_variants() {
  roost_banner_supports_color   && printf 'color\n'
  roost_banner_supports_braille && printf 'braille\n'
  printf 'blocks\noutline\n'
}

roost_banner_art() {
  case "$1" in
    # The only rendering kept out of line: 44x22 cells of 24-bit escapes is
    # 20 KB, which would bury the three readable ones underneath it.
    color)
      f="$(roost_banner_dir)/$ROOST_BANNER_COLOR_FILE_NAME"
      [ -f "$f" ] || return 1
      cat "$f"
      ;;
    braille) cat <<'ART'
⣼⡄⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢠⣧
⣿⣿⣦⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣴⣿⣿
⣿⣿⣿⣷⣄⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣀⣀⣀⣀⣀⣀⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣠⣾⣿⣿⣿
⢹⣿⣿⣿⣿⣿⣦⣄⠀⠀⠀⠀⣀⣤⣴⣶⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣶⣦⣤⣀⠀⠀⠀⠀⣠⣴⣿⣿⣿⣿⣿⡏
⠀⢿⣿⣿⣿⣿⣿⣿⣿⣶⣤⣈⠛⠿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⠿⠛⣁⣤⣶⣿⣿⣿⣿⣿⣿⣿⡿⠀
⠀⠀⠻⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣶⣌⡙⠿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⠿⢋⣡⣶⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⠟⠀⠀
⠀⠀⠀⠈⢻⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣶⣌⠻⣿⣿⣿⣿⣿⣿⠟⣡⣶⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡟⠁⠀⠀⠀
⠀⠀⠀⣰⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣷⣜⣿⣿⣿⡿⣫⣾⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣆⠀⠀⠀
⠀⠀⢠⣿⣿⣿⣿⡿⠁⠉⠛⢿⣿⣿⣿⣿⣿⣿⣿⣿⣾⣿⣿⣷⣿⣿⣿⣿⣿⣿⣿⣿⡿⠛⠉⠈⢿⣿⣿⣿⣿⡄⠀⠀
⠀⠀⣾⣿⣿⣿⣿⠇⠀⠀⢠⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡄⠀⠀⠘⣿⣿⣿⣿⣷⠀⠀
⠀⠀⣿⣿⣿⣿⣿⠀⠀⠀⢸⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡇⠀⠀⠀⣿⣿⣿⣿⣿⠀⠀
⠀⠀⣿⣿⣿⣿⣿⠀⠀⠀⠘⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⠃⠀⠀⠀⣿⣿⣿⣿⣿⠀⠀
⠀⠀⣿⣿⣿⣿⣿⡀⠀⠀⠀⠈⠛⠿⣿⣿⣿⠿⠛⠻⣿⣿⣿⣿⠟⠛⠿⣿⣿⣿⠿⠟⠁⠀⠀⠀⢀⣿⣿⣿⣿⣿⠀⠀
⠀⠀⢹⣿⣿⣿⣿⣧⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠙⣿⣿⠋⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣼⣿⣿⣿⣿⡏⠀⠀
⠀⠀⠀⢿⣿⣿⣿⣿⣦⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠸⠇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣴⣿⣿⣿⣿⡿⠀⠀⠀
⠀⠀⠀⠈⢻⣿⣿⣿⣿⣷⣄⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣀⣀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣠⣾⣿⣿⣿⣿⡟⠁⠀⠀⠀
⠀⠀⠀⠀⠀⠙⢿⣿⣿⣿⣿⣷⣦⣄⡀⠀⠀⠀⠀⣠⣾⣿⣿⣷⣄⠀⠀⠀⠀⢀⣠⣴⣾⣿⣿⣿⣿⡿⠋⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠙⠻⣿⣿⣿⣿⣿⣿⣷⣦⣄⣴⣿⣿⣿⣿⣿⣿⣦⣠⣴⣾⣿⣿⣿⣿⣿⣿⠟⠋⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⠛⠿⢿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡿⠿⠛⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⠛⠿⣿⣿⣿⣿⣿⣿⣿⣿⠿⠛⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠙⢿⣿⣿⡿⠋⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢻⡟⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
ART
      ;;
    blocks) cat <<'ART'
░░                                        ░░
░░░                                      ░░░
░░░░░░           ░░░░░░░░░░           ░░░░░░
░░░░░░░░░   ░░░░░░░░░░░░░░░░░░░░   ░░░░░░░░░
 ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
  ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
    ▒░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░▒
   ▒▒▒▒▒▒░░░░░░░░░░░░▒▒░░░░░░░░░░░░▒▒▒▒▒▒
  ▒▒▒▒▒▒   ▒▒▒▒░░░░░░░░░░░░░░▒▒▒▒   ▒▒▒▒▒▒
  ▒▒▒▒▒   ▒▒▒▓▒▒▒▒░░░░░░░░▒▒▒▒▓▒▒▒   ▒▒▒▒▒
  ▒▒▒▒▒   ▒▒▒▒▒▓▓▓▒▒░░▒░▒▒▓▓▓▒▒▒▒▒   ▒▒▒▒▒
  ▒▒▒▒▒    ▒▒▒▒▒▒▓▓▓▒▒▒▒▓▓▓▒▒▒▒▒▒    ▒▒▒▒▒
  ▒▒▓▒▒▒     ▒▒▒▒▒  ▓▒▒▓  ▒▒▒▒▒     ▒▒▒▓▒▒
   ▒▒▓▓▓▒            ▒▒            ▒▓▓▓▒▒
   ▒▒▒▒▒▓▓                        ▓▓▒▒▒▒▒
     ▒▒▒▒▒▒▒▒       ░░▒▒       ▒▒▒▒▒▒▒▒
       ▒▒▒░░░▒▒░░ ░░░░▒▒▒░ ░░▒▒░░░▒▒▒
         ░░░░░░░░░░░░░░░▒▒░░░░░░░░░
              ░░░░░▒░░░░▒░░░░░
                   ░▒░░▒░
                     ░░
ART
      ;;
    outline) cat <<'ART'
##                                            ##
# #                                          # #
#  ##                                      ##  #
#    ###       ##################       ###    #
 #      ###  ##                  ##  ###      #
  ##       ##                      ##       ##
    #                                      #
    #                                      #
   #    ####                        ####    #
   #   #    #                      #    #   #
  #    #   #                        #   #    #
  #    #   #                        #   #    #
  #    #    ###    ###    ###    ###    #    #
  #    #       ####   #  #   ####       #    #
   #    #              ##              #    #
    #    #                            #    #
     #    ##           ##           ##    #
      ###   ####     ##  ##     ####   ###
         ####   #####      #####   ####
             #####            #####
                  ###      ###
                     ##  ##
                       ##
ART
      ;;
    *) return 1 ;;
  esac
}

# roost_banner [VARIANT] -> print one rendering, indented two spaces.
roost_banner() {
  variant="${1:-${ROOST_BANNER:-}}"
  if [ -z "$variant" ]; then
    # $RANDOM is bash-only but this file is already bash; no external process.
    set -f; set -- $(roost_banner_variants); set +f
    shift $(( RANDOM % $# ))
    variant="$1"
  fi
  # Capture first: piping straight into sed would report sed's exit status,
  # so an unknown variant would print nothing and still claim success.
  art="$(roost_banner_art "$variant")" || {
    printf 'roost-banner: unknown variant %s (color|braille|blocks|outline)\n' "$variant" >&2
    return 1
  }
  printf '%s\n' "$art" | sed 's/^/  /'
}

# Executed directly rather than sourced: print and exit.
case "${0##*/}" in
  roost-banner) roost_banner "${1:-}" ;;
esac
