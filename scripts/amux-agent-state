#!/usr/bin/env bash
# amux-agent-state — record an AI agent's state onto its tmux window.
#
# Called by Claude Code lifecycle hooks (see `amux hooks`). It stamps the
# window that the agent runs in with a state + glyph, which the amux status
# bar renders at a glance. It is a deliberate no-op unless the agent is running
# inside an `amux` server pane, so it is safe to wire into your GLOBAL Claude
# hooks — running `claude` anywhere else does nothing.
#
#   usage: amux-agent-state <working|blocked|done|idle>
set -euo pipefail

state="${1:-idle}"

# Must be inside tmux, in a known pane.
[ -n "${TMUX:-}" ] || exit 0
[ -n "${TMUX_PANE:-}" ] || exit 0

# $TMUX = "<socket-path>,<pid>,<session>"; only act on the amux socket.
sock="${TMUX%%,*}"
case "$sock" in
  */amux) ;;
  *) exit 0 ;;
esac

# Each state gets a glyph with a distinct SHAPE, not just a distinct colour, so
# the bar stays readable for colourblind users and in a mono terminal. All four
# are single-codepoint and exactly two cells wide — no variation selectors, which
# are what break tmux's width maths and smear the status line.
#
# Built-in fallback glyphs. Config (@amux-glyph-<state>) overrides these; the
# fallback guarantees the bar never goes blank if the option is missing/empty.
case "$state" in
  blocked) fallback="🛑" ;;        # stop sign — needs you
  working) fallback="⏳" ;;        # hourglass — thinking
  done)    fallback="✅" ;;        # check — finished, awaiting next prompt
  idle|*)  state="idle"; fallback="💤" ;;
esac
glyph="$(tmux -S "$sock" show-options -gqv "@amux-glyph-$state" 2>/dev/null)"
[ -n "$glyph" ] || glyph="$fallback"

# PostToolUse fires after EVERY tool call and Claude blocks on this script
# exiting, so the overwhelmingly common case — state already correct — has to be
# cheap: one read, then bail before doing any writes. #{@agent_state} resolves
# the window option *with* the global fallback, i.e. exactly what the bar shows.
cur="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{@agent_state}|#{@agent_glyph}' 2>/dev/null || true)"
prev="${cur%%|*}"
prev_glyph="${cur#*|}"
[ "$state" = "$prev" ] && [ "$glyph" = "$prev_glyph" ] && exit 0

# Stamp the WINDOW that owns this pane (reliably read by window-status-format).
tmux -S "$sock" set-option -w -t "$TMUX_PANE" @agent_state "$state" 2>/dev/null || true
tmux -S "$sock" set-option -w -t "$TMUX_PANE" @agent_glyph "$glyph" 2>/dev/null || true

# On a real state change, record when it happened (for elapsed-time display)
# and ping if an off-screen agent just became blocked (needs your input).
if [ "$state" != "$prev" ]; then
  tmux -S "$sock" set-option -w -t "$TMUX_PANE" @agent_since "$(date +%s)" 2>/dev/null || true

  if [ "$state" = blocked ]; then
    active="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{window_active}' 2>/dev/null || echo 0)"
    if [ "$active" != "1" ]; then
      wname="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null || echo agent)"
      AMUX_NOTIFY_SOCK="$sock" "$(dirname "$0")/amux-notify" "amux · ${wname}" "needs your input" || true
    fi
  fi
fi

# Nudge every attached client to repaint now instead of waiting for the tick.
tmux -S "$sock" refresh-client -S 2>/dev/null || true
