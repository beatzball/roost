#!/usr/bin/env bash
# amux-agent-state — record an AI agent's state onto its tmux pane.
#
# Called by Claude Code lifecycle hooks (see `amux hooks`). It stamps the
# pane that the agent runs in with a state, which the amux status bar
# renders at a glance (glyphs are derived at render time, not stored here).
# It is a deliberate no-op unless the agent is running
# inside an `amux` server pane, so it is safe to wire into your GLOBAL Claude
# hooks — running `claude` anywhere else does nothing.
#
#   usage: amux-agent-state <working|blocked|error|done|idle>
set -euo pipefail

# Resolve this script's own directory even when invoked via a symlink — same
# readlink loop as bin/amux. This hook is wired into ~/.claude/settings.json by
# ABSOLUTE path, and that path can perfectly well be a symlink (an alias on
# PATH, a compatibility shim left behind by a rename). Through one, $0 is the
# symlink, so `dirname "$0"` names the WRONG directory and the amux-notify call
# below would miss its sibling — silently, since that call carries `|| true`
# and must keep carrying it. Resolve once here, at the top, where it costs
# nothing: this is pure shell, no tmux round trip, so the PostToolUse hot path
# (one tmux read, then bail) is unaffected.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

state="${1:-idle}"

# Must be inside tmux, in a known pane.
[ -n "${TMUX:-}" ] || exit 0
[ -n "${TMUX_PANE:-}" ] || exit 0

# $TMUX = "<socket-path>,<pid>,<session>"; only act on the amux socket.
sock="${TMUX%%,*}"
case "$sock" in
  */amux) ;;
  *) exit 0 ;;
esac

# Normalise: anything unrecognised is idle.
case "$state" in blocked|working|done|error) ;; *) state="idle" ;; esac

# PostToolUse fires after EVERY tool call and Claude blocks on this script
# exiting, so the common case — state already correct — must be cheap: ONE read,
# then bail before any writes. It MUST carry `|| true`: under `set -e` a bare
# failing $(...) aborts, and a dead tmux server (agent windows are killable) has
# to degrade, never break Claude.
#
# That same read also tells us whether the pane already has a label, so the
# hot (unchanged-state) path stays a single tmux round trip even though it
# now decides two things instead of one. A plain separator between the two
# fields is not safe to add here: @amux-name is free text a human chose (see
# bin/amux's `send` comment on why an in-band separator breaks), so nothing
# printable is guaranteed absent from it. Instead we append a fixed marker
# "X" to the state, but only when @amux-name is non-empty — the same
# emptiness-ternary idiom bin/amux's `status` branch and tmux/amux.conf's
# @amux-pane-border already use for this exact check, and deliberately an
# equality test against "" rather than tmux's `#{?@amux-name,...}`
# truthiness, which treats a pane literally named "0" as unset. $state is
# always error/blocked/working/done/idle, never ending in X, so a trailing X
# can only have come from the marker and is safe to strip.
raw="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" \
  '#{@agent_state}#{?#{==:#{@amux-name},},,X}' 2>/dev/null || true)"
case "$raw" in
  *X) prev="${raw%X}"; has_name=1 ;;
  *)  prev="$raw";      has_name=0 ;;
esac
[ "$state" = "$prev" ] && exit 0

# Stamp the PANE, not the window. Pane scope is what lets two agents share one
# window without overwriting each other's badge. Glyphs are NOT stamped: the
# status bar derives them from @amux-glyph-<state> at render time, so a theme
# change is live everywhere with nothing left to go stale.
tmux -S "$sock" set-option -p -t "$TMUX_PANE" @agent_state "$state" 2>/dev/null || true
tmux -S "$sock" set-option -p -t "$TMUX_PANE" @agent_since "$(date +%s)" 2>/dev/null || true

# Label the pane, but only to fill a gap: a name a human chose (`split -n`,
# `spawn NAME`) always wins, so this never runs when $has_name is 1. Without
# a label a live Claude pane falls back to #{pane_current_command}, which
# reports its OWN VERSION STRING (e.g. "2.1.226") — it changes every release
# and means nothing to a reader of the border or the switcher.
#
# AMUX_AGENT_NAME lets a non-Claude harness (e.g. the opencode adapter, which
# sets it in its execFile env) name itself instead of inheriting the
# Claude-flavoured default — every opencode pane would otherwise read
# "claude" on its border and in the switcher. It is preferred over
# @amux-name-default, but a human-chosen @amux-name (has_name=1) still wins
# over both, since that branch never runs at all.
# @amux-name-default is a global option (in keeping with @amux-glyph-*,
# @amux-notify-*, etc.) so a user running something other than Claude under
# amux's hooks can rename the fallback; "claude" is the honest default since
# this script IS Claude Code's hook.
if [ "$has_name" != 1 ]; then
  # AMUX_AGENT_NAME is process env from whatever harness invoked us — just as
  # uncontrolled as @amux-name-default (a human can export anything), so it
  # gets the identical tab/newline rejection before it is trusted.
  # ANSI-C $'\t'/$'\n', NOT "$(printf '\n')": command substitution strips ALL
  # trailing newlines, so that form collapses to the empty string and the
  # newline arm would then match (and reject) every label — the same hazard
  # bin/amux's reject_bad_name comment warns about.
  label="${AMUX_AGENT_NAME:-}"
  case "$label" in *$'\t'*|*$'\n'*) label="" ;; esac
  if [ -z "$label" ]; then
    label="$(tmux -S "$sock" show-options -gqv @amux-name-default 2>/dev/null || true)"
    # @amux-name-default is user-controlled tmux state (a human can `tmux
    # set-option -g` it directly), not validated at write time the way every
    # OTHER @amux-name write site is via bin/amux's reject_bad_name — this hook
    # is a fourth write site with no gate of its own. A tab shifts `amux
    # status`'s tab-delimited switcher rows; a newline splits one pane's line
    # into two — either way a selectable row loses its session/window key
    # fields and a click runs `switch-client -t ""` silently, the exact
    # corruption reject_bad_name's own comment documents. Unlike
    # reject_bad_name (a loud exit 2, fine for an interactive command), this
    # hook runs on every PostToolUse and Claude blocks on it exiting, so a bad
    # value must degrade to the built-in default instead of breaking the hook.
    case "$label" in *$'\t'*|*$'\n'*) label="claude" ;; esac
  fi
  [ -n "$label" ] || label="claude"
  tmux -S "$sock" set-option -p -t "$TMUX_PANE" @amux-name "$label" 2>/dev/null || true
fi

# Ping if an off-screen agent just became blocked (needs your input) or errored
# (will not progress without you — for opencode the usual cause is a provider
# it cannot reach, retrying forever). If the window is on screen the pane is
# visible, so no ping. `done` deliberately never notifies: it fires every turn
# and would be noise.
msg=""
case "$state" in
  blocked) msg="needs your input" ;;
  error)   msg="hit an error" ;;
esac
if [ -n "$msg" ]; then
  active="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{window_active}' 2>/dev/null || echo 0)"
  if [ "$active" != "1" ]; then
    wname="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null || echo agent)"
    # $SELF_DIR, not `dirname "$0"`: through a symlink $0 is the symlink's own
    # path and the sibling lookup would miss. The `|| true` is deliberate and
    # must stay — a dead tmux server (agent windows are killable) has to
    # degrade, never break Claude — which is exactly why the miss would be
    # invisible, and why the path has to be right before it is swallowed.
    AMUX_NOTIFY_SOCK="$sock" "$SELF_DIR/amux-notify" "amux · ${wname}" "$msg" || true
  fi
fi

# Nudge every attached client to repaint now instead of waiting for the tick.
tmux -S "$sock" refresh-client -S 2>/dev/null || true
