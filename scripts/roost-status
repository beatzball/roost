#!/usr/bin/env bash
# roost-status — one-line summary of agent states for the roost status bar.
# Rolls every agent pane across the roost server up to badged counts:
#   💥1 error  🛑3 blocked  ⏳1 working  ✅4 done  💤2 idle
# Panes never stamped by a hook (plain shells, log tails) are skipped, not
# counted as idle. Invoked from status-right on the normal status tick; six
# tmux calls (five glyph reads + one pane list) — see the separator note below
# for why the glyph reads cannot be collapsed into one across tmux versions.
#
# The glyphs are read back off global config rather than hardcoded here, so
# roost-agent-state stays the single source of truth for what each state looks
# like. (The old ● dots also carried a latent bug: U+25CF is East-Asian
# Ambiguous width, so it renders 1 cell here but 2 in a CJK locale, smearing
# the bar. The state emoji are unambiguously 2 cells everywhere.)

# Socket, in order: ROOST_STATUS_SOCK (test seam, a path -> -S), else the server
# we are running inside, else the shared production server by name.
# The middle step is what keeps this off the wrong server: status-right's #()
# child inherits $TMUX, so a rollup rendered by a throwaway server reports on
# THAT server. Without it, anything invoking this script without the env var —
# a test, a manual check — silently reads the developer's live agents instead.
roost_status_tmux() {
  if [ -n "${ROOST_STATUS_SOCK:-}" ]; then tmux -S "$ROOST_STATUS_SOCK" "$@"
  elif [ -n "${TMUX:-}" ]; then tmux -S "${TMUX%%,*}" "$@"
  else tmux -L roost "$@"; fi
}

e=0 b=0 w=0 d=0 i=0
# Glyphs come from config so the rollup, the tab badge, and the switcher all
# derive from one source. Hardcoded values are last-resort fallbacks only.
# One call, not five: this runs on the 2s status tick, so each extra tmux
# invocation is a fork+roundtrip every 2 seconds on a live bar.
#
# One value per call, deliberately. Reading all five in a single
# display-message and splitting on an in-band separator does NOT survive the
# supported tmux range: glyphs are USER-CONFIGURABLE so no printable separator
# is safe, and a control byte is version-dependent — `#{a:N}` for N<32 is
# silently dropped by the format engine, while a literal 0x1F in the template
# comes back as the four characters \037 on tmux 3.4 (CI caught this; it passes
# through untouched on 3.6+, so it looks correct on a modern box and breaks on
# the floor). `show-options -gqv` prints one raw value with no quoting and no
# escaping on every version, which is the only thing that holds.
#
# This costs five forks per status tick instead of one. That is the price of
# working on tmux 3.4; see @roost-tab-badge in tmux/roost.conf for the same read
# done in-process by the format engine, where it is free.
ge="$(roost_status_tmux show-options -gqv @roost-glyph-error   2>/dev/null)"
gb="$(roost_status_tmux show-options -gqv @roost-glyph-blocked 2>/dev/null)"
gw="$(roost_status_tmux show-options -gqv @roost-glyph-working 2>/dev/null)"
gd="$(roost_status_tmux show-options -gqv @roost-glyph-done    2>/dev/null)"
gi="$(roost_status_tmux show-options -gqv @roost-glyph-idle    2>/dev/null)"
[ -n "$ge" ] || ge="💥"
[ -n "$gb" ] || gb="🛑"
[ -n "$gw" ] || gw="⏳"
[ -n "$gd" ] || gd="✅"
[ -n "$gi" ] || gi="💤"

# Count AGENT PANES, not windows: two agents sharing a window count twice, and a
# pane with no state is a plain shell, not an idle agent, so it is skipped
# entirely. The rollup is therefore a count of agents rather than of tabs.
while IFS= read -r st; do
  case "$st" in
    error)   e=$((e+1)) ;;
    blocked) b=$((b+1)) ;;
    working) w=$((w+1)) ;;
    done)    d=$((d+1)) ;;
    idle)    i=$((i+1)) ;;
    *)       ;;   # empty -> not an agent
  esac
done < <(roost_status_tmux list-panes -a -F '#{@agent_state}' 2>/dev/null)

# Ordered by how much they want your attention. The emoji carry their own colour,
# so no #[fg=] is needed — which is what lets the counts stay legible on any bg.
#
# Spacing: one space inside a badge, two between them. Emoji render flush against
# a following digit, and with an equal gap either side "🛑1 ⏳2" reads as one run
# of characters — the outer gap has to beat the inner gap for each badge to read
# as a unit. The trailing pair also separates the counts from the session name.
out=""
[ "$e" -gt 0 ] && out+="${ge} ${e}  "
[ "$b" -gt 0 ] && out+="${gb} ${b}  "
[ "$w" -gt 0 ] && out+="${gw} ${w}  "
[ "$d" -gt 0 ] && out+="${gd} ${d}  "
[ "$i" -gt 0 ] && out+="${gi} ${i}  "
printf '%s' "$out"
