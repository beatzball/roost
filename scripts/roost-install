#!/usr/bin/env bash
# roost install — wire every installed harness to THIS checkout.
#
# One command, safe to re-run, that does everything that can be done without a
# human answering a prompt and names precisely what is left.
#
# What this file does today: detection, the plan, the prompt, the flags, the
# exit codes, the three adapter symlinks (opencode, pi, copilot), the claude
# and codex hook files, and copilot's EXTENSIONS feature flag. What is left in
# the closing manual block is what no tool can do: a file roost refused to
# edit because it is not ours, the two prompts a human has to answer, and the
# blocks to paste when there is no JSON tool on the machine.
#
# Four properties are load-bearing and every change must keep them:
#
#   - Nothing is written without consent. `read -r -t 60`, and BOTH a timeout
#     and a non-terminal resolve to no. Someone who started this and walked
#     away has agreed to nothing being written to their machine, and a pipe or
#     a CI step has nobody in it to agree.
#   - A path that is not ours is never replaced. Not moved, not backed up and
#     overwritten, not `ln -sf`'d. It is left exactly as found and the manual
#     command is printed instead. Someone's own extension must never be lost
#     to an install run.
#   - --dry-run writes NOTHING, `mkdir -p` included. An empty directory left
#     behind by a run that promised to change nothing is still a change.
#   - A backup is taken only immediately before a write that is really going
#     to happen. A `.roost-bak-*` beside a file nothing changed is a bug, not
#     a safety margin: it is indistinguishable from one that records a real
#     change, so it makes every other backup less trustworthy.
set -u

# `--symlinks-only` is written for `roost validate`, and validate's
# offer_adapter_install now calls it — `--symlinks-only --yes --only <the
# harnesses it offered>` — instead of carrying its own copy of the mkdir and
# the ln. That caller's policy is narrower than this command's on purpose, and
# the one place they differ is a DANGLING adapter link: relinking one is right
# here and wrong there, which is why validate restricts the run with --only
# rather than letting this command decide.
#
# --- this checkout ---------------------------------------------------------
# Resolved from this file's own location, never from an inherited $ROOST_HOME.
# bin/roost does `set-environment -g ROOST_HOME` (bin/roost:89), so EVERY pane
# of a roost session exports it pointing at whichever checkout started the
# server — and an installer that trusted it, run from a second checkout inside
# that session, would cheerfully create symlinks into the FIRST one while
# reporting that it had linked this one. scripts/lib/roost-adapters.sh's
# _roost_adapter_root comment records the measured version of that bug.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _dir="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) : ;; *) _self="$_dir/$_self" ;; esac
done
HERE="$(cd -P "$(dirname "$_self")/.." && pwd)"
HERE="${HERE%/}"

# roost_adapter_home / _path / _target / _state — the one table of where each
# adapter goes, shared with roost validate and roost doctor so a report and an
# install plan can never disagree about which file either of them means.
. "$HERE/scripts/lib/roost-adapters.sh"
# roost_hooks_claude / roost_hooks_codex — the ONE definition of the hook JSON
# bodies, used by --print-only. Never re-typed here: codex stores a hash of
# each normalised handler object and silently skips any handler whose hash no
# longer matches, so a second copy that drifts by one byte un-badges every
# machine that had already granted trust.
. "$HERE/scripts/lib/roost-hooks.sh"
# roost_json_tool / roost_json_merge / roost_json_backup — the atomic,
# backed-up JSON writer. It is the only thing here that edits a config file,
# and it is the reason this command can promise that a malformed input is left
# untouched: every non-zero status it returns leaves the file alone and takes
# no backup.
. "$HERE/scripts/lib/roost-json.sh"

# Whether THIS checkout is a linked git worktree, read once per run. It decides
# one thing: whether a link that names another copy of roost may be taken over
# (see the other-checkout arm in the plan below). On the machine roost is built
# on, the live agents run from the primary checkout and every build and test
# pane runs from a worktree under .claude/worktrees/; a `roost install --yes`
# in one of those panes must not steal the primary's links, because the
# worktree is deleted after its merge and the links would then point at
# nothing. No git, or not a repository at all, reads as not a worktree.
IN_WORKTREE=0
roost_checkout_is_worktree "$HERE" && IN_WORKTREE=1

# The hook target scripts, for the merge and for telling "already wired to
# THIS checkout" from "wired to a different one".
#
# roost-hooks.sh names the same two paths as ITS defaults, and these two lines
# are the second spelling. That is a real drift risk — a mismatch would write
# hooks pointing at a script that is not there, and a hook that cannot exec
# just never badges, silently — so tests/test-adapter-install.sh renders the
# block both ways and compares, and will fail the moment they disagree. The
# duplication is not avoidable today: roost_json_merge takes the SCRIPT path
# from its caller, and roost-hooks.sh exposes no accessor for its own default.
CLAUDE_TARGET="$HERE/scripts/roost-agent-state"
CODEX_TARGET="$HERE/adapters/codex/roost-codex-hook"

# Detection order, and the only names --only will accept.
HARNESSES="opencode pi copilot claude codex"

# --- flags -----------------------------------------------------------------
ASSUME_YES=0
DRY_RUN=0
PRINT_ONLY=0
SYMLINKS_ONLY=0
# Where to write the machine-readable record, or empty for "do not". Opt-in
# on purpose: see record_outcome below.
RECORDS=""
ONLY=""
# Whether --only was GIVEN, tracked apart from its value. The two are not the
# same question, and conflating them is what let an empty value read as "no
# restriction" instead of "a restriction naming nothing".
ONLY_GIVEN=0

usage() { # usage RC — to stdout for --help, to stderr for a usage error
  local rc="$1" out=1
  [ "$rc" -eq 0 ] || out=2
  {
    cat <<'USAGE'
usage: roost install [-y|--yes] [--dry-run] [--only H[,H...]]
                     [--print-only] [--symlinks-only] [--records FILE]
                     [-h|--help]

Wires every installed harness to this roost checkout. Prints the plan first,
asks once, and never replaces a file that is not roost's own.

  -y, --yes         do not ask. Required for an unattended run: with no
                    terminal, silence is taken as no and nothing is written.
  --dry-run         print the plan and change nothing at all. Exits 0.
  --only H[,H...]   restrict to these harnesses (opencode, pi, copilot,
                    claude, codex). Anything else is left completely alone.
  --print-only      never edit a JSON file; print the blocks to paste instead.
  --symlinks-only   the adapter symlinks and nothing else. This is the mode
                    `roost validate` invokes after its own prompt, so that
                    a validation run writes symlinks and nothing else.
  --records FILE    write a machine-readable record of what this run did to
                    FILE, for a caller assembling its own report. Adds
                    nothing to the output above. `roost validate` is the one
                    caller; see the comment on record_outcome for the shape.
  -h, --help        this text.

Exit codes: 0 everything it could do succeeded, even with manual steps left.
1 a write failed. 2 usage.
USAGE
  } >&"$out"
  exit "$rc"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -y|--yes)        ASSUME_YES=1; shift ;;
    --dry-run)       DRY_RUN=1; shift ;;
    --print-only)    PRINT_ONLY=1; shift ;;
    --symlinks-only) SYMLINKS_ONLY=1; shift ;;
    # The SAME missing-value guard --only carries, and for the same class of
    # reason. A caller whose variable was unset would otherwise get a run
    # with no record at all, which to the caller reads exactly like a run
    # that wrote nothing -- the one failure mode a report cannot tell from
    # success.
    --records)
      case "${2:-}" in
        ''|-*) printf 'roost install: --records needs a file path\n' >&2; usage 2 ;;
      esac
      RECORDS="$2"; shift 2 ;;
    --records=*)
      case "${1#*=}" in
        ''|-*) printf 'roost install: --records needs a file path\n' >&2; usage 2 ;;
      esac
      RECORDS="${1#*=}"; shift ;;
    --only)
      # A following flag is not a value. `--only --yes` must fail as a missing
      # argument rather than silently restricting the run to a harness called
      # "--yes" and then linking nothing.
      case "${2:-}" in
        ''|-*) printf 'roost install: --only needs a harness list\n' >&2; usage 2 ;;
      esac
      ONLY_GIVEN=1; ONLY="$2"; shift 2 ;;
    # The SAME guard, on the other spelling. `--only=` with an empty value used
    # to slip past it and then, being empty, past the `[ -n "$ONLY" ]` test
    # below as well — so the restriction was DROPPED rather than emptied and
    # the run linked every harness. `roost install --only="$HARNESS" --yes` in
    # a wrapper where $HARNESS is unset is the realistic way to get there.
    --only=*)
      case "${1#*=}" in
        ''|-*) printf 'roost install: --only needs a harness list\n' >&2; usage 2 ;;
      esac
      ONLY_GIVEN=1; ONLY="${1#*=}"; shift ;;
    -h|--help)       usage 0 ;;
    *) printf "roost install: unknown argument '%s'\n" "$1" >&2; usage 2 ;;
  esac
done

# --only is validated against the known names BEFORE anything is detected or
# printed. A typo'd harness silently restricting the run to nothing at all
# would exit 0 having done nothing, which reads exactly like a successful
# no-op — the one failure mode a user cannot tell from success.
#
# THE INVARIANT, and it is a safety one: if --only was given at all, it must
# end up naming at least one real harness, or this exits 2. Anything else —
# `--only=`, `--only ,`, `--only ' '` — is a caller error, and the one
# interpretation that must never be reachable is "no restriction". The blast
# radius of getting that wrong is not just the three symlinks: it is claude's
# settings.json, codex's hooks.json and copilot's settings.json written on a
# machine whose caller explicitly scoped them out.
ONLY_LIST=""
if [ "$ONLY_GIVEN" -eq 1 ]; then
  # Bash's own substitution, not `tr`: this runs before roost has told the
  # user anything, and a thin PATH must not turn a typo'd --only into a silent
  # empty restriction that then links everything.
  for h in ${ONLY//,/ }; do
    case " $HARNESSES " in
      *" $h "*) ONLY_LIST="$ONLY_LIST $h" ;;
      *) printf "roost install: --only: unknown harness '%s' (known: %s)\n" \
           "$h" "$HARNESSES" >&2; exit 2 ;;
    esac
  done
  # Non-empty but reducing to no words at all: separators only, or whitespace.
  # Caught here rather than left to `in_scope`, which reads an empty ONLY_LIST
  # as "unrestricted" — correct for a run with no --only, catastrophic for one
  # that had it.
  if [ -z "$ONLY_LIST" ]; then
    printf "roost install: --only: no harness named (known: %s)\n" "$HARNESSES" >&2
    exit 2
  fi
fi
ONLY_LIST="${ONLY_LIST# }"

# --- the machine-readable record -------------------------------------------
# record_outcome VERB HARNESS PATH [UNDO] -- one TAB-separated line per path
# this run reached a FINAL outcome for, appended to --records' file:
#
#   wrote      this run changed that path. UNDO is the exact command that
#              puts it back -- `rm` for a link or a file this run created,
#              `cp` from the backup for a merge into a file that was there.
#   removed    this run removed a symlink at that path: roost's own opencode
#              1.x link, on a machine whose opencode is 2.x. UNDO is the
#              `ln -s` that puts the same link back.
#   unchanged  it was already correct. Written by nobody this run, and
#              deliberately NOT the same as no line at all.
#   refused    something that is not this checkout's is there, or the path
#              changed underneath the run after the plan was printed.
#   failed     the write was attempted and did not work.
#
# WHY A FILE AND NOT STDOUT. `roost validate` captures this command's output
# and prints it verbatim when a write fails -- that output is the only
# explanation a tester gets on the one path where it matters, and machine
# lines interleaved through it would be exactly the noise this flag promised
# not to add. A separate stream also cannot be broken by a caller that
# reworded a human line.
#
# WHY VALIDATE NEEDS IT AT ALL, rather than reading roost_adapter_state back
# off the disk afterwards: "is it linked now" is a different question from
# "did this run link it", and the two diverge in both directions. A link
# created against an adapter file that is not in the checkout is a real write
# that reads back as `dangling`; a link a tester makes in another terminal
# while validate's 60-second prompt is open reads back as `ok` and this run
# did not make it. Deriving the report from the disk therefore both hid a
# write and claimed one. This function is the installer saying what it did.
record_outcome() { # record_outcome VERB HARNESS PATH [UNDO]
  [ -n "$RECORDS" ] || return 0
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-}" >> "$RECORDS"
}

# Truncated up front, and a failure here is fatal rather than ignored. An
# append-only record that a previous run had already filled in would tell the
# caller this run wrote things it never touched, and a record file that
# cannot be written at all must not read as a run that did nothing.
if [ -n "$RECORDS" ]; then
  : > "$RECORDS" || {
    printf "roost install: --records: cannot write '%s'\n" "$RECORDS" >&2
    exit 2
  }
fi

in_scope() { # in_scope HARNESS
  [ -n "$ONLY_LIST" ] || return 0
  case " $ONLY_LIST " in *" $1 "*) return 0 ;; esac
  return 1
}

# --- config files that are really symlinks ---------------------------------
# resolve_link PATH -> the real path a symlink chain ends at (PATH itself when
# it is not a link).
#
# Keeping ~/.claude/settings.json symlinked into a dotfiles repo is common in
# this audience, and every naive check gets it wrong in the same direction:
# `[ -f ]` FOLLOWS the link, so the file reads as present, and then the
# temp-file-plus-`mv` write drops a regular file over the link. The dotfiles
# repo stops being the source of that file, the user's VCS never sees the
# change, and nothing says so. Resolving first also keeps the write atomic for
# the right file: roost_json_merge puts its temp file in `dirname FILE`, which
# has to be the REAL file's directory or the `mv` crosses filesystems.
#
# Bounded rather than `while [ -L ]` forever: a symlink loop is rare and
# self-inflicted, but an installer that hangs on one is worse than one that
# gives up and writes to the link itself, which is what the caller would have
# done anyway.
resolve_link() { # resolve_link PATH
  local p="$1" d n=0
  while [ -L "$p" ] && [ "$n" -lt 20 ]; do
    d="$(cd -P "$(dirname "$p")" 2>/dev/null && pwd)" || break
    p="$(readlink "$p")"
    case "$p" in /*) : ;; *) p="$d/$p" ;; esac
    n=$((n + 1))
  done
  printf '%s' "$p"
}

# --- reading a config file before writing it -------------------------------
# json_probe MODE FILE [PATCH WANT] -> one word on stdout, optionally followed
# by a TAB and the offending command string:
#
#   ours            nothing to do — every one of roost's entries is already
#                   there, pointing at this checkout
#   write K R       a write is due. K entries belonging to someone else sit in
#                   those events and are KEPT; R entries of ROOST'S OWN are
#                   not the current shape and are replaced by it. `write 0 0`
#                   covers the two nothing-there-yet cases as well: a
#                   settings.json with no "hooks" key, and a copilot file whose
#                   EXTENSIONS flag is absent or false. Both parse perfectly,
#                   so neither is `malformed` -- and an engine answering in a
#                   FIFTH word would be, because the dispatcher below accepts
#                   only the four listed here and reports anything else as a
#                   file it could not parse
#   other-checkout  a roost hook is there, pointing at a DIFFERENT checkout
#   unreadable      the file exists and cannot be read
#   malformed       it does not parse, an event roost writes is not an array,
#                   or the engine could not answer
#
# A `write` with K > 0 is not a refusal, and it used to be one.
# The refusal was correct while scripts/lib/roost-json.sh REPLACED each event
# it wrote — merging over a PostToolUse carrying the user's own formatter
# deleted it, rc 0, nothing printed — but refusing meant anyone with a
# formatter hook got no roost automation at all, which is most of the people
# who would want it. The merge appends now, so the honest answer is to write
# and SAY what was kept.
#
# other-checkout is still a hard refusal and is the most important behaviour
# in this file. See the codex note further down for why rewriting one would be
# worse than doing nothing.
#
# EVENTS ARE NOT LISTED HERE. They are read out of PATCH — the very document
# roost-hooks.sh is about to merge — so an event added there is checked here
# without anybody remembering to. Same for the marker: it is the basename of
# WANT, so "roost-agent-state" and "roost-codex-hook" are each written down
# once, in the target path, and nowhere else.
#
# Both engines are implemented because roost_json_merge supports both, and a
# probe that only understood python3 would leave a jq-only machine unable to
# tell "already wired" from "wired somewhere else" — the one distinction that
# decides whether anything is written at all.
json_probe__py() {
  cat <<'PY'
import json
import sys


def commands(node, out):
    # Every value of a "command" key, at any depth. Claude nests them under
    # hooks[event][group]["hooks"][n], codex the same way; walking for the key
    # rather than for a fixed shape means a hand-written file that nests
    # differently is still read, instead of silently reading as empty (which
    # would classify someone's own hook as "no hook here" and overwrite it).
    if isinstance(node, dict):
        for k, v in node.items():
            if k == "command" and isinstance(v, str):
                out.append(v)
            else:
                commands(v, out)
    elif isinstance(node, list):
        for v in node:
            commands(v, out)


def main():
    mode = sys.argv[1]
    try:
        with open(sys.argv[2]) as fh:
            data = json.load(fh)
    except Exception:
        print("malformed")
        return
    if not isinstance(data, dict):
        print("malformed")
        return

    if mode == "flag":
        # `write 0 0`, not a word of its own. There is no hook entry to keep or
        # to replace when the question is one boolean, and a fourth outcome
        # that the dispatcher below would have to learn -- and did not -- is
        # how this came back as "malformed" for a file that parses fine.
        flags = data.get("enabledFeatureFlags")
        print("ours" if isinstance(flags, dict) and flags.get("EXTENSIONS") is True else "write\t0\t0")
        return

    patch = json.loads(sys.argv[3])["hooks"]
    want = sys.argv[4]
    # ALSO is the scripts DIRECTORY of another copy of roost, and KIND says
    # how much of it counts as roost's own:
    #
    #   gone  the caller proved on the FILESYSTEM that it is gone -- a hook
    #         wired to a checkout that has been moved, renamed or deleted.
    #         EVERY command under it counts. Such an entry is roost's, and
    #         broken, and safe to replace; the symlink adapters have always
    #         treated their equivalent (`dangling`) that way. Without it the
    #         entry classified as another checkout's and the whole claude
    #         step was refused on every re-run, forever.
    #   live  the copy still EXISTS, and the caller is a plain checkout taking
    #         its hooks over. Only roost's own scripts count: a command whose
    #         first word is exactly ALSO/<name>, for a <name> this patch
    #         invokes (roost-agent-state, roost-session-context). Anything
    #         else under that directory can run, and may be the user's own --
    #         a prefix match deleted a hand-added `<other>/scripts/roost-notify`
    #         hook, and with a roost-agent-state copied into ~/bin it deleted
    #         the user's formatter beside it.
    #
    # A DIRECTORY rather than one script path, and that distinction cost an
    # end-to-end run to find. The claude patch invokes TWO scripts from that
    # directory, and only one of them carries $marker: matching the dead
    # roost-agent-state alone left the dead roost-session-context classified
    # as a stranger's, so it was kept and roost's own was appended beside it.
    # The file came back with two SessionStart hooks, one of them a path that
    # does not exist. Everything under a directory that is not there is dead
    # by definition, so the whole directory is the honest unit.
    #
    # Matched with a trailing "/" so a sibling directory whose name merely
    # starts with the same characters is not swept up with it.
    also = sys.argv[5] if len(sys.argv) > 5 else ""
    kind = sys.argv[6] if len(sys.argv) > 6 else "gone"
    marker = want.rsplit("/", 1)[-1]
    # For `live`: the script names this patch runs from want's directory,
    # read out of the patch itself so a script added there is covered here
    # without anybody remembering to. Cut at the directory, not at the first
    # space, so a checkout path with a space in it still yields the name.
    wantdir = want.rsplit("/", 1)[0]
    pcmds = []
    commands(json.loads(sys.argv[3]), pcmds)
    names = sorted({c[len(wantdir) + 1:].split(" ", 1)[0]
                    for c in pcmds if c.startswith(wantdir + "/")})
    alsos = [also + "/" + n for n in names if n] if also else []

    def also_owns(cmd):
        if not also:
            return False
        if kind == "live":
            return any(cmd == a or cmd.startswith(a + " ") for a in alsos)
        return cmd.startswith(also + "/")
    hooks = data.get("hooks")
    if hooks is None:
        # A settings.json with no "hooks" key at all: the most ordinary claude
        # file this command meets. Nothing of anyone's is in those events, so
        # nothing is kept and nothing is replaced.
        print("write\t0\t0")
        return
    if not isinstance(hooks, dict):
        print("malformed")
        return

    # Asked ENTRY BY ENTRY, not event by event, because the merge appends
    # entry by entry. "Is this event already what roost would write" was the
    # right question only while the merge assigned over the whole array; now
    # the question is whether each of roost's entries is present, and who owns
    # each of the ones that are not roost's.
    missing = False   # one of roost's entries is not there -> a write is due
    kept = 0          # entries belonging to someone else, which survive it
    replaced = 0      # entries of ROOST'S OWN that are not the current shape
    checkout = None   # a roost entry from a DIFFERENT checkout -> refuse
    for event in patch:
        existing = hooks.get(event, [])
        # No append means anything here, and roost does not get to decide what
        # it meant. roost_json_merge refuses it in the same words.
        if not isinstance(existing, list):
            print("malformed")
            return
        for entry in patch[event]:
            if entry not in existing:
                missing = True
        for entry in existing:
            if entry in patch[event]:
                continue          # roost's own, already exactly right
            cmds = []
            commands(entry, cmds)
            mine = bool(cmds)
            for cmd in cmds:
                if cmd == want or cmd.startswith(want + " "):
                    continue
                if also_owns(cmd):
                    continue          # ours, from another copy (see KIND)
                mine = False
                if marker in cmd and checkout is None:
                    checkout = cmd
            if mine:
                # This checkout's, but not the shape roost writes today: an
                # older release's entry, or one the user edited by hand. The
                # merge drops it and appends the canonical one. Counted
                # separately from `kept` because it is the one change a user
                # cannot see in the accounting — nothing of "theirs" was
                # there, so no kept-line would fire — and reverting somebody's
                # deliberate edit in silence is exactly the kind of thing this
                # command prints backups for.
                replaced += 1
            else:
                kept += 1

    if checkout is not None:
        print("other-checkout\t" + checkout)
    elif missing or replaced:
        print("write\t%d\t%d" % (kept, replaced))
    else:
        print("ours")


main()
PY
}

json_probe__jq() {
  cat <<'JQ'
def cmds: [ .. | objects | to_entries[] | select(.key == "command") | .value | select(type == "string") ];
# $also is another copy's scripts directory, and $kind says how much of it
# counts as roost's own -- see the python probe's note on KIND: under `gone`
# every command below it, under `live` only a command whose first word is
# exactly $also/<name> for a script this patch runs. Defined once and used by
# both ownership tests below, because two copies of this predicate is exactly
# how one of them ends up knowing about $also and the other not.
($want | sub("/[^/]*$"; "")) as $wantdir
| ( [ $patch | cmds[] | select(startswith($wantdir + "/"))
      | .[($wantdir | length) + 1:] | split(" ")[0] | select(. != "") ]
    | unique | map($also + "/" + .) ) as $alsos
| def ours: . as $c
  | ($c == $want or ($c | startswith($want + " ")))
    or (($also != "")
        and (if $kind == "live"
             then any($alsos[]; . as $a | $c == $a or ($c | startswith($a + " ")))
             else ($c | startswith($also + "/")) end));
if length != 1 then "malformed"
else .[0] as $d
| if ($d | type) != "object" then "malformed"
  elif $mode == "flag" then
    (if (($d.enabledFeatureFlags | type) == "object") and ($d.enabledFeatureFlags.EXTENSIONS == true)
     then "ours" else "write\t0\t0" end)
  elif ($d.hooks == null) then "write\t0\t0"
  elif (($d.hooks | type) != "object") then "malformed"
  else
    ($patch.hooks) as $p
    | ($want | split("/") | .[-1]) as $marker
    | if any($p | keys_unsorted[]; (($d.hooks[.]) // []) | type != "array") then "malformed"
      else
      ( [ ($p | keys_unsorted[]) as $ev
          | (($d.hooks[$ev]) // []) as $ex
          | ( [ $p[$ev][] as $pe | select(any($ex[]; . == $pe) | not) | "missing" ] )
            + ( [ $ex[] as $ee | select(any($p[$ev][]; . == $ee) | not)
                  | ($ee | cmds) as $c
                  | if (($c | length) > 0) and (all($c[]; ours))
                    then "replaced"
                    else ( [ $c[] | select(ours | not)
                             | select(index($marker) != null) ] ) as $bad
                         | if ($bad | length) > 0 then "other-checkout\t" + $bad[0] else "kept" end
                    end ] )
        ] | flatten ) as $all
      | ( [ $all[] | select(startswith("other-checkout")) ] ) as $oc
      | ( [ $all[] | select(. == "kept") ] | length ) as $nkept
      | ( [ $all[] | select(. == "replaced") ] | length ) as $nrepl
      | if ($oc | length) > 0 then $oc[0]
        elif ($all | index("missing")) or ($nrepl > 0) then
          "write\t" + ($nkept | tostring) + "\t" + ($nrepl | tostring)
        else "ours" end
      end
  end
end
JQ
}

# ALSO and KIND (gone|live, default gone): another copy's scripts directory and
# how much of it counts as roost's -- see KIND in the python engine.
json_probe() { # json_probe MODE FILE [PATCH WANT [ALSO [KIND]]]
  local mode="$1" file="$2" patch="${3:-}" want="${4:-}" also="${5:-}" kind="${6:-gone}" out
  # jq's --argjson needs a document even in flag mode, where none is used.
  [ -n "$patch" ] || patch='"'"'{"hooks":{}}'"'"'
  # -r before anything else: a file that exists and cannot be read must not
  # come back as "malformed", which reads as "your file is broken" when the
  # real answer is a mode or an owner.
  [ -r "$file" ] || { printf 'unreadable'; return 0; }
  case "$(roost_json_tool)" in
    python3)
      out="$(python3 -c "$(json_probe__py)" "$mode" "$file" "$patch" "$want" "$also" "$kind" 2>/dev/null)" ;;
    jq)
      out="$(jq -r --slurp --arg mode "$mode" --argjson patch "$patch" --arg want "$want" \
               --arg also "$also" --arg kind "$kind" "$(json_probe__jq)" "$file" 2>/dev/null)" ;;
  esac
  case "$out" in
    ours|write*|other-checkout*|malformed) printf '%s' "$out" ;;
    # An engine that died, or an answer this does not recognise. Reported as
    # malformed rather than guessed at: the write path then refuses and says
    # so, and nothing is written on the strength of an answer nobody
    # understood.
    *) printf 'malformed' ;;
  esac
}

# --- is this checkout itself behind? ---------------------------------------
# People will reasonably expect `roost install` to update roost's own code. It does not, and must not:
# the checkout may be someone's dev tree with local work in it, and this tool
# does not get to run `git pull` over that. All it does is SAY so.
#
# It NEVER fetches. A fetch inside an installer is a surprise network call —
# on a metered link, behind a proxy, or in a CI step that has no credentials —
# and this command has never made one. The cost is honest and worth stating:
# what it reads is as current as the user's last fetch and no more, so it can
# be silent on a checkout that is in fact behind. Silent-when-unsure is the
# right side to err on for a line nobody asked for.
#
# Silent on every uninteresting answer: git not installed, not a repo at all
# (a tarball install must not print a git error at someone who did nothing
# wrong), no upstream configured, or already current.
#
# `roost upgrade` is the command that DOES pull, and the note names it. That
# is safe because upgrade refuses before touching the network on anything that
# is not a plain `main` with no local work; this installer has no such gate,
# which is why it only ever says so.
upstream_note() {
  local up n word
  command -v git >/dev/null 2>&1 || return 0
  git -C "$HERE" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  # The abbreviated name is for the MESSAGE only. The count is asked with the
  # literal @{upstream}, so a remote branch whose name needs quoting cannot
  # turn into a ref this fails to resolve and then silently reports as zero.
  up="$(git -C "$HERE" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)" || return 0
  [ -n "$up" ] || return 0
  n="$(git -C "$HERE" rev-list --count 'HEAD..@{upstream}' 2>/dev/null)" || return 0
  case "$n" in ''|0) return 0 ;; esac
  word=commits; [ "$n" = 1 ] && word=commit
  printf 'This checkout is %s %s behind %s.\n' "$n" "$word" "$up"
  printf '  roost install wires harnesses to this checkout; it does not update roost\n'
  printf '  itself, and it has not fetched — this is what git already knew locally.\n'
  printf '  To update the code:  roost upgrade\n\n'
}

# --- plan ------------------------------------------------------------------
# Records are tab-separated lines in a newline-separated string: bash 3.2 is
# the floor here, so no associative arrays, and roost-validate already uses
# this shape for BLOCKED_LINKS.
#
#   LINK_STEPS   ACTION \t HARNESS \t PATH \t TARGET \t KEY [\t OLD]   (ACTION: link | relink)
#   UNLINK_STEPS ACTION \t HARNESS \t PATH \t TARGET \t KEY   (ACTION: unlink)
#   OK_STEPS     HARNESS \t PATH
#   REFUSED      HARNESS \t PATH \t TARGET \t ACTION
#
# HARNESS is the name the user knows (`opencode`); KEY is the adapter table's
# key for the path on that line (`opencode` or `opencode2`, see
# roost_adapter_key), which is what the apply loop re-checks the state with.
# For an unlink step TARGET is what the link points at NOW, read before
# anything changes, because that is what the undo line has to put back.
# REFUSED's ACTION is the step roost would have taken there, so the manual
# note can say the right thing: `link`/`relink` means roost wants its adapter
# at that path, `unlink` means it wants nothing there at all, and `worktree`
# means a link to ANOTHER copy of roost is there, which this run would relink
# from a plain checkout and leaves alone because this checkout is a git
# worktree. The note for that one reads the old target back off the link.
#
# OLD is the link's text as the plan read it, and only a relink of a link
# that names another copy of roost carries it: the summary names it, and the
# undo puts it back. It is the LAST field and is left off entirely, never
# written empty, on every other row.
#
# A field is never left empty. IFS is a tab here, and a tab is IFS
# whitespace, so `read` folds two tabs in a row into one and every later
# field would slide one place left.
LINK_STEPS=""
UNLINK_STEPS=""
OK_STEPS=""
REFUSED=""
# Paths in REFUSED with ACTION `worktree` where roost wants NOTHING (the 1.x
# opencode link on opencode 2), not its adapter, one per line. The row shape
# cannot say which, and the manual note for the two differs.
WT_UNLINK=""
DETECTED=""
TAB="$(printf '\t')"

for h in $HARNESSES; do
  in_scope "$h" || continue
  # A harness that is not installed is not mentioned at all. Not "skipped",
  # not "not found" — an install report should be about this machine, and a
  # list of five harnesses of which the user has two is noise they have to
  # read past every single run.
  command -v "$h" >/dev/null 2>&1 || continue
  DETECTED="$DETECTED $h"

  # One binary, two adapters, and the version decides. opencode 1.x loads a
  # FILE at plugin/roost.js and 2.x a DIRECTORY at plugins/roost, so the
  # adapter table carries them as two keys, `opencode` and `opencode2`, and
  # roost_adapter_key says which one the opencode on PATH gets. $k is that key
  # and is what every table call in this iteration asks with; $h stays the
  # name the user sees, in the plan, the summary, --only and --records. For
  # every other harness the two are the same word, and roost_adapter_key only
  # runs `opencode --version` when $h is opencode.
  k="$(roost_adapter_key "$h")"

  case "$(roost_adapter_state "$k")" in
    ok)      OK_STEPS="$OK_STEPS$h$TAB$(roost_adapter_path "$k")
"
             record_outcome unchanged "$h" "$(roost_adapter_path "$k")" ;;
    missing) LINK_STEPS="${LINK_STEPS}link$TAB$h$TAB$(roost_adapter_path "$k")$TAB$(roost_adapter_target "$k")$TAB$k
" ;;
    # A dangling symlink is OURS and broken — the checkout it pointed at moved
    # or was deleted — so replacing it loses nothing. This is the whole reason
    # roost_adapter_state reports `dangling` separately from `foreign`.
    dangling) LINK_STEPS="${LINK_STEPS}relink$TAB$h$TAB$(roost_adapter_path "$k")$TAB$(roost_adapter_target "$k")$TAB$k
" ;;
    # A live link to ANOTHER copy of roost's adapter: roost's own link, made by
    # a second checkout's install. From a plain checkout it is replaced, and
    # the plan, the summary and the undo all name what it pointed at, so the
    # take-over is never silent. From a git worktree it is left alone: see
    # IN_WORKTREE at the top of this file for why.
    other-checkout)
      if [ "$IN_WORKTREE" -eq 0 ]; then
        LINK_STEPS="${LINK_STEPS}relink$TAB$h$TAB$(roost_adapter_path "$k")$TAB$(roost_adapter_target "$k")$TAB$k$TAB$(readlink "$(roost_adapter_path "$k")")
"
      else
        REFUSED="$REFUSED$h$TAB$(roost_adapter_path "$k")$TAB$(roost_adapter_target "$k")${TAB}worktree
"
        record_outcome refused "$h" "$(roost_adapter_path "$k")"
      fi ;;
    foreign) REFUSED="$REFUSED$h$TAB$(roost_adapter_path "$k")$TAB$(roost_adapter_target "$k")${TAB}link
"
             record_outcome refused "$h" "$(roost_adapter_path "$k")" ;;
    # `none` is claude and codex: no symlink-shaped adapter exists for them.
    none) : ;;
  esac

  # On opencode 2, roost's own 1.x adapter at plugin/roost.js is not merely
  # unused: 2.x tries to load it, cannot, and prints `1 plugin failed` in its
  # footer. So it is removed — but only when it is ROOST'S OWN LINK, which is
  # what `ok` (a link to this checkout) and a `dangling` link that names a
  # roost adapter (a link to a checkout that is gone) mean. `dangling` alone
  # says only that the target is missing, not whose target it was: the user's
  # own plugin on a volume that is not mounted reads exactly the same. So a
  # dangling link counts only when roost_adapter_names_1x says so — the rule
  # scripts/roost-doctor uses to call a leftover link roost's — and is refused
  # otherwise. `-L` as well, because `ok` is an `-ef` test and is
  # also true of the checkout's own FILE reached through a symlinked plugin/
  # directory; `rm` there would delete adapters/opencode/roost.js out of the
  # checkout. A live link into ANOTHER copy of roost's 1.x adapter is roost's
  # own link too, and is removed the same way — but only from a plain
  # checkout, for the reason IN_WORKTREE gives. Anything else at the path —
  # the user's own plugin — is left exactly as found and named, the same
  # promise this file's header makes for every path that is not ours.
  if [ "$k" = opencode2 ]; then
    p1="$(roost_adapter_path opencode)"
    p1_state="$(roost_adapter_state opencode)"
    case "$p1_state" in
      ok|dangling)
        if [ -L "$p1" ] && { [ "$p1_state" = ok ] || roost_adapter_names_1x "$p1"; }; then
          UNLINK_STEPS="${UNLINK_STEPS}unlink$TAB$h$TAB$p1$TAB$(readlink "$p1")${TAB}opencode
"
        else
          REFUSED="$REFUSED$h$TAB$p1$TAB$(roost_adapter_target opencode)${TAB}unlink
"
          record_outcome refused "$h" "$p1"
        fi ;;
      # Another copy of roost's 1.x link: a curl install made it, and a second
      # checkout now runs install on a machine whose opencode is 2.x. opencode
      # 2 cannot load it and prints "1 plugin failed" on every start, whichever
      # copy it names, so it goes exactly as this checkout's own would, with
      # the link's text as the undo. From a worktree it is left alone, and the
      # manual note says so (WT_UNLINK marks the row for that note).
      other-checkout)
        if [ "$IN_WORKTREE" -eq 0 ]; then
          UNLINK_STEPS="${UNLINK_STEPS}unlink$TAB$h$TAB$p1$TAB$(readlink "$p1")${TAB}opencode
"
        else
          REFUSED="$REFUSED$h$TAB$p1$TAB$(roost_adapter_target opencode)${TAB}worktree
"
          WT_UNLINK="$WT_UNLINK$p1
"
          record_outcome refused "$h" "$p1"
        fi ;;
      foreign)
        REFUSED="$REFUSED$h$TAB$p1$TAB$(roost_adapter_target opencode)${TAB}unlink
"
        record_outcome refused "$h" "$p1" ;;
      *) : ;;
    esac
  fi
done

DETECTED="${DETECTED# }"

# --- the roost skill (#208) --------------------------------------------------
# One more symlink per detected harness: `roost` in that harness's own skills
# folder, pointing at this checkout's skills/roost, so an agent in a pane knows
# how to drive roost without anyone linking it by hand. Where each folder is,
# and why it is not ~/.agents/skills, is in scripts/lib/roost-adapters.sh
# beside roost_skill_dir.
#
# The rows go into the SAME lists as the adapter links, so they are printed in
# the same plan, covered by the same one answer, re-checked the same way
# before writing, and undone by the same printed lines. Their KEY is
# `skill:<harness>`, which step_state below routes to roost_skill_state; every
# other field means what it means for an adapter row. The five arms are the
# adapter loop's, for the same reasons given there.
#
# Not under --symlinks-only. That mode is `roost validate`'s call, and validate
# promises its tester that the report names every link the call made; it
# reads back only the adapter paths it offered, so a skill link made there
# would be a change to the tester's machine that no report line mentions.
# validate predicts the skill links instead (skill_link_rows) and leaves them
# to `roost install`.
if [ "$SYMLINKS_ONLY" -eq 0 ]; then
  for h in $DETECTED; do
    sp="$(roost_skill_path "$h")"; st="$(roost_skill_target)"
    case "$(roost_skill_state "$h")" in
      # "<harness> skill" in the summary's name list, so "Already correct:
      # claude" is never printed on the strength of the skill alone while
      # claude's hooks are still to be written.
      ok)       OK_STEPS="$OK_STEPS$h skill$TAB$sp
"
                record_outcome unchanged "$h" "$sp" ;;
      missing)  LINK_STEPS="${LINK_STEPS}link$TAB$h$TAB$sp$TAB$st${TAB}skill:$h
" ;;
      dangling) LINK_STEPS="${LINK_STEPS}relink$TAB$h$TAB$sp$TAB$st${TAB}skill:$h
" ;;
      other-checkout)
        if [ "$IN_WORKTREE" -eq 0 ]; then
          LINK_STEPS="${LINK_STEPS}relink$TAB$h$TAB$sp$TAB$st${TAB}skill:$h$TAB$(readlink "$sp")
"
        else
          REFUSED="$REFUSED$h$TAB$sp$TAB$st${TAB}worktree
"
          record_outcome refused "$h" "$sp"
        fi ;;
      foreign)  REFUSED="$REFUSED$h$TAB$sp$TAB$st${TAB}link
"
                record_outcome refused "$h" "$sp" ;;
      *) : ;;
    esac
  done
fi

# step_state KEY -- the state of the path a LINK_STEPS or UNLINK_STEPS row is
# about, asked of the table that row came from: `skill:<harness>` for a skill
# link, an adapter key for everything else.
step_state() {
  case "$1" in
    skill:*) roost_skill_state "${1#skill:}" ;;
    *)       roost_adapter_state "$1" ;;
  esac
}

# --- the JSON steps --------------------------------------------------------
# The harnesses configured by editing a JSON file rather than by a symlink.
# One name per task as they land; the machinery below is shared.
#
#   JSON_STEPS    HARNESS \t REAL_PATH \t CONFIG_PATH \t KEPT \t REPLACED \t DEAD \t KIND \t LABEL
#                 KEPT     entries belonging to someone else that survive
#                 REPLACED entries of roost's own that are not the current
#                          shape and will be overwritten by it
#                 DEAD     another copy's scripts directory whose hooks this
#                          write takes over, or `-`
#                 KIND     `gone` or `live` (see json_probe), or `-`
#                 Never an empty field: these rows are read with IFS=tab,
#                 tab is IFS whitespace, and an empty field between two tabs
#                 collapses and shifts every field after it -- an ordinary
#                 write once passed its LABEL to the merge as a directory.
#   JSON_OK       HARNESS \t REAL_PATH
#   JSON_REFUSED  HARNESS \t REAL_PATH \t WHY   (WHY runs to end of line)
#
# REAL_PATH and CONFIG_PATH differ only when the config file is a symlink —
# see resolve_link. Everything downstream writes to REAL_PATH and mentions
# CONFIG_PATH, because that is the one the user knows the file by.
JSON_HARNESSES="claude codex copilot"
JSON_STEPS=""
JSON_OK=""
JSON_REFUSED=""

# print  — the user asked for the block instead of a write (--print-only)
# notool — neither python3 nor jq is here, so roost CANNOT edit JSON. Not an
#          error: scripts/lib/roost-json.sh returns 3 for exactly this and the
#          contract is that the caller falls back to printing. The run carries
#          on and still exits 0.
# write  — the ordinary case.
JSON_MODE=write
[ "$PRINT_ONLY" -eq 1 ] && JSON_MODE=print
[ -n "$(roost_json_tool)" ] || JSON_MODE=notool

if [ "$SYMLINKS_ONLY" -eq 0 ]; then
  for h in $JSON_HARNESSES; do
    case " $DETECTED " in *" $h "*) : ;; *) continue ;; esac
    json_cfg="$(roost_adapter_settings "$h")"
    json_real="$(resolve_link "$json_cfg")"
    case "$h" in
      claude)
        json_probe_mode=hooks
        json_want="$CLAUDE_TARGET"
        json_patch="$(roost_hooks_claude "$CLAUDE_TARGET")"
        json_label="roost's Claude hooks" ;;
      codex)
        json_probe_mode=hooks
        json_want="$CODEX_TARGET"
        json_patch="$(roost_hooks_codex "$CODEX_TARGET")"
        json_label="roost's five codex handlers" ;;
      # Not a hook file: one boolean, and no target script to compare against.
      # The question is only whether it is already true, and it is asked of
      # the PARSED document -- scripts/roost-doctor:233 greps for the flag's
      # name and its own comment records the cost, that a file setting it to
      # false reads as set. Doctor can afford that; an installer that took it
      # would leave the extension off forever and report success.
      copilot)
        json_probe_mode=flag
        json_want=""
        json_patch=""
        json_label="copilot's EXTENSIONS feature flag" ;;
    esac

    # Not a write: --print-only, or no JSON engine on the machine. Nothing is
    # recorded here -- the manual block at the end re-derives both the harness
    # list and the reason from $DETECTED and $JSON_MODE, which is where they
    # have to be read from anyway.
    [ "$JSON_MODE" = write ] || continue

    if [ -e "$json_real" ]; then
      json_answer="$(json_probe "$json_probe_mode" "$json_real" "$json_patch" "$json_want")"
    else
      json_answer="write${TAB}0${TAB}0"
    fi
    json_state="${json_answer%%$TAB*}"
    json_rest="${json_answer#*$TAB}"
    [ "$json_rest" = "$json_answer" ] && json_rest=""
    json_kept="${json_rest%%$TAB*}"
    json_repl="${json_rest#*$TAB}"
    [ "$json_repl" = "$json_rest" ] && json_repl=0
    # The detail is a COMMAND STRING out of the user's own JSON, and both the
    # refusal records and the manual notes are newline-separated. An embedded
    # newline split one record into two, and the orphaned half was printed as
    # its own "Still manual" note — with no harness and no path, telling the
    # user to run `roost hooks <their own text>`. Nothing executed and the
    # file was still correctly left alone, but text out of a file roost is
    # READING must never come back out as an instruction roost is GIVING.
    # Tabs go too: they are this record format's field separator.
    #
    # Bash's own substitution, not `tr`, for the reason the --only guard above
    # already gives at length: a thin PATH must not turn this into a silent
    # no-op. It very nearly did — the suite's harness shim carries no `tr`, so
    # the first version of this line produced an EMPTY detail on every run and
    # the case that was supposed to prove the stripping passed because the
    # text had vanished for the wrong reason.
    json_detail="${json_rest//[$'\n\r\t']/}"

    # A refusal, but is that checkout still THERE? A hook naming a checkout
    # that has been moved, renamed or deleted is roost's own and broken -- the
    # same thing `dangling` means for the symlink adapters, which have always
    # been relinked rather than refused. Left as a refusal it never healed:
    # every re-run of `roost install` saw another checkout's path and refused
    # again, so a moved checkout stayed un-wired forever while the docs
    # promised `roost update` handled exactly that.
    #
    # The script path is cut at the MARKER (the basename of $json_want, e.g.
    # roost-agent-state) rather than at the first space, so a checkout whose
    # path contains a space is measured correctly instead of being tested as
    # its own first word -- and %% takes the shortest prefix, so a marker that
    # appears twice cuts at the first.
    #
    # CLAUDE ONLY. codex keeps its refusal even when the checkout is gone,
    # because rewriting a codex handler re-hashes it and silently un-badges a
    # machine that had already granted trust: there, doing nothing really is
    # the lesser harm. What it gains here is an honest reason, below.
    #
    # A Claude hook naming another copy of roost that still EXISTS is taken
    # over too, by the rule the symlink adapters follow (see IN_WORKTREE at
    # the top): from a plain checkout it is replaced and the run names the
    # other copy; from a worktree it is refused, so a build pane cannot steal
    # the primary checkout's hooks and leave them pointing at a worktree that
    # is deleted after its merge. Rewriting a Claude hook costs nothing like a
    # codex re-hash: Claude reads the command afresh on its next session.
    #
    # A LIVE copy is taken over only when the hook names roost's own layout,
    # <other>/scripts/roost-agent-state, and the probe is then re-asked with
    # KIND `live`, which counts as roost's only the commands that run one of
    # roost's own scripts there exactly. A roost-agent-state copied into
    # ~/bin, or a `//` in the path, stays "a different checkout": the
    # directory above it is not a copy of roost, and the rest of it may be
    # the user's own hooks.
    json_dead=""
    json_kind=""
    json_gone=0
    json_other=0
    if [ "$json_state" = "other-checkout" ]; then
      json_marker="${json_want##*/}"
      case "$json_detail" in
        *"$json_marker"*)
          json_deadpath="${json_detail%%"$json_marker"*}$json_marker"
          # Known gap, older than the live-copy rule: a command that runs the
          # script through an interpreter (`bash <copy>/scripts/...`) is cut
          # here with the interpreter in front, so -e fails and a LIVE copy
          # reads as gone -- and is rewritten, even from a worktree.
          if [ ! -e "$json_deadpath" ]; then
            # Recorded for BOTH harnesses, because both have something honest
            # to say about it -- but only claude acts on it. codex keeps the
            # refusal and gains a truthful reason: what it found is not
            # somebody else's config, it is roost's own hook pointing at a
            # checkout that is gone, and roost still will not rewrite it.
            json_gone=1
          elif [ "$h" = claude ]; then
            case "$json_deadpath" in */scripts/roost-agent-state) json_other=1 ;; esac
          fi
          if [ "$h" = claude ] && { [ "$json_gone" -eq 1 ] || { [ "$json_other" -eq 1 ] && [ "$IN_WORKTREE" -eq 0 ]; }; }; then
            # The directory, not the script: see the python probe's note on
            # why one script path is not enough.
            json_dead="${json_deadpath%/*}"
            json_kind=gone
            [ "$json_gone" -eq 1 ] || json_kind=live
            # Ask again, this time saying that the other copy counts as ours
            # -- all of it when gone, its two scripts when live. Re-probing
            # rather than patching the counts by hand: the entry has to be
            # re-classified (it becomes `replaced`, not `kept`), and the
            # engine is the only thing that knows how to do that.
            json_answer="$(json_probe "$json_probe_mode" "$json_real" "$json_patch" "$json_want" "$json_dead" "$json_kind")"
            json_state="${json_answer%%$TAB*}"
            json_rest="${json_answer#*$TAB}"
            [ "$json_rest" = "$json_answer" ] && json_rest=""
            json_kept="${json_rest%%$TAB*}"
            json_repl="${json_rest#*$TAB}"
            [ "$json_repl" = "$json_rest" ] && json_repl=0
          fi ;;
      esac
    fi

    case "$json_state" in
      # KEPT and REPLACED ride along so the writing block can report both:
      # entries of somebody else's that survive this, and entries of roost's
      # own that it overwrites with the current shape. A user should be able
      # to see either from the output rather than from a diff.
      #
      # A malformed file is planned as a write rather than pre-refused here,
      # deliberately. roost_json_merge parses it again at write time, refuses
      # in the parser's OWN words, writes nothing and takes no backup — a
      # better message than this could produce — and routing it that way is
      # what keeps `--dry-run` at exit 0 while an attempted run exits 1.
      write)
        JSON_STEPS="${JSON_STEPS}$h$TAB$json_real$TAB$json_cfg$TAB$json_kept$TAB$json_repl$TAB${json_dead:--}$TAB${json_kind:--}$TAB$json_label
" ;;
      malformed)
        JSON_STEPS="${JSON_STEPS}$h$TAB$json_real$TAB$json_cfg${TAB}0${TAB}0$TAB-$TAB-$TAB$json_label
" ;;
      ours)
        JSON_OK="$JSON_OK$h$TAB$json_real
"
        record_outcome unchanged "$h" "$json_real" ;;
      # WHY is one LINE, detail included. These records are newline-separated,
      # so a two-line reason would be read back as two records and the second
      # one would arrive with no harness and no path.
      other-checkout)
        # WHY is one LINE either way -- these records are newline-separated,
        # so a two-line reason arrives as two records and the second one has
        # no harness and no path.
        if [ "$json_gone" -eq 1 ]; then
          JSON_REFUSED="$JSON_REFUSED$h$TAB$json_real${TAB}a roost hook there points at a checkout that no longer exists, and rewriting a codex handler would re-hash it and silently un-badge this machine — fix it by hand: $json_detail
"
        elif [ "$h" = claude ] && [ "$json_other" -eq 1 ] && [ "$IN_WORKTREE" -eq 1 ]; then
          # From a plain checkout the probe was re-asked above and this entry
          # is normally a write. IN_WORKTREE is tested again anyway: a file
          # naming a THIRD copy as well is still other-checkout after the
          # re-ask, and must not be told this checkout is a worktree.
          JSON_REFUSED="$JSON_REFUSED$h$TAB$json_real${TAB}a roost hook there points at another copy of roost, $json_detail, and this checkout is a git worktree — run roost install from that copy, or from the primary checkout
"
        else
          JSON_REFUSED="$JSON_REFUSED$h$TAB$json_real${TAB}a roost hook there points at a different checkout: $json_detail
"
        fi
        record_outcome refused "$h" "$json_real" ;;
      unreadable)
        JSON_REFUSED="$JSON_REFUSED$h$TAB$json_real${TAB}it exists and could not be read
"
        record_outcome refused "$h" "$json_real" ;;
    esac
  done
fi

if [ -z "$DETECTED" ]; then
  printf 'roost install: no supported harness found on PATH — nothing to do.\n'
  # What it ACTUALLY looked for. Under --only that is the restricted list, and
  # printing all five would tell a user their harness was searched for and
  # missing when it was never searched for at all.
  if [ -n "$ONLY_LIST" ]; then
    printf '  Looked for (--only): %s\n' "$ONLY_LIST"
  else
    printf '  Looked for: %s\n' "$HARNESSES"
  fi
  # Printed on this path too, and not only on the one below. Someone running
  # this on a machine with no harness on PATH is quite likely to be looking at
  # a checkout that has not been updated in a while, which is exactly when the
  # note is worth having.
  printf '\n'
  upstream_note
  exit 0
fi

printf 'roost install — wiring these harnesses to\n  %s\n\n' "$HERE"
printf 'Detected: %s\n\n' "${DETECTED// /, }"
upstream_note

if [ -n "$LINK_STEPS$JSON_STEPS" ]; then
  printf 'Will write:\n'
  # Every planned write, with the exact target path, printed BEFORE anything
  # happens. "link the opencode adapter" is not something a user can check;
  # a full path is.
  printf '%s' "$LINK_STEPS" | while IFS="$TAB" read -r action h path target key old; do
    [ -n "$action" ] || continue
    # A relink of a link into another copy of roost says what it replaces:
    # that link works, so the reader is about to lose something that does.
    was=""; [ -n "${old:-}" ] && was=" (was $old)"
    printf '  %-6s %s%s\n         -> %s\n' "$action" "$path" "$was" "$target"
  done
  # Same column, same rule: the exact file, and what goes into it. When the
  # config path is a symlink the REAL file is the one named on the first line,
  # because that is the file whose bytes change.
  printf '%s' "$JSON_STEPS" | while IFS="$TAB" read -r h real cfg kept replaced dead kind label; do
    [ -n "$h" ] || continue
    # Setting a boolean flag is not a merge in the sense the two hook files
    # are, and one word for both reads as "roost is about to rewrite my
    # copilot settings". Its own verb.
    case "$h" in copilot) verb=enable ;; *) verb=merge ;; esac
    printf '  %-6s %s\n         %s\n' "$verb" "$real" "$label"
    case "$kept" in
      0) : ;;
      1) printf '         (the 1 entry already in those events is kept)\n' ;;
      *) printf '         (the %s entries already in those events are kept)\n' "$kept" ;;
    esac
    case "$replaced" in
      0) : ;;
      *) printf '         (a roost entry already there is replaced with the current one)\n' ;;
    esac
    # Said here, before the prompt, because answering it is consenting to
    # it: hooks that another copy of roost still runs move to this one.
    # DEAD is always <other>/scripts for a live takeover (see the JSON loop).
    [ "$kind" = live ] && \
      printf '         (one of those is a hook from another copy of roost, %s; it is replaced)\n' "${dead%/scripts}"
    [ "$real" = "$cfg" ] || printf '         (%s is a symlink to it)\n' "$cfg"
  done
  printf '\n'
fi

if [ -n "$UNLINK_STEPS" ]; then
  # Its own heading, not a line under "Will write:". Removing something is the
  # step a reader most needs to see before answering, and it is the one a
  # list headed "write" would hide in plain sight.
  printf 'Will remove:\n'
  printf '%s' "$UNLINK_STEPS" | while IFS="$TAB" read -r action h path target key; do
    [ -n "$action" ] || continue
    # `1 plugin failed` was measured for a LIVE 1.x adapter. A dangling link
    # was not measured, so for one the line claims only what is certain.
    if [ -e "$path" ]; then
      why="$h 2 cannot load it and says \"1 plugin failed\""
    else
      why="it points at nothing, and $h 2 cannot load it"
    fi
    printf '  %-6s %s\n         (roost'"'"'s own %s 1.x adapter, a link to %s;\n          %s)\n' \
      remove "$path" "$h" "$target" "$why"
  done
  printf '\n'
fi

if [ -n "$OK_STEPS$JSON_OK" ]; then
  # One summary line, not a line each. An `ok` adapter is the boring case and
  # the point of running this twice is that the second run is quiet.
  #
  # De-duplicated: copilot has BOTH a symlink and a settings file, so without
  # this it reports itself twice on a machine where both are already right.
  ok_names=""
  while IFS="$TAB" read -r h path; do
    [ -n "${h:-}" ] || continue
    case " $ok_names " in *" $h "*) continue ;; esac
    ok_names="$ok_names $h"
  done <<EOF
$OK_STEPS$JSON_OK
EOF
  ok_names="${ok_names# }"
  printf 'Already correct: %s\n\n' "${ok_names// /, }"
fi

# own_file_via_dir PATH TARGET — true when PATH is not a link but IS this
# checkout's own TARGET file, which means some directory on the way to it is a
# symlink into the checkout (in practice plugin/ itself). roost_adapter_state
# calls that `ok`, because `ok` is an -ef test, and the opencode 2 unlink step
# refuses it, because an `rm` there deletes the file out of the checkout. Both
# the heading and the manual note below need to say THAT, and not "something
# that is not this checkout", which is the one thing it certainly is not.
own_file_via_dir() { [ ! -L "$1" ] && [ "$1" -ef "$2" ]; }

if [ -n "$REFUSED" ]; then
  # Three headings, because the one that fits every other refusal is false for
  # a row that is this checkout's own file: a reader who believes the heading
  # treats the file as someone else's and deletes it. And a link to another
  # copy of roost, left alone only because this is a worktree, is roost's own
  # link, not "something that is not this checkout".
  refused_foreign=""; refused_own=""; refused_worktree=""
  while IFS="$TAB" read -r h path target action; do
    [ -n "${h:-}" ] || continue
    if [ "${action:-}" = worktree ]; then
      refused_worktree="$refused_worktree  $path
"
    elif own_file_via_dir "$path" "$target"; then
      refused_own="$refused_own  $path
"
    else
      refused_foreign="$refused_foreign  $path
"
    fi
  done <<EOF
$REFUSED
EOF
  if [ -n "$refused_foreign" ]; then
    printf 'Will NOT touch — something that is not this checkout is already there:\n'
    printf '%s\n' "$refused_foreign"
  fi
  if [ -n "$refused_own" ]; then
    printf 'Will NOT touch — this checkout'"'"'s own file, reached through a symlinked directory:\n'
    printf '%s\n' "$refused_own"
  fi
  if [ -n "$refused_worktree" ]; then
    printf 'Will NOT touch — a link to another copy of roost, and this is a git worktree:\n'
    printf '%s\n' "$refused_worktree"
  fi
fi

if [ -n "$JSON_REFUSED" ]; then
  # Separate from the block above because the REASON is the useful part here
  # and it differs per file, where a symlink refusal always means the same
  # thing. Printed before the prompt, so anyone who says yes has already been
  # told which of their files this run has decided to leave alone.
  printf 'Will NOT edit — and the reason matters, so read it before answering:\n'
  printf '%s' "$JSON_REFUSED" | while IFS="$TAB" read -r h path why; do
    [ -n "$h" ] || continue
    printf '  %s\n    %s\n' "$path" "$why"
  done
  printf '\n'
fi

# --- consent ---------------------------------------------------------------
do_writes=0
if [ -z "$LINK_STEPS$UNLINK_STEPS$JSON_STEPS" ]; then
  # Nothing to ask about. Asking anyway trains people to type y without
  # reading, which is the opposite of what the prompt is for.
  :
elif [ "$DRY_RUN" -eq 1 ]; then
  printf -- '--dry-run: nothing above was written.\n\n'
elif [ "$ASSUME_YES" -eq 1 ]; then
  do_writes=1
elif [ -t 0 ]; then
  # 60s and then no. The promise of the prompt is that walking away is safe,
  # so silence has to resolve to the conservative answer, not the convenient
  # one. `read` returns non-zero on both the timeout and EOF; both mean no.
  ans=n
  printf 'Write the above? [y/N] (no answer in 60s = no) '
  read -r -t 60 ans || ans=n
  printf '\n'
  case "${ans:-n}" in y|Y|yes|YES) do_writes=1 ;; *) printf 'Nothing was written.\n\n' ;; esac
else
  # A pipe, a cron, a CI step. Nobody is there to consent — and a "y" arriving
  # on a non-terminal stdin is not a person answering, it is whatever the
  # caller happened to have on stdin. --yes is how an unattended run opts in
  # explicitly, and it is the only way.
  printf 'Not a terminal, so nothing was asked and nothing was written.\n'
  printf 'Pass --yes to write in an unattended run.\n\n'
fi

# --- do it -----------------------------------------------------------------
failed=0
UNDO=""

if [ "$do_writes" -eq 1 ]; then
  printf 'Writing:\n'
  # A `while read` over a pipeline runs in a subshell in bash 3.2, where
  # $failed and $UNDO would be lost on the way out. A here-string keeps the
  # loop in this shell.
  while IFS="$TAB" read -r action h path target key old; do
    [ -n "${action:-}" ] || continue

    # Re-checked immediately before writing rather than trusted from the plan
    # above. The prompt may have sat there for a minute, and this is the one
    # place in the command that creates something on someone's machine.
    # roost-validate's offer_adapter_install used to take the same precaution
    # in its own loop and now relies on this one, having asked its question
    # and handed the writing over — so this check is the only thing standing
    # between that prompt's minute and a path that changed underneath it.
    #
    # Asked with the step's KEY, not the harness name: on opencode 2 the two
    # opencode steps are about two different paths (plugins/roost and the 1.x
    # plugin/roost.js), and only the key says which one this line means. A
    # skill row's key routes the question to the skill table (step_state).
    state="$(step_state "$key")"
    # The plan removes a dangling link only when it names a roost adapter. A
    # link swapped for someone else's dangling one while the prompt sat there
    # still reads `dangling`, so the same rule is asked again here, and a link
    # that fails it falls to the refusal below like any other change.
    if [ "$action:$state" = unlink:dangling ] && ! roost_adapter_names_1x "$path"; then
      state="dangling, not a roost adapter"
    fi
    # A link into another copy of roost is taken over only when the plan
    # listed it as one (OLD is set) and it still names the same copy. A
    # dangling link that became a different checkout's while the prompt sat
    # there was never shown to the reader as a take-over, and in a worktree
    # the plan never lists one at all, so either falls to the refusal below.
    # The same for a removal: the plan's TARGET is the link's text as it read
    # it, and a worktree never plans one, so a link that turned into another
    # copy's while the prompt sat there is never removed.
    if [ "$action:$state" = unlink:other-checkout ] \
       && { [ "$IN_WORKTREE" -ne 0 ] || [ "$(readlink "$path" 2>/dev/null)" != "$target" ]; }; then
      state="other-checkout, not the link the plan named"
    fi
    if [ "$action:$state" = relink:other-checkout ] \
       && { [ -z "${old:-}" ] || [ "$(readlink "$path" 2>/dev/null)" != "$old" ]; }; then
      state="other-checkout, not the link the plan named"
    fi
    case "$action:$state" in
      link:missing|relink:dangling|relink:other-checkout|unlink:ok|unlink:dangling|unlink:other-checkout) : ;;
      # Removed by someone else while the prompt sat there. What the step
      # wanted is already true, so it is the removal's `ok`.
      unlink:missing)
        printf '  %s was already gone by the time this ran — nothing to remove\n' "$path"
        record_outcome unchanged "$h" "$path"
        continue ;;
      *:ok)
        printf '  %s was already linked by the time this ran — left alone\n' "$h"
        record_outcome unchanged "$h" "$path"
        continue ;;
      *)
        printf '  %s changed underneath this run (now: %s) — left alone\n' "$h" "$state"
        REFUSED="$REFUSED$h$TAB$path$TAB$target$TAB$action
"
        record_outcome refused "$h" "$path"
        continue ;;
    esac

    if [ "$action" = unlink ]; then
      # Only ever a SYMLINK, checked here and not just in the plan: `ok` is an
      # `-ef` test, and a regular file at this path that the plan saw as a link
      # must never be what `rm` reaches. Removing a link cannot touch what it
      # points at, so the checkout's own adapter is safe either way.
      if [ ! -L "$path" ]; then
        printf '  %s changed underneath this run (now: not a symlink) — left alone\n' "$h"
        REFUSED="$REFUSED$h$TAB$path$TAB$(roost_adapter_target "$key")$TAB$action
"
        record_outcome refused "$h" "$path"
        continue
      fi
      if rm -f "$path" 2>/dev/null && [ ! -L "$path" ]; then
        printf '  %-8s %s\n' removed "$path"
        # The undo for a removal is the link it removed, put back exactly as
        # the plan read it.
        UNDO="${UNDO}ln -s \"$target\" \"$path\"
"
        record_outcome removed "$h" "$path" "ln -s \"$target\" \"$path\""
      else
        printf '  could NOT remove %s\n' "$path" >&2
        record_outcome failed "$h" "$path"
        failed=1
      fi
      continue
    fi

    if [ "$action" = relink ]; then
      # Only ever a SYMLINK -- dangling, or a link into another copy of roost --
      # re-verified above, and checked once more here as the unlink branch
      # does: both states are read through the link, and `rm -f` on anything
      # that is not one would delete a real file or directory. Never a bare
      # `rm` of whatever happens to be at the path.
      if [ ! -L "$path" ]; then
        printf '  %s changed underneath this run (now: not a symlink) — left alone\n' "$h"
        REFUSED="$REFUSED$h$TAB$path$TAB$target$TAB$action
"
        record_outcome refused "$h" "$path"
        continue
      fi
      # The removal is checked, as the unlink branch checks it. If the old
      # link is still there, the `ln -s` below would not replace it: for a
      # link to a DIRECTORY (opencode 2's plugins/roost) it would follow the
      # link and create a new one INSIDE the other copy's adapter directory,
      # then report success. A parent directory this user cannot write is
      # enough to get there.
      if ! { rm -f "$path" 2>/dev/null && [ ! -L "$path" ]; }; then
        printf '  could NOT relink %s\n' "$path" >&2
        record_outcome failed "$h" "$path"
        failed=1
        continue
      fi
    fi

    # The undo removes what this run made, and for a link it took over from
    # another copy of roost it also puts that link back exactly as it was.
    undo="rm \"$path\""
    [ -n "${old:-}" ] && undo="rm \"$path\" && ln -s \"$old\" \"$path\""
    # -n: if anything is at the path by now, a link to a directory is never
    # entered; ln fails on it instead, and that is reported as a failure.
    if mkdir -p "$(dirname "$path")" 2>/dev/null && ln -sn "$target" "$path" 2>/dev/null; then
      printf '  %-8s %s\n' "${action}ed" "$path"
      if [ -n "${old:-}" ]; then
        # roost does not look for copies of itself; it names the one it was
        # just pointed at, because a second copy nobody meant to keep is how
        # this link came to point at it.
        printf '    was %s — a second copy of roost.\n' "$old"
        printf '    If you did not mean to keep two, remove that copy'"'"'s directory and the PATH\n'
        printf '    line install.sh added for it.\n'
      fi
      UNDO="${UNDO}$undo
"
      record_outcome wrote "$h" "$path" "$undo"
    else
      printf '  could NOT %s %s\n' "$action" "$path" >&2
      record_outcome failed "$h" "$path"
      failed=1
    fi
  done <<EOF
$LINK_STEPS$UNLINK_STEPS
EOF

  # The JSON steps, under the SAME single consent as the symlinks above. A
  # here-string again, and for the same reason: $failed and $UNDO must survive
  # the loop.
  json_reindented=0
  while IFS="$TAB" read -r h real cfg kept replaced dead kind label; do
    [ -n "${h:-}" ] || continue
    # `-` is JSON_STEPS' spelling of an empty field; see its header.
    [ "$dead" = - ] && dead=""
    [ "$kind" = - ] && kind=""

    # Whether the file was there BEFORE this write decides what the undo line
    # says, and it has to be read now: after the merge the file exists either
    # way.
    json_existed=0
    [ -e "$real" ] && json_existed=1

    # roost_json_merge prints the backup path on stdout, and ONLY when it
    # actually took one — an existing file whose content is about to change.
    # Its stderr (a parser's complaint about a malformed file) is deliberately
    # not captured: that message is the most useful thing this command can
    # give someone whose settings.json will not parse.
    case "$h" in
      # $dead, when the plan found one, is the scripts directory of another
      # copy of roost whose hooks this write takes over -- one that no longer
      # exists ($kind gone) or, from a plain checkout, one that does ($kind
      # live). The probe was re-asked with both and said a write is due; the
      # merge has to be told the same thing, or it would leave those entries
      # in place and APPEND roost's beside them. Empty for every ordinary
      # install.
      claude) json_bak="$(roost_json_merge "$real" claude-hooks "$CLAUDE_TARGET" ${dead:+"$dead" "$kind"})"; rc=$? ;;
      # Adding a NEW event to a hooks.json codex has already been trusted with
      # is measured-safe on 0.151.0: the handlers already trusted keep firing,
      # because their hashes are over their own parsed structs and nothing
      # about them moved. The handlers roost's own merge would REPLACE are the
      # ones the probe has already refused to touch.
      codex)  json_bak="$(roost_json_merge "$real" codex-hooks  "$CODEX_TARGET")";  rc=$? ;;
      copilot) json_bak="$(roost_json_merge "$real" copilot-flag)"; rc=$? ;;
      *)      json_bak=""; rc=2 ;;
    esac

    case "$rc" in
      0)
        if [ "$json_existed" -eq 1 ] && [ -z "$json_bak" ]; then
          # Nothing changed after all. The probe said a write was needed and
          # the merge disagreed; say so rather than claiming a write.
          printf '  %s needed no change: %s\n' "$h" "$real"
          record_outcome unchanged "$h" "$real"
          continue
        fi
        case "$h" in copilot) printf '  enabled  %s\n' "$real" ;;
                     *)       printf '  merged   %s\n' "$real" ;; esac
        [ "$real" = "$cfg" ] || \
          printf '           (%s is a symlink — written through to the real file above,\n           so your dotfiles repo still owns it)\n' "$cfg"
        if [ -n "$json_bak" ]; then
          printf '           backup:  %s\n' "$json_bak"
          json_reindented=1
          UNDO="${UNDO}cp \"$json_bak\" \"$real\"
"
          record_outcome wrote "$h" "$real" "cp \"$json_bak\" \"$real\""
        else
          UNDO="${UNDO}rm \"$real\"
"
          record_outcome wrote "$h" "$real" "rm \"$real\""
        fi
        # Both said out loud, after the backup line so "the backup above" is
        # true. The first because roost's entry REPLACING theirs is exactly
        # what this used to do, and a user who has been bitten by a tool
        # rewriting their hooks has no reason to take it on trust. The second
        # because a roost entry someone customised by hand is reverted here —
        # deliberately, it is how an older shape gets updated — and reverting
        # somebody's edit in silence is the thing backups exist to make
        # visible.
        case "$kept" in
          0) : ;;
          1) printf '           kept the 1 entry already in those events; roost joined it\n' ;;
          *) printf '           kept the %s entries already in those events; roost joined them\n' "$kept" ;;
        esac
        case "$replaced" in
          0) : ;;
          1) printf '           replaced 1 roost entry of its own with the current one\n' ;;
          *) printf '           replaced %s roost entries of its own with the current ones\n' "$replaced" ;;
        esac
        case "$replaced" in
          0) : ;;
          *) [ -n "$json_bak" ] && printf '           (the backup above still has what it said)\n' ;;
        esac
        # The Claude hook's counterpart to "relinked ... a second copy of
        # roost": roost does not look for copies of itself, it names the one
        # it was just pointed at.
        [ "$kind" = live ] && \
          printf '  replaced a hook from another copy of roost, %s — if you did not mean to keep two, remove that copy and its PATH line.\n' "${dead%/scripts}"
        ;;
      *)
        # 1, 2 and 5 all mean the same thing to a user: nothing was written,
        # no backup was taken, and the engine's own message is above.
        printf '  could NOT write %s\n' "$real" >&2
        record_outcome failed "$h" "$real"
        failed=1 ;;
    esac
  done <<EOF
$JSON_STEPS
EOF

  # Once per run, and only when a file that already existed was rewritten.
  # Someone who diffs their settings.json afterwards finds every line changed
  # and needs to have been told why, and where the original went.
  if [ "$json_reindented" -eq 1 ]; then
    printf '\n  A JSON round-trip renormalises the whole file to two spaces of\n'
    printf '  indentation, so a diff will show lines this run did not mean to touch.\n'
    printf '  Only whitespace moved; the backup above holds the original bytes.\n'
  fi
  printf '\n'
fi

# --- undo ------------------------------------------------------------------
# Only for what THIS run wrote. Printing `rm` lines for links that were
# already correct is how someone deletes a working install while trying to
# undo a run that did nothing.
if [ -n "$UNDO" ]; then
  printf 'To undo exactly what this run wrote (removing a symlink cannot affect\nwhat it pointed at; a `cp` puts back the bytes the backup holds):\n'
  # Whole commands, not bare paths: undoing a JSON merge is a restore from the
  # backup, not a delete, and a user copying these lines must not have to work
  # out which is which.
  printf '%s' "$UNDO" | while read -r line; do
    [ -n "$line" ] && printf '  %s\n' "$line"
  done
  printf '\n'
fi

# --- what is still manual --------------------------------------------------
# Only the steps that actually apply on THIS machine, after what this run
# actually did.
manual=""
# Entries are separated by a blank line. Several of them are three or four
# lines long and carry a command to paste; run together they read as one wall
# of text and the command lines stop standing out, which is the only part
# anyone is going to act on.
add_manual() { manual="$manual$1

"; }

if [ -n "$REFUSED" ]; then
  # Never a bare `ln -sf`. Overwriting is the user's call to make, not
  # something roost hands them without first saying what is there.
  while IFS="$TAB" read -r h path target action; do
    [ -n "${h:-}" ] || continue
    # roost's own link, from a second copy of roost. No `rm && ln -s` here:
    # the point of refusing is that a worktree should not take the link, and
    # handing the reader the command to take it anyway would undo that.
    if [ "${action:-}" = worktree ]; then
      case "$WT_UNLINK" in
        *"$path
"*) wt_what="points at another copy of roost's 1.x adapter, $(readlink "$path" 2>/dev/null), which opencode 2 cannot load" ;;
        *) wt_what="points at another copy of roost, $(readlink "$path" 2>/dev/null)" ;;
      esac
      add_manual "$h: $path
  $wt_what.
  This checkout is a git worktree, so roost install leaves the link alone:
  run roost install from that copy, or from this repository's primary
  checkout."
      continue
    fi
    # Roost's 1.x opencode adapter path, on a machine whose opencode is 2.x.
    # roost wants NOTHING there, so the 1.x fix below — put roost's adapter in
    # its place — would hand the user the exact file that makes opencode 2
    # print `1 plugin failed`. The `rm` is offered only for a symlink: a
    # regular file there may be the user's own plugin, and one reached through
    # a symlinked plugin/ directory may be the checkout's own adapter.
    if [ "${action:-}" = unlink ] && own_file_via_dir "$path" "$target"; then
      # The checkout's own 1.x adapter FILE, reached through a plugin/
      # directory that is a symlink into the checkout. Deleting the file
      # deletes adapters/opencode/roost.js from the checkout, so the note
      # names the directory as the thing to change, and offers no `rm`.
      add_manual "$h: $path
  is a regular file reached through a symlinked plugin/ directory — it is
  this checkout's own 1.x adapter, $target.
  This machine's $h is 2.x, which uses roost's adapter in plugins/roost
  instead, and $h 2 cannot load this one. roost install will not remove it.
  The fix is the directory: remove or re-point
    $(dirname "$path")
  so it no longer links into the roost checkout. Look at it first with
    ls -ld \"$(dirname "$path")\"
  and never delete the file: that deletes it from the checkout."
      continue
    fi
    if [ "${action:-}" = unlink ]; then
      oc_note="$h: something that is not this checkout's link is at
    $path
  This machine's $h is 2.x, which uses roost's adapter in plugins/roost
  instead. If that file is a roost 1.x adapter, $h 2 cannot load it and
  prints \"1 plugin failed\". roost install will not remove it."
      if [ -L "$path" ]; then
        oc_note="$oc_note Look at it
  first, then:
    rm \"$path\""
      else
        oc_note="$oc_note Look at it
  first, and remove it yourself if it is roost's."
      fi
      add_manual "$oc_note"
      continue
    fi
    # Named for what roost wants there. A skill row's TARGET is this
    # checkout's skills/roost, and a stranger's skill there is most likely
    # their own skill called roost, which "adapter" would misdescribe.
    what=adapter
    [ "$target" = "$(roost_skill_target)" ] && what=skill
    # The `rm` only for a symlink, the rule scripts/roost-doctor follows:
    # handed for a regular file or a directory it deletes the thing itself,
    # which may be the only copy of someone's own plugin.
    if [ -L "$path" ]; then
      add_manual "$h: something that is not this checkout is at
    $path
  roost install will not replace it. If you are sure you want roost's $what
  there instead, look at it first, then:
    rm \"$path\" && ln -s \"$target\" \"$path\""
    else
      add_manual "$h: something that is not this checkout is at
    $path
  roost install will not replace it, and
  it is not a symlink — look at it first, move it aside yourself, then:
    ln -s \"$target\" \"$path\""
    fi
  done <<EOF
$REFUSED
EOF
fi

# WHERE THE JSON STEPS GO
# -----------------------
# The claude, codex and copilot JSON writes are planned alongside LINK_STEPS
# above and executed under the same single consent, so each one DROPS OUT of
# the manual notes below the moment it is actually performed. A note here now
# means one of three things and nothing else: the write was refused (the file
# is not ours to change), --print-only asked for the block instead, or there
# is no JSON tool on this machine.
#
# What must keep being true: --print-only keeps printing the block instead of
# writing it, --symlinks-only keeps skipping the JSON entirely (it is what
# `roost validate` invokes, and validate's report promises the tester that
# nothing but symlinks was written), and the codex trust prompt and the copilot
# per-directory approval stay listed forever — they are prompts no tool can
# answer, not steps waiting to be automated.

# A step this run would not or could not perform. One note per refusal,
# carrying the reason the plan already printed plus the command that prints
# the block to merge by hand.
if [ -n "$JSON_REFUSED" ]; then
  while IFS="$TAB" read -r h path why; do
    [ -n "${h:-}" ] || continue
    json_note="$h: left alone —
    $path
  $why
  roost will not edit that file. Look at it first, then merge the object from
    roost hooks $h
  into it by hand, or move the entry that is already there out of the way."
    # The one place in this command where helpfully fixing something would be
    # worse than doing nothing, said in plain words because a reader who does
    # not know this will reasonably assume the tool is being timid.
    case "$h" in
      codex) json_note="$json_note
  Why roost will not just rewrite it: codex stores a hash of each handler and
  silently skips any handler whose hash no longer matches — nothing on stdout,
  nothing on stderr, nothing in its TUI. Rewriting that command string would
  re-hash the handler and stop every badge on a machine that is working today,
  with no way to notice. Doing nothing is deliberate." ;;
    esac
    add_manual "$json_note"
  done <<EOF
$JSON_REFUSED
EOF
fi

if [ "$SYMLINKS_ONLY" -eq 0 ]; then
  case " $DETECTED " in *" claude "*)
    # The BLOCK itself, not a "run this to see it" — that is what --print-only
    # is for, and on a machine with no JSON tool it is all roost can offer.
    # The bytes come from roost-hooks.sh so they are the same ones `roost
    # hooks` prints.
    case "$JSON_MODE" in
      print)
        add_manual "claude: --print-only, so nothing was written. Merge this into
    $(roost_adapter_settings claude)
  into any \"hooks\" object already there:
$(roost_hooks_claude)" ;;
      notool)
        add_manual "claude: neither python3 nor jq is on this PATH, so roost cannot edit
  JSON here. Nothing was written. Merge this into
    $(roost_adapter_settings claude)
  into any \"hooks\" object already there:
$(roost_hooks_claude)" ;;
    esac
  ;; esac

  case " $DETECTED " in *" codex "*)
    codex_hooks="$(roost_adapter_settings codex)"
    case "$JSON_MODE" in
      print)
        add_manual "codex: --print-only, so nothing was written. Put this in
    $codex_hooks
$(roost_hooks_codex)" ;;
      notool)
        add_manual "codex: neither python3 nor jq is on this PATH, so roost cannot edit
  JSON here. Nothing was written. Put this in
    $codex_hooks
$(roost_hooks_codex)" ;;
    esac
    # Unconditional, and it always will be — printed on every path, including
    # the ones that wrote nothing at all. Codex skips every hook until a human
    # answers this, there is no file on disk that records the answer, and no
    # tool can answer it for them, so there is nothing roost could detect that
    # would justify leaving it out.
    add_manual "codex: start \`codex\` and answer \"Trust all and continue\" at its
  \"Hooks need review\" prompt. Until then codex silently runs no hook at all
  and its pane will not badge.
  If codex asks again on a machine that was already trusted, it is asking
  about Interrupt alone: its timeout is now 3, the cap codex was clamping the
  old 10 down to anyway. The hook does what it always did; the warning codex
  printed with your hooks.json path on every start does not come back.
  Codex 0.154.0 leaves a timeout out of the hash it trusts, so there it does
  not ask at all -- nothing is wrong if you see no prompt."
  ;; esac

  case " $DETECTED " in *" copilot "*)
    copilot_settings="$(roost_adapter_settings copilot)"
    case "$JSON_MODE" in
      print)
        add_manual "copilot: --print-only, so nothing was written. Add
    {\"enabledFeatureFlags\": {\"EXTENSIONS\": true}}
  to $copilot_settings (merging, not replacing)." ;;
      notool)
        add_manual "copilot: neither python3 nor jq is on this PATH, so roost cannot edit
  JSON here. Nothing was written. Add
    {\"enabledFeatureFlags\": {\"EXTENSIONS\": true}}
  to $copilot_settings (merging, not replacing)." ;;
    esac
    # Permanent, and printed on every path including the ones that wrote
    # nothing. copilot persists nothing for this, so there is no file to read
    # and no way to tell "not yet asked" from "denied" — do not try to detect
    # it, say it plainly instead.
    add_manual "copilot: the first time you run it in a directory, answer Yes to the
  extension's \"wants to: handle permission requests\" prompt. Once per
  directory, and nothing on disk records it."
  ;; esac
fi

if [ -n "$manual" ]; then
  printf 'Still manual:\n\n'
  printf '%s' "$manual" | sed 's/^/  /; s/^  $//'
  printf '\n'
fi

# --- exit ------------------------------------------------------------------
# 0 covers "everything it could do succeeded", refusals and leftover manual
# steps included: a foreign path left alone is this command working correctly,
# not failing. Only a write that was attempted and did not happen is a 1.
if [ "$failed" -ne 0 ]; then
  printf 'roost install: at least one write failed (see above).\n' >&2
  exit 1
fi
exit 0
