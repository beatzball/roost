#!/usr/bin/env bash
# amux-status — one-line summary of agent states for the amux status bar.
# Rolls every window across the amux server up to badged counts:
#   🛑3 blocked  ⏳1 working  ✅4 done  💤2 idle
# Invoked from status-right on the normal status tick; cheap (one tmux call).
#
# The glyphs are read back off the windows rather than hardcoded here, so
# amux-agent-state stays the single source of truth for what each state looks
# like. (The old ● dots also carried a latent bug: U+25CF is East-Asian
# Ambiguous width, so it renders 1 cell here but 2 in a CJK locale, smearing
# the bar. The state emoji are unambiguously 2 cells everywhere.)

# Socket: the shared -L amux server in production. Tests set AMUX_STATUS_SOCK to a
# socket PATH to point the rollup at an isolated server (-S) instead.
amux_status_tmux() {
  if [ -n "${AMUX_STATUS_SOCK:-}" ]; then tmux -S "$AMUX_STATUS_SOCK" "$@"
  else tmux -L amux "$@"; fi
}

b=0 w=0 d=0 i=0
gb="🛑" gw="⏳" gd="✅"   # fallbacks, only used if a stamped window lacks a glyph
# idle is the DEFAULT state of an unstamped window (e.g. a brand-new tab), so its
# fallback must track the configured glyph set, not a hardcoded emoji — otherwise
# the rollup shows 💤 for a nerd/ascii theme. Matches the status-bar tab fallback.
gi="$(amux_status_tmux show-options -gqv @amux-glyph-idle 2>/dev/null)"; [ -n "$gi" ] || gi="💤"
while IFS='|' read -r st gl; do
  case "$st" in
    blocked) b=$((b+1)); [ -n "$gl" ] && gb="$gl" ;;
    working) w=$((w+1)); [ -n "$gl" ] && gw="$gl" ;;
    done)    d=$((d+1)); [ -n "$gl" ] && gd="$gl" ;;
    *)       i=$((i+1)); [ -n "$gl" ] && gi="$gl" ;;
  esac
done < <(amux_status_tmux list-windows -a -F '#{@agent_state}|#{@agent_glyph}' 2>/dev/null)

# Ordered by how much they want your attention. The emoji carry their own colour,
# so no #[fg=] is needed — which is what lets the counts stay legible on any bg.
#
# Spacing: one space inside a badge, two between them. Emoji render flush against
# a following digit, and with an equal gap either side "🛑1 ⏳2" reads as one run
# of characters — the outer gap has to beat the inner gap for each badge to read
# as a unit. The trailing pair also separates the counts from the session name.
out=""
[ "$b" -gt 0 ] && out+="${gb} ${b}  "
[ "$w" -gt 0 ] && out+="${gw} ${w}  "
[ "$d" -gt 0 ] && out+="${gd} ${d}  "
[ "$i" -gt 0 ] && out+="${gi} ${i}  "
printf '%s' "$out"
