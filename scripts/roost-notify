#!/usr/bin/env bash
# roost-notify <title> <message> — deliver one desktop notification, cross-platform.
# Delivery only; the caller decides *whether* to notify. Never fails: every
# backend miss falls through, and the final fallback is an in-tmux message.
set -u
title="${1:-roost}"; msg="${2:-}"
# Socket, in order: ROOST_NOTIFY_SOCK (tests / roost-agent-state pass a PATH -> -S),
# else the server we are running inside, else the shared server by name.
# (Using -S roost here would mean a socket FILE named "roost".) The middle step
# keeps a notification — and its in-tmux fallback message — on the server that
# actually raised it, rather than on the developer's live one.
nt() {
  if [ -n "${ROOST_NOTIFY_SOCK:-}" ]; then tmux -S "$ROOST_NOTIFY_SOCK" "$@"
  elif [ -n "${TMUX:-}" ]; then tmux -S "${TMUX%%,*}" "$@"
  else tmux -L roost "$@"; fi
}
opt() { nt show-options -gqv "$1" 2>/dev/null; }

backend="$(opt @roost-notify-backend)"; backend="${backend:-auto}"
if [ "${1:-}" = "--which" ]; then printf '%s\n' "$backend"; exit 0; fi
[ "$backend" = none ] && exit 0

tmux_fallback() { nt display-message "$title — $msg" 2>/dev/null || true; }

if [ "$backend" = tmux ]; then tmux_fallback; exit 0; fi

# ---------------------------------------------------------------------------
# OSC backend (#46) — a notification that reaches the HUMAN's terminal
# ---------------------------------------------------------------------------
# Every other backend here delivers to the desktop of the machine this script
# runs on. When the fleet runs on another box, that desktop is the wrong one:
# nobody is looking at it. A terminal notification escape sequence travels down
# the SSH connection instead and is raised by whatever terminal the human is
# actually sitting in front of. No daemon, no port, no account.
#
# MEASURED (tmux 3.6, macOS 25.3.0, 2026-09-21) — where the bytes have to go:
#
#   bare OSC 9 -> #{client_tty}                    ARRIVES at the outer terminal
#   bare OSC 9 -> #{pane_tty}                      absent (tmux parses, drops it)
#   DCS-wrapped, passthrough on, pane VISIBLE      ARRIVES
#   DCS-wrapped, passthrough on, pane OFF-SCREEN   absent
#   DCS-wrapped, passthrough off                   absent
#
# So this writes BARE sequences to the client's tty, not DCS-wrapped ones to
# the pane. Two reasons, and the second is the decisive one:
#
#   1. The client's tty is the slave side of the pty whose master is the
#      terminal emulator, so a write there bypasses tmux's parser altogether —
#      no `allow-passthrough`, no wrapper, nothing to unwrap wrongly.
#   2. tmux forwards a passthrough DCS only while the pane is VISIBLE, and
#      scripts/roost-agent-state calls this script ONLY when the pane is
#      off-screen (`#{window_active}` != 1). The passthrough route therefore
#      drops exactly the notifications this feature exists to deliver. The
#      issue's own suggestion was written from reading rather than running;
#      tests/test-notify-osc.sh pins the measurement.
#
# Off unless the human is somewhere else: `@roost-notify-osc on` forces it,
# `off` silences it, and unset means "only for a client tmux reports as
# remote". A terminal that does not know these sequences prints nothing: an
# unknown OSC string is swallowed up to its terminator. A terminal that does
# not know OSC *at all* would print the payload, which is the whole reason this
# is off for a local client unless asked for.
osc_mode="$(opt @roost-notify-osc)"
osc_codes="$(opt @roost-notify-osc-codes)"; osc_codes="${osc_codes:-9}"
# An explicit tty to write to instead of discovering clients. Its first job is
# to be the seam tests/test-notify-osc.sh writes into — a test cannot attach a
# real client from a plain shell, since attaching needs a pty — but it is also
# the escape hatch for a setup where client discovery cannot see the right
# terminal. It names a DESTINATION and decides nothing: in auto mode tmux still
# has to report a remote client before anything is written to it.
osc_tty="$(opt @roost-notify-osc-tty)"

# The C1 controls, U+0080-U+009F, as the TWO-byte UTF-8 sequences C2 80 .. C2 9F.
# Built once, with printf, because a literal \x escape is not portable in sed:
# BSD sed does not read \xNN, so the bytes go into the program itself and the
# match runs under LC_ALL=C.
osc_c1_re="$(printf 's/\302[\200-\237]/ /g')"

# Payload sanitiser. Window names and agent messages are not trusted input.
#
#   C0 and DEL  an ESC, a BEL or a newline TERMINATES the OSC string early and
#               the rest is printed as garbage on the human's screen (#46
#               requirements 4 and 5). Byte-safe to strip: 0x00-0x1F and 0x7F
#               never appear inside a UTF-8 multi-byte sequence.
#   C1          a lone U+009C can be read as an 8-bit ST and end the string the
#               same way. These are NOT byte-strippable, and getting that wrong
#               corrupts ordinary text. MEASURED on the string "a<C2 9B>b ł c":
#                 tr '\200-\237' ' '   -> "a<C2> b<C5> c"   both characters destroyed
#                 sed on C2 80-C2 9F   -> "a b ł c"         correct
#               U+0142 'ł' is C5 82 and 0x82 is in that byte range, which is
#               exactly how a naive strip eats it.
#
# A payload that is not valid UTF-8 can still carry a bare 0x9C, and that is
# deliberately left alone: telling "invalid byte" from "second byte of a real
# character" needs a validity check, and iconv cannot be trusted to give one —
# MEASURED, `iconv -f UTF-8 -t UTF-8` rejected a lone 0x9C on one image here and
# ACCEPTED it on another. Corrupting every 'ł' to catch an invalid byte that a
# UTF-8 terminal already replaces is the worse trade.
#
# LC_ALL=C throughout so both tools work on bytes: UTF-8 continuation bytes are
# 0x80-0xBF and so never inside the C0 range, which is what keeps non-ASCII
# intact (MEASURED: a UTF-8 payload reaches the outer terminal byte for byte).
osc_clean() { LC_ALL=C tr '\000-\037\177' ' ' | LC_ALL=C sed "$osc_c1_re"; }

# Is the client attached to session $1 a remote one?
#
# SSH_CONNECTION is in tmux's DEFAULT update-environment (MEASURED on tmux 3.6:
# DISPLAY KRB5CCNAME MSYSTEM SSH_ASKPASS SSH_AUTH_SOCK SSH_AGENT_PID
# SSH_CONNECTION WINDOWID XAUTHORITY), so tmux copies it from the attaching
# client into that session's environment and REMOVES it again when a local
# client attaches. That makes tmux's own view the only honest source here.
# SSH_TTY is not in that list; it is checked too, cheaply, for a user who added
# it, but nothing may rest on it alone.
#
# `show-environment -t S VAR` prints "VAR=value" when set and "-VAR" — a removal
# marker, not an error — when it is not, so the test has to be for the
# assignment form with a non-empty value, never merely for non-empty output.
#
# This process's OWN environment is deliberately NOT consulted. It looked like a
# cheap extra signal and it is a bug: this script runs inside an agent's pane,
# and a pane keeps SSH_CONNECTION for its whole life once the server (or the
# window) was created over ssh — long after the human walked back to the
# machine. A review caught it writing to a LOCAL client that tmux was correctly
# reporting as local. Per client, from tmux, or not at all.
# $1 is a session ID (`$0`, `$7`), never a session NAME. tmux resolves a -t
# target as an ID FIRST, so a session whose NAME happens to be another session's
# ID is read as that other session — MEASURED: with a session named "$0" beside
# the session whose id IS $0, `show-environment -t '$0'` returns the latter's
# environment. Judging by name would then call a local client remote and write
# to it, which is why #{session_id} is in the list-clients format below.
osc_session_remote() {
  for _v in SSH_CONNECTION SSH_TTY; do
    case "$(nt show-environment -t "$1" "$_v" 2>/dev/null)" in
      "$_v"=?*) return 0 ;;
    esac
  done
  return 1
}

# The clients worth writing to, one tty per line. $1 = force | auto.
osc_targets() {
  # Fields are separated by a SPACE and split at the FIRST one, which looks lax
  # and is not: a tty path can never contain a space, #{client_control_mode} is
  # 0 or 1, #{client_flags} is comma-separated with no spaces, and a
  # #{session_id} is `$` and digits. The session ID is what is carried, not the
  # session NAME — a name is ambiguous with an ID at any -t target, and a name
  # can contain spaces where an ID cannot. A tab
  # would be the obvious separator and is version-dependent — MEASURED, with a
  # real tab in the -F string:
  #
  #   tmux 3.6 (macOS 25.3.0)   `0 \t $0`   tab preserved
  #   tmux 3.4 / 3.5a / 3.7c    `0 _ $0`    tab rewritten to an UNDERSCORE
  #
  # Those builds sanitise a control character out of a format result, so `read`
  # saw one field, the session came back empty, and every attached client was
  # skipped — on Linux only, while macOS stayed green.
  #
  # An older tmux that does not know one of these formats expands it to EMPTY
  # rather than erroring (MEASURED: `-F '[#{client_no_such_format}]'` prints
  # `[]`), which leaves a run of spaces the split above absorbs, so the session
  # ID still lands in the last field.
  nt list-clients -F '#{client_tty} #{client_control_mode} #{client_flags} #{session_id}' 2>/dev/null |
  while IFS= read -r _line; do
    [ -n "$_line" ] || continue
    _ctty="${_line%% *}"; _rest="${_line#* }"
    _ccm="${_rest%% *}";  _rest="${_rest#* }"
    _cflags="${_rest%% *}"; _csid="${_rest#* }"
    [ -n "$_ctty" ] || continue
    # A control-mode client (`tmux -CC`, what an integrating terminal attaches
    # with) is NOT an emulator: its tty carries tmux's own control protocol, a
    # line-based stream of %begin/%output blocks. Raw escape bytes shoved into
    # it are read as protocol and can desync the parser on the other side.
    # Skipped whatever its session says. Both spellings are checked because
    # roost supports tmux >= 3.2 and only 3.3a upward could be measured here
    # (MEASURED on 3.3a, 3.4, 3.5a, 3.6, 3.7c: #{client_control_mode} is 1 AND
    # #{client_flags} contains control-mode); on a build that knows neither,
    # both read empty and such a client would be written to.
    [ "$_ccm" = 1 ] && continue
    case ",$_cflags," in *,control-mode,*) continue ;; esac
    if [ "$1" != force ] && ! osc_session_remote "$_csid"; then continue; fi
    printf '%s\n' "$_ctty"
  done
}

# One tty, one write, bounded. Runs as a background job of osc_write_all.
#
# The write MUST NOT be able to block for ever. This script is called
# synchronously from scripts/roost-agent-state, which is a hook on the agent's
# own turn, and the file's contract at the top is that it never fails. A
# terminal that has stopped reading — laptop asleep, wifi gone, sshd not
# draining the pty — leaves the pty buffer full, and the next write to it blocks
# in the kernel with no timeout. MEASURED: a pty filled with 1 KiB on macOS and
# never read made this hook still running after 8 s. There is no portable
# non-blocking open in POSIX shell, so the bound is a watchdog: write in a
# child, kill it if it is still there after the deadline.
#
# 1 second, and it is the longest a wedged terminal can hold up the agent's
# turn. MEASURED on this machine: a healthy notification (the whole script, a
# few tmux round trips included) takes 0.12-0.16 s wall, of which the write
# itself is one small write() to a pty; the same call against a filled pty
# that nobody reads returns in 1.14 s with exit 0, and leaves no process
# behind 5 s later.
osc_write_one() {
  { printf '%s' "$_pay" >"$1" 2>/dev/null || true; } >/dev/null 2>&1 </dev/null &
  _w=$!
  ( sleep 1; kill -9 "$_w" 2>/dev/null || true ) >/dev/null 2>&1 </dev/null &
  _k=$!
  wait "$_w" 2>/dev/null || true
  # The writer is done, one way or the other. This kills the watchdog SUBSHELL,
  # not the `sleep` it is currently blocked in: that sleep is a child of the
  # subshell and is orphaned rather than killed, so one `sleep 1` per client can
  # outlive this function by up to a second. It is reparented, exits on its own,
  # and leaves no zombie — MEASURED: nothing of this script's making is still
  # running 5 s after a wedged write.
  kill "$_k" 2>/dev/null || true
}

# $1 = newline-separated tty paths. Every write is started FIRST and waited for
# afterwards, so one wedged terminal cannot delay the others and the whole
# fan-out costs one deadline rather than one per client.
osc_write_all() {
  _pids=""
  # A here-document feeds `read` without a pipeline, so this loop stays in the
  # current shell and the job ids survive it.
  while IFS= read -r _t; do
    [ -n "$_t" ] || continue
    osc_write_one "$_t" &
    _pids="$_pids $!"
  done <<OSC_TTYS
$1
OSC_TTYS
  for _p in $_pids; do wait "$_p" 2>/dev/null || true; done
  return 0
}

# Build the whole payload ONCE. A short single write() to a tty will not be
# torn in half, so tmux's own output cannot land in the middle of an escape
# sequence and corrupt the screen; one printf per code, opened once, would
# leave that window open between codes.
osc_payload() {
  _t="$(printf '%s' "$title" | osc_clean)"
  _m="$(printf '%s' "$msg" | osc_clean)"
  _b="$_t — $_m"
  # OSC 9 carries a body and no title, so the two are joined with the same
  # em dash the in-tmux fallback uses.
  #
  # ConEmu's progress-bar sequence is OSC 9;4 — the same OSC 9, distinguished
  # only by a leading "4;" (Ghostty 1.3.1 documents both forms). A title that
  # began "4;" would drive a progress bar instead of raising a banner, so shift
  # it by one space: invisible in a notification, and not a subcommand number.
  case "$_b" in 4\;*) _b=" $_b" ;; esac
  # OSC 777's fields are delimited by ";", so a ";" anywhere in the title or the
  # body shifts every field after it — "a;b" as a title makes "b" the body and
  # drops the real one. The substitution is applied to the 777 form ONLY: OSC
  # 9's payload is everything after the first ";", so there is nothing to shift
  # there and the text is left exactly as the human wrote it.
  _t7="$(printf '%s' "$_t" | tr ';' ',')"
  _m7="$(printf '%s' "$_m" | tr ';' ',')"
  # Every sequence is preceded by an ST (ESC \), and that is not decoration.
  # A write can be cut PART WAY THROUGH — the watchdog below kills it when the
  # terminal is slow rather than dead, leaving the terminal inside an OSC string
  # with nothing to close it, swallowing everything printed after it until it
  # sees a terminator. MEASURED, with ten bytes of room left in the pty: the
  # bytes that landed were `ESC ] 9 ; r o o s t` and stopped there. A leading ST
  # closes whatever the last write left open, so the next notification heals the
  # terminal as well as delivering. Outside a control string an ST is ignored
  # (ECMA-48), so it costs two bytes and changes nothing on a healthy terminal —
  # that a real emulator visibly recovers is inferred from the standard, not
  # measured, since it cannot be read back from a pty.
  printf -v _st '\033\\'
  _p=""
  for _c in $osc_codes; do
    case "$_c" in
      # iTerm2's form, also read by Ghostty, WezTerm, Windows Terminal and
      # kitty. The widest reach of the three, which is why it is the default.
      9)   printf -v _s '%s\033]9;%s\033\\' "$_st" "$_b" ;;
      # rxvt-unicode's extension, read by Ghostty and foot. Title and body get
      # their own fields.
      777) printf -v _s '%s\033]777;notify;%s;%s\033\\' "$_st" "$_t7" "$_m7" ;;
      # kitty's own protocol: one escape per part, keyed by the same identifier
      # so the two chunks are one notification. NOT in the default set —
      # Ghostty 1.3.1 shows no sign of reading OSC 99 (MEASURED: its binary
      # carries "]777;notify;" and documents OSC 9 and OSC 777 for
      # `desktop-notifications`, and has no OSC 99 string at all), so on the
      # terminal measured here it would be a silent no-op.
      99)  printf -v _s '%s\033]99;i=roost:d=0:p=title;%s\033\\%s\033]99;i=roost:d=1:p=body;%s\033\\' "$_st" "$_t" "$_st" "$_m" ;;
      # Anything else is dropped rather than written out. A typo in
      # @roost-notify-osc-codes must never reach a terminal as raw text.
      *)   _s="" ;;
    esac
    _p="$_p$_s"
  done
  printf '%s' "$_p"
}

# $1 = "force" to write to every client without asking whether it is remote (an
# explicitly selected backend, or `@roost-notify-osc on`). Never fails, like
# every other backend here: an unwritable tty is a miss.
osc_notify() {
  _force="$1"
  [ -n "$osc_codes" ] || return 0
  _pay="$(osc_payload)"
  [ -n "$_pay" ] || return 0
  _targets="$(osc_targets "$_force")"
  if [ -n "$osc_tty" ]; then
    # A destination override still needs a reason to fire. In auto that reason
    # is the same one every other client is judged by: tmux reporting a remote
    # client somewhere. Pair the override with `@roost-notify-osc on` to write
    # unconditionally.
    if [ "$_force" = force ] || [ -n "$_targets" ]; then osc_write_all "$osc_tty"; fi
    return 0
  fi
  [ -n "$_targets" ] || return 0
  osc_write_all "$_targets"
}

# Selected on its own: emit and stop, without asking whether anyone is remote.
# That is what makes it testable and what "it must be selectable" (#46
# requirement 2) means.
if [ "$backend" = osc ]; then osc_notify force; exit 0; fi

# The OSC backend is ADDITIVE, not an alternative: it reaches the human's
# TERMINAL, where every backend below reaches some machine's DESKTOP. So it
# runs first and the chain below still runs to its end, in its existing order,
# down to the same in-tmux fallback (#46 requirement 6). It is off for a local
# client unless asked for, so nothing changes for anyone not running a remote
# fleet.
# `on` is a decision already taken, so it skips the remote test outright; in
# auto mode osc_targets does the deciding per CLIENT, since a server can have a
# local client and a remote one attached at once and only the remote one needs
# this.
case "$osc_mode" in
  off) ;;
  on)  osc_notify force ;;
  *)   osc_notify auto ;;
esac

# auto: user override first
cmd="$(opt @roost-notify-cmd)"
if [ -n "$cmd" ]; then
  # %t/%s are replaced with shell positionals $1/$2, and the real title/message
  # are passed as arguments — so shell metacharacters in the payload (window
  # names, message text) can never be re-parsed as shell syntax. Reference the
  # placeholders double-quoted ("%s") or bare, NOT single-quoted (which would
  # suppress the positional expansion).
  run=$(printf '%s' "$cmd" | sed 's/%t/$1/g; s/%s/$2/g')
  sh -c "$run" sh "$title" "$msg" >/dev/null 2>&1 || true
  exit 0
fi

case "$(uname -s)" in
  Darwin)
    osascript -e "display notification \"$msg\" with title \"$title\" sound name \"Ping\"" >/dev/null 2>&1 && exit 0 ;;
esac
if grep -qi microsoft /proc/version 2>/dev/null && command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -Command "New-BurntToastNotification -Text '$title','$msg'" >/dev/null 2>&1 && exit 0
fi
if { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; } && command -v notify-send >/dev/null 2>&1; then
  notify-send "$title" "$msg" >/dev/null 2>&1 && exit 0
fi
tmux_fallback
exit 0
