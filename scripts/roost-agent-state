#!/usr/bin/env bash
# roost-agent-state — record an AI agent's state onto its tmux pane.
#
# Called by Claude Code lifecycle hooks (see `roost hooks`). It stamps the
# pane that the agent runs in with a state, which the roost status bar
# renders at a glance (glyphs are derived at render time, not stored here).
# It is a deliberate no-op unless the agent is running
# inside a `roost` server pane, so it is safe to wire into your GLOBAL Claude
# hooks — running `claude` anywhere else does nothing.
#
#   usage: roost-agent-state <working|blocked|error|done|idle> [--stop-hook]
#
# --stop-hook additionally reads Claude Code's Stop payload from stdin and
# records that turn's reply on the pane, which is what `roost read` returns.
# With `error` instead of `done` it reads nothing and clears that reply: the
# codex adapter uses it for a turn that ended with no reply (#39).
#
# The other three flags each say "stdin is THAT event's payload", and each is a
# flag rather than an always-on read for the same reason --stop-hook is one: a
# human typing `roost state blocked` at a terminal must never wait on a stdin
# nobody closes. --notification-hook and --permission-request-hook go with
# `blocked` and record the dialog (#38, #91); --stop-failure-hook goes with
# `error` and records which kind of API error ended the turn (#55).
set -euo pipefail

# Resolve this script's own directory even when invoked via a symlink — same
# readlink loop as bin/roost. This hook is wired into ~/.claude/settings.json by
# ABSOLUTE path, and that path can perfectly well be a symlink (an alias on
# PATH, a compatibility shim left behind by a rename). Through one, $0 is the
# symlink, so `dirname "$0"` names the WRONG directory and the roost-notify call
# below would miss its sibling — silently, since that call carries `|| true`
# and must keep carrying it. Resolve once here, at the top, where it costs
# nothing: this is pure shell, no tmux round trip, so the PostToolUse hot path
# (one tmux read, then bail) is unaffected.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

state="${1:-idle}"
# Only the Stop hook passes this, and only Stop carries a reply to record.
# It is a flag rather than an always-on stdin read because `roost state` is a
# documented public command: a human typing `roost state done` at a terminal
# would hang forever on a `cat` that never sees EOF.
stop_hook=0
[ "${2:-}" = "--stop-hook" ] && stop_hook=1
# Only Claude Code's Notification hook passes this, and it means "stdin is that
# hook's payload". With `blocked` it records the payload's transcript_path
# beside the stamp, which is what lets bin/roost clear a 🛑 that a declined or
# dismissed dialog left behind (#38, scripts/lib/roost-unblock.sh). A flag, not
# a stdin read on every `blocked`, for the reason --stop-hook is one: codex's
# adapter and `roost state blocked` reach this script too, and a `cat` on a
# stdin nobody closes would hang the agent.
notification_hook=0
[ "${2:-}" = "--notification-hook" ] && notification_hook=1
# Only Claude Code's StopFailure hook passes this, with `error`, and it means
# "stdin is that hook's payload" (#55). A flag for the same reason as the two
# above: `roost state error` is typed by humans and passed by codex's adapter,
# and neither must ever wait on a stdin nobody closes.
stop_failure_hook=0
[ "${2:-}" = "--stop-failure-hook" ] && stop_failure_hook=1
# Only Claude Code's PermissionRequest hook passes this, with `blocked`, and it
# means "stdin is that hook's payload" (#91). A flag for the same reason as the
# three above: `roost state blocked` is typed by humans and passed by codex's
# adapter, and neither must ever wait on a stdin nobody closes.
#
# WHY THERE IS A SECOND DIALOG HOOK AT ALL. Measured on Claude Code 2.1.278
# with a logger on all 18 hook events, an isolated HOME and a local stand-in
# for the Messages API so a real dialog opened with no account behind it:
# PermissionRequest fires 11-16 ms after the dialog is drawn, and the
# permission_prompt Notification that roost badged on until now fires a flat
# 6.00 s after PermissionRequest -- for a Bash, an Edit, a Write, a WebFetch
# and an MCP tool alike. A dialog answered inside those six seconds fires no
# Notification at all, so it was never badged, and `roost send` pasted into it.
# The Notification entry stays wired as the fallback for a Claude old enough
# not to have this event; on a Claude that has it, the repeat-blocked path
# below is all the second event does.
#
# The hook DECIDES NOTHING and prints nothing, which is measured too: a hook
# that printed `{}` and a hook that printed nothing both left the dialog open
# for the human, and neither auto-allowed nor auto-denied anything. Claude does
# not wait for it either -- with every hook sleeping 3 s the dialog was on
# screen 16 ms BEFORE this event's hook started -- so the tmux round trips
# below cost the human nothing.
permission_request_hook=0
[ "${2:-}" = "--permission-request-hook" ] && permission_request_hook=1
# Claude's Stop, and only Claude's: this call may have to be held back because
# a dialog is open on the pane (#91). Whether it IS held back is decided by
# tmux at the write, at the bottom of this file, never from a value read
# earlier — that is what this flag's whole comment there is about.
#
# `done` alone, so the codex adapter's `error --stop-hook` and
# `idle --stop-hook` (#39, #38) are untouched: those already mean "this turn
# produced nothing", and neither is a turn that ended while waiting on a
# background agent, which is the shape being guarded against.
stop_while_blocked=0
[ "$stop_hook" = 1 ] && [ "$state" = "done" ] && stop_while_blocked=1

# Must be inside tmux, in a known pane.
[ -n "${TMUX:-}" ] || exit 0
[ -n "${TMUX_PANE:-}" ] || exit 0

# Only act on a roost socket. The rule itself lives in lib/roost-socket.sh
# because bin/roost needs the identical one — `roost state` (this script) and
# `roost reply` (there) are the two halves of one contract, and they used to
# answer "which server?" differently: this script from $TMUX, bin/roost from
# the -L roost default. On any other roost server the badge landed here and the
# reply silently did not. One copy, so they cannot drift apart again.
#
# Sourced at the top, unlike lib/roost-reply.sh below, because the guard is the
# very first thing every PostToolUse call needs. It costs a file read, no fork:
# roost_self_socket sets a variable rather than printing one for exactly that
# reason.
. "$SELF_DIR/lib/roost-socket.sh"
roost_self_socket
sock="$ROOST_SELF_SOCK"
[ -n "$sock" ] || exit 0

# Normalise: anything unrecognised is idle.
case "$state" in blocked|working|done|error) ;; *) state="idle" ;; esac

# Why a pane is error, for `roost wait-done` and `read`. Only an adapter sets
# it — see the write below — and the StopFailure branch further down replaces
# it with a sentence of its own.
error_reason="${ROOST_ERROR_REASON:-}"

# Record the turn's reply, for `roost read`.
#
# This sits ABOVE the unchanged-state early bail below, and that placement is
# load-bearing twice over:
#
#  1. A Stop arriving when the pane already reads `done` — a turn with no
#     UserPromptSubmit, a re-entrant stop — would otherwise bail out before
#     recording anything, and `roost read` would silently serve the PREVIOUS
#     turn's reply.
#  2. The reply must be stamped BEFORE @agent_state, which happens further
#     down. `roost wait-done` returns the instant the state stops being
#     working/blocked, and the documented idiom is `wait-done` then `read`, so
#     stamping the state first opens a window where read lands between the two
#     and falls back to the screen. That would reintroduce the original bug
#     intermittently, which is harder to diagnose than reintroducing it
#     consistently.
#
# Gated on --stop-hook AND done, so PostToolUse — which fires on every tool
# call, and which Claude blocks on — never reaches any of this and keeps its
# one-read-then-bail cost.
if [ "$stop_hook" = 1 ] && [ "$state" = "done" ]; then
  # A tty here means a human typed the flag by hand; `cat` would wait for them
  # to press ^D. Skip rather than hang.
  if [ ! -t 0 ]; then
    payload="$(cat 2>/dev/null || true)"
    # last_assistant_message is a JSON string: it WILL contain \n, and it can
    # contain \", \\ and \uXXXX. Unescaping that in pure bash is a meaningful
    # amount of shell whose failure mode is a subtly corrupted reply — wrong,
    # plausible, and silent, which is the worst shape a bug takes here. A
    # process spawn once per turn is the cheaper side of that trade: by this
    # repo's own measurements a spawn is ~0.57 of a tmux round trip, and this
    # script already makes several.
    #
    # But neither reader may be REQUIRED. scripts/roost-doctor records the
    # standing decision that python3 is not a runtime dependency, so a machine
    # with neither python3 nor jq records nothing and `roost read` falls back
    # to the screen — the path that already exists and already announces
    # itself. The feature degrades; it never breaks the agent.
    reply=""
    if command -v python3 >/dev/null 2>&1; then
      reply="$(printf '%s' "$payload" | python3 -c \
        'import sys,json; sys.stdout.write(json.load(sys.stdin).get("last_assistant_message") or "")' \
        2>/dev/null || true)"
    elif command -v jq >/dev/null 2>&1; then
      reply="$(printf '%s' "$payload" | jq -r '.last_assistant_message // ""' 2>/dev/null || true)"
    fi
    if [ -n "$reply" ]; then
      # Sourced here, inside the branch, rather than at the top of the file:
      # PostToolUse never gets this far, so the hot path does not pay for a
      # file read it has no use for.
      . "$SELF_DIR/lib/roost-reply.sh"
      # The durable copy (#42), written BEFORE the pane option for the same
      # reason the reply is written before @agent_state: a reader that sees the
      # pointer below must find its file. docs/airig/specs/2026-09-16-pane-record-design.md
      # has the layout and the measurements; scripts/lib/roost-record.sh has the
      # rules. Every step fails soft: no record means the pane option below is
      # written exactly as it always was, and `read` serves it as it always did.
      #
      # The boot key costs one tmux read, so it is taken only when records are
      # on — ROOST_RECORD_DIR set to "" (the test suite's default) costs nothing.
      . "$SELF_DIR/lib/roost-record.sh"
      turn=""
      roost_record_root
      if [ -n "$ROOST_RECORD_ROOT" ]; then
        boot="$(tmux -S "$sock" display-message -p '#{start_time}-#{pid}' 2>/dev/null || true)"
        if roost_record_pane_dir "$boot" "$TMUX_PANE" \
           && roost_record_append "$ROOST_RECORD_PANE_DIR" "$sock" "$reply"; then
          turn="$ROOST_RECORD_TURN"
        fi
      fi
      # @roost-reply-turn names the file that holds THIS reply. It is set in the
      # same tmux command as @roost-reply, so no reader sees one without the
      # other. When nothing was recorded it is left as it is: `read` uses it only
      # while @roost-reply is set, and serves the file only when the file agrees
      # with @roost-reply, so a pointer left from an earlier turn cannot change
      # what is printed (and an unset here could not be caught by any test).
      #
      # The pointer is a few dozen bytes; roost_reply_encode's cap leaves ~4 KB
      # of headroom under tmux's command-length limit for exactly this.
      #
      # The same command then reads @roost-reply back, and that text — what tmux
      # STORED, which on tmux 3.4 and 3.5a is not always what it was sent — is
      # kept beside the turn as NNNNNN.pane. `read` serves the turn file only
      # while the pane still holds exactly that (roost_record_match, which says
      # why the value cannot be compared with the file itself). One command, so
      # no other writer's set-option can land between the write and the read.
      # If set-option fails, tmux runs nothing after it, the read-back is empty
      # and no sidecar is written: `read` then prints the pane value, as before.
      #
      # A tmux client that is not UTF-8 (no UTF-8 locale, no -u, no $TMUX)
      # PRINTS newline, tab, non-ASCII and control bytes as `_` — on output, not
      # in storage (measured on tmux 3.3a and 3.4). This hook only runs with
      # $TMUX set, which makes its client UTF-8, so the read-back is the stored
      # value itself; `read` compares through `tmux -u` to see the same thing.
      if [ -n "$turn" ]; then
        stored="$(tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-reply \
          "$(roost_reply_encode "$reply")" \; \
          set-option -p -t "$TMUX_PANE" @roost-reply-turn "$turn" \; \
          show-options -pqv -t "$TMUX_PANE" @roost-reply 2>/dev/null || true)"
        roost_record_put_pane "$ROOST_RECORD_PANE_DIR" "$turn" "$stored" || true
      else
        tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-reply \
          "$(roost_reply_encode "$reply")" 2>/dev/null || true
      fi
    else
      # This turn ENDED and produced nothing to record. Clearing is not
      # tidiness, it is the whole point: the staleness notice in bin/roost's
      # `read` is keyed on @agent_state being working/blocked, and the state
      # this script writes below is `done`. A reply left in place here is
      # therefore served as THIS turn's answer, on a pane that reads finished,
      # with an empty stderr and no signal of any kind to the caller. Measured
      # before the fix: turn 1 answers "TURN ONE REPLY", turn 2 records
      # nothing, `roost read` prints "TURN ONE REPLY" and exits 0 quietly.
      #
      # Unsetting hands `read` its screen fallback instead, and that fallback
      # already announces itself on stderr. A caller then sees the pane's
      # screen and a notice, which is worse content and a far better failure:
      # wrong-and-loud beats wrong-and-silent, and this is the exact failure
      # the reply channel was built to remove.
      #
      # Three real routes reach here, and the comment above only describes the
      # third: `last_assistant_message` present but empty (a turn that ended on
      # a tool call), the field absent (an interrupted turn), and a payload
      # neither reader could parse — which includes the machine with no working
      # python3 and no jq. That machine degrades to the announcing fallback
      # only from this line; before it, the fallback was reachable on the very
      # first turn and never again.
      #
      # Guarded by the same `--stop-hook`, `done` and `[ ! -t 0 ]` conditions
      # as the write above, so a human typing `roost state done` by hand, or
      # any PostToolUse call, can never wipe a recorded reply on the way past.
      tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply 2>/dev/null || true
    fi
  fi
elif [ "$stop_hook" = 1 ] && [ "$state" = "error" ] && [ ! -t 0 ]; then
  # A turn that ended as an ERROR has no answer to record, and whatever reply
  # is stored is the previous turn's. Cleared for the same reason the empty
  # `done` branch above clears it, and above the unchanged-state bail for the
  # same reason as that one: a second dead turn in a row must not leave turn
  # N-1's answer behind either. The stdin is not read — nothing in an error
  # turn's payload is published — so there is no `cat` to hang on, but the tty
  # guard stays so a human typing the flag by hand can never wipe a reply.
  #
  # Only adapters/codex/roost-codex-hook passes `error --stop-hook` today: codex
  # has no error event, so its adapter decides from the Stop payload (#39).
  tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply 2>/dev/null || true
elif [ "$stop_hook" = 1 ] && [ "$state" = "idle" ] && [ ! -t 0 ]; then
  # A turn that ended because the human INTERRUPTED it — declined a dialog,
  # pressed Esc — has no answer either, and no Stop fires to replace the stored
  # one, so it is the previous turn's. Cleared for the same reasons as the error
  # arm above. Only adapters/codex/roost-codex-hook passes `idle --stop-hook`,
  # on codex's Interrupt event (#38).
  tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply 2>/dev/null || true
elif [ "$stop_failure_hook" = 1 ] && [ "$state" = "error" ] && [ ! -t 0 ]; then
  # Claude Code's StopFailure: the turn ended on an API error — a rate limit,
  # an overload, a model that does not exist (#55). Claude fires it INSTEAD of
  # Stop and nothing follows it, so before this hook was wired the pane kept
  # UserPromptSubmit's `working` forever while Claude sat idle under an error
  # banner. Measured on 2.1.272 with a logger on all 33 events: seven failures
  # triggered on demand each fired exactly one StopFailure, and pressing Esc
  # while the model was streaming fired none.
  #
  # Unlike codex's 💥 this is a REPORT, not an inference: Claude says the turn
  # failed, and says what kind. The payload's `error` is one word out of a
  # fixed list in Claude's source (rate_limit, overloaded, server_error,
  # model_not_found, ... unknown), and it is the only thing taken from it.
  #
  # Three rules, each for a reason:
  #
  #  1. A payload that names an `agent_id` belongs to a SUBAGENT's loop.
  #     Claude's source adds that field only there, and a subagent's API error
  #     comes back to the main turn as a failed tool call — the main turn goes
  #     on. So this call changes nothing at all, not even the reply, and
  #     exits. Read from the source; not measured live.
  #  2. The kind goes into @roost-error-reason only if it is lowercase letters
  #     and underscores, 40 at most. Anything else, or a payload no reader can
  #     parse, is "unknown". The reason is printed by `wait-done` and `read`,
  #     and text copied out of a payload is not something roost prints as its
  #     own words. The READER checks the whole string first, because the shell
  #     cannot: `$(...)` strips trailing newlines and bash drops NUL bytes, so
  #     "rate_limit\n" and "x<NUL>y" would reach the case below already
  #     cleaned into "rate_limit" and "xy" (found by review, reproduced). The
  #     case below stays as a second check. Its letters are spelled out rather
  #     than written a-z: bash 3.2 matches a range by the locale's collation,
  #     where a-z can include capitals.
  #  3. It still badges error when the payload cannot be read. StopFailure is
  #     itself the report, so a machine with no python3 and no jq loses only
  #     the kind and the subagent check, not the badge.
  #
  # The previous turn's reply is cleared, for the reason the error arm above
  # gives. last_assistant_message is NOT recorded in its place: on a
  # StopFailure it is Claude's error banner, not an answer.
  payload="$(cat 2>/dev/null || true)"
  kind=""
  if command -v python3 >/dev/null 2>&1; then
    kind="$(printf '%s' "$payload" | python3 -c '
import sys, json, re
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(d, dict):
    sys.exit(0)
a = d.get("agent_id")
if isinstance(a, str) and a:
    sys.stdout.write("subagent")
    sys.exit(0)
e = d.get("error")
ok = isinstance(e, str) and re.fullmatch(r"[a-z_]{1,40}", e)
sys.stdout.write("kind:" + (e if ok else ""))' 2>/dev/null || true)"
  elif command -v jq >/dev/null 2>&1; then
    # \A and \z, not ^ and $: in jq's regex engine $ also matches before a
    # trailing newline, which is the very case this check exists for.
    kind="$(printf '%s' "$payload" | jq -r 'if type == "object" then
        (if (.agent_id | type) == "string" and .agent_id != "" then "subagent"
         else "kind:" + (if (.error | type) == "string" and (.error | test("\\A[a-z_]{1,40}\\z"))
                         then .error else "" end) end)
      else "" end' 2>/dev/null || true)"
  fi
  case "$kind" in
    subagent) exit 0 ;;
    kind:*) kind="${kind#kind:}" ;;
    *) kind="" ;;
  esac
  case "$kind" in
    ''|*[!abcdefghijklmnopqrstuvwxyz_]*) kind="unknown" ;;
  esac
  [ "${#kind}" -le 40 ] || kind="unknown"
  error_reason="Claude ended the turn on an API error ($kind)"
  tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply 2>/dev/null || true
fi

# The dialog payload: the transcript path (#38) and what the dialog is about
# (#91). Read here, before the unchanged-state bail, only because stdin must be
# drained where it is read; both are WRITTEN below, with the stamp. Gated on
# either dialog flag, on `blocked` and on a non-tty stdin, so no other call
# path ever reads stdin here.
#
# ONE reader, two fields, because this runs on every dialog of every live
# Claude agent and a second process spawn would double that cost for a value
# the same document already holds. It prints exactly two lines: the transcript
# path, then the description. Neither may contain a newline, which is what
# makes splitting on the first one safe -- the reader drops a path that has one
# and strips control characters out of the description.
#
# The path is recorded only if it is absolute, and carries no tab or newline
# (it becomes one tmux option value, read back by splitting on the first
# space) and no trailing `;` (tmux's parser would eat it). Anything else
# records nothing, and a pane with no record simply keeps the pre-#38
# behaviour: nothing ever clears its 🛑 but a new event.
#
# The description is "<tool_name>: <command or path or url>", and every part of
# that is checked rather than trusted. tool_input is MODEL OUTPUT: it reaches a
# tmux option value, and `roost status` renders pane options into tab-delimited
# rows, so a tab or a newline in it would split a row exactly the way a bad
# @roost-name does (see bin/roost's reject_bad_name). So control characters go,
# the detail is cut to 120 characters, and a tool_name that is not the shape
# Claude uses records NOTHING rather than a value roost would then print as if
# it were roost's own words -- the same rule the StopFailure branch above
# applies to its one word.
#
# WHICH key is read, in this order: command (Bash), file_path (Edit, Write,
# Read, NotebookEdit), url (WebFetch). Measured payloads for all five dialog
# kinds are in tests/test-claude-permission-request.sh. An MCP tool has none of
# them -- its input is whatever that server declares -- so it records the tool
# name alone, which is still the thing a human needs to see.
transcript=""
blocked_on=""
if { [ "$notification_hook" = 1 ] || [ "$permission_request_hook" = 1 ]; } \
   && [ "$state" = "blocked" ] && [ ! -t 0 ]; then
  payload="$(cat 2>/dev/null || true)"
  fields=""
  if command -v python3 >/dev/null 2>&1; then
    fields="$(printf '%s' "$payload" | python3 -c '
import sys, json
# Spelled out rather than written as a regex range: bash 3.2 matches a range by
# the locale collation and python str.isalnum() is unicode-aware, so both of
# the short forms accept characters this must not.
NAME = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-"
try:
    d = json.load(sys.stdin)
except Exception:
    d = None
if not isinstance(d, dict):
    d = {}
p = d.get("transcript_path")
sys.stdout.write((p if isinstance(p, str) and "\n" not in p else "") + "\n")
out = ""
name = d.get("tool_name")
if isinstance(name, str) and 0 < len(name) <= 64 and all(c in NAME for c in name):
    out = name
    inp = d.get("tool_input")
    detail = ""
    if isinstance(inp, dict):
        for k in ("command", "file_path", "url"):
            v = inp.get(k)
            if isinstance(v, str) and v:
                detail = v
                break
    # Control characters out FIRST, then the cut: cutting first would spend
    # part of the 120 on bytes that are about to be removed.
    detail = "".join(c for c in detail if 31 < ord(c) != 127)[:120]
    if detail:
        out = name + ": " + detail
sys.stdout.write(out + "\n")' 2>/dev/null || true)"
  elif command -v jq >/dev/null 2>&1; then
    # \A and \z, not ^ and $: in jq's regex engine $ also matches before a
    # trailing newline, the same trap the StopFailure reader above documents.
    fields="$(printf '%s' "$payload" | jq -r 'if type == "object" then
        (if (.transcript_path | type) == "string" and ((.transcript_path | test("\n")) | not)
         then .transcript_path else "" end),
        (if (.tool_name | type) == "string" and (.tool_name | test("\\A[a-zA-Z0-9_.-]{1,64}\\z"))
         then (.tool_name) as $n
              | ([(.tool_input.command? // empty), (.tool_input.file_path? // empty),
                  (.tool_input.url? // empty)]
                 | map(select(type == "string" and . != "")) | .[0] // "")
              | gsub("[[:cntrl:]]"; "") | .[0:120]
              | if . == "" then $n else $n + ": " + . end
         else "" end)
      else "", "" end' 2>/dev/null || true)"
  fi
  transcript="${fields%%$'\n'*}"
  case "$fields" in *$'\n'*) blocked_on="${fields#*$'\n'}" ;; esac
  # The second line is the last; $( ) already dropped its trailing newline, but
  # a reader that printed a third would otherwise smuggle one through.
  blocked_on="${blocked_on%%$'\n'*}"
  case "$transcript" in
    /*) : ;;
    *) transcript="" ;;
  esac
  case "$transcript" in *$'\t'*|*$'\n'*|*';') transcript="" ;; esac
  # The shell's own second check, for the same reason the StopFailure branch
  # keeps one: $( ) strips trailing newlines and bash drops NUL bytes, so a
  # value can arrive here already cleaned, and a reader that was edited badly
  # would not be caught by the tests that feed it those bytes.
  case "$blocked_on" in *$'\t'*|*$'\n'*) blocked_on="" ;; esac
  [ "${#blocked_on}" -le 190 ] || blocked_on=""
  # A trailing `;` survives, rather than being dropped: tmux's COMMAND parser
  # eats one from any option value, and lib/roost-reply.sh already carries the
  # measured escape for exactly that (`return 0;` came back one character
  # short). A command ending in `;` is ordinary shell, so this is the common
  # case rather than an edge one. Sourced here, inside the branch, so the
  # PostToolUse hot path never pays for a file read it has no use for — the
  # same placement the Stop branch above uses and for the same reason.
  if [ -n "$blocked_on" ]; then
    . "$SELF_DIR/lib/roost-reply.sh"
    blocked_on="$(roost_reply_escape "$blocked_on")"
  fi
fi

# PostToolUse fires after EVERY tool call and Claude blocks on this script
# exiting, so the common case — state already correct — must be cheap: ONE read,
# then bail before any writes. It MUST carry `|| true`: under `set -e` a bare
# failing $(...) aborts, and a dead tmux server (agent windows are killable) has
# to degrade, never break Claude.
#
# That same read also tells us whether the pane already has a label, so the
# hot (unchanged-state) path stays a single tmux round trip even though it
# now decides two things instead of one. A plain separator between the two
# fields is not safe to add here: @roost-name is free text a human chose (see
# bin/roost's `send` comment on why an in-band separator breaks), so nothing
# printable is guaranteed absent from it. Instead we append a fixed marker
# "X" to the state, but only when @roost-name is non-empty — the same
# emptiness-ternary idiom bin/roost's `status` branch and tmux/roost.conf's
# @roost-pane-border already use for this exact check, and deliberately an
# equality test against "" rather than tmux's `#{?@roost-name,...}`
# truthiness, which treats a pane literally named "0" as unset. $state is
# always error/blocked/working/done/idle, never ending in X, so a trailing X
# can only have come from the marker and is safe to strip.
raw="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" \
  '#{@agent_state}#{?#{==:#{@roost-name},},,X}' 2>/dev/null || true)"
case "$raw" in
  *X) prev="${raw%X}"; has_name=1 ;;
  *)  prev="$raw";      has_name=0 ;;
esac
# A Stop that lands while a dialog is OPEN is handled at the WRITE, near the
# bottom of this file, and NOT here where $prev is in hand (#91, flock round
# 1). $prev was read above; the write happens dozens of lines later; and the
# two events race. Deciding here reads the pane at one instant and acts on it
# at another, which is the bug this guard exists to prevent, re-introduced
# intermittently. See the `stop_while_blocked` write below.

if [ "$state" = "$prev" ]; then
  # The one repeat that is NOT a no-op: a Notification for a NEW dialog on a
  # pane that still reads blocked (flock round 1 on #38, reproduced). The first
  # dialog was declined, so its recorded transcript ends in the decline
  # records; if the new dialog's records live in a different file, keeping the
  # old stamp and the old path lets scripts/lib/roost-unblock.sh judge the new,
  # OPEN dialog by the old file — and clear it, so `send` pastes into it.
  #
  # So the stamp moves to now, and the record either names the new file or is
  # removed. The record is written BEFORE the stamp: a reader landing between
  # the two sees a record and a stamp that disagree, and clears nothing. No
  # label and no notification here — the state did not change, and this path
  # must stay as cheap as the bail it replaces for every other repeat.
  #
  # Either dialog event reaches here, and they are not interchangeable. A
  # PermissionRequest is always about ONE dialog and always names its tool, so
  # it OWNS @roost-blocked-on and replaces it. The permission_prompt
  # Notification for that same dialog lands six seconds later carrying no tool
  # name at all, so it must leave the description alone rather than blank it —
  # which is why the write below is gated on the flag and not merely on the
  # value being empty.
  if { [ "$notification_hook" = 1 ] || [ "$permission_request_hook" = 1 ]; } \
     && [ "$state" = "blocked" ] && [ ! -t 0 ]; then
    now="$(date +%s)"
    if [ -n "$transcript" ]; then
      tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-transcript "$now $transcript" 2>/dev/null || true
    else
      tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-transcript 2>/dev/null || true
    fi
    if [ "$permission_request_hook" = 1 ]; then
      if [ -n "$blocked_on" ]; then
        tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-blocked-on "$blocked_on" 2>/dev/null || true
      else
        tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-blocked-on 2>/dev/null || true
      fi
      # A NEW dialog, so it gets a Stop of its own to swallow — see the write
      # at the bottom of this file. Without this reset a second dialog in the
      # same turn would inherit the first one's spent mark and lose its guard.
      tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-stop-swallowed 2>/dev/null || true
    fi
    tmux -S "$sock" set-option -p -t "$TMUX_PANE" @agent_since "$now" 2>/dev/null || true
  fi
  exit 0
fi

# The pane terminal's foreground job, for `roost wait-done` (#64). An agent
# typed at a shell prompt and then killed leaves its pane alive at the prompt
# with pane_dead 0 and the badge still busy, and no hook runs to say so. What
# does change is the terminal: the shell gets it back. So a busy stamp records
# WHICH JOB held the terminal, as "PGID:PANE_PID" in @roost-agent-job, and
# wait-done calls the pane died only when that job has no process left AND the
# pane's shell holds the terminal again. The design, and every measurement
# behind it, is docs/airig/specs/2026-09-15-agent-identity-design.md.
#
# Read from the TERMINAL, not from this script's parents, and that is the
# point. The process that runs a hook is not always the agent: copilot's
# extension is a forked host, and codex's adapter runs this script two levels
# below codex. But at every hook call measured — Claude, codex, opencode, pi,
# copilot, through --settings, a settings file and a PATH wrapper — the
# terminal's foreground job was the agent's job. Claude runs its hooks with no
# terminal at all, which is why this asks about the PANE's process, not our own.
#
# Only on a transition into working or blocked, never above: the
# unchanged-state bail is the PostToolUse hot path and gains nothing here.
# Measured +5 to +7 ms per busy transition. A second, identical hook firing
# (Claude runs both copies when two settings sources name it with different
# strings) writes the same value, because it reads the same terminal.
#
# Nothing is recorded, and any old record is removed, when:
#   - the foreground job IS the pane's process: an agent run as the pane's own
#     command (`roost spawn`), one started with `&`, a shell without job
#     control. A job that is the pane cannot be told from the shell, and #54
#     already sees that pane close;
#   - the foreground job is THIS process: `roost state working` typed at a
#     prompt execs straight into this script, which leads its own job and exits
#     at once. Recording it would report "died" a moment later about a pane
#     that never had an agent;
#   - tmux or ps give nothing usable (a dead server, a container that cannot
#     see the host's pane process, a ps without tpgid). Degrades to today.
# Removing, not leaving, is what keeps a record from one agent from being
# checked against a later pane process; wait-done also ignores a record whose
# PANE_PID is not the pane's current one (respawn-pane -k keeps options).
#
# Written BEFORE @agent_state, for the reply's reason: a waiter that sees the
# new busy state should find the record that goes with it.
if [ "$state" = "working" ] || [ "$state" = "blocked" ]; then
  job=""
  pane_pid="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{pane_pid}' 2>/dev/null || true)"
  case "$pane_pid" in ''|*[!0-9]*) pane_pid="" ;; esac
  if [ -n "$pane_pid" ]; then
    fg_job="$(ps -o tpgid= -p "$pane_pid" 2>/dev/null || true)"
    fg_job="${fg_job//[[:space:]]/}"
    case "$fg_job" in ''|*[!0-9]*) fg_job="" ;; esac
    # tpgid is 0 (macOS) or -1 (Linux, filtered above) for a terminal with no
    # foreground job; 1 would be init. Neither names an agent.
    if [ -n "$fg_job" ] && [ "$fg_job" -gt 1 ] \
       && [ "$fg_job" != "$pane_pid" ] && [ "$fg_job" != "$$" ]; then
      job="$fg_job:$pane_pid"
    fi
  fi
  if [ -n "$job" ]; then
    tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-agent-job "$job" 2>/dev/null || true
  else
    tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-agent-job 2>/dev/null || true
  fi
fi

# Stamp the PANE, not the window. Pane scope is what lets two agents share one
# window without overwriting each other's badge. Glyphs are NOT stamped: the
# status bar derives them from @roost-glyph-<state> at render time, so a theme
# change is live everywhere with nothing left to go stale.
# NEITHER of these needs the trailing-semicolon escape @roost-reply carries.
# tmux's command parser eats a trailing `;` from any option value, but $state
# has been normalised to one of five fixed words by the `case` above and
# @agent_since is `date +%s`, so neither can end in one. Said here because the
# obvious next move on reading roost_reply_escape is to apply it to every
# option write, and escaping a value that cannot need it only adds a way to be
# wrong later.
#
# @roost-error-reason says WHY a pane is error, and `roost wait-done` prints it.
# It is written BEFORE @agent_state for the reply's reason: wait-done reads it
# the instant it sees `error`, so stamping the state first opens a window where
# the reason is missing. It is cleared when a pane LEAVES error, so a reason
# can never be printed about a later turn it does not describe.
#
# The clear is keyed on $prev, not run on every transition. A reason is only
# ever written together with `error`, so a pane whose previous state was not
# error has none to clear — and this script is the hook every live Claude agent
# runs, so an unconditional unset was one more tmux call on every transition of
# every agent, spent clearing nothing. $prev is already in hand from the one
# read above. An error -> error write (a hand-typed `roost state error` after a
# codex dead turn) cannot reach here at all: the unchanged-state bail catches
# it, and the reason it leaves describes the turn that is still showing.
#
# ROOST_ERROR_REASON is set only by adapters/codex/roost-codex-hook, as a fixed
# sentence. The StopFailure branch above sets $error_reason itself, to a fixed
# sentence carrying one checked word. Like @agent_state neither needs the
# trailing-semicolon escape: the StopFailure sentence ends in `)`, and a caller
# who exported one ending in `;` would lose that character, not the write.
if [ "$state" = "error" ] && [ -n "$error_reason" ]; then
  tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-error-reason "$error_reason" 2>/dev/null || true
elif [ "$prev" = "error" ]; then
  tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-error-reason 2>/dev/null || true
fi
#
# @roost-transcript is "<stamp> <path>", written BEFORE the state and stamp for
# the reply's reason, and with the stamp it will carry: `now` is taken once, so
# the record and @agent_since are the same number. scripts/lib/roost-unblock.sh
# trusts a record only when its first word equals @agent_since, so a reader
# that lands between these writes sees a record and a stamp that disagree, and
# clears nothing.
#
# @roost-blocked-on says WHAT the open dialog is asking for — "<tool_name>:
# <command or path>" — and it is #91's half of #93. NOTHING DISPLAYS IT YET,
# on purpose: #93 owns the display, and a value that is recorded now is a
# value #93 can be built against without a second round of measuring. A
# reader must check @agent_state first, the way `read` checks @roost-reply
# before believing @roost-reply-turn: this is a description of a dialog, not
# a stamp, and the one place that clears 🛑 without running this script
# (scripts/lib/roost-unblock.sh, after a decline) unsets it there.
#
# Written only by the PermissionRequest hook, and cleared when the pane LEAVES
# blocked. The clear is keyed on $prev, not run on every transition, for the
# reason @roost-error-reason's is: a pane that was not blocked has nothing to
# clear, and this script runs on every PostToolUse of every live agent, so an
# unconditional unset would be one more tmux call per transition spent clearing
# nothing. $prev is already in hand from the single read above.
#
# A NOTE FOR #93, which will display this: tool_input is whatever the model
# asked for, so a Bash command that sets a secret on its own line
# (`export TOKEN=sk-...`) lands here verbatim. Recording it is no worse than
# the command already being on the pane's own screen; PUTTING IT ON A STATUS
# BAR, in a switcher, or in a notification is a different exposure, and #93
# has to decide that deliberately rather than inherit it from here.
now="$(date +%s)"
if [ "$permission_request_hook" = 1 ] && [ "$state" = "blocked" ]; then
  # EVERYTHING A DIALOG STAMPS, IN ONE TMUX COMMAND, and this is not tidiness.
  # Written as separate calls, the first version left a window between
  # @roost-blocked-on and @agent_state in which the racing Stop's own write ran
  # — its condition read a pane that was not blocked YET, so it took the branch
  # that unsets @roost-blocked-on, and the dialog's description was gone by the
  # time the badge appeared. Measured live on 2.1.278, three subagent dialogs
  # out of three: @agent_state blocked and @roost-transcript set, with
  # @roost-blocked-on missing. One command, so no other hook can land inside
  # the group at all, and the pair of orderings the separate writes had to
  # reason about stops existing.
  #
  # `;` as its own argument is tmux's command separator in argv form — the same
  # shape the @roost-reply write above uses, and the reason neither of these
  # values needs the trailing-semicolon escape twice.
  #
  # A NOTE FOR #93, which will display @roost-blocked-on: tool_input is
  # whatever the model asked for, so a Bash command that sets a secret
  # (`export TOKEN=sk-...`) lands here verbatim. Recording it is no worse than
  # the command already being on the pane's own screen; PUTTING IT ON A STATUS
  # BAR, in a switcher or in a notification is a different exposure, and #93
  # has to decide that deliberately rather than inherit it from here.
  wr=(set-option -p -t "$TMUX_PANE" @agent_state "$state"
      ';' set-option -p -t "$TMUX_PANE" @agent_since "$now")
  if [ -n "$transcript" ]; then
    wr+=(';' set-option -p -t "$TMUX_PANE" @roost-transcript "$now $transcript")
  else
    # A dialog whose path could not be recorded. An older record may still sit
    # on the pane, and if it was written in this same second its stamp would
    # match the one written here — so remove it rather than trust the clock.
    wr+=(';' set-option -pu -t "$TMUX_PANE" @roost-transcript)
  fi
  if [ -n "$blocked_on" ]; then
    wr+=(';' set-option -p -t "$TMUX_PANE" @roost-blocked-on "$blocked_on")
  else
    wr+=(';' set-option -pu -t "$TMUX_PANE" @roost-blocked-on)
  fi
  # This dialog has not swallowed a Stop yet — see the Stop write below. It
  # belongs to the DIALOG, not to the pane's state, so a second dialog resets
  # it (the repeat path above) and leaving blocked clears it (below).
  wr+=(';' set-option -pu -t "$TMUX_PANE" @roost-stop-swallowed)
  tmux -S "$sock" "${wr[@]}" 2>/dev/null || true
else
  if [ "$state" != "blocked" ] && [ "$prev" = "blocked" ] && [ "$stop_while_blocked" = 0 ]; then
    tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-blocked-on 2>/dev/null || true
    tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-stop-swallowed 2>/dev/null || true
  fi
  if [ -n "$transcript" ]; then
    tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-transcript "$now $transcript" 2>/dev/null || true
  elif [ "$notification_hook" = 1 ] && [ "$state" = "blocked" ]; then
    # The same removal as above, for a Notification on a Claude too old to have
    # fired a PermissionRequest at all.
    tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-transcript 2>/dev/null || true
  fi
  if [ "$stop_while_blocked" = 1 ]; then
    # A Stop while a dialog is OPEN (#91). ONE tmux command, and the condition is
    # evaluated by tmux in the same command as the writes, so no other hook can
    # land between the test and the act. That is the whole point: $prev was read
    # dozens of lines ago and the two events race. Measured on 2.1.278, a real
    # subagent dialog — PermissionRequest's hook ran at 1790058350.889319 and the
    # main turn's Stop 7 ms later; on the very next run of the same case the two
    # INVERTED, Stop at 1790062049.316559 and PermissionRequest at
    # 1790062049.316824. Deciding from a value read earlier gave ✅ done under an
    # open dialog in 28 of 40 runs when they started together (flock round 1).
    #
    # WHY THE MAIN TURN STOPS AT ALL: a background agent's dialog is drawn on the
    # MAIN pane while the main turn has already finished and is waiting on that
    # agent. The Stop payload carries no agent_id, so nothing in it tells the two
    # apart — only the pane's own state does.
    #
    # BOUNDED: exactly one Stop per dialog. @roost-stop-swallowed is unset when a
    # dialog is stamped and set here, so a SECOND Stop falls through to the else
    # branch and the pane moves. Without that bound a turn whose only clearing
    # event roost had not wired left the pane 🛑 for ever, with `send` refusing,
    # `wait-done` burning its timeout and `read` calling the reply stale (flock
    # round 1, both reviewers). The wired case is PostToolUseFailure — a tool
    # that fails after a Yes fires that and no PostToolUse — and it is now an
    # entry of its own; this is the belt to that braces, for whatever event is
    # next.
    #
    # The reply was already recorded above, deliberately: the turn's answer is
    # real and `roost read` should still find it. Only the STATE is held, so
    # `wait-done` keeps waiting and `send` keeps refusing while the dialog is up.
    #
    # THIS APPLIES TO CODEX TOO, and deliberately. `done --stop-hook` is what
    # adapters/codex/roost-codex-hook calls as well, and nothing in the call
    # says which harness made it — but nothing needs to: the rule is about the
    # PANE, and a codex pane reading blocked has a codex dialog open on it, so
    # a Stop that arrives there must not paint it done either. It will rarely
    # engage: codex fires Interrupt when a dialog is declined (#38), which
    # leaves idle, and an approval fires PostToolUse first. And it is bounded
    # the same way, so a codex pane cannot be stranded by it.
    #
    # The else branch carries the @roost-blocked-on and @roost-stop-swallowed
    # unsets that the $prev-keyed clear above skips for this call: they describe
    # the dialog, and whether there is still a dialog is decided here, not there.
    tmux -S "$sock" if-shell -F -t "$TMUX_PANE" \
      "#{&&:#{==:#{@agent_state},blocked},#{==:#{@roost-stop-swallowed},}}" \
      "set-option -p -t $TMUX_PANE @roost-stop-swallowed 1" \
      "set-option -p -t $TMUX_PANE @agent_state $state ; set-option -p -t $TMUX_PANE @agent_since $now ; set-option -pu -t $TMUX_PANE @roost-blocked-on ; set-option -pu -t $TMUX_PANE @roost-stop-swallowed" \
      2>/dev/null || true
  else
    tmux -S "$sock" set-option -p -t "$TMUX_PANE" @agent_state "$state" 2>/dev/null || true
    tmux -S "$sock" set-option -p -t "$TMUX_PANE" @agent_since "$now" 2>/dev/null || true
  fi
fi

# Label the pane, but only to fill a gap: a name a human chose (`split -n`,
# `spawn NAME`) always wins, so this never runs when $has_name is 1. Without
# a label a live Claude pane falls back to #{pane_current_command}, which
# reports its OWN VERSION STRING (e.g. "2.1.226") — it changes every release
# and means nothing to a reader of the border or the switcher.
#
# ROOST_AGENT_NAME lets a non-Claude harness (e.g. the opencode adapter, which
# sets it in its execFile env) name itself instead of inheriting the
# Claude-flavoured default — every opencode pane would otherwise read
# "claude" on its border and in the switcher. It is preferred over
# @roost-name-default, but a human-chosen @roost-name (has_name=1) still wins
# over both, since that branch never runs at all.
# @roost-name-default is a global option (in keeping with @roost-glyph-*,
# @roost-notify-*, etc.) so a user running something other than Claude under
# roost's hooks can rename the fallback; "claude" is the honest default since
# this script IS Claude Code's hook.
if [ "$has_name" != 1 ]; then
  # ROOST_AGENT_NAME is process env from whatever harness invoked us — just as
  # uncontrolled as @roost-name-default (a human can export anything), so it
  # gets the identical tab/newline rejection before it is trusted.
  # ANSI-C $'\t'/$'\n', NOT "$(printf '\n')": command substitution strips ALL
  # trailing newlines, so that form collapses to the empty string and the
  # newline arm would then match (and reject) every label — the same hazard
  # bin/roost's reject_bad_name comment warns about.
  label="${ROOST_AGENT_NAME:-}"
  case "$label" in *$'\t'*|*$'\n'*) label="" ;; esac
  if [ -z "$label" ]; then
    label="$(tmux -S "$sock" show-options -gqv @roost-name-default 2>/dev/null || true)"
    # @roost-name-default is user-controlled tmux state (a human can `tmux
    # set-option -g` it directly), not validated at write time the way every
    # OTHER @roost-name write site is via bin/roost's reject_bad_name — this hook
    # is a fourth write site with no gate of its own. A tab shifts `roost
    # status`'s tab-delimited switcher rows; a newline splits one pane's line
    # into two — either way a selectable row loses its session/window key
    # fields and a click runs `switch-client -t ""` silently, the exact
    # corruption reject_bad_name's own comment documents. Unlike
    # reject_bad_name (a loud exit 2, fine for an interactive command), this
    # hook runs on every PostToolUse and Claude blocks on it exiting, so a bad
    # value must degrade to the built-in default instead of breaking the hook.
    case "$label" in *$'\t'*|*$'\n'*) label="claude" ;; esac
  fi
  [ -n "$label" ] || label="claude"
  tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-name "$label" 2>/dev/null || true
fi

# Ping if an off-screen agent just became blocked (needs your input) or errored
# (will not progress without you — for opencode the usual cause is a provider
# it cannot reach, retrying forever). If the window is on screen the pane is
# visible, so no ping. `done` deliberately never notifies: it fires every turn
# and would be noise.
msg=""
case "$state" in
  blocked) msg="needs your input" ;;
  error)   msg="hit an error" ;;
esac
if [ -n "$msg" ]; then
  active="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{window_active}' 2>/dev/null || echo 0)"
  if [ "$active" != "1" ]; then
    wname="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null || echo agent)"
    # $SELF_DIR, not `dirname "$0"`: through a symlink $0 is the symlink's own
    # path and the sibling lookup would miss. The `|| true` is deliberate and
    # must stay — a dead tmux server (agent windows are killable) has to
    # degrade, never break Claude — which is exactly why the miss would be
    # invisible, and why the path has to be right before it is swallowed.
    ROOST_NOTIFY_SOCK="$sock" "$SELF_DIR/roost-notify" "roost · ${wname}" "$msg" || true
  fi
fi

# Nudge every attached client to repaint now instead of waiting for the tick.
tmux -S "$sock" refresh-client -S 2>/dev/null || true
