#!/usr/bin/env bash
# roost-agent-state — record an AI agent's state onto its tmux pane.
#
# Called by Claude Code lifecycle hooks (see `roost hooks`). It stamps the
# pane that the agent runs in with a state, which the roost status bar
# renders at a glance (glyphs are derived at render time, not stored here).
# It is a deliberate no-op unless the agent is running
# inside a `roost` server pane, so it is safe to wire into your GLOBAL Claude
# hooks — running `claude` anywhere else does nothing.
#
#   usage: roost-agent-state <working|blocked|error|done|idle> [--stop-hook]
#          roost-agent-state --subagent-hook start|stop
#
# --stop-hook additionally reads Claude Code's Stop payload from stdin and
# records that turn's reply on the pane, which is what `roost read` returns.
# With `error` instead of `done` it reads nothing and clears that reply: the
# codex adapter uses it for a turn that ended with no reply (#39).
#
# The other three flags each say "stdin is THAT event's payload", and each is a
# flag rather than an always-on read for the same reason --stop-hook is one: a
# human typing `roost state blocked` at a terminal must never wait on a stdin
# nobody closes. --notification-hook and --permission-request-hook go with
# `blocked` and record the dialog (#38, #91); --stop-failure-hook goes with
# `error` and records which kind of API error ended the turn (#55).
#
# The second form is not a state at all. --subagent-hook goes with Claude's
# SubagentStart and SubagentStop events and keeps a COUNT on the pane: how many
# subagents are running and their ids (@roost-subagents, @roost-subagent-ids).
# It reads stdin the way --stop-hook does, touches those two options and
# nothing else, and exits before any of the state logic below -- see its block.
set -euo pipefail

# Resolve this script's own directory even when invoked via a symlink — same
# readlink loop as bin/roost. This hook is wired into ~/.claude/settings.json by
# ABSOLUTE path, and that path can perfectly well be a symlink (an alias on
# PATH, a compatibility shim left behind by a rename). Through one, $0 is the
# symlink, so `dirname "$0"` names the WRONG directory and the roost-notify call
# below would miss its sibling — silently, since that call carries `|| true`
# and must keep carrying it. Resolve once here, at the top, where it costs
# nothing: this is pure shell, no tmux round trip, so the PostToolUse hot path
# (one tmux read, then bail) is unaffected.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

state="${1:-idle}"
# Only the Stop hook passes this, and only Stop carries a reply to record.
# It is a flag rather than an always-on stdin read because `roost state` is a
# documented public command: a human typing `roost state done` at a terminal
# would hang forever on a `cat` that never sees EOF.
stop_hook=0
[ "${2:-}" = "--stop-hook" ] && stop_hook=1
# Only Claude Code's Notification hook passes this, and it means "stdin is that
# hook's payload". With `blocked` it records the payload's transcript_path
# beside the stamp, which is what lets bin/roost clear a 🛑 that a declined or
# dismissed dialog left behind (#38, scripts/lib/roost-unblock.sh). A flag, not
# a stdin read on every `blocked`, for the reason --stop-hook is one: codex's
# adapter and `roost state blocked` reach this script too, and a `cat` on a
# stdin nobody closes would hang the agent.
notification_hook=0
[ "${2:-}" = "--notification-hook" ] && notification_hook=1
# Only Claude Code's StopFailure hook passes this, with `error`, and it means
# "stdin is that hook's payload" (#55). A flag for the same reason as the two
# above: `roost state error` is typed by humans and passed by codex's adapter,
# and neither must ever wait on a stdin nobody closes.
stop_failure_hook=0
[ "${2:-}" = "--stop-failure-hook" ] && stop_failure_hook=1
# Only Claude Code's PermissionRequest hook passes this, with `blocked`, and it
# means "stdin is that hook's payload" (#91). A flag for the same reason as the
# three above: `roost state blocked` is typed by humans and passed by codex's
# adapter, and neither must ever wait on a stdin nobody closes.
#
# WHY THERE IS A SECOND DIALOG HOOK AT ALL. Measured on Claude Code 2.1.278
# with a logger on all 18 hook events, an isolated HOME and a local stand-in
# for the Messages API so a real dialog opened with no account behind it:
# PermissionRequest fires 11-16 ms after the dialog is drawn, and the
# permission_prompt Notification that roost badged on until now fires a flat
# 6.00 s after PermissionRequest -- for a Bash, an Edit, a Write, a WebFetch
# and an MCP tool alike. A dialog answered inside those six seconds fires no
# Notification at all, so it was never badged, and `roost send` pasted into it.
# The Notification entry stays wired as the fallback for a Claude old enough
# not to have this event; on a Claude that has it, the repeat-blocked path
# below is all the second event does.
#
# The hook DECIDES NOTHING and prints nothing, which is measured too: a hook
# that printed `{}` and a hook that printed nothing both left the dialog open
# for the human, and neither auto-allowed nor auto-denied anything. Claude does
# not wait for it either -- with every hook sleeping 3 s the dialog was on
# screen 16 ms BEFORE this event's hook started -- so the tmux round trips
# below cost the human nothing.
permission_request_hook=0
[ "${2:-}" = "--permission-request-hook" ] && permission_request_hook=1
# Claude's Stop, and only Claude's: this call may have to be held back because
# a dialog is open on the pane (#91). Whether it IS held back is decided by
# tmux at the write, at the bottom of this file, never from a value read
# earlier — that is what this flag's whole comment there is about.
#
# `done` alone, so the codex adapter's `error --stop-hook` and
# `idle --stop-hook` (#39, #38) are untouched: those already mean "this turn
# produced nothing", and neither is a turn that ended while waiting on a
# background agent, which is the shape being guarded against.
stop_while_blocked=0
[ "$stop_hook" = 1 ] && [ "$state" = "done" ] && stop_while_blocked=1
# Claude Code's PostToolUse and PostToolUseFailure, with `working`. It means
# "stdin is that event's payload, and you may need it" — MAY, because this is
# the hook that fires on every tool call of every live agent and Claude blocks
# on it exiting. The payload is read only when it can change the answer: when
# the pane already reads 🛑. See the agent_id check below.
tool_hook=0
[ "${2:-}" = "--tool-hook" ] && tool_hook=1
# Claude Code's UserPromptSubmit, with `working`, and only it (#95). It means
# "stdin is that event's payload": the transcript path is taken from it so an
# Esc later in the turn can be read from Claude's transcript. A flag, for the
# reason every flag above is one: `roost state working` is public, and a
# script that badges itself from inside a `while read` loop, or with a stdin
# that stays open, must never have its input eaten or its badge held until
# the writer closes (both reproduced by review, flock round 1 on #95).
prompt_hook=0
[ "${2:-}" = "--prompt-hook" ] && [ "$state" = "working" ] && prompt_hook=1
# `idle --interrupted` (#95): the turn is over because a HUMAN stopped it.
# codex's adapter passes it on `Interrupt`, copilot's on an aborted
# `session.idle`, and `roost state idle --interrupted` is the public spelling.
# It stamps idle as a plain `idle` does and adds three things: it clears the
# previous turn's reply (no Stop replaced it), it records @roost-ended
# "<stamp> interrupted" in the same tmux command as the badge -- the record
# `roost wait-done` reads to exit 5 instead of 0 -- and it appends an EMPTY
# turn file with an `outcome` sidecar, so the interrupted prompt keeps its
# turn number (scripts/lib/roost-record.sh says why). Only with idle: an
# interrupt that leaves any other badge is not one roost has measured.
interrupted_hook=0
[ "${2:-}" = "--interrupted" ] && [ "$state" = "idle" ] && interrupted_hook=1

# Must be inside tmux, in a known pane.
[ -n "${TMUX:-}" ] || exit 0
[ -n "${TMUX_PANE:-}" ] || exit 0

# Only act on a roost socket. The rule itself lives in lib/roost-socket.sh
# because bin/roost needs the identical one — `roost state` (this script) and
# `roost reply` (there) are the two halves of one contract, and they used to
# answer "which server?" differently: this script from $TMUX, bin/roost from
# the -L roost default. On any other roost server the badge landed here and the
# reply silently did not. One copy, so they cannot drift apart again.
#
# Sourced at the top, unlike lib/roost-reply.sh below, because the guard is the
# very first thing every PostToolUse call needs. It costs a file read, no fork:
# roost_self_socket sets a variable rather than printing one for exactly that
# reason.
. "$SELF_DIR/lib/roost-socket.sh"
roost_self_socket
sock="$ROOST_SELF_SOCK"
[ -n "$sock" ] || exit 0

# A Claude SUBAGENT started or stopped (Phase 0 lane D of the fleet board).
# Keep the count and the ids on the pane, in @roost-subagents and
# @roost-subagent-ids, and EXIT: nothing below this block runs. Every branch
# below is state logic -- the reply, the dialog record, the unchanged-state
# bail, the stamp, the label, the ping -- and a subagent event is none of it.
# A count is not a badge. Whether background work holds a pane at `working`
# is the turn-over design's question (docs/airig/specs/2026-09-29-turn-over-
# design.md, #97, step 1 there), and it is answered there, not here: these two
# events never write @agent_state or @agent_since, and the test that pins that
# is the mutation target (tests/test-agent-state.sh). Claude only, by Q7 of
# that design: no other harness is measured, so no other adapter calls this.
#
# What the payloads carry is measured, not read from the source (M10 of that
# design, Claude Code 2.1.307): both events name the agent in `agent_id` --
# 17 lower-case hex characters every time -- and its kind in `agent_type`.
# Only those two are taken. SubagentStop also carries everything a Stop
# carries, the subagent's own last_assistant_message among it, and a
# background_tasks that still lists the stopping agent as running; all of it
# is ignored. An empty `agent_type` is Claude's prompt-suggestion fork (M4),
# not the user's work, and changes nothing; on 2.1.307 that fork was not seen
# at all in four runs, and the rule stands because a version that sends it
# again must not count it.
#
# THE UPDATE HAPPENS INSIDE TMUX, IN ONE COMMAND, and that is the one thing
# about this block that is not obvious from reading it. Three `Agent` calls in
# one assistant message fire three SubagentStart hooks 0.2 ms apart (M10, one
# run): three processes that each read the count, add one and write it back
# would all read the same value and the pane would say 1 for 3. So the count
# is never computed here. The hook hands tmux a format -- `#{e|+:...,1}` to
# add, a clamped `#{e|-:...,1}` to take away, `#{m:...}` to ask whether the id
# is listed, `#{s/.../}` to strike it from the list -- and tmux evaluates it
# against the option's value at the moment it writes, inside one `if-shell -F`
# whose test and whose set-options are one command line from one client.
# Measured on tmux 3.4 (CI's) and 3.6: 50 clients each sending one such
# increment at once left the option at 50, every run; the same 50 as a read
# in the shell and a write back lost most of them. roost's floor is tmux 3.2
# and these modifiers are not measured there. The one read this block makes
# (below) decides only the list's cap and the overflow rule, where a race
# costs an id in the list past 32 running agents, never the count.
#
# THE LIST IS CAPPED AT 32 IDS; THE COUNT IS NOT. The ids are one tmux option
# value, and a pane that somehow runs a hundred agents must not grow it
# without bound (roost_reply_encode's cap on @roost-reply is the same
# thought). So the 33rd id is counted and not listed. A stop for an id that is
# not listed then has two readings, and the count tells them apart: while the
# count is above the list's length some running agents are unlisted and the
# stop is one of theirs, so the count goes down; when the two agree every
# running agent is listed and an unlisted id was never started -- a replayed
# or foreign payload -- so nothing changes. That second case is the rule
# "a stop for an id never started changes nothing", and it is why the count
# cannot simply go down on every stop. Past the cap that rule is a limit, not
# a promise: docs/known-gaps.md ("Past 32 subagents at once the count is a
# limit, not a promise") lists the three ways the count can be wrong from the
# 33rd running agent on, and tests/test-agent-state.sh pins each one.
#
# THE ID IS CHECKED BEFORE IT IS A FORMAT OR AN OPTION VALUE. It is spliced
# into `#{m:* ID *,...}` and `#{s/ ID / /:...}` and appended to a
# space-separated list, so a space would be two ids, a `,` would end the
# modifier's argument, a `;` would end the tmux command, a `/` the
# substitution. The reader accepts 1-64 of [a-z0-9] and prints nothing
# otherwise; the shell checks the same set again, because `$( )` strips a
# trailing newline and bash drops NUL bytes, so a value can arrive here
# already cleaned (the StopFailure branch below has the same second check
# and says why). The letters are spelled out rather than written a-z: bash
# 3.2 matches a range by the locale's collation, where a-z can include
# capitals. Nothing else from the payload is ever written anywhere.
#
# Fails soft, like every other write in this file: a dead server, a tmux
# without these modifiers, a machine with neither python3 nor jq each leave
# the count where it was and exit 0, and `roost status --json` reports
# `subagents` as null for a pane that has never been counted.
if [ "${1:-}" = "--subagent-hook" ]; then
  op="${2:-}"
  case "$op" in start|stop) ;; *) exit 0 ;; esac
  # A tty means a human typed the flag; `cat` would wait for ^D. Skip.
  [ ! -t 0 ] || exit 0
  payload="$(cat 2>/dev/null || true)"
  sid=""
  if command -v python3 >/dev/null 2>&1; then
    sid="$(printf '%s' "$payload" | python3 -c '
import sys, json
OK = "abcdefghijklmnopqrstuvwxyz0123456789"
try:
    d = json.load(sys.stdin)
except Exception:
    d = None
if not isinstance(d, dict):
    sys.exit(0)
t = d.get("agent_type")
a = d.get("agent_id")
if isinstance(t, str) and t and isinstance(a, str) and 0 < len(a) <= 64 and all(c in OK for c in a):
    sys.stdout.write(a)' 2>/dev/null || true)"
  elif command -v jq >/dev/null 2>&1; then
    # \A and \z, not ^ and $: in jq's regex engine $ also matches before a
    # trailing newline, the same trap the StopFailure reader below documents.
    sid="$(printf '%s' "$payload" | jq -r 'if type == "object"
        and (.agent_type | type) == "string" and .agent_type != ""
        and (.agent_id | type) == "string" and (.agent_id | test("\\A[a-z0-9]{1,64}\\z"))
      then .agent_id else "" end' 2>/dev/null || true)"
  fi
  case "$sid" in ''|*[!abcdefghijklmnopqrstuvwxyz0123456789]*) exit 0 ;; esac
  [ "${#sid}" -le 64 ] || exit 0
  # One read, for the two decisions tmux cannot make in a format: how many ids
  # are listed (the cap), and whether the count is above that (the overflow
  # rule for a stop). Unset options read as empty, so a pane that has never
  # seen a subagent reads " " here: count "" and no ids.
  cur="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" \
    '#{@roost-subagents} #{@roost-subagent-ids}' 2>/dev/null || true)"
  count="${cur%% *}"
  case "$count" in ''|*[!0123456789]*) count=0 ;; esac
  set -- ${cur#* }
  n=$#
  inc='#{e|+:#{@roost-subagents},1}'
  dec='#{?#{e|<:#{@roost-subagents},1},0,#{e|-:#{@roost-subagents},1}}'
  # The list wrapped in spaces, so the first and the last id match like any
  # other; the strike leaves a space at either end, which the two outer
  # substitutions take back off.
  listed="#{m:* $sid *, #{@roost-subagent-ids} }"
  add="#{?#{==:#{@roost-subagent-ids},},$sid,#{@roost-subagent-ids} $sid}"
  strike="#{s/^ //:#{s/ \$//:#{s/ $sid / /: #{@roost-subagent-ids} }}}"
  if [ "$op" = start ]; then
    # Only an id that is not already listed counts: a repeated start for one
    # agent is one agent. `#{?X,,1}` is "not X" -- true when X is empty.
    if [ "$n" -lt 32 ]; then
      tmux -S "$sock" if-shell -F -t "$TMUX_PANE" "#{?$listed,,1}" \
        "set-option -p -t $TMUX_PANE -F @roost-subagents '$inc' ; set-option -p -t $TMUX_PANE -F @roost-subagent-ids '$add'" \
        2>/dev/null || true
    else
      tmux -S "$sock" if-shell -F -t "$TMUX_PANE" "#{?$listed,,1}" \
        "set-option -p -t $TMUX_PANE -F @roost-subagents '$inc'" \
        2>/dev/null || true
    fi
  else
    # Above the list's length, every stop is a running agent's (listed or
    # not): count down, and strike the id if it is there. At or below it, only
    # a listed id was started. The strike is a no-op for an id not listed.
    if [ "$count" -gt "$n" ]; then
      tmux -S "$sock" if-shell -F -t "$TMUX_PANE" "1" \
        "set-option -p -t $TMUX_PANE -F @roost-subagents '$dec' ; set-option -p -t $TMUX_PANE -F @roost-subagent-ids '$strike'" \
        2>/dev/null || true
    else
      tmux -S "$sock" if-shell -F -t "$TMUX_PANE" "$listed" \
        "set-option -p -t $TMUX_PANE -F @roost-subagents '$dec' ; set-option -p -t $TMUX_PANE -F @roost-subagent-ids '$strike'" \
        2>/dev/null || true
    fi
  fi
  exit 0
fi

# Normalise: anything unrecognised is idle.
case "$state" in blocked|working|done|error) ;; *) state="idle" ;; esac

# Why a pane is error, for `roost wait-done` and `read`. Only an adapter sets
# it — see the write below — and the StopFailure branch further down replaces
# it with a sentence of its own.
error_reason="${ROOST_ERROR_REASON:-}"

# Whether a Claude Stop is holding the pane at `working` for background work
# that still runs in it (#97). Decided inside the Stop branch below from the
# payload; read again at the stamp at the bottom, where a held Stop that did
# not bail writes @roost-background beside the badge.
held=0 bg_count="" bg_types=""

# Record the turn's reply, for `roost read`.
#
# This sits ABOVE the unchanged-state early bail below, and that placement is
# load-bearing twice over:
#
#  1. A Stop arriving when the pane already reads `done` — a turn with no
#     UserPromptSubmit, a re-entrant stop — would otherwise bail out before
#     recording anything, and `roost read` would silently serve the PREVIOUS
#     turn's reply.
#  2. The reply must be stamped BEFORE @agent_state, which happens further
#     down. `roost wait-done` returns the instant the state stops being
#     working/blocked, and the documented idiom is `wait-done` then `read`, so
#     stamping the state first opens a window where read lands between the two
#     and falls back to the screen. That would reintroduce the original bug
#     intermittently, which is harder to diagnose than reintroducing it
#     consistently.
#
# Gated on --stop-hook AND done, so PostToolUse — which fires on every tool
# call, and which Claude blocks on — never reaches any of this and keeps its
# one-read-then-bail cost.
if [ "$stop_hook" = 1 ] && [ "$state" = "done" ]; then
  # A tty here means a human typed the flag by hand; `cat` would wait for them
  # to press ^D. Skip rather than hang.
  if [ ! -t 0 ]; then
    payload="$(cat 2>/dev/null || true)"
    # last_assistant_message is a JSON string: it WILL contain \n, and it can
    # contain \", \\ and \uXXXX. Unescaping that in pure bash is a meaningful
    # amount of shell whose failure mode is a subtly corrupted reply — wrong,
    # plausible, and silent, which is the worst shape a bug takes here. A
    # process spawn once per turn is the cheaper side of that trade: by this
    # repo's own measurements a spawn is ~0.57 of a tmux round trip, and this
    # script already makes several.
    #
    # But neither reader may be REQUIRED. scripts/roost-doctor records the
    # standing decision that python3 is not a runtime dependency, so a machine
    # with neither python3 nor jq records nothing and `roost read` falls back
    # to the screen — the path that already exists and already announces
    # itself. The feature degrades; it never breaks the agent.
    #
    # THE SAME READ ALSO DECIDES WHETHER THIS TURN IS OVER (#97, step 1 of
    # docs/airig/specs/2026-09-29-turn-over-design.md). Claude's Stop lists the
    # work it still has running in `background_tasks` -- a `run_in_background`
    # Bash, a background Agent, a Monitor -- and Claude starts a turn of its
    # own when that work ends, whose Stop carries an empty list (measured on
    # 2.1.283 and again on 2.1.310: docs/known-gaps.md, "When a Claude turn
    # is over"). Before this, the first Stop painted ✅ done while the work
    # ran for 30 s, and `wait-done` exited 0 into files that were still
    # changing. So the reader prints ONE verdict line before the reply:
    #
    #   absent   no `background_tasks` key, or a payload no reader could
    #            parse: today's done, kept on purpose for an older Claude
    #            (the design's Q5, listed in docs/known-gaps.md as one of the
    #            places "could not tell" is reported as done)
    #   none     a list with no `running` item: this turn is over
    #   hold N [TYPES]  N items whose `status` is `running`. The pane is held
    #            at `working`. TYPES lists, comma-joined, every running item's
    #            type that is not `shell` or `subagent` -- the two kinds
    #            measured to live in this pane's process tree (A1, M8) --
    #            because a kind roost has not measured is not assumed to live
    #            elsewhere (§3.1): it holds too, and `roost doctor` names it
    #   bad      the key is there but is not a list, or an item is not an
    #            object or has no string `status`: a shape roost has not seen,
    #            so "could not tell", and the pane is held with a count of `?`
    #            (the Q5 limits: the exception is for an ABSENT key only)
    #
    # `type` is only ever written back as a word of [A-Za-z0-9_.-], at most
    # 64 of them, or as `?`: it is model-facing text that ends up in a tmux
    # option, and the shell below checks it again (the StopFailure branch
    # says why a second check is kept). A `session_crons` entry is NOT a
    # hold: a scheduled wake-up is owned here but is not running now (§3.1,
    # case 4; measured: `background_tasks` stays `[]` beside it).
    reply="" fields="" bg_verdict=""
    if command -v python3 >/dev/null 2>&1; then
      fields="$(printf '%s' "$payload" | python3 -c '
import sys, json
OK = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-"
try:
    d = json.load(sys.stdin)
except Exception:
    d = None
verdict, reply = "absent", ""
if isinstance(d, dict):
    reply = d.get("last_assistant_message") or ""
    if not isinstance(reply, str):
        reply = ""
    if "background_tasks" in d:
        b = d["background_tasks"]
        if not isinstance(b, list) or any(not isinstance(i, dict) or not isinstance(i.get("status"), str) for i in b):
            verdict = "bad"
        else:
            run = [i for i in b if i["status"] == "running"]
            if not run:
                verdict = "none"
            else:
                kinds = []
                for i in run:
                    t = i.get("type")
                    if t in ("shell", "subagent"):
                        continue
                    if not (isinstance(t, str) and 0 < len(t) <= 64 and all(c in OK for c in t)):
                        t = "?"
                    if t not in kinds:
                        kinds.append(t)
                verdict = "hold %d %s" % (len(run), ",".join(kinds))
sys.stdout.write(verdict + "\n" + reply)' 2>/dev/null || true)"
    elif command -v jq >/dev/null 2>&1; then
      # \A and \z, not ^ and $: in jq, $ also matches before a trailing
      # newline (the StopFailure reader below documents the trap).
      fields="$(printf '%s' "$payload" | jq -r '
        (if type != "object" or (has("background_tasks") | not) then "absent"
         elif (.background_tasks | type) != "array"
              or (.background_tasks | any(.[]; type != "object" or (.status | type) != "string")) then "bad"
         else ([.background_tasks[] | select(.status == "running")]) as $r
           | if ($r | length) == 0 then "none"
             else "hold \($r | length) " + ([$r[] | .type
                    | if . == "shell" or . == "subagent" then empty
                      elif type == "string" and test("\\A[A-Za-z0-9_.-]{1,64}\\z") then .
                      else "?" end] | unique | join(","))
             end
         end),
        (if type == "object" and (.last_assistant_message | type) == "string" then .last_assistant_message else "" end)' \
        2>/dev/null || true)"
    fi
    bg_verdict="${fields%%$'\n'*}"
    case "$fields" in *$'\n'*) reply="${fields#*$'\n'}" ;; *) reply="" ;; esac
    bg_count="" bg_types=""
    case "$bg_verdict" in
      "hold "*)
        read -r _w bg_count bg_types _ <<EOF || true
$bg_verdict
EOF
        case "$bg_count" in ''|*[!0123456789]*) bg_count="?" ;; esac
        [ "${#bg_count}" -le 9 ] || bg_count="?"
        case "$bg_types" in *[!A-Za-z0-9_.,?-]*) bg_types="?" ;; esac
        [ "${#bg_types}" -le 200 ] || bg_types="?"
        held=1 ;;
      bad) bg_count="?"; held=1 ;;
      *) held=0 ;;
    esac
    # A held turn is reported as `working`, not `done`: the agent's answer is
    # ready, and the turn is not over (§3, "coordinators ask two different
    # questions"). The Stop that releases the pane is the one whose list is
    # empty, and it writes the turn file; this one writes the main reply on
    # the pane and nothing on disk. That is the deferral the design's §10
    # item 2 asks for in place of §5.4's rewrite: records stay append-only,
    # "turn N = the Nth prompt" holds with no renumbering, and
    # `wait-done --turn N` simply waits for the release. The cost: the main
    # reply is not kept once the final reply replaces it.
    #
    # @roost-background is "<@agent_since> N" and is written HERE, in the
    # same tmux command as the reply and ABOVE the unchanged-state bail --
    # the pane already reads `working` from UserPromptSubmit, so the bail is
    # exactly where a held Stop leaves this script (§10 item 1: the same bail
    # already ate @roost-error-reason once). tmux fills in #{@agent_since} at
    # the write, so the record carries the stamp the pane holds at that
    # instant and a reader that finds the two disagreeing ignores it. A held
    # Stop that reaches the stamp below (the pane was not working) writes the
    # record again there, with the new stamp, in the same command as the
    # badge. @roost-background-types is written the same way, only when a
    # running item's type is not one of the two measured kinds.
    # A RELEASE WITH NO REPLY OF ITS OWN (flock round 1 on #95/#97,
    # reproduced). The held Stop above put the turn's main reply on the pane
    # and nothing on disk, on the promise that the release records the turn.
    # A release whose last_assistant_message is empty or absent -- a turn that
    # ended on a tool call, or a payload no reader could parse -- would take
    # the "produced nothing" arm below: unset the reply, append nothing. The
    # agent's answer was then gone from the pane AND from disk, and the
    # prompt lost its number, so the NEXT prompt's reply became turn N and
    # `wait-done --turn N` / `read --turn N` answered for the wrong prompt.
    #
    # So when this Stop is not itself held, has no reply, and the pane's hold
    # record agrees with its stamp (the @roost-transcript rule: a record from
    # another stamp says nothing about this turn), the held main reply is
    # taken back off the pane and recorded as this prompt's ONE turn file;
    # and with no held reply either, an EMPTY turn file keeps the numbering.
    # The pane value is what tmux stored, so a main reply longer than the
    # 12 KB cap is recorded with its truncation marker: docs/known-gaps.md.
    # One tmux read, only on a Stop with no reply, never on the hot path.
    release_empty=0
    if [ "$held" = 0 ] && [ -z "$reply" ]; then
      rel="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{@agent_since}|#{@roost-background}' 2>/dev/null || true)"
      rel_since="${rel%%|*}"; rel_bg="${rel#*|}"
      case "$rel_since" in ''|*[!0123456789]*) rel_since="" ;; esac
      if [ -n "$rel_since" ] && [ "${rel_bg%% *}" = "$rel_since" ] && [ "$rel_bg" != "$rel_since" ]; then
        reply="$(tmux -S "$sock" show-options -pqv -t "$TMUX_PANE" @roost-reply 2>/dev/null || true)"
        [ -n "$reply" ] || release_empty=1
      fi
    fi
    if [ "$held" = 1 ]; then
      state="working"
      bg_wr=(set-option -p -t "$TMUX_PANE" -F @roost-background "#{@agent_since} $bg_count")
      if [ -n "$bg_types" ]; then
        bg_wr+=(';' set-option -p -t "$TMUX_PANE" -F @roost-background-types "#{@agent_since} $bg_types")
      else
        bg_wr+=(';' set-option -pu -t "$TMUX_PANE" @roost-background-types)
      fi
      # The pointer names a turn file; a main reply has none yet, and a
      # pointer left from the previous turn must not pair with this reply
      # (roost_record_match would refuse it anyway, since the sidecar holds
      # the old text, but an unset is cheaper than a mismatch on every read).
      if [ -n "$reply" ]; then
        . "$SELF_DIR/lib/roost-reply.sh"
        tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-reply "$(roost_reply_encode "$reply")" \; \
          set-option -pu -t "$TMUX_PANE" @roost-reply-turn \; "${bg_wr[@]}" 2>/dev/null || true
      else
        tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply \; \
          set-option -pu -t "$TMUX_PANE" @roost-reply-turn \; "${bg_wr[@]}" 2>/dev/null || true
      fi
    elif [ -n "$reply" ]; then
      # Sourced here, inside the branch, rather than at the top of the file:
      # PostToolUse never gets this far, so the hot path does not pay for a
      # file read it has no use for.
      . "$SELF_DIR/lib/roost-reply.sh"
      # The durable copy (#42), written BEFORE the pane option for the same
      # reason the reply is written before @agent_state: a reader that sees the
      # pointer below must find its file. docs/airig/specs/2026-09-16-pane-record-design.md
      # has the layout and the measurements; scripts/lib/roost-record.sh has the
      # rules. Every step fails soft: no record means the pane option below is
      # written exactly as it always was, and `read` serves it as it always did.
      #
      # The boot key costs one tmux read, so it is taken only when records are
      # on — ROOST_RECORD_DIR set to "" (the test suite's default) costs nothing.
      . "$SELF_DIR/lib/roost-record.sh"
      turn=""
      roost_record_root
      if [ -n "$ROOST_RECORD_ROOT" ]; then
        boot="$(tmux -S "$sock" display-message -p '#{start_time}-#{pid}' 2>/dev/null || true)"
        if roost_record_pane_dir "$boot" "$TMUX_PANE" \
           && roost_record_append "$ROOST_RECORD_PANE_DIR" "$sock" "$reply"; then
          turn="$ROOST_RECORD_TURN"
        fi
      fi
      # @roost-reply-turn names the file that holds THIS reply. It is set in the
      # same tmux command as @roost-reply, so no reader sees one without the
      # other. When nothing was recorded it is left as it is: `read` uses it only
      # while @roost-reply is set, and serves the file only when the file agrees
      # with @roost-reply, so a pointer left from an earlier turn cannot change
      # what is printed (and an unset here could not be caught by any test).
      #
      # The pointer is a few dozen bytes; roost_reply_encode's cap leaves ~4 KB
      # of headroom under tmux's command-length limit for exactly this.
      #
      # The same command then reads @roost-reply back, and that text — what tmux
      # STORED, which on tmux 3.4 and 3.5a is not always what it was sent — is
      # kept beside the turn as NNNNNN.pane. `read` serves the turn file only
      # while the pane still holds exactly that (roost_record_match, which says
      # why the value cannot be compared with the file itself). One command, so
      # no other writer's set-option can land between the write and the read.
      # If set-option fails, tmux runs nothing after it, the read-back is empty
      # and no sidecar is written: `read` then prints the pane value, as before.
      #
      # A tmux client that is not UTF-8 (no UTF-8 locale, no -u, no $TMUX)
      # PRINTS newline, tab, non-ASCII and control bytes as `_` — on output, not
      # in storage (measured on tmux 3.3a and 3.4). This hook only runs with
      # $TMUX set, which makes its client UTF-8, so the read-back is the stored
      # value itself; `read` compares through `tmux -u` to see the same thing.
      #
      # The release of a held pane (#97) clears @roost-background and its
      # types in this same command: a reader that sees the final reply must
      # not also see a hold record that says the main reply is still the
      # answer. An absent key clears too -- an older Claude never set one,
      # and the unset of an option that is not set is not an error.
      if [ -n "$turn" ]; then
        stored="$(tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-reply \
          "$(roost_reply_encode "$reply")" \; \
          set-option -p -t "$TMUX_PANE" @roost-reply-turn "$turn" \; \
          set-option -pu -t "$TMUX_PANE" @roost-background \; \
          set-option -pu -t "$TMUX_PANE" @roost-background-types \; \
          show-options -pqv -t "$TMUX_PANE" @roost-reply 2>/dev/null || true)"
        roost_record_put_pane "$ROOST_RECORD_PANE_DIR" "$turn" "$stored" || true
      else
        tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-reply \
          "$(roost_reply_encode "$reply")" \; \
          set-option -pu -t "$TMUX_PANE" @roost-background \; \
          set-option -pu -t "$TMUX_PANE" @roost-background-types 2>/dev/null || true
      fi
    elif [ "$release_empty" = 1 ]; then
      # A held turn released with no reply anywhere (above): ONE empty turn
      # file, so the prompt keeps its number, the pointer at it, the reply and
      # the hold record cleared, in one command. Records off: the clears only.
      . "$SELF_DIR/lib/roost-record.sh"
      turn=""
      roost_record_root
      if [ -n "$ROOST_RECORD_ROOT" ]; then
        boot="$(tmux -S "$sock" display-message -p '#{start_time}-#{pid}' 2>/dev/null || true)"
        if roost_record_pane_dir "$boot" "$TMUX_PANE" \
           && roost_record_append "$ROOST_RECORD_PANE_DIR" "$sock" ""; then
          turn="$ROOST_RECORD_TURN"
        fi
      fi
      if [ -n "$turn" ]; then
        tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply \; \
          set-option -p -t "$TMUX_PANE" @roost-reply-turn "$turn" \; \
          set-option -pu -t "$TMUX_PANE" @roost-background \; \
          set-option -pu -t "$TMUX_PANE" @roost-background-types 2>/dev/null || true
      else
        tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply \; \
          set-option -pu -t "$TMUX_PANE" @roost-background \; \
          set-option -pu -t "$TMUX_PANE" @roost-background-types 2>/dev/null || true
      fi
    else
      # This turn ENDED and produced nothing to record. Clearing is not
      # tidiness, it is the whole point: the staleness notice in bin/roost's
      # `read` is keyed on @agent_state being working/blocked, and the state
      # this script writes below is `done`. A reply left in place here is
      # therefore served as THIS turn's answer, on a pane that reads finished,
      # with an empty stderr and no signal of any kind to the caller. Measured
      # before the fix: turn 1 answers "TURN ONE REPLY", turn 2 records
      # nothing, `roost read` prints "TURN ONE REPLY" and exits 0 quietly.
      #
      # Unsetting hands `read` its screen fallback instead, and that fallback
      # already announces itself on stderr. A caller then sees the pane's
      # screen and a notice, which is worse content and a far better failure:
      # wrong-and-loud beats wrong-and-silent, and this is the exact failure
      # the reply channel was built to remove.
      #
      # Three real routes reach here, and the comment above only describes the
      # third: `last_assistant_message` present but empty (a turn that ended on
      # a tool call), the field absent (an interrupted turn), and a payload
      # neither reader could parse — which includes the machine with no working
      # python3 and no jq. That machine degrades to the announcing fallback
      # only from this line; before it, the fallback was reachable on the very
      # first turn and never again.
      #
      # Guarded by the same `--stop-hook`, `done` and `[ ! -t 0 ]` conditions
      # as the write above, so a human typing `roost state done` by hand, or
      # any PostToolUse call, can never wipe a recorded reply on the way past.
      # The hold record goes with it: this is a releasing Stop (#97).
      tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply \; \
        set-option -pu -t "$TMUX_PANE" @roost-background \; \
        set-option -pu -t "$TMUX_PANE" @roost-background-types 2>/dev/null || true
    fi
  fi
elif [ "$stop_hook" = 1 ] && [ "$state" = "error" ] && [ ! -t 0 ]; then
  # A turn that ended as an ERROR has no answer to record, and whatever reply
  # is stored is the previous turn's. Cleared for the same reason the empty
  # `done` branch above clears it, and above the unchanged-state bail for the
  # same reason as that one: a second dead turn in a row must not leave turn
  # N-1's answer behind either. The stdin is not read — nothing in an error
  # turn's payload is published — so there is no `cat` to hang on, but the tty
  # guard stays so a human typing the flag by hand can never wipe a reply.
  #
  # Only adapters/codex/roost-codex-hook passes `error --stop-hook` today: codex
  # has no error event, so its adapter decides from the Stop payload (#39).
  tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply 2>/dev/null || true
elif { [ "$stop_hook" = 1 ] || [ "$interrupted_hook" = 1 ]; } && [ "$state" = "idle" ] && [ ! -t 0 ]; then
  # A turn that ended because the human INTERRUPTED it — declined a dialog,
  # pressed Esc — has no answer either, and no Stop fires to replace the stored
  # one, so it is the previous turn's. Cleared for the same reasons as the error
  # arm above. adapters/codex/roost-codex-hook passed `idle --stop-hook` on
  # codex's Interrupt event (#38) and passes `idle --interrupted` since #95;
  # the older spelling is kept for an adapter that still uses it.
  #
  # With --interrupted the outcome is written here too, ABOVE the bail and in
  # the same command, as `#{@agent_since} interrupted`: a second interrupt on
  # a pane that already reads idle bails out below and must still leave the
  # record agreeing with the stamp the pane holds. The stamp below writes it
  # again with the new second when the badge moves.
  if [ "$interrupted_hook" = 1 ]; then
    tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply \; \
      set-option -p -t "$TMUX_PANE" -F @roost-ended '#{@agent_since} interrupted' 2>/dev/null || true
  else
    tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply 2>/dev/null || true
  fi
elif [ "$stop_failure_hook" = 1 ] && [ "$state" = "error" ] && [ ! -t 0 ]; then
  # Claude Code's StopFailure: the turn ended on an API error — a rate limit,
  # an overload, a model that does not exist (#55). Claude fires it INSTEAD of
  # Stop and nothing follows it, so before this hook was wired the pane kept
  # UserPromptSubmit's `working` forever while Claude sat idle under an error
  # banner. Measured on 2.1.272 with a logger on all 33 events: seven failures
  # triggered on demand each fired exactly one StopFailure, and pressing Esc
  # while the model was streaming fired none.
  #
  # Unlike codex's 💥 this is a REPORT, not an inference: Claude says the turn
  # failed, and says what kind. The payload's `error` is one word out of a
  # fixed list in Claude's source (rate_limit, overloaded, server_error,
  # model_not_found, ... unknown), and it is the only thing taken from it.
  #
  # Three rules, each for a reason:
  #
  #  1. A payload that names an `agent_id` belongs to a SUBAGENT's loop.
  #     Claude's source adds that field only there, and a subagent's API error
  #     comes back to the main turn as a failed tool call — the main turn goes
  #     on. So this call changes nothing at all, not even the reply, and
  #     exits. Read from the source; not measured live.
  #  2. The kind goes into @roost-error-reason only if it is lowercase letters
  #     and underscores, 40 at most. Anything else, or a payload no reader can
  #     parse, is "unknown". The reason is printed by `wait-done` and `read`,
  #     and text copied out of a payload is not something roost prints as its
  #     own words. The READER checks the whole string first, because the shell
  #     cannot: `$(...)` strips trailing newlines and bash drops NUL bytes, so
  #     "rate_limit\n" and "x<NUL>y" would reach the case below already
  #     cleaned into "rate_limit" and "xy" (found by review, reproduced). The
  #     case below stays as a second check. Its letters are spelled out rather
  #     than written a-z: bash 3.2 matches a range by the locale's collation,
  #     where a-z can include capitals.
  #  3. It still badges error when the payload cannot be read. StopFailure is
  #     itself the report, so a machine with no python3 and no jq loses only
  #     the kind and the subagent check, not the badge.
  #
  # The previous turn's reply is cleared, for the reason the error arm above
  # gives. last_assistant_message is NOT recorded in its place: on a
  # StopFailure it is Claude's error banner, not an answer.
  payload="$(cat 2>/dev/null || true)"
  kind=""
  if command -v python3 >/dev/null 2>&1; then
    kind="$(printf '%s' "$payload" | python3 -c '
import sys, json, re
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(d, dict):
    sys.exit(0)
a = d.get("agent_id")
if isinstance(a, str) and a:
    sys.stdout.write("subagent")
    sys.exit(0)
e = d.get("error")
ok = isinstance(e, str) and re.fullmatch(r"[a-z_]{1,40}", e)
sys.stdout.write("kind:" + (e if ok else ""))' 2>/dev/null || true)"
  elif command -v jq >/dev/null 2>&1; then
    # \A and \z, not ^ and $: in jq's regex engine $ also matches before a
    # trailing newline, which is the very case this check exists for.
    kind="$(printf '%s' "$payload" | jq -r 'if type == "object" then
        (if (.agent_id | type) == "string" and .agent_id != "" then "subagent"
         else "kind:" + (if (.error | type) == "string" and (.error | test("\\A[a-z_]{1,40}\\z"))
                         then .error else "" end) end)
      else "" end' 2>/dev/null || true)"
  fi
  case "$kind" in
    subagent) exit 0 ;;
    kind:*) kind="${kind#kind:}" ;;
    *) kind="" ;;
  esac
  case "$kind" in
    ''|*[!abcdefghijklmnopqrstuvwxyz_]*) kind="unknown" ;;
  esac
  [ "${#kind}" -le 40 ] || kind="unknown"
  error_reason="Claude ended the turn on an API error ($kind)"
  tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-reply 2>/dev/null || true
fi

# The dialog payload: the transcript path (#38) and what the dialog is about
# (#91). Read here, before the unchanged-state bail, only because stdin must be
# drained where it is read; both are WRITTEN below, with the stamp. Gated on
# either dialog flag, on `blocked` and on a non-tty stdin, so no other call
# path ever reads stdin here.
#
# ONE reader, two fields, because this runs on every dialog of every live
# Claude agent and a second process spawn would double that cost for a value
# the same document already holds. It prints exactly two lines: the transcript
# path, then the description. Neither may contain a newline, which is what
# makes splitting on the first one safe -- the reader drops a path that has one
# and strips control characters out of the description.
#
# The path is recorded only if it is absolute, and carries no tab or newline
# (it becomes one tmux option value, read back by splitting on the first
# space) and no trailing `;` (tmux's parser would eat it). Anything else
# records nothing, and a pane with no record simply keeps the pre-#38
# behaviour: nothing ever clears its 🛑 but a new event.
#
# The description is "<tool_name>: <command or path or url>", and every part of
# that is checked rather than trusted. tool_input is MODEL OUTPUT: it reaches a
# tmux option value, and `roost status` renders pane options into tab-delimited
# rows, so a tab or a newline in it would split a row exactly the way a bad
# @roost-name does (see bin/roost's reject_bad_name). So control characters go,
# the detail is cut to 120 characters, and a tool_name that is not the shape
# Claude uses records NOTHING rather than a value roost would then print as if
# it were roost's own words -- the same rule the StopFailure branch above
# applies to its one word.
#
# WHICH key is read, in this order: command (Bash), file_path (Edit, Write,
# Read, NotebookEdit), url (WebFetch). Measured payloads for all five dialog
# kinds are in tests/test-claude-permission-request.sh. An MCP tool has none of
# them -- its input is whatever that server declares -- so it records the tool
# name alone, which is still the thing a human needs to see. A question
# (AskUserQuestion) records its FIRST question's text, which the same payload
# carries (#142, F3 of the answer design): the tool name alone told a reader
# nothing about what was being asked.
#
# THE SAME READER ALSO DESCRIBES THE DIALOG FOR `roost answer` (#142), in a
# third line: "<kind> <options> <digest> <token>". The design, and the
# measurements every rule here rests on, is
# docs/airig/specs/2026-09-30-roost-answer-design.md §4; the words are checked
# again in the shell below and written, with the stamp, as @roost-dialog.
#
#   kind     `question` only for ONE question, multiSelect false, two to four
#            options and no option with a preview (M2); `permission` only for a
#            tool whose dialog was measured -- Bash and Write on Claude (M1),
#            Edit on Claude (2.1.309, once each: the same marker lines, `1`
#            approved with no Enter and Escape declined, as for Write), the
#            command approval on codex (M3). Everything else is `other`,
#            and `roost answer` sends nothing to an `other`: a multi-select,
#            two questions, a tool not yet measured, a SUBAGENT's dialog (it
#            names an agent_id; not measured), a payload no reader could parse
#   options  how many options the MODEL gave, for a question; 0 otherwise.
#            Claude adds "Type something." and "Chat about this" by itself, and
#            those rows are not the model's, so they are not counted
#   digest   eight hex characters of (tool name, tool input). Not an identity:
#            M4 measured two dialogs equal in every field but the transcript's
#            tool-use id, 0.2 s apart. It only tells "the same hook ran twice
#            for one dialog" (Claude runs a hook once per settings source that
#            names it) from "a different dialog" -- see roost_stamp_blocked
#   token    twelve hex characters, new for each dialog. THIS is the
#            fingerprint `roost answer --expect` names. It is a token and not a
#            hash because no field in either harness's PermissionRequest tells
#            two such dialogs apart (M4); it comes from the reader that already
#            runs here, so it costs no new process. It does not have to be
#            secret, only new
#
# Which harness this is comes from ROOST_DIALOG_HARNESS, which only
# adapters/codex/roost-codex-hook sets (to `codex`). Unset means Claude, because
# this script IS Claude Code's hook. Any other value records no dialog at all.
#
# Nothing from the payload reaches @roost-dialog as text: every word is a fixed
# word, a digit or hex the reader computed.
transcript=""
blocked_on=""
dialog=""
dialog_harness="${ROOST_DIALOG_HARNESS:-claude}"
case "$dialog_harness" in claude|codex) ;; *) dialog_harness="" ;; esac
if { [ "$notification_hook" = 1 ] || [ "$permission_request_hook" = 1 ]; } \
   && [ "$state" = "blocked" ] && [ ! -t 0 ]; then
  payload="$(cat 2>/dev/null || true)"
  fields=""
  if command -v python3 >/dev/null 2>&1; then
    fields="$(printf '%s' "$payload" | python3 -c '
import sys, json, os, zlib
# Spelled out rather than written as a regex range: bash 3.2 matches a range by
# the locale collation and python str.isalnum() is unicode-aware, so both of
# the short forms accept characters this must not.
NAME = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-"
harness = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    d = json.load(sys.stdin)
except Exception:
    d = None
if not isinstance(d, dict):
    d = {}
p = d.get("transcript_path")
sys.stdout.write((p if isinstance(p, str) and "\n" not in p else "") + "\n")
out = ""
name = d.get("tool_name")
inp = d.get("tool_input")
name_ok = isinstance(name, str) and 0 < len(name) <= 64 and all(c in NAME for c in name)
if name_ok:
    out = name
    detail = ""
    if isinstance(inp, dict):
        for k in ("command", "file_path", "url"):
            v = inp.get(k)
            if isinstance(v, str) and v:
                detail = v
                break
        qs = inp.get("questions")
        if not detail and name == "AskUserQuestion" and isinstance(qs, list) and qs and isinstance(qs[0], dict):
            v = qs[0].get("question")
            if isinstance(v, str):
                detail = v
    # Control characters out FIRST, then the cut: cutting first would spend
    # part of the 120 on bytes that are about to be removed.
    detail = "".join(c for c in detail if 31 < ord(c) != 127)[:120]
    if detail:
        out = name + ": " + detail
sys.stdout.write(out + "\n")
# The dialog line, for `roost answer`. See the comment above this reader.
kind, opts = "other", 0
sub = d.get("agent_id")
if name_ok and isinstance(inp, dict) and not (isinstance(sub, str) and sub):
    if harness == "claude" and name == "AskUserQuestion":
        qs = inp.get("questions")
        if isinstance(qs, list) and len(qs) == 1 and isinstance(qs[0], dict):
            q = qs[0]
            o = q.get("options")
            if (q.get("multiSelect") is False and isinstance(o, list) and 2 <= len(o) <= 4
                    and all(isinstance(x, dict) and not x.get("preview") for x in o)):
                kind, opts = "question", len(o)
    elif harness == "claude" and name == "Bash" and isinstance(inp.get("command"), str):
        kind = "permission"
    elif harness == "claude" and name in ("Write", "Edit") and isinstance(inp.get("file_path"), str):
        kind = "permission"
    elif harness == "codex" and name == "Bash" and isinstance(inp.get("command"), str):
        kind = "permission"
canon = json.dumps([name, inp], sort_keys=True, separators=(",", ":"))
digest = "%08x" % (zlib.crc32(canon.encode("utf-8", "replace")) & 0xffffffff)
sys.stdout.write("%s %d %s %s\n" % (kind, opts, digest, os.urandom(6).hex()))' "$dialog_harness" 2>/dev/null || true)"
  elif command -v jq >/dev/null 2>&1; then
    # \A and \z, not ^ and $: in jq's regex engine $ also matches before a
    # trailing newline, the same trap the StopFailure reader above documents.
    #
    # jq can neither hash nor make a random number, so it prints the dialog
    # line as "<kind> <options>" and then a FOURTH line, the canonical
    # (tool name, tool input) the shell digests below with cksum. `falsy` is
    # python's truthiness, so the two readers refuse the same previews.
    fields="$(printf '%s' "$payload" | jq -r --arg h "$dialog_harness" '
      def falsy: . == null or . == false or . == "" or . == 0 or . == [] or . == {};
      if type == "object" then
        (if (.transcript_path | type) == "string" and ((.transcript_path | test("\n")) | not)
         then .transcript_path else "" end),
        (if (.tool_name | type) == "string" and (.tool_name | test("\\A[a-zA-Z0-9_.-]{1,64}\\z"))
         then (.tool_name) as $n
              | ([(.tool_input.command? // empty), (.tool_input.file_path? // empty),
                  (.tool_input.url? // empty),
                  (if $n == "AskUserQuestion" then (.tool_input.questions?[0]?.question? // empty) else empty end)]
                 | map(select(type == "string" and . != "")) | .[0] // "")
              | gsub("[[:cntrl:]]"; "") | .[0:120]
              | if . == "" then $n else $n + ": " + . end
         else "" end),
        (if (.tool_name | type) == "string" and (.tool_name | test("\\A[a-zA-Z0-9_.-]{1,64}\\z"))
            and (.tool_input | type) == "object"
            and (((.agent_id | type) == "string" and .agent_id != "") | not)
         then
           (if $h == "claude" and .tool_name == "AskUserQuestion" then
              (.tool_input.questions) as $q
              | if ($q | type) == "array" and ($q | length) == 1 and ($q[0] | type) == "object"
                   and $q[0].multiSelect == false and ($q[0].options | type) == "array"
                   and ($q[0].options | length) >= 2 and ($q[0].options | length) <= 4
                   and ($q[0].options | all(.[]; type == "object" and (.preview | falsy)))
                then "question \($q[0].options | length)" else "other 0" end
            elif $h == "claude" and .tool_name == "Bash" and (.tool_input.command | type) == "string" then "permission 0"
            elif $h == "claude" and (.tool_name == "Write" or .tool_name == "Edit") and (.tool_input.file_path | type) == "string" then "permission 0"
            elif $h == "codex" and .tool_name == "Bash" and (.tool_input.command | type) == "string" then "permission 0"
            else "other 0" end)
         else "other 0" end),
        ([.tool_name, .tool_input] | tojson)
      else "", "", "other 0", "null" end' 2>/dev/null || true)"
  fi
  transcript="${fields%%$'\n'*}"
  rest=""
  case "$fields" in *$'\n'*) rest="${fields#*$'\n'}" ;; esac
  # The second line is the description. $( ) already dropped the trailing
  # newline of the LAST line, and the lines after this one are the dialog's, so
  # the cut at the first newline is what keeps either of them, or a reader that
  # printed one line too many, from being smuggled into the description.
  blocked_on="${rest%%$'\n'*}"
  case "$rest" in *$'\n'*) rest="${rest#*$'\n'}" ;; *) rest="" ;; esac
  dialog_line="${rest%%$'\n'*}"
  case "$rest" in *$'\n'*) canon="${rest#*$'\n'}" ;; *) canon="" ;; esac
  canon="${canon%%$'\n'*}"
  case "$transcript" in
    /*) : ;;
    *) transcript="" ;;
  esac
  case "$transcript" in *$'\t'*|*$'\n'*|*';') transcript="" ;; esac
  # A codex dialog records no transcript. Its transcript_path names codex's own
  # rollout file, and the one reader of @roost-transcript is
  # scripts/lib/roost-unblock.sh, which reads it as a CLAUDE transcript: it
  # would refuse it (fail closed) after a parse of up to 4 MiB on every send to
  # a blocked codex pane. A codex decline fires Interrupt, which needs no
  # transcript (#38).
  [ "$dialog_harness" = codex ] && transcript=""
  # The dialog record, from the PermissionRequest path only (§4.1 of the
  # answer design): the permission_prompt Notification six seconds later
  # belongs to the same dialog and must not change it, which is the rule
  # @roost-blocked-on already keeps. Each word is checked here as well as in
  # the reader, for the reason the StopFailure branch gives for its own second
  # check; hex and digits are spelled out because bash 3.2 matches a range by
  # the locale's collation.
  if [ "$permission_request_hook" = 1 ] && [ -n "$dialog_harness" ]; then
    d_kind="" d_opts="" d_digest="" d_token=""
    read -r d_kind d_opts d_digest d_token _ <<EOF || true
$dialog_line
EOF
    # The jq reader printed no digest and no token: the digest is cksum's CRC
    # of the canonical line it printed instead, and the token is the shell's.
    # Three $RANDOMs are 45 bits; a token only has to differ from the one
    # before it on this pane, and two equal draws are not a case worth a
    # process. With no reader at all, the same, over an empty line.
    if [ -z "$d_token" ]; then
      d_digest="$(printf '%s' "$canon" | cksum 2>/dev/null || true)"
      d_digest="${d_digest%% *}"
      case "$d_digest" in ''|*[!0123456789]*) d_digest=0 ;; esac
      d_digest="$(printf '%08x' "$d_digest" 2>/dev/null || true)"
      d_token="$(printf '%04x%04x%04x' "$RANDOM" "$RANDOM" "$RANDOM" 2>/dev/null || true)"
    fi
    case "$d_kind" in permission|question|other) ;; *) d_kind=other ;; esac
    case "$d_opts" in [0123456789]) ;; *) d_opts=0 ;; esac
    [ "$d_kind" = question ] || d_opts=0
    case "$d_digest" in ''|*[!0123456789abcdef]*) d_digest=00000000 ;; esac
    [ "${#d_digest}" -eq 8 ] || d_digest=00000000
    case "$d_token" in ''|*[!0123456789abcdef]*) d_token="" ;; esac
    [ "${#d_token}" -eq 12 ] || d_token=""
    if [ -n "$d_token" ]; then
      dialog_tail="$dialog_harness $d_kind $d_opts $d_digest"
      dialog="$d_token $dialog_tail"
    fi
  fi
  # The shell's own second check, for the same reason the StopFailure branch
  # keeps one: $( ) strips trailing newlines and bash drops NUL bytes, so a
  # value can arrive here already cleaned, and a reader that was edited badly
  # would not be caught by the tests that feed it those bytes.
  case "$blocked_on" in *$'\t'*|*$'\n'*) blocked_on="" ;; esac
  [ "${#blocked_on}" -le 190 ] || blocked_on=""
  # A trailing `;` survives, rather than being dropped: tmux's COMMAND parser
  # eats one from any option value, and lib/roost-reply.sh already carries the
  # measured escape for exactly that (`return 0;` came back one character
  # short). A command ending in `;` is ordinary shell, so this is the common
  # case rather than an edge one. Sourced here, inside the branch, so the
  # PostToolUse hot path never pays for a file read it has no use for — the
  # same placement the Stop branch above uses and for the same reason.
  if [ -n "$blocked_on" ]; then
    . "$SELF_DIR/lib/roost-reply.sh"
    blocked_on="$(roost_reply_escape "$blocked_on")"
  fi
fi

# The transcript at the START of a turn (#95). Claude's UserPromptSubmit
# carries `transcript_path` like every other hook, and recording it with the
# `working` stamp is what gives scripts/lib/roost-unblock.sh a transcript to
# read for a WORKING pane: an Esc mid-stream or mid-tool fires no event, and
# the only record of it is that file. Until now only the dialog hooks
# recorded it, so an interrupted turn with no dialog in it could never be
# recovered.
#
# Read only under --prompt-hook, which only Claude's UserPromptSubmit entry
# passes (scripts/lib/roost-hooks.sh): never for a plain `working`, so
# PostToolUse's hot path, an adapter's `roost state working` and a human's
# pay nothing and read nothing. Not from a tty either, and not when stdin is
# empty. A `working` that read no payload leaves an older record as it is --
# it names the same session's file, and a stamp that does not match it
# ignores it anyway. A wiring from before the flag (an older settings.json,
# a wiring file from a server started before the upgrade) records nothing
# here: no Esc recovery for a turn with no dialog, which is the behaviour
# before #95, and `roost doctor` names it. A payload that WAS read and carried no
# usable path removes an older record instead, as the dialog hooks do: an
# older record could share this second's stamp, so it is removed rather than
# trusted. The same checks as the dialog path: an absolute path, no tab, no
# newline, no trailing `;`. It is WRITTEN below, in the same tmux command as
# the stamp, with the stamp's own second, for the reason the dialog path
# gives: the reader trusts a record only when its first word equals
# @agent_since. A UserPromptSubmit on a pane that already reads working is a
# repeat and bails before the write, which is right: the turn it belongs to
# has a record already.
prompt_transcript="" prompt_payload=0
if [ "$prompt_hook" = 1 ] && [ ! -t 0 ]; then
  payload="$(cat 2>/dev/null || true)"
  if [ -n "$payload" ]; then
    prompt_payload=1
    if command -v python3 >/dev/null 2>&1; then
      prompt_transcript="$(printf '%s' "$payload" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
p = d.get("transcript_path") if isinstance(d, dict) else None
sys.stdout.write(p if isinstance(p, str) and "\n" not in p else "")' 2>/dev/null || true)"
    elif command -v jq >/dev/null 2>&1; then
      prompt_transcript="$(printf '%s' "$payload" | jq -r 'if type == "object" and (.transcript_path | type) == "string" and ((.transcript_path | test("\n")) | not) then .transcript_path else "" end' 2>/dev/null || true)"
    fi
    case "$prompt_transcript" in /*) ;; *) prompt_transcript="" ;; esac
    case "$prompt_transcript" in *$'\t'*|*$'\n'*|*';') prompt_transcript="" ;; esac
  fi
fi

# hold_carry NOW -> HOLD_WR, tmux commands (each ending in `;`) that move a
# hold record (#97) onto the stamp NOW, when it agrees with the stamp the pane
# holds at that instant. A dialog inside a held turn stamps `blocked`, and the
# approved tool's PostToolUse stamps `working` again: both are the SAME turn,
# but each moves @agent_since, so the hold record "<old stamp> N" stopped
# matching and `read` called the turn's own main reply stale and final
# (flock round 1 on #95/#97, reproduced). tmux makes the comparison and the
# rewrite inside the stamp's own command, so nothing can land between them;
# a record from another stamp, or none, is left exactly as it is. Placed
# BEFORE the @agent_since write in that command, so it compares with the old
# stamp. NOW is digits, so it cannot break the format.
hold_carry() {
  local opt
  HOLD_WR=()
  for opt in @roost-background @roost-background-types; do
    HOLD_WR+=(if-shell -F -t "$TMUX_PANE" "#{==:#{s/ .*//:#{$opt}},#{@agent_since}}"
      "set-option -p -t $TMUX_PANE -F $opt '$1 #{s/^[^ ]* //:#{$opt}}'" ';')
  done
}

# roost_stamp_blocked NOW — write everything a 🛑 stamp owns, in ONE tmux
# command, from wherever the stamp came from.
#
# ONE FUNCTION, TWO CALL SITES, and that is the whole point. There are two ways
# into `blocked`: a pane that was not blocked (the transition, near the bottom
# of this file) and a pane that already was (the repeat, just below). Round 1
# of the flock made the transition atomic and round 2 found the repeat still
# writing four separate calls and never writing @agent_state at all, trusting a
# read taken dozens of lines earlier. scripts/lib/roost-unblock.sh could land
# in that window — it sees `blocked`, the FIRST dialog's stamp and the FIRST
# dialog's decline records, clears the badge, and the hook then finishes
# stamping the SECOND dialog around a pane that no longer reads blocked:
# state=[] with the second dialog's description recorded, and `send` exiting 0
# into an open dialog (reproduced). Two call sites that must agree is a bug
# waiting to be re-introduced; one function cannot disagree with itself.
#
# @agent_state is written on BOTH paths, and on the repeat it is idempotent on
# purpose: writing the value the pane is supposed to have is what makes the
# group survive anything that changed it while the payload was being read.
#
# @roost-stop-swallowed is unset on EVERY entry, whatever set the badge —
# round 2 again. It belongs to the DIALOG, not to the flag that stamped it, so
# a codex dialog stamped flagless (adapters/codex/roost-codex-hook still maps
# its PermissionRequest to a flagless `blocked` when its hook runs inside
# codex's shared app-server, #142) or an old Claude's
# permission_prompt Notification landing on a pane that had already spent its
# Stop would otherwise inherit the spent mark, and the next Stop would paint ✅
# done under a dialog that is open.
#
# @roost-transcript and @roost-blocked-on stay conditional, and differently:
# a transcript is removed when a hook that CARRIES one could not produce one
# (an older record could share this second's stamp, so it is removed rather
# than trusted), and left alone for a flagless stamp that never had one.
# @roost-blocked-on is written only by the PermissionRequest hook, because the
# permission_prompt Notification for the same dialog arrives six seconds later
# with no tool name at all and must not blank the description of a dialog that
# is still open.
#
# `;` as its own argument is tmux's command separator in argv form — the same
# shape the @roost-reply write above uses.
#
# A NOTE FOR #93, which will display @roost-blocked-on: tool_input is whatever
# the model asked for, so a Bash command that sets a secret
# (`export TOKEN=sk-...`) lands here verbatim. Recording it is no worse than
# the command already being on the pane's own screen; PUTTING IT ON A STATUS
# BAR, in a switcher or in a notification is a different exposure, and #93 has
# to decide that deliberately rather than inherit it from here.
#
# @roost-dialog (#142) is "<token> <harness> <kind> <options> <digest>", the
# dialog `roost answer` names with --expect, and it is written only by the
# PermissionRequest hook, like @roost-blocked-on and for the same reason. It is
# the FIRST command of the group, before @agent_state is written, because its
# test has to see the pane as it was before this stamp:
#
#   the pane already reads blocked AND the stored record ends in the same
#   harness, kind, options and digest  -> keep it, token and all
#   anything else                       -> write the new record, and remove
#                                          @roost-answered and
#                                          @roost-answer-nonce, which belonged
#                                          to the dialog before it
#
# The first line is Claude running this hook once per settings source that
# names it: two calls for ONE dialog, which must not hand a caller who read the
# first token a refusal for the second. The test is tmux's, inside this one
# command, so two copies that start together cannot both see "not blocked":
# tmux runs one client's command list at a time, and whichever comes second
# sees the first one's stamp. A real second dialog has, in every flow measured
# (M1, M2 of the design), come after the pane LEFT blocked, and leaving blocked
# removes the record -- so it always gets a new token. What was not measured is
# a subagent's dialog with the same tool and input opened while the main one
# is up (the design's §12.4); a subagent's dialog is kind `other`, so its tail
# differs and it gets a new token too.
#
# `#{?TEST,,1}` is "not TEST", the shape the subagent count above uses. The
# record holds only hex, fixed words and a digit (checked where it is built),
# so it can sit inside the command string unquoted by anything but '…'.
roost_stamp_blocked() {
  local wr
  wr=()
  if [ "$permission_request_hook" = 1 ]; then
    if [ -n "$dialog" ]; then
      wr=(if-shell -F -t "$TMUX_PANE" \
            "#{?#{&&:#{==:#{@agent_state},blocked},#{m:* $dialog_tail,#{@roost-dialog}}},,1}" \
            "set-option -p -t $TMUX_PANE @roost-dialog '$dialog' ; set-option -pu -t $TMUX_PANE @roost-answered ; set-option -pu -t $TMUX_PANE @roost-answer-nonce"
          ';')
    else
      wr=(set-option -pu -t "$TMUX_PANE" @roost-dialog
          ';' set-option -pu -t "$TMUX_PANE" @roost-answered
          ';' set-option -pu -t "$TMUX_PANE" @roost-answer-nonce
          ';')
    fi
  fi
  # @roost-ended goes with every stamp but an interrupt's (#95): it says how
  # the PREVIOUS turn ended, and a reader trusts it only while its first word
  # equals @agent_since -- which a turn that starts and ends in the same
  # second as the interrupt would still match (flock round 1, reproduced:
  # exit 5 on a pane that read done). Unset in the stamp's own command.
  # A dialog inside a held turn keeps the hold (hold_carry above).
  hold_carry "$1"
  wr+=("${HOLD_WR[@]}")
  wr+=(set-option -p -t "$TMUX_PANE" @agent_state blocked
      ';' set-option -p -t "$TMUX_PANE" @agent_since "$1"
      ';' set-option -pu -t "$TMUX_PANE" @roost-stop-swallowed
      ';' set-option -pu -t "$TMUX_PANE" @roost-ended)
  if [ -n "$transcript" ]; then
    wr+=(';' set-option -p -t "$TMUX_PANE" @roost-transcript "$1 $transcript")
  elif [ "$notification_hook" = 1 ] || [ "$permission_request_hook" = 1 ]; then
    wr+=(';' set-option -pu -t "$TMUX_PANE" @roost-transcript)
  fi
  if [ "$permission_request_hook" = 1 ]; then
    if [ -n "$blocked_on" ]; then
      wr+=(';' set-option -p -t "$TMUX_PANE" @roost-blocked-on "$blocked_on")
    else
      wr+=(';' set-option -pu -t "$TMUX_PANE" @roost-blocked-on)
    fi
  fi
  tmux -S "$sock" "${wr[@]}" 2>/dev/null || true
}

# PostToolUse fires after EVERY tool call and Claude blocks on this script
# exiting, so the common case — state already correct — must be cheap: ONE read,
# then bail before any writes. It MUST carry `|| true`: under `set -e` a bare
# failing $(...) aborts, and a dead tmux server (agent windows are killable) has
# to degrade, never break Claude.
#
# That same read also tells us whether the pane already has a label, so the
# hot (unchanged-state) path stays a single tmux round trip even though it
# now decides two things instead of one. A plain separator between the two
# fields is not safe to add here: @roost-name is free text a human chose (see
# bin/roost's `send` comment on why an in-band separator breaks), so nothing
# printable is guaranteed absent from it. Instead we append a fixed marker
# "X" to the state, but only when @roost-name is non-empty — the same
# emptiness-ternary idiom bin/roost's `status` branch and tmux/roost.conf's
# @roost-pane-border already use for this exact check, and deliberately an
# equality test against "" rather than tmux's `#{?@roost-name,...}`
# truthiness, which treats a pane literally named "0" as unset. $state is
# always error/blocked/working/done/idle, never ending in X, so a trailing X
# can only have come from the marker and is safe to strip.
raw="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" \
  '#{@agent_state}#{?#{==:#{@roost-name},},,X}' 2>/dev/null || true)"
case "$raw" in
  *X) prev="${raw%X}"; has_name=1 ;;
  *)  prev="$raw";      has_name=0 ;;
esac

# A SUBAGENT's tool result must not clear a dialog it knows nothing about
# (#91, flock round 2). A background agent finishing a tool call fires
# PostToolUse on the MAIN pane, and `working` cleared the 🛑 that a DIFFERENT
# agent's dialog had stamped there: badge gone, description gone, `send`
# delivering into the open dialog. Measured at hook level by the reviewer; the
# two-parallel-subagents case behind it is in docs/known-gaps.md as not
# reproducible without the live rig.
#
# `agent_id` is the discriminator, the same one the StopFailure branch above
# uses: Claude adds it only for a subagent's loop. The rule is narrow on
# purpose — a subagent's tool result is ignored ONLY while the pane is
# blocked. With no dialog open it is an ordinary busy stamp and the turn IS
# alive, so it badges working as it always did.
#
# READ ONLY WHEN IT MATTERS. PostToolUse fires on every tool call of every
# live agent and Claude waits for this hook to exit, so the hot path has to
# stay one tmux read and a bail; a `cat` and a process spawn on every call
# would be paid by every agent for a case that needs a dialog to be open. A
# pane that reads blocked is a pane whose agent is already waiting on a human,
# where the spawn costs nothing anyone can feel. $prev is the same read the
# hot path already made.
#
# $prev can be stale here — it is the clear path's known gap, above — and the
# cost of losing that race is the behaviour this whole block improves on
# rather than a new one: a subagent's tool result clearing a fresh dialog.
if [ "$tool_hook" = 1 ] && [ "$prev" = "blocked" ] && [ ! -t 0 ]; then
  payload="$(cat 2>/dev/null || true)"
  sub=""
  if command -v python3 >/dev/null 2>&1; then
    sub="$(printf '%s' "$payload" | python3 -c \
      'import sys,json
try:
    d = json.load(sys.stdin)
except Exception:
    d = None
a = d.get("agent_id") if isinstance(d, dict) else None
sys.stdout.write("subagent" if isinstance(a, str) and a else "")' 2>/dev/null || true)"
  elif command -v jq >/dev/null 2>&1; then
    sub="$(printf '%s' "$payload" | jq -r 'if type == "object" and (.agent_id | type) == "string" and .agent_id != ""
      then "subagent" else "" end' 2>/dev/null || true)"
  fi
  # A payload no reader could parse is treated as the MAIN turn's, which is
  # the pre-#91 behaviour and the one that clears a badge rather than keeping
  # one: this must degrade towards the old bug, never towards a stuck pane.
  [ "$sub" = "subagent" ] && exit 0
fi
# A Stop that lands while a dialog is OPEN is handled at the WRITE, near the
# bottom of this file, and NOT here where $prev is in hand (#91, flock round
# 1). $prev was read above; the write happens dozens of lines later; and the
# two events race. Deciding here reads the pane at one instant and acts on it
# at another, which is the bug this guard exists to prevent, re-introduced
# intermittently. See the `stop_while_blocked` write below.

# The event log (#98): one JSON line per state change, and one when a pane that
# stays blocked is blocked on something new. Both lines are guarded the same
# way, so the PostToolUse hot path — an unchanged state that is not blocked —
# pays neither the file read nor the call. The line is written from an EXIT
# trap, after every write below; scripts/lib/roost-events.sh says why.
if [ "$state" != "$prev" ] || [ "$state" = blocked ]; then . "$SELF_DIR/lib/roost-events.sh" || true; fi
if [ "$state" != "$prev" ] || [ "$state" = blocked ]; then roost_events_arm "$sock" "$TMUX_PANE" "$prev" "$state" "$permission_request_hook" "$stop_while_blocked" || true; fi

if [ "$state" = "$prev" ]; then
  # The one repeat that is NOT a no-op: a Notification for a NEW dialog on a
  # pane that still reads blocked (flock round 1 on #38, reproduced). The first
  # dialog was declined, so its recorded transcript ends in the decline
  # records; if the new dialog's records live in a different file, keeping the
  # old stamp and the old path lets scripts/lib/roost-unblock.sh judge the new,
  # OPEN dialog by the old file — and clear it, so `send` pastes into it.
  #
  # So the stamp moves to now, and the record either names the new file or is
  # removed. The record is written BEFORE the stamp: a reader landing between
  # the two sees a record and a stamp that disagree, and clears nothing. No
  # label and no notification here — the state did not change, and this path
  # must stay as cheap as the bail it replaces for every other repeat.
  #
  # The SAME group the transition path writes, from the one function that
  # builds it — see roost_stamp_blocked above for what is in it and why. Any
  # caller reaches here, not just the two dialog hooks: a flagless `blocked`
  # (codex's adapter under the shared app-server, a human's `roost state
  # blocked`) is a new dialog too, and it needs the spent-Stop mark
  # reset exactly as much (flock round 2). No label and no notification here —
  # the state did not change, and this path must stay as cheap as the bail it
  # replaces for every other repeat.
  if [ "$state" = "blocked" ]; then
    roost_stamp_blocked "$(date +%s)"
  fi
  exit 0
fi

# A NEW turn takes away the label an unrecorded one left behind (#56, flock
# review). `roost send --from` files who sent a prompt beside the turn it
# predicts — base + 1 — the moment the badge leaves done/idle, and the reply
# that makes that turn real arrives only when the turn ends. A turn that ends
# WITHOUT a reply (an API error, an interrupt, an answer that was all tool
# calls) is never recorded, so its number goes to the next turn — often a
# prompt the human typed by hand — and `read --json` of that turn would then
# say the coordinator sent it. A wrong label is the one thing the record must
# never hold: null is a question, "coord" is a lie.
#
# Dropped HERE, at the start of the next turn, and not on the error arms
# above, because this is the one point every harness passes through: Claude's
# UserPromptSubmit, codex's, and every adapter's `roost state working`. The
# error arms are three branches only Claude and codex reach, and the opencode,
# copilot and pi adapters report a failed turn with a plain `error` that this
# script cannot tell from opencode's mid-turn retry. A new turn is a stamp of
# working from a FINISHED state — done, idle, error, or no badge yet. From
# blocked it is the same turn resuming after a dialog, and the label stays;
# from working it never gets here (the bail above).
#
# BEFORE the stamp below, and that order is the guarantee: `send` writes its
# sidecar only once it has SEEN the badge move, so the label of the turn
# starting now cannot exist yet and cannot be dropped. One tmux read, one
# directory listing and one rm, once per turn start, only when records are on
# and this pane has one; the PostToolUse hot path is above the bail and pays
# nothing.
#
# The cost in the other direction, recorded in docs/known-gaps.md: opencode
# reports `error` on its third retry and `working` again when the retry goes
# on, which looks like a new turn from here, so a label for a turn that lived
# through a retry is dropped — null, which is honest.
if [ "$state" = "working" ]; then
  case "$prev" in
    ''|done|idle|error)
      . "$SELF_DIR/lib/roost-record.sh"
      roost_record_root
      if [ -n "$ROOST_RECORD_ROOT" ]; then
        boot="$(tmux -S "$sock" display-message -p '#{start_time}-#{pid}' 2>/dev/null || true)"
        if roost_record_pane_dir "$boot" "$TMUX_PANE"; then
          roost_record_drop_pending "$ROOST_RECORD_PANE_DIR" || true
        fi
      fi ;;
  esac
fi

# The pane terminal's foreground job, for `roost wait-done` (#64). An agent
# typed at a shell prompt and then killed leaves its pane alive at the prompt
# with pane_dead 0 and the badge still busy, and no hook runs to say so. What
# does change is the terminal: the shell gets it back. So a busy stamp records
# WHICH JOB held the terminal, as "PGID:PANE_PID" in @roost-agent-job, and
# wait-done calls the pane died only when that job has no process left AND the
# pane's shell holds the terminal again. The design, and every measurement
# behind it, is docs/airig/specs/2026-09-15-agent-identity-design.md.
#
# Read from the TERMINAL, not from this script's parents, and that is the
# point. The process that runs a hook is not always the agent: copilot's
# extension is a forked host, and codex's adapter runs this script two levels
# below codex. But at every hook call measured — Claude, codex, opencode, pi,
# copilot, through --settings, a settings file and a PATH wrapper — the
# terminal's foreground job was the agent's job. Claude runs its hooks with no
# terminal at all, which is why this asks about the PANE's process, not our own.
#
# Only on a transition into working or blocked, never above: the
# unchanged-state bail is the PostToolUse hot path and gains nothing here.
# Measured +5 to +7 ms per busy transition. A second, identical hook firing
# (Claude runs both copies when two settings sources name it with different
# strings) writes the same value, because it reads the same terminal.
#
# Nothing is recorded, and any old record is removed, when:
#   - the foreground job IS the pane's process: an agent run as the pane's own
#     command (`roost spawn`), one started with `&`, a shell without job
#     control. A job that is the pane cannot be told from the shell, and #54
#     already sees that pane close;
#   - the foreground job is THIS process: `roost state working` typed at a
#     prompt execs straight into this script, which leads its own job and exits
#     at once. Recording it would report "died" a moment later about a pane
#     that never had an agent;
#   - tmux or ps give nothing usable (a dead server, a container that cannot
#     see the host's pane process, a ps without tpgid). Degrades to today.
# Removing, not leaving, is what keeps a record from one agent from being
# checked against a later pane process; wait-done also ignores a record whose
# PANE_PID is not the pane's current one (respawn-pane -k keeps options).
#
# Written BEFORE @agent_state, for the reply's reason: a waiter that sees the
# new busy state should find the record that goes with it.
if [ "$state" = "working" ] || [ "$state" = "blocked" ]; then
  job=""
  pane_pid="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{pane_pid}' 2>/dev/null || true)"
  case "$pane_pid" in ''|*[!0-9]*) pane_pid="" ;; esac
  if [ -n "$pane_pid" ]; then
    fg_job="$(ps -o tpgid= -p "$pane_pid" 2>/dev/null || true)"
    fg_job="${fg_job//[[:space:]]/}"
    case "$fg_job" in ''|*[!0-9]*) fg_job="" ;; esac
    # tpgid is 0 (macOS) or -1 (Linux, filtered above) for a terminal with no
    # foreground job; 1 would be init. Neither names an agent.
    if [ -n "$fg_job" ] && [ "$fg_job" -gt 1 ] \
       && [ "$fg_job" != "$pane_pid" ] && [ "$fg_job" != "$$" ]; then
      job="$fg_job:$pane_pid"
    fi
  fi
  if [ -n "$job" ]; then
    tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-agent-job "$job" 2>/dev/null || true
  else
    tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-agent-job 2>/dev/null || true
  fi
fi

# Stamp the PANE, not the window. Pane scope is what lets two agents share one
# window without overwriting each other's badge. Glyphs are NOT stamped: the
# status bar derives them from @roost-glyph-<state> at render time, so a theme
# change is live everywhere with nothing left to go stale.
# NEITHER of these needs the trailing-semicolon escape @roost-reply carries.
# tmux's command parser eats a trailing `;` from any option value, but $state
# has been normalised to one of five fixed words by the `case` above and
# @agent_since is `date +%s`, so neither can end in one. Said here because the
# obvious next move on reading roost_reply_escape is to apply it to every
# option write, and escaping a value that cannot need it only adds a way to be
# wrong later.
#
# @roost-error-reason says WHY a pane is error, and `roost wait-done` prints it.
# It is written BEFORE @agent_state for the reply's reason: wait-done reads it
# the instant it sees `error`, so stamping the state first opens a window where
# the reason is missing. It is cleared when a pane LEAVES error, so a reason
# can never be printed about a later turn it does not describe.
#
# The clear is keyed on $prev, not run on every transition. A reason is only
# ever written together with `error`, so a pane whose previous state was not
# error has none to clear — and this script is the hook every live Claude agent
# runs, so an unconditional unset was one more tmux call on every transition of
# every agent, spent clearing nothing. $prev is already in hand from the one
# read above. An error -> error write (a hand-typed `roost state error` after a
# codex dead turn) cannot reach here at all: the unchanged-state bail catches
# it, and the reason it leaves describes the turn that is still showing.
#
# ROOST_ERROR_REASON is set only by adapters/codex/roost-codex-hook, as a fixed
# sentence. The StopFailure branch above sets $error_reason itself, to a fixed
# sentence carrying one checked word. Like @agent_state neither needs the
# trailing-semicolon escape: the StopFailure sentence ends in `)`, and a caller
# who exported one ending in `;` would lose that character, not the write.
if [ "$state" = "error" ] && [ -n "$error_reason" ]; then
  tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-error-reason "$error_reason" 2>/dev/null || true
elif [ "$prev" = "error" ]; then
  tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-error-reason 2>/dev/null || true
fi
#
# @roost-transcript is "<stamp> <path>", written BEFORE the state and stamp for
# the reply's reason, and with the stamp it will carry: `now` is taken once, so
# the record and @agent_since are the same number. scripts/lib/roost-unblock.sh
# trusts a record only when its first word equals @agent_since, so a reader
# that lands between these writes sees a record and a stamp that disagree, and
# clears nothing.
#
# @roost-blocked-on says WHAT the open dialog is asking for — "<tool_name>:
# <command or path>" — and it is #91's half of #93. NOTHING DISPLAYS IT YET,
# on purpose: #93 owns the display, and a value that is recorded now is a
# value #93 can be built against without a second round of measuring. A
# reader must check @agent_state first, the way `read` checks @roost-reply
# before believing @roost-reply-turn: this is a description of a dialog, not
# a stamp, and the one place that clears 🛑 without running this script
# (scripts/lib/roost-unblock.sh, after a decline) unsets it there.
now="$(date +%s)"
if [ "$state" = "blocked" ]; then
  # A pane that was NOT blocked and is now. The same one-command group the
  # repeat path above writes, from the same function — see roost_stamp_blocked.
  roost_stamp_blocked "$now"
else
  # LEAVING blocked. @roost-blocked-on and @roost-stop-swallowed both describe
  # the dialog that has just been answered, so both go. Keyed on $prev rather
  # than run on every transition, for the reason @roost-error-reason's clear is:
  # a pane that was not blocked has nothing to clear, and this script runs on
  # every PostToolUse of every live agent, so an unconditional unset would be
  # one more tmux call per transition spent clearing nothing (two, before the
  # unsets were chained into one call).
  #
  # THIS IS THE ONE WRITER LEFT THAT IS NOT ATOMIC, and it is a known gap
  # rather than an oversight (flock round 2): $prev was read above, the unsets
  # are a separate call from that read (one call now, two before #142), and a
  # dialog stamped in between would have its record cleared. Round 2 bounded the
  # window at single-digit milliseconds and could not reproduce it at any gap,
  # because the hook that would have to win the race is systematically the
  # slower of the two. docs/known-gaps.md carries it.
  if [ "$prev" = "blocked" ] && [ "$stop_while_blocked" = 0 ]; then
    # The dialog record and who answered it (#142) describe the same dialog,
    # so they go here too, and all five unsets are ONE call: a tmux process
    # per option on every transition out of blocked would be spent clearing
    # what is usually there, and this way the transition costs no more
    # processes than the two separate unsets it replaced (review). tmux stops
    # a command list at its first error, and an unset of an option that is
    # not set is not an error, so each unset still runs.
    tmux -S "$sock" set-option -pu -t "$TMUX_PANE" @roost-blocked-on \; \
      set-option -pu -t "$TMUX_PANE" @roost-stop-swallowed \; \
      set-option -pu -t "$TMUX_PANE" @roost-dialog \; \
      set-option -pu -t "$TMUX_PANE" @roost-answered \; \
      set-option -pu -t "$TMUX_PANE" @roost-answer-nonce 2>/dev/null || true
  fi
  if [ "$stop_while_blocked" = 1 ]; then
    # A held Stop (#97) ALWAYS comes through here: stop_while_blocked is set
    # for every `done --stop-hook` (near the top), before the hold rewrites
    # $state to working. So a held Stop on a pane that was not already
    # working -- done, idle, error, no badge yet, or blocked on its second
    # Stop -- stamps `working` in the else-branch below, and that stamp is a
    # NEW @agent_since. The @roost-background written above the bail carried
    # the old one, so it is written again here, in the same tmux command as
    # the badge: a reader that sees this stamp finds a record that agrees
    # with it, never one that disagrees for the gap between two calls. (A
    # separate arm for this case was dead code: flock round 1 found it, and
    # tests/test-turn-over-edges.sh section 9 drives a held Stop into a pane
    # that really reads blocked.) $now is digits and $bg_count digits or `?`,
    # so neither can break the string.
    held_wr=""
    if [ "$held" = 1 ]; then
      held_wr=" ; set-option -p -t $TMUX_PANE @roost-background '$now $bg_count'"
      [ -n "$bg_types" ] && held_wr="$held_wr ; set-option -p -t $TMUX_PANE @roost-background-types '$now $bg_types'"
    fi
    # A Stop while a dialog is OPEN (#91). ONE tmux command, and the condition is
    # evaluated by tmux in the same command as the writes, so no other hook can
    # land between the test and the act. That is the whole point: $prev was read
    # dozens of lines ago and the two events race. Measured on 2.1.278, a real
    # subagent dialog — PermissionRequest's hook ran at 1790058350.889319 and the
    # main turn's Stop 7 ms later; on the very next run of the same case the two
    # INVERTED, Stop at 1790062049.316559 and PermissionRequest at
    # 1790062049.316824. Deciding from a value read earlier gave ✅ done under an
    # open dialog in 28 of 40 runs when they started together (flock round 1).
    #
    # WHY THE MAIN TURN STOPS AT ALL: a background agent's dialog is drawn on the
    # MAIN pane while the main turn has already finished and is waiting on that
    # agent. The Stop payload carries no agent_id, so nothing in it tells the two
    # apart — only the pane's own state does.
    #
    # BOUNDED: exactly one Stop per dialog. @roost-stop-swallowed is unset when a
    # dialog is stamped and set here, so a SECOND Stop falls through to the else
    # branch and the pane moves. Without that bound a turn whose only clearing
    # event roost had not wired left the pane 🛑 for ever, with `send` refusing,
    # `wait-done` burning its timeout and `read` calling the reply stale (flock
    # round 1, both reviewers). The wired case is PostToolUseFailure — a tool
    # that fails after a Yes fires that and no PostToolUse — and it is now an
    # entry of its own; this is the belt to that braces, for whatever event is
    # next.
    #
    # The reply was already recorded above, deliberately: the turn's answer is
    # real and `roost read` should still find it. Only the STATE is held, so
    # `wait-done` keeps waiting and `send` keeps refusing while the dialog is up.
    #
    # THIS APPLIES TO CODEX TOO, and deliberately. `done --stop-hook` is what
    # adapters/codex/roost-codex-hook calls as well, and nothing in the call
    # says which harness made it — but nothing needs to: the rule is about the
    # PANE, and a codex pane reading blocked has a codex dialog open on it, so
    # a Stop that arrives there must not paint it done either. It will rarely
    # engage: codex fires Interrupt when a dialog is declined (#38), which
    # leaves idle, and an approval fires PostToolUse first. And it is bounded
    # the same way, so a codex pane cannot be stranded by it.
    #
    # The else branch carries the @roost-blocked-on and @roost-stop-swallowed
    # unsets that the $prev-keyed clear above skips for this call: they describe
    # the dialog, and whether there is still a dialog is decided here, not there.
    # @roost-dialog, @roost-answered and @roost-answer-nonce (#142) describe it
    # too, and go with them.
    tmux -S "$sock" if-shell -F -t "$TMUX_PANE" \
      "#{&&:#{==:#{@agent_state},blocked},#{==:#{@roost-stop-swallowed},}}" \
      "set-option -p -t $TMUX_PANE @roost-stop-swallowed 1" \
      "set-option -p -t $TMUX_PANE @agent_state $state ; set-option -p -t $TMUX_PANE @agent_since $now$held_wr ; set-option -pu -t $TMUX_PANE @roost-ended ; set-option -pu -t $TMUX_PANE @roost-blocked-on ; set-option -pu -t $TMUX_PANE @roost-stop-swallowed ; set-option -pu -t $TMUX_PANE @roost-dialog ; set-option -pu -t $TMUX_PANE @roost-answered ; set-option -pu -t $TMUX_PANE @roost-answer-nonce" \
      2>/dev/null || true
  else
    # One command for the badge and the stamp, and with them, on a transition
    # to working, the transcript record (#95): the prompt hook's path when it
    # carried one, else -- leaving a dialog -- the path the dialog hook
    # recorded, re-stamped with THIS second, so an Esc later in the same turn
    # still has a record whose first word is the pane's @agent_since. A
    # prompt hook whose payload carried no usable path removes the older
    # record (it could share this second's stamp); a `working` that read no
    # payload at all leaves it. Read from the pane once, only on a transition
    # out of blocked, which is once per dialog, never on the PostToolUse hot
    # path.
    stamp_wr=()
    # Back to working from a dialog is the same turn: a hold goes with it
    # (hold_carry). A new prompt is a new turn and needs nothing carried --
    # a released hold is already gone.
    if [ "$state" = "working" ] && [ "$prev" = "blocked" ] && [ "$prompt_hook" = 0 ]; then
      hold_carry "$now"
      stamp_wr+=("${HOLD_WR[@]}")
    fi
    stamp_wr+=(set-option -p -t "$TMUX_PANE" @agent_state "$state"
              ';' set-option -p -t "$TMUX_PANE" @agent_since "$now")
    # The interrupted outcome (#95) beside the idle it leaves, with the stamp's
    # own second, and the empty turn file BEFORE the stamp, for the reply's
    # reason: `wait-done --turn N` returns the instant the badge moves and
    # must find the sidecar that says why turn N is empty. Only on a
    # transition: a repeat idle bailed out above, and two interrupts with no
    # prompt between them are one turn, not two.
    #
    # Every other stamp CLEARS @roost-ended, in this same command: the outcome
    # belongs to the turn that was interrupted, and a new stamp in the same
    # second would otherwise still match it (see roost_stamp_blocked).
    if [ "$interrupted_hook" = 1 ]; then
      stamp_wr+=(';' set-option -p -t "$TMUX_PANE" @roost-ended "$now interrupted")
      . "$SELF_DIR/lib/roost-record.sh"
      roost_record_root
      if [ -n "$ROOST_RECORD_ROOT" ]; then
        boot="$(tmux -S "$sock" display-message -p '#{start_time}-#{pid}' 2>/dev/null || true)"
        if roost_record_pane_dir "$boot" "$TMUX_PANE"; then
          roost_record_append_interrupted "$ROOST_RECORD_PANE_DIR" "$sock" || true
        fi
      fi
    else
      stamp_wr+=(';' set-option -pu -t "$TMUX_PANE" @roost-ended)
    fi
    if [ "$state" = "working" ]; then
      if [ -n "$prompt_transcript" ]; then
        stamp_wr+=(';' set-option -p -t "$TMUX_PANE" @roost-transcript "$now $prompt_transcript")
      elif [ "$prompt_payload" = 1 ]; then
        stamp_wr+=(';' set-option -pu -t "$TMUX_PANE" @roost-transcript)
      elif [ "$prev" = "blocked" ]; then
        old_tr="$(tmux -S "$sock" show-options -pqv -t "$TMUX_PANE" @roost-transcript 2>/dev/null || true)"
        case "$old_tr" in
          *" /"*) stamp_wr+=(';' set-option -p -t "$TMUX_PANE" @roost-transcript "$now ${old_tr#* }") ;;
        esac
      fi
    fi
    tmux -S "$sock" "${stamp_wr[@]}" 2>/dev/null || true
  fi
fi

# Label the pane, but only to fill a gap: a name a human chose (`split -n`,
# `spawn NAME`) always wins, so this never runs when $has_name is 1. Without
# a label a live Claude pane falls back to #{pane_current_command}, which
# reports its OWN VERSION STRING (e.g. "2.1.226") — it changes every release
# and means nothing to a reader of the border or the switcher.
#
# ROOST_AGENT_NAME lets a non-Claude harness (e.g. the opencode adapter, which
# sets it in its execFile env) name itself instead of inheriting the
# Claude-flavoured default — every opencode pane would otherwise read
# "claude" on its border and in the switcher. It is preferred over
# @roost-name-default, but a human-chosen @roost-name (has_name=1) still wins
# over both, since that branch never runs at all.
# @roost-name-default is a global option (in keeping with @roost-glyph-*,
# @roost-notify-*, etc.) so a user running something other than Claude under
# roost's hooks can rename the fallback; "claude" is the honest default since
# this script IS Claude Code's hook.
if [ "$has_name" != 1 ]; then
  # ROOST_AGENT_NAME is process env from whatever harness invoked us — just as
  # uncontrolled as @roost-name-default (a human can export anything), so it
  # gets the identical tab/newline rejection before it is trusted.
  # ANSI-C $'\t'/$'\n', NOT "$(printf '\n')": command substitution strips ALL
  # trailing newlines, so that form collapses to the empty string and the
  # newline arm would then match (and reject) every label — the same hazard
  # bin/roost's reject_bad_name comment warns about.
  label="${ROOST_AGENT_NAME:-}"
  case "$label" in *$'\t'*|*$'\n'*) label="" ;; esac
  if [ -z "$label" ]; then
    label="$(tmux -S "$sock" show-options -gqv @roost-name-default 2>/dev/null || true)"
    # @roost-name-default is user-controlled tmux state (a human can `tmux
    # set-option -g` it directly), not validated at write time the way every
    # OTHER @roost-name write site is via bin/roost's reject_bad_name — this hook
    # is a fourth write site with no gate of its own. A tab shifts `roost
    # status`'s tab-delimited switcher rows; a newline splits one pane's line
    # into two — either way a selectable row loses its session/window key
    # fields and a click runs `switch-client -t ""` silently, the exact
    # corruption reject_bad_name's own comment documents. Unlike
    # reject_bad_name (a loud exit 2, fine for an interactive command), this
    # hook runs on every PostToolUse and Claude blocks on it exiting, so a bad
    # value must degrade to the built-in default instead of breaking the hook.
    case "$label" in *$'\t'*|*$'\n'*) label="claude" ;; esac
  fi
  [ -n "$label" ] || label="claude"
  tmux -S "$sock" set-option -p -t "$TMUX_PANE" @roost-name "$label" 2>/dev/null || true
fi

# Ping if an off-screen agent just became blocked (needs your input) or errored
# (will not progress without you — for opencode the usual cause is a provider
# it cannot reach, retrying forever). If the window is on screen the pane is
# visible, so no ping. `done` deliberately never notifies: it fires every turn
# and would be noise.
msg=""
case "$state" in
  blocked) msg="needs your input" ;;
  error)   msg="hit an error" ;;
esac
if [ -n "$msg" ]; then
  active="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{window_active}' 2>/dev/null || echo 0)"
  if [ "$active" != "1" ]; then
    wname="$(tmux -S "$sock" display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null || echo agent)"
    # $SELF_DIR, not `dirname "$0"`: through a symlink $0 is the symlink's own
    # path and the sibling lookup would miss. The `|| true` is deliberate and
    # must stay — a dead tmux server (agent windows are killable) has to
    # degrade, never break Claude — which is exactly why the miss would be
    # invisible, and why the path has to be right before it is swallowed.
    ROOST_NOTIFY_SOCK="$sock" "$SELF_DIR/roost-notify" "roost · ${wname}" "$msg" || true
  fi
fi

# Nudge every attached client to repaint now instead of waiting for the tick.
tmux -S "$sock" refresh-client -S 2>/dev/null || true
