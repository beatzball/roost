#!/usr/bin/env bash
# roost init — write ~/.config/roost/roost.conf from a few prompts.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/roost-themes.sh"
. "$HERE/lib/roost-config.sh"

# Answers come from stdin. On a non-tty we require ROOST_INIT_ANSWERS=- (tests).
# This guard must stay ahead of the migration block below: a command that
# exits non-zero should never have written a file, and amux-init's guard was
# always the first thing that script did — the rename does not get to add a
# pre-guard side effect just because migration is new.
if [ ! -t 0 ] && [ "${ROOST_INIT_ANSWERS:-}" != "-" ]; then
  echo "roost init: needs a tty (or ROOST_INIT_ANSWERS=- with scripted stdin)"; exit 1
fi

# Legacy migration: the first time roost init runs, if roost.conf doesn't
# exist yet but an old amux.conf does, carry its settings across instead of
# asking the questions again. The sed below runs over the WHOLE line, not
# just the key position — it is safe only because the literal substring
# "@amux-" never occurs anywhere else (values, comments) in a file amux init
# wrote; it is a line-global swap, not a key-scoped one. Keys like
# @agent_state / @agent_since / @agent_glyph have no "amux-" in them at all,
# so they pass through unchanged regardless. The old file is only ever read
# — never written, moved, or deleted, since a running amux server may still
# be reading it. An existing roost.conf always wins; migration never
# overwrites it. No tty is *inherently* needed for this path (it asks no
# questions), but it still runs after the guard above like everything else.
#
# The write is atomic (temp file in the target dir + mv, same shape as
# roost_cfg_set in lib/roost-config.sh) and checked: sed's exit status is
# tested before the mv, so a read failure (unreadable legacy file, I/O
# error) is reported and aborts rather than leaving a truncated or
# zero-byte roost.conf. Because migration only ever fires while roost.conf
# is absent, a silent partial write would never self-heal on a later run.
target="$(roost_cfg_path)"
legacy="${XDG_CONFIG_HOME:-$HOME/.config}/amux/amux.conf"
if [ ! -f "$target" ] && [ -f "$legacy" ]; then
  migdir="$(dirname "$target")"
  mkdir -p "$migdir"
  migtmp="$(mktemp "$migdir/.roost.XXXXXX")" || {
    echo "roost init: could not create a temp file to migrate $legacy" >&2
    exit 1
  }
  if sed \
      -e 's/^# Generated by amux init\. Re-run amux init to change, or edit by hand\.$/# Migrated by roost init from the old amux config. Re-run roost init to change, or edit by hand./' \
      -e 's/@amux-/@roost-/g' \
      "$legacy" > "$migtmp"; then
    # Carry the legacy file's permissions across (mirrors roost_cfg_set's
    # mode preservation) — a user who chmod'd amux.conf shouldn't get
    # umask defaults on the migrated roost.conf.
    migmode="$(stat -c '%a' "$legacy" 2>/dev/null || stat -f '%Lp' "$legacy" 2>/dev/null)"
    [ -n "$migmode" ] && chmod "$migmode" "$migtmp"
    if mv "$migtmp" "$target"; then
      echo "roost: migrated legacy config $legacy -> $target (left untouched)" >&2
      exit 0
    fi
  fi
  rm -f "$migtmp"
  echo "roost init: failed to migrate $legacy to $target — nothing written" >&2
  exit 1
fi

ask() { printf '%s ' "$1" >&2; IFS= read -r REPLY || REPLY=""; printf '%s' "$REPLY"; }

notify="$(ask 'Enable OS notifications? [y/N]')"
case "$notify" in y|Y|yes) nb="auto" ;; *) nb="tmux" ;; esac

pl="$(ask 'Does this look like a triangle?  (y/N)')"   # caller shows the wedge
case "$pl" in y|Y) sep="$(roost_sep triangle)" ;; *) sep="$(roost_sep none)" ;; esac

mode="$(ask 'Terminal is light or dark? [dark]')"; mode="${mode:-dark}"

# Mode picks the suggested themes and the default; any valid theme name is still
# accepted (a light-mode user could still choose a dark theme if they insist).
case "$mode" in
  light) suggest="catppuccin-latte tokyonight-day"; deftheme="catppuccin-latte" ;;
  *)     suggest="roost catppuccin-mocha tokyonight-storm"; deftheme="roost" ;;
esac
theme="$(ask "Theme? [$suggest] (default $deftheme)")"; theme="${theme:-$deftheme}"
roost_theme "$theme" >/dev/null 2>&1 || theme="$deftheme"
set -- $(roost_theme "$theme")
bar_bg="$1" bar_fg="$2" logo_bg="$3" active_bg="$4" active_fg="$5" idle_fg="$6"

gset="$(ask 'Glyph set? emoji/orbs/ascii/nerd [emoji]')"; gset="${gset:-emoji}"
# set -f: the ascii glyphs ([!] [~] [+]) are glob patterns; disable pathname
# expansion around the word-split so they stay literal.
set -f; set -- $(roost_glyphset "$gset"); set +f
gerr="$1" gb="$2" gw="$3" gd="$4" gi="$5"

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/roost"
mkdir -p "$cfg"
target="$cfg/roost.conf"
[ -f "$target" ] && cp "$target" "$target.$(date +%s 2>/dev/null || echo prev).$$.bak"

{
  echo "# Generated by roost init. Re-run roost init to change, or edit by hand."
  echo "set -g @roost-notify-backend \"$nb\""
  echo "set -g @roost-sep-left  \"$sep\""
  echo "set -g @roost-sep-right \"$sep\""
  echo "set -g @roost-color-bar-bg    \"$bar_bg\""
  echo "set -g @roost-color-bar-fg    \"$bar_fg\""
  echo "set -g @roost-color-logo-bg   \"$logo_bg\""
  echo "set -g @roost-color-active-bg \"$active_bg\""
  echo "set -g @roost-color-active-fg \"$active_fg\""
  echo "set -g @roost-color-idle-fg   \"$idle_fg\""
  echo "set -g @roost-glyph-error   \"$gerr\""
  echo "set -g @roost-glyph-blocked \"$gb\""
  echo "set -g @roost-glyph-working \"$gw\""
  echo "set -g @roost-glyph-done    \"$gd\""
  echo "set -g @roost-glyph-idle    \"$gi\""
} > "$target"

# Prints the hook JSON for the user to paste into ~/.claude/settings.json — roost
# never edits that file itself (same reason the installer prints PATH steps
# rather than editing your shell rc: don't silently rewrite a user's config).
hooks="$(ask 'Print the Claude Code hooks to add to settings.json? [y/skip]')"
case "$hooks" in y|Y|yes) "$HERE/../bin/roost" hooks ;; *) : ;; esac

echo "roost: wrote $target" >&2
echo "Reload a running roost with prefix + r, or start one with: roost" >&2
