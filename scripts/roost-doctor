#!/usr/bin/env bash
# roost doctor — preflight checks. Exit non-zero only if a REQUIRED check fails
# (tmux >= 3.2, truecolor). Optional checks warn.
required_fail=0
ok()   { printf '  ✓ %s\n' "$1"; }
warn() { printf '  ! %s\n' "$1"; }
bad()  { printf '  ✗ %s\n' "$1"; required_fail=1; }

ver="$(tmux -V 2>/dev/null | sed 's/^tmux //')"
# numeric compare: 3.2 is the floor (#{P:} pane loops, #{E:}, pane options)
maj="${ver%%.*}"; rest="${ver#*.}"; min="${rest%%[a-z]*}"
if [ -z "$maj" ]; then bad "tmux not found"
elif [ "$maj" -gt 3 ] 2>/dev/null || { [ "$maj" -eq 3 ] && [ "${min:-0}" -ge 2 ]; } 2>/dev/null; then
  ok "tmux $ver (>= 3.2)"
else
  bad "tmux $ver — need >= 3.2 (#{P:} pane loops, #{E:}, pane options)"
fi

case "${COLORTERM:-}" in
  truecolor|24bit) ok "truecolor terminal" ;;
  *) warn "COLORTERM not truecolor — the palette is #rrggbb and may band" ;;
esac

command -v fzf >/dev/null 2>&1 && ok "fzf present (prefix a switcher)" \
  || warn "fzf missing — the prefix a switcher will be unavailable"
: # python3 is not required at runtime — roost init prints the hooks for you to
  # merge by hand; only the test suite uses python3.

# roost itself must be on PATH: adapters (the opencode plugin, and any future
# one) shell out to `roost state ...` by bare name via execFile, so a pane
# goes silently unbadged — never an error, just nothing — if roost is not
# reachable that way.
command -v roost >/dev/null 2>&1 && ok "roost is on PATH" \
  || warn "roost not found on PATH — adapters (e.g. the opencode plugin) cannot report pane state"

settings="${CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
if grep -q roost-agent-state "$settings" 2>/dev/null; then
  ok "Claude hooks wired in $settings"
else
  warn "Claude hooks not found in $settings — run: roost hooks"
fi

# --- stale amux references (Phase 5 trigger) ---
# The amux compatibility shims (amux-agent-state and friends) are deleted
# once roost doctor reports clean on this pair of checks on every machine the
# author uses. Warning only, never a hard failure: a stale reference does not
# break anything today (the shim still exists), it just means this machine
# was never migrated and the shims cannot be dropped yet.
if [ -f "$settings" ] && grep -q amux-agent-state "$settings" 2>/dev/null; then
  warn "$settings still references amux-agent-state — replace those hook commands with the roost-agent-state path"
fi

ocplug_old="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugin/amux.js"
if [ -e "$ocplug_old" ] || [ -L "$ocplug_old" ]; then
  warn "$ocplug_old still exists — relink it to adapters/opencode/roost.js (or remove it)"
fi

# opencode adapter — informational. Most users will not have opencode, so a
# missing plugin is a warning, never a required failure.
if command -v opencode >/dev/null 2>&1; then
  ocplug="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugin/roost.js"
  ocwant="$(cd "$(dirname "$0")/.." && pwd)/adapters/opencode/roost.js"
  if [ -L "$ocplug" ] && [ ! -e "$ocplug" ]; then
    # -e follows symlinks, so a DANGLING link (target moved/deleted, e.g. an
    # old checkout that got removed) reads as simply absent, and the "not
    # installed" branch's `ln -s` then fails with "File exists" — the link
    # itself is still there, just pointing nowhere. Name the real fix.
    warn "opencode plugin symlink at $ocplug is dangling — run: rm \"$ocplug\" && ln -s \"$ocwant\" \"$ocplug\""
  elif [ ! -e "$ocplug" ]; then
    warn "opencode found, roost plugin not installed — run: mkdir -p \"$(dirname "$ocplug")\" && ln -s \"$ocwant\" \"$ocplug\""
  elif [ "$ocplug" -ef "$ocwant" ]; then
    ok "opencode plugin linked"
  else
    warn "opencode plugin at $ocplug is not this install — relink it to $ocwant"
  fi
fi

# --- an upgraded config may predate the error state ---
# A user who picked ascii/nerd/orbs before this branch has four saved glyph
# lines and no @roost-glyph-error, so they silently inherit the emoji default
# (tmux/roost.conf's global 💥) — an emoji in a bar they deliberately chose
# not to have emoji in. Informational only: this never fails doctor, and it
# is never auto-backfilled — doing so here could race a deliberate custom
# glyph the user set themselves.
. "$(dirname "$0")/roost-themes.sh"
. "$(dirname "$0")/lib/roost-config.sh"
if [ -f "$(roost_cfg_path)" ]; then
  cur="$(roost_current_glyphset)"
  if [ "$cur" != "custom" ]; then
    set -f; set -- $(roost_glyphset "$cur"); set +f
    want="$1"
    have="$(roost_opt @roost-glyph-error)"
    if [ "$have" != "$want" ]; then
      warn "your saved '$cur' glyph set predates the error state — the error glyph doesn't match; run: roost settings, and re-pick your glyph set"
    fi
  fi
fi

printf '\n  notify backend: %s\n' \
  "$("$(dirname "$0")/roost-notify" --which 2>/dev/null || echo 'auto (run roost init to choose)')"

[ "$required_fail" -eq 0 ]
