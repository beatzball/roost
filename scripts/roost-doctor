#!/usr/bin/env bash
# roost doctor — preflight checks. Exit non-zero only if a REQUIRED check fails
# (tmux >= 3.2, truecolor). Optional checks warn.
required_fail=0
ok()   { printf '  ✓ %s\n' "$1"; }
warn() { printf '  ! %s\n' "$1"; }
bad()  { printf '  ✗ %s\n' "$1"; required_fail=1; }

# Banner only on a terminal. `roost doctor | grep ...` and the test suite both
# capture stdout, and 20 lines of owl in front of the report would be noise
# there -- the art is for a human looking at the screen.
[ -t 1 ] && { "$(dirname "$0")/roost-banner" || true; printf '\n'; }

# Which roost wrote this report (#47). doctor is what a user pastes into a bug
# report, and a report that describes the machine in detail without naming the
# roost that produced it is missing the one field that makes the rest
# reproducible. So it is the first line of the report: a partial paste keeps
# the top.
#
# Asked of THIS checkout's bin/roost rather than read from VERSION here, so
# doctor and `roost version` read one source through one line of code and
# cannot drift. bin/roost already turns a missing or unreadable VERSION into
# the literal "unknown" rather than failing (see the comment above its `read`).
#
# An EMPTY answer is unknown too, but it is a different fault and gets its own
# words: bin/roost itself is missing, or died before dispatching (a library it
# sources is gone). VERSION may be perfectly readable then, and a report that
# blamed it would send the reader to the wrong file. Found by review.
#
# A line of context, not a check: it goes through neither ok, warn nor bad, so
# it can never touch $required_fail or doctor's exit code.
roost_root="$(cd "$(dirname "$0")/.." && pwd)"
roost_ver="$("$roost_root/bin/roost" version 2>/dev/null)"
case "$roost_ver" in
  '')      printf '  roost version: unknown (%s gave no version)\n' "$roost_root/bin/roost" ;;
  unknown) printf '  roost version: unknown (could not read %s)\n' "$roost_root/VERSION" ;;
  *)       printf '  roost version: %s\n' "$roost_ver" ;;
esac

ver="$(tmux -V 2>/dev/null | sed 's/^tmux //')"
# numeric compare: 3.2 is the floor (#{P:} pane loops, #{E:}, pane options)
maj="${ver%%.*}"; rest="${ver#*.}"; min="${rest%%[a-z]*}"
if [ -z "$maj" ]; then bad "tmux not found"
elif [ "$maj" -gt 3 ] 2>/dev/null || { [ "$maj" -eq 3 ] && [ "${min:-0}" -ge 2 ]; } 2>/dev/null; then
  ok "tmux $ver (>= 3.2)"
else
  bad "tmux $ver — need >= 3.2 (#{P:} pane loops, #{E:}, pane options)"
fi

case "${COLORTERM:-}" in
  truecolor|24bit) ok "truecolor terminal" ;;
  *) warn "COLORTERM not truecolor — the palette is #rrggbb and may band" ;;
esac

command -v fzf >/dev/null 2>&1 && ok "fzf present (prefix a switcher)" \
  || warn "fzf missing — the prefix a switcher will be unavailable"
: # python3 is not required at runtime — roost init prints the hooks for you to
  # merge by hand; only the test suite uses python3.
  #
  # It IS used, optionally, by one path: the Claude Stop hook parses that
  # event's JSON payload to pull out the turn's reply for `roost read`. With
  # neither python3 nor jq present nothing is recorded and read falls back to
  # scraping the pane's screen — degraded, announced on every read, and never
  # an error. So this warns; it does not fail, and it does not make python3 a
  # dependency.
command -v python3 >/dev/null 2>&1 || command -v jq >/dev/null 2>&1 \
  && ok "a JSON reader is present (roost read can collect Claude replies)" \
  || warn "neither python3 nor jq found — roost read will fall back to the pane's screen for Claude agents"

# roost itself must be on PATH: adapters (the opencode plugin, and any future
# one) shell out to `roost state ...` by bare name via execFile, so a pane
# goes silently unbadged — never an error, just nothing — if roost is not
# reachable that way.
command -v roost >/dev/null 2>&1 && ok "roost is on PATH" \
  || warn "roost not found on PATH — adapters (e.g. the opencode plugin) cannot report pane state"

# _settings_state FILE -> "absent" | "unreadable" | "ok". A file that exists
# but cannot be read (wrong mode, wrong owner, ...) must not read as
# "absent": `grep -q` exits 2 on a permission error with its stderr already
# discarded below, so treating that silently as "nothing to see" would hide
# the one case doctor most needs to surface accurately.
_settings_state() {
  if [ ! -e "$1" ]; then printf 'absent'
  elif [ ! -r "$1" ]; then printf 'unreadable'
  else printf 'ok'
  fi
}

# The one definition of this path lives in the adapter table, so doctor's
# report and roost install's write can never disagree about which file they
# mean -- $CLAUDE_SETTINGS included. Sourced here rather than beside the
# other two libs further down because the very next line needs it.
. "$(dirname "$0")/lib/roost-adapters.sh"
settings="$(roost_adapter_settings claude)"
# This checkout's own hook command, for the same comparison the codex branch
# further down has always made. Without it the claude check was `grep -q
# roost-agent-state`, a substring match that is true for ANY roost's hook --
# so a settings.json wired to a checkout that had since been moved, renamed or
# deleted was reported as "wired". The pane never badges (the command is a
# path that is not there), nothing is printed anywhere, and `roost install`
# refuses to repair it because it correctly sees another checkout's hook. The
# user is told everything is fine while nothing works. Found by the
# multi-model review of #27; the codex branch was already right, which is what
# made the gap visible.
clwant="$(cd "$(dirname "$0")/.." && pwd)/scripts/roost-agent-state"
case "$(_settings_state "$settings")" in
  ok)
    # grep -F, like the codex branch: the needle is a filesystem path, and a
    # basic-regex `.` in a dotted directory name matches any character, which
    # makes a check that looks strict quietly permissive.
    if ! grep -qF roost-agent-state "$settings" 2>/dev/null; then
      warn "Claude hooks not found in $settings — run: roost hooks, or run: roost install"
    elif ! grep -qF "$clwant" "$settings" 2>/dev/null; then
      # Deliberately does not try to say WHICH other checkout: reading it back
      # out means parsing JSON, which doctor does not require a tool for, and
      # printing a command string out of the user's own file as if it were
      # roost's advice is a mistake scripts/roost-install already had to fix.
      # Both fixes are named because the two cases want different ones: if
      # that checkout is gone, `roost install` now heals it; if it is a second
      # checkout you meant to keep, roost will not touch it and `roost hooks`
      # is how you move it by hand.
      warn "$settings wires a roost-agent-state from a different checkout — this one is $clwant; run: roost install (it repairs a checkout that has been moved or deleted), or re-run: roost hooks"
    else
      ok "Claude hooks wired in $settings"
      # A config copied from `roost hooks` before the reply channel existed
      # badges perfectly and records no reply, so the only symptom is that
      # `roost read` scrapes the screen forever. That notice appears on the
      # READER's terminal, which may be a different agent or a different
      # machine from the one that needs fixing — so name it here too, where
      # the person who can fix it is looking.
      #
      # The test is for the flag anywhere in the file rather than for the Stop
      # entry specifically: matching a JSON key's own array with grep is how
      # a check ends up quietly wrong, and the false positive here (someone
      # who wired the other three hooks and deliberately skipped Stop) costs a
      # line of advice, while the false negative costs the feature.
      grep -q -- --stop-hook "$settings" 2>/dev/null \
        || warn "$settings has no --stop-hook on the Stop hook — roost read will fall back to the pane's screen; re-run: roost hooks, or run: roost install"
      # Same shape, same reason, for the SessionStart context hook. A config
      # copied from `roost hooks` before that hook existed badges perfectly
      # and injects nothing, so the only symptom is an agent that does not
      # know it is inside roost — and the way THAT shows up is a bare
      # `tmux split-window` aimed at the user's ordinary server. There is no
      # error to notice; nothing is printed anywhere. So it has to be named
      # here, on the terminal of the person who can re-run the command.
      #
      # Matched on the script's name anywhere in the file rather than on the
      # SessionStart key's own array, for the reason the check above gives:
      # matching a JSON key's array with grep is how a check ends up quietly
      # wrong, and the false positive costs a line of advice while the false
      # negative costs the feature.
      grep -q roost-session-context "$settings" 2>/dev/null \
        || warn "$settings has no SessionStart hook — agents will not be told they are inside roost; re-run: roost hooks, or run: roost install"
      # Same shape again, for the StopFailure hook (#55). A config wired before
      # it existed badges every healthy turn correctly, so nothing looks wrong
      # until a turn fails on a rate limit or an overload — and then the pane
      # reads ⏳ working on an agent that has stopped, `wait-done` waits out its
      # whole timeout, and nobody connects that to a hook that is not there.
      # `roost install` adds the missing entry and leaves the rest alone
      # (tests/test-adapter-install.sh), so the tail names it.
      grep -q -- --stop-failure-hook "$settings" 2>/dev/null \
        || warn "$settings has no StopFailure hook — a Claude turn that ends on an API error (a rate limit, an overload) stays ⏳ working instead of 💥 error; re-run: roost hooks, or run: roost install"
      # And again for the PermissionRequest hook (#91). A config wired before
      # it existed still badges every dialog — six seconds late, off the
      # permission_prompt Notification — so nothing looks broken until an agent
      # answers a dialog faster than that, and then the pane never reads 🛑 at
      # all and `roost send` pastes into the open dialog. That is invisible
      # from the reader's end and hard to connect to a missing entry, so it is
      # named here, on the terminal of the person who can re-run the command.
      #
      # Matched on the flag anywhere in the file, for the reason the three
      # checks above give: matching a JSON key's own array with grep is how a
      # check ends up quietly wrong, and the false positive costs a line of
      # advice while the false negative costs the feature.
      grep -q -- --permission-request-hook "$settings" 2>/dev/null \
        || warn "$settings has no PermissionRequest hook — a Claude permission dialog is badged 🛑 six seconds late, and one answered faster than that is never badged at all; re-run: roost hooks, or run: roost install"
      # And the event that clears that 🛑 when the tool FAILS. PostToolUse
      # fires only on success, so without this entry a command that exits
      # non-zero after the human said Yes leaves the pane blocked for the rest
      # of the turn (#91, measured). docs/known-gaps.md claimed doctor named
      # this before it did (flock round 2); now it does.
      #
      # Matched on the event NAME, not on a flag: both PostToolUse entries
      # carry --tool-hook, so a flag cannot tell the two apart. Same shape as
      # the roost-session-context check above, and the same caveat — a name
      # anywhere in the file counts, which costs a line of advice in the false
      # positive and the whole feature in the false negative.
      grep -q PostToolUseFailure "$settings" 2>/dev/null \
        || warn "$settings has no PostToolUseFailure hook — a Claude tool that FAILS after you approved it leaves the pane 🛑 blocked for the rest of the turn, because PostToolUse fires only on success; re-run: roost hooks, or run: roost install"
    fi
    ;;
  unreadable) warn "$settings exists but is not readable — could not check whether Claude hooks are wired" ;;
  absent)     warn "Claude hooks not found in $settings — run: roost hooks, or run: roost install" ;;
esac

# --- roost-owned wiring (#58) -----------------------------------------------
# One row per state in the design's doctor table
# (docs/airig/specs/2026-09-15-roost-owned-settings-design.md). A · line is
# context, not a finding: like ok it never touches $required_fail, and unlike
# warn it is not something to fix — every · state below is one the user chose.
note() { printf '  · %s\n' "$1"; }
# An XDG_CONFIG_HOME that is not absolute is ignored, as the XDG spec says and
# as scripts/roost-wiring reads it, so the two agree on where the marker is.
w_xdg="${XDG_CONFIG_HOME:-}"
case "$w_xdg" in /*) : ;; *) w_xdg="" ;; esac
w_root="${w_xdg:-$HOME/.config}/roost"
# The wiring directory is the one this pane's server exported. There is one
# per roost checkout, so it cannot be worked out from where doctor runs.
w_dir="${ROOST_WIRING_DIR:-}"
# Inside a roost pane is decided by the same rule the hooks and the shim use:
# $TMUX names a socket whose path ends in /roost. Nothing else is asked, so a
# doctor run from outside roost never contacts any server for these rows.
w_sock=""
case "${TMUX%%,*}" in */roost) w_sock="${TMUX%%,*}" ;; esac
# The tmux the shim would use to read the server switch: ROOST_TMUX when it
# names a binary, else whatever tmux is on PATH — the shim's own fallback.
# Doctor reads the switch through the same one, so the two cannot disagree
# about a pane whose PATH holds no tmux (found in review).
w_tmux="${ROOST_TMUX:-}"
if [ -z "$w_tmux" ] || [ ! -x "$w_tmux" ]; then
  w_tmux="$(command -v tmux 2>/dev/null || true)"
fi
w_state=unknown
if [ -e "$w_root/wiring.off" ]; then
  w_state=removed
  note "wiring is removed ($w_root/wiring.off) — claude and opencode badge only through roost install, if you ran it; to restore, run: roost wiring on"
elif [ -z "$w_sock" ]; then
  # Outside a roost pane there is no server to ask and no wiring directory
  # to read, so nothing below is claimed either (found in review: the two
  # "runs once / runs twice" rows used to print here about files that did
  # not exist).
  note "not inside a roost pane — the claude shim check was skipped"
elif [ -n "$w_tmux" ] && [ "$("$w_tmux" -S "$w_sock" show-options -gqv @roost-wiring-enabled 2>/dev/null)" = off ]; then
  w_state=off
  note "wiring is off for this roost server — claude runs without roost's settings; to restore, run: roost wiring on"
elif [ -n "$w_tmux" ] && [ "$("$w_tmux" -S "$w_sock" show-options -gqv @roost-wiring-active 2>/dev/null)" != on ]; then
  # A roost server that was never wired: started by a roost from before this
  # existed, or apply failed quietly at server start. "Wiring is on but a file
  # is missing" was the wrong story for it (found in review round 2).
  w_state=unwired
  note "this roost server is not wired — it started before roost wiring existed, or wiring could not be applied; run: roost wiring on"
else
  w_state=on
  [ -n "${ROOST_NO_SHIM:-}" ] \
    && note "ROOST_NO_SHIM is set here — claude started from this shell or session runs without roost's settings"
  [ -n "$w_tmux" ] \
    || warn "the claude shim cannot read the server switch here — neither ROOST_TMUX nor tmux on PATH names a tmux binary, so wiring stays on; restart the roost server"
  if [ -z "$w_dir" ]; then
    # The server is wired but this pane's environment predates it: a pane that
    # was open before `roost wiring on`. Only a new pane gets the variable.
    warn "this pane has no ROOST_WIRING_DIR — it was opened before wiring was on, so claude here runs without roost's settings; open a new pane"
  elif [ ! -f "$w_dir/claude/settings.json" ]; then
    warn "wiring is on but $w_dir/claude/settings.json is missing — claude runs without roost's settings; run: roost wiring on"
  elif ! grep -q -- --permission-request-hook "$w_dir/claude/settings.json" 2>/dev/null; then
    # The SECOND place a Claude settings file lives, and the one the user
    # cannot see (flock round 1 on #91). scripts/roost-wiring regenerates this
    # file at SERVER START, so a `-L roost` server that has been up since
    # before the upgrade still hands every claude in it the old entries —
    # and the settings.json check further up says nothing, because that file
    # is fine. The symptom is the #91 bug on a machine whose `roost doctor`
    # is otherwise all ✓.
    #
    # Matched on the flag rather than on the JSON, for the reason every check
    # above gives: matching a key's own array with grep is how a check ends
    # up quietly wrong, and the false positive costs a line of advice.
    warn "$w_dir/claude/settings.json was generated before the PermissionRequest hook existed — this roost server has been running since then, so a permission dialog in it is badged 🛑 six seconds late; run: roost wiring on"
  fi
  w_claude="$(command -v claude 2>/dev/null || true)"
  if [ -n "$w_claude" ]; then
    if [ -f "$(dirname "$w_claude")/.roost-shim" ]; then
      # The ✓ only when the shim really adds the file here. With ROOST_NO_SHIM
      # set, or no file to add, the note or warning above is the whole truth,
      # and a ✓ beside it contradicted it (found in review round 2).
      if [ -z "${ROOST_NO_SHIM:-}" ] && [ -n "$w_dir" ] && [ -f "$w_dir/claude/settings.json" ]; then
        ok "claude in this pane runs through roost's shim — its hooks come from $w_dir/claude/settings.json"
      fi
    else
      # No alias in the list of causes: doctor runs in its own process, where
      # the user's shell aliases do not exist, so it cannot see one. An alias
      # to claude's full path bypasses the shim while this row reads ok.
      warn "claude in this pane resolves to $w_claude, not roost's shim — roost's settings are not added (your own default-command, or PATH order); badges then depend on: roost install"
    fi
  fi
fi
# The two routes together, compared against what the shim actually adds — the
# generated file this server names — and not against doctor's own checkout,
# which may be a different one (found in review). Identical commands from the
# global install and the generated file run once (design M4b); different ones
# run twice (M4 C3).
if [ "$w_state" = on ] && [ -f "$w_dir/claude/settings.json" ] \
   && [ "$(_settings_state "$settings")" = ok ] && grep -qF roost-agent-state "$settings" 2>/dev/null; then
  w_cmd="$(grep -o '"[^"]*/roost-agent-state' "$w_dir/claude/settings.json" 2>/dev/null | head -1 | tr -d '"')"
  if [ -n "$w_cmd" ] && grep -qF "\"$w_cmd " "$settings" 2>/dev/null; then
    ok "the global Claude hooks and roost's wiring name the same commands, so each hook runs once"
  else
    warn "the global Claude hooks name a different checkout than this server's wiring, so every roost hook runs twice — run roost install from ${w_cmd%/scripts/roost-agent-state}, or: roost wiring off"
  fi
fi
if [ -n "${OPENCODE_CONFIG_DIR:-}" ]; then
  case "$OPENCODE_CONFIG_DIR" in
    "$w_root/wiring/"*/opencode) : ;;
    *) note "OPENCODE_CONFIG_DIR is $OPENCODE_CONFIG_DIR, not roost's — roost does not replace it, so opencode badges come only from roost install" ;;
  esac
fi

# Which warnings end with ", or run: roost install", and which must not. The
# tail goes on every state that command actually resolves -- and it resolves
# more than the "not installed" ones: it relinks a DANGLING adapter (that link
# is ours and broken, so replacing it loses nothing), merges its hooks into a
# codex hooks.json that names none of them, sets copilot's EXTENSIONS flag, and
# replaces a Claude Stop hook that predates --stop-hook with the current shape.
# Measured against the real installer on a seeded box, all six went to ✓.
#
# It must NOT go on a state the installer refuses, and those sit right beside
# these: something that is not roost's at an adapter path is never replaced,
# and a hook pointing at a DIFFERENT checkout is a hard refusal. A tail there
# would send a user to a command that will read their file, decline, and leave
# them exactly where they started. tests/test-doctor.sh pins both directions,
# because a tail is the kind of thing that gets pasted onto a whole block of
# lines that look alike.
#
# roost.js is the target every opencode-plugin symlink should point at (used
# below, and by the two stale-install checks further down) — computed once,
# unconditionally, since a leftover amux.js can exist whether or not the
# opencode binary is currently on this machine.
ocplug="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugin/roost.js"
ocwant="$(cd "$(dirname "$0")/.." && pwd)/adapters/opencode/roost.js"

# Same for the copilot extension. Copilot does NOT use the XDG directories:
# `copilot help environment` documents COPILOT_HOME as the one override, with
# $HOME/.copilot as its default.
#
# The directory under extensions/ is ours to name; the FILE is not — copilot
# discovers <dir>/extension.mjs and nothing else.
cphome="${COPILOT_HOME:-$HOME/.copilot}"
cpext="$cphome/extensions/roost/extension.mjs"
cpwant="$(cd "$(dirname "$0")/.." && pwd)/adapters/copilot/extension.mjs"
cpsettings="$cphome/settings.json"

# Same for the pi extension. pi does NOT use the XDG directories either:
# docs/usage.md's environment table names PI_CODING_AGENT_DIR as the one
# override, defaulting to $HOME/.pi/agent, and it covers settings, provider
# config, auth and the extension directory.
#
# The file name under extensions/ is ours to choose -- pi discovers `*.ts` and
# `*/index.ts` -- but it must be a .ts: pi loads extensions through jiti, and
# that is the only extension the discovery glob looks for.
pihome="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
piext="$pihome/extensions/roost.ts"
piwant="$(cd "$(dirname "$0")/.." && pwd)/adapters/pi/roost.ts"

# --- stale amux references (Phase 5 trigger) ---
# The amux compatibility shims (amux-agent-state and friends) are deleted
# once roost doctor reports clean on these checks on every machine the author
# uses, so a false negative here is the expensive direction: it green-lights
# deleting a shim something still depends on. False positives are cheap.
# Warning only, never a hard failure — a stale reference does not break
# anything today (the shim still exists), it just means this location was
# never migrated.
#
# Claude Code merges hooks from THREE settings files, not just the user one
# (https://code.claude.com/docs/en/settings: "Hook entries merge across
# settings levels rather than replacing each other"):
#   user    ~/.claude/settings.json
#   project .claude/settings.json      — read from the directory the session
#                                         runs in (no upward search)
#   local   .claude/settings.local.json — read from the git repository root,
#                                         resolved through worktrees to the
#                                         MAIN checkout, so a session started
#                                         in a linked worktree still sees the
#                                         same local file as the main one;
#                                         outside a git repo (or one whose
#                                         root is $HOME) it stays in the
#                                         starting directory instead.
# Managed/enterprise settings can also carry hooks but are out of scope: they
# are administered centrally, not something doctor advises hand-editing.
_warn_stale_settings() {
  local f="$1" label="$2"
  case "$(_settings_state "$f")" in
    ok) grep -q amux-agent-state "$f" 2>/dev/null && \
      warn "$f ($label settings) still references amux-agent-state — replace those hook commands with the roost-agent-state path" ;;
    unreadable) warn "$f ($label settings) exists but is not readable — could not check it for a stale amux-agent-state hook" ;;
    absent) : ;;
  esac
}

proj_settings="$PWD/.claude/settings.json"
if git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && [ -n "$git_common_dir" ]; then
  local_root="$(dirname "$git_common_dir")"
  [ "$local_root" = "$HOME" ] && local_root="$PWD"
else
  local_root="$PWD"
fi
local_settings="$local_root/.claude/settings.local.json"

_warn_stale_settings "$settings" user
_warn_stale_settings "$proj_settings" project
_warn_stale_settings "$local_settings" local

ocplug_old="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugin/amux.js"
if [ -e "$ocplug_old" ] || [ -L "$ocplug_old" ]; then
  # There is no frozen amux half left for this to coexist with — it was
  # deleted, and the in-repo adapters/opencode/amux.js is now itself just a
  # symlink to roost.js. So a plugin file still named amux.js keeps working
  # (it forwards to the exact same roost adapter roost.js would), but that
  # is a leftover, not a reason to keep it: the advice here is unconditional.
  # "relink" is not a real fix here: `ln -sf ... amux.js` still leaves a file
  # NAMED amux.js, so this warning would fire forever and the opencode-plugin
  # check below would still say roost's plugin is not installed. Only
  # remove-then-create-roost.js clears both, so name that exact command, the
  # same way its siblings below do.
  warn "$ocplug_old still exists — it still works (it just forwards to roost.js) but there is no reason to keep the old name around; run: rm \"$ocplug_old\" && ln -s \"$ocwant\" \"$ocplug\""
fi

# opencode adapter — informational. Most users will not have opencode, so a
# missing plugin is a warning, never a required failure.
if command -v opencode >/dev/null 2>&1; then
  if [ -L "$ocplug" ] && [ ! -e "$ocplug" ]; then
    # -e follows symlinks, so a DANGLING link (target moved/deleted, e.g. an
    # old checkout that got removed) reads as simply absent, and the "not
    # installed" branch's `ln -s` then fails with "File exists" — the link
    # itself is still there, just pointing nowhere. Name the real fix.
    warn "opencode plugin symlink at $ocplug is dangling — run: rm \"$ocplug\" && ln -s \"$ocwant\" \"$ocplug\", or run: roost install"
  elif [ ! -e "$ocplug" ]; then
    warn "opencode found, roost plugin not installed — run: mkdir -p \"$(dirname "$ocplug")\" && ln -s \"$ocwant\" \"$ocplug\", or run: roost install"
  elif [ "$ocplug" -ef "$ocwant" ]; then
    ok "opencode plugin linked"
  else
    warn "opencode plugin at $ocplug is not this install — relink it to $ocwant"
  fi
fi

# GitHub Copilot CLI adapter — informational, in the same shape as the opencode
# check above. Most users will not have copilot, so a missing extension is a
# warning, never a required failure.
if command -v copilot >/dev/null 2>&1; then
  if [ -L "$cpext" ] && [ ! -e "$cpext" ]; then
    # -e follows symlinks, so a DANGLING link (an old checkout that got removed)
    # reads as simply absent, and the "not installed" branch's `ln -s` then
    # fails with "File exists". Name the real fix.
    warn "copilot extension symlink at $cpext is dangling — run: rm \"$cpext\" && ln -s \"$cpwant\" \"$cpext\", or run: roost install"
  elif [ ! -e "$cpext" ]; then
    warn "copilot found, roost extension not installed — run: mkdir -p \"$(dirname "$cpext")\" && ln -s \"$cpwant\" \"$cpext\", or run: roost install"
  elif [ "$cpext" -ef "$cpwant" ]; then
    ok "copilot extension linked"
  else
    warn "copilot extension at $cpext is not this install — relink it to $cpwant"
  fi

  # "The extension is installed" and "the extension will run" are different
  # claims, and copilot makes them differ TWICE — so a linked-and-silent
  # extension is the normal case, not an exotic one, and doctor has to check
  # rather than infer (AGENTS.md §9).
  #
  # First gate: extensions are behind a feature flag that is off by default.
  # Verified on 1.0.81, both directions — without it copilot does not read the
  # first line of the adapter, and says nothing about having skipped it.
  #
  # This is checked with grep rather than a JSON parser on purpose:
  # scripts/roost-doctor:31 holds the standing decision that python3 is not a
  # runtime dependency, and jq is not one either. The cost is that a file whose
  # flag is set to false, or set inside a comment, reads as set — so the message
  # says what was FOUND ("names EXTENSIONS") rather than claiming the flag is
  # on, and the fix it prints works either way.
  if [ -f "$cpsettings" ] && grep -q '"EXTENSIONS"' "$cpsettings" 2>/dev/null; then
    ok "copilot settings.json names the EXTENSIONS feature flag"
  else
    warn "copilot extensions are off by default — launch panes as \"copilot --experimental\", or add {\"enabledFeatureFlags\": {\"EXTENSIONS\": true}} to $cpsettings, or run: roost install"
  fi

  # Second gate, and this one cannot be checked from disk at all. In interactive
  # mode copilot asks the human to approve the extension's elevated permissions
  # — "wants to: handle permission requests" — once per directory, and denying
  # prevents it from loading. Choosing "Yes" rather than "Yes, and always allow
  # in this directory" persists nothing, so there is no file to read and no way
  # to distinguish "not yet asked" from "denied". Say so plainly instead of
  # inferring an answer: an unanswered gate looks exactly like a healthy pane.
  warn "copilot asks once per directory to approve the roost extension (\"wants to: handle permission requests\") — answer Yes, or the badges stay silent with nothing reported"
fi

# pi adapter -- informational, in the same shape as the two checks above. Most
# users will not have pi, so a missing extension is a warning, never a required
# failure.
if command -v pi >/dev/null 2>&1; then
  if [ -L "$piext" ] && [ ! -e "$piext" ]; then
    # -e follows symlinks, so a DANGLING link (an old checkout that got removed)
    # reads as simply absent, and the "not installed" branch's `ln -s` then
    # fails with "File exists". Name the real fix.
    warn "pi extension symlink at $piext is dangling — run: rm \"$piext\" && ln -s \"$piwant\" \"$piext\", or run: roost install"
  elif [ ! -e "$piext" ]; then
    warn "pi found, roost extension not installed — run: mkdir -p \"$(dirname "$piext")\" && ln -s \"$piwant\" \"$piext\", or run: roost install"
  elif [ "$piext" -ef "$piwant" ]; then
    ok "pi extension linked"
  else
    warn "pi extension at $piext is not this install — relink it to $piwant"
  fi

  # "The extension is installed" and "the badges will be complete" are different
  # claims, and for pi they differ in one specific, permanent way that no file
  # on disk records (AGENTS.md §9). pi ships NO permission prompts — its own
  # docs/usage.md:309 lists them among the things it intentionally omits — so a
  # pi pane never enters `blocked`, and `roost send`'s exit-3 refusal never
  # fires for one.
  #
  # This is not a misconfiguration and there is nothing to fix, so it is stated
  # once rather than dressed up as a problem: the point is that a user reads it
  # BEFORE they trust a pi pane's badge to tell them a human is being waited on.
  # It is a warn rather than an ok because ok lines read as "this is handled",
  # and this one is a gap the user is carrying.
  warn "pi ships no permission prompts, so a pi pane never badges blocked and \`roost send\` will not refuse one — see /docs/state-badges"

  # The second half of the same honesty, and the one with an actual fix. pi
  # loads an extension only from a trusted location, and only a .ts. A file
  # dropped in as roost.js, or a project-local .pi/extensions install in an
  # untrusted project, is silently not loaded.
  case "$piext" in
    *.ts) : ;;
    *) warn "pi only discovers *.ts extensions — $piext will never be loaded" ;;
  esac
fi

# OpenAI Codex CLI adapter — informational, like the two above, but it checks
# one more thing than they do and the extra check is the point of it.
#
# Codex is the one adapted harness that PINS its registration: it stores a hash
# of each handler in config.toml and skips any handler whose hash does not
# match, or that was never trusted at all. "The hooks are installed" and "the
# hooks will run" are therefore different claims (AGENTS.md §9), and codex will
# never tell the user they differ — measured on 0.150.1, a `codex exec` turn
# with eight untrusted hooks wired printed warnings about hook timeouts and
# about model metadata, and NOT ONE WORD about the hooks being skipped. Codex's
# own docs promise a startup warning pointing at `/hooks`; that is true of the
# TUI and false of `exec`, which is where automation lives.
#
# So this checks the trust entries rather than inferring them, in the same
# warn-with-a-fix shape as the stale-hook and dangling-symlink checks above.
cxhome="${CODEX_HOME:-$HOME/.codex}"
cxhooks="$cxhome/hooks.json"
cxconfig="$cxhome/config.toml"
cxwant="$(cd "$(dirname "$0")/.." && pwd)/adapters/codex/roost-codex-hook"
if command -v codex >/dev/null 2>&1; then
  # grep -F throughout: every needle here is a filesystem path, and a path is
  # full of regex metacharacters (`.` in a dotted directory is the common one).
  # A basic-regex `.` matching any character would make a check that looks
  # strict quietly permissive.
  if [ ! -e "$cxhooks" ]; then
    warn "codex found, roost hooks not written — run: roost hooks codex, and copy the JSON object into $cxhooks, or run: roost install"
  elif [ ! -r "$cxhooks" ]; then
    warn "$cxhooks exists but is not readable — could not check whether codex hooks are wired"
  elif ! grep -qF roost-codex-hook "$cxhooks" 2>/dev/null; then
    warn "$cxhooks does not reference roost-codex-hook — run: roost hooks codex, or run: roost install"
  elif ! grep -qF "$cxwant" "$cxhooks" 2>/dev/null; then
    # "A different checkout" is only true while that checkout still exists.
    # Once it has been moved, renamed or deleted, saying so sends the reader
    # looking for a checkout that is not there -- and this is the common case,
    # because a checkout that is genuinely still around is one somebody keeps
    # on purpose. scripts/roost-install draws the same distinction, in the
    # same words; the two must agree or doctor's report and the installer's
    # refusal describe different problems.
    #
    # The wired path is pulled out with grep -o rather than a JSON parser:
    # doctor does not require jq or python3, and this is a message, not a
    # decision. If the extraction finds nothing the check falls back to the
    # original wording, which is the safe direction to be wrong in.
    cxwired="$(grep -o '"[^"]*roost-codex-hook[^"]*"' "$cxhooks" 2>/dev/null | head -1 | tr -d '"')"
    cxwired="${cxwired%%roost-codex-hook*}roost-codex-hook"
    if [ -n "$cxwired" ] && [ ! -e "$cxwired" ]; then
      warn "$cxhooks wires a roost-codex-hook from a checkout that no longer exists — this one is $cxwant; roost will not rewrite it (that would re-hash the handler and silently un-badge this machine), so fix it by hand: re-run: roost hooks codex"
    else
      warn "$cxhooks wires a roost-codex-hook from a different checkout — this one is $cxwant; re-run: roost hooks codex"
    fi
  else
    ok "codex hooks wired in $cxhooks"
    # --- the Interrupt handler still carrying the old timeout ---------------
    # The one roost upgrade that changes a handler codex has already hashed,
    # and therefore the one an install can leave half-applied. A hooks.json
    # written before the change asks for 10, codex clamps it to 3 and warns
    # with this file's full path on every start; the fix is `roost install`,
    # which replaces roost's own entry, followed by one more trust answer.
    #
    # Worth detecting rather than trusting the installer to have run, because
    # the two failures look identical from the badge's side and have opposite
    # fixes: an un-rewritten hooks.json still works (codex clamps and warns),
    # while a rewritten-but-untrusted one silently runs no Interrupt hook at
    # all. The trust count below reports the second; this reports the first.
    #
    # Whitespace is normalised away before matching because both layouts are
    # legitimate: `roost hooks codex` prints the handler on one line, and the
    # installer's JSON writer indents it over five. The terminator is part of
    # the needle so that a timeout of 30 can never read as a 3.
    cxint="$(grep -F -A3 "$cxwant Interrupt\"" "$cxhooks" 2>/dev/null | tr -d ' \t\n')"
    case "$cxint" in
      *'"timeout":3,'*|*'"timeout":3}'*) : ;;
      *'"timeout":'*)
        warn "the Interrupt handler in $cxhooks still asks for a timeout codex will not honour — codex caps it at 3s, clamps it, and warns with this path on every start. Run: roost install, then answer \"Trust all and continue\" at codex's \"Hooks need review\" once more" ;;
    esac
    # The trust key is "<absolute hooks.json path>:<snake_case event>:<group>:<handler>",
    # one entry per handler, verified live. Counting the four roost registers
    # separates "never trusted" (0) from "trusted, then hooks.json was edited by
    # hand and re-prompted for only some" (1-3), which are different problems
    # with different fixes.
    #
    # Five since #38 added Interrupt. A machine that trusted the first four
    # before Interrupt existed has exactly the other four and not that one, and
    # its fix is not "something was hand-edited": codex simply has a new handler
    # to ask about. So that case gets its own words.
    #
    # The key `interrupt` is measured, not guessed from the other four's
    # snake_case: codex-cli 0.154.0, trusting a hooks.json that registered all
    # twelve events, wrote `<hooks.json>:interrupt:0:0` into config.toml.
    trusted=0
    interrupt_trusted=0
    for _ev in user_prompt_submit post_tool_use permission_request stop interrupt; do
      if grep -qF "$cxhooks:$_ev:0:0" "$cxconfig" 2>/dev/null; then
        trusted=$((trusted + 1))
        [ "$_ev" = interrupt ] && interrupt_trusted=1
      fi
    done
    case "$trusted" in
      5) ok "codex has trusted all five roost hooks" ;;
      0) warn "codex has trusted NONE of the five roost hooks, so every badge is silently skipped — run: codex, then answer \"Trust all and continue\" at \"Hooks need review\"" ;;
      4) if [ "$interrupt_trusted" = 0 ]; then
           warn "codex has trusted four of the five roost hooks, but not Interrupt, which is new — until it is trusted, a dialog answered No or Esc leaves the pane blocked. Run: codex, then answer \"Trust all and continue\" at \"Hooks need review\" once more"
         else
           warn "codex has trusted only $trusted of the five roost hooks — the rest are silently skipped; a trust entry records a HASH of the handler, so hand-editing $cxhooks after trusting it invalidates that entry. Run: codex, then /hooks, and trust the remainder"
         fi ;;
      *) warn "codex has trusted only $trusted of the five roost hooks — the rest are silently skipped; a trust entry records a HASH of the handler, so hand-editing $cxhooks after trusting it invalidates that entry. Run: codex, then /hooks, and trust the remainder" ;;
    esac
    # What this check CANNOT see, recorded here rather than printed on every
    # healthy run. The stored value is a hash of the normalised handler, and
    # roost does not know codex's normalisation, so four present entries are
    # not proof that four hooks will fire: a hooks.json hand-edited after trust
    # was granted keeps its entries and loses its hooks. Nothing on this machine
    # can tell those two apart from the outside.
    #
    # It is left as a comment because roost's answer to it is upstream of
    # doctor: `roost hooks codex` emits handler objects that are frozen, so a
    # roost upgrade is almost never the cause — and a standing warning on a
    # correct install is the "cries wolf" failure this file's own error-glyph
    # check was split in two to avoid.
    #
    # "Almost never" rather than "never" since the Interrupt timeout moved from
    # 10 to 3. That is the one upgrade that can leave a machine with five trust
    # entries and four working hooks, which is exactly the state this check
    # cannot see. It is not left undetected, though: the timeout check above
    # catches the half of it roost CAN read — a hooks.json still carrying the
    # old number — and the installer prints the trust step on every run.
  fi
fi

# --- the saved error glyph doesn't match the saved glyph set ---
# Two different situations reach this check, and the old single message named
# one of them as the cause for both:
#
#   1. The config predates the `error` state. It has four glyph lines and no
#      @roost-glyph-error at all, so the bar inherits tmux/roost.conf's global
#      💥 — an emoji in a bar the user deliberately chose not to have emoji in.
#   2. The user set a custom error glyph on an otherwise-standard set. Nothing
#      is wrong; roost_glyphset_match ignores the fifth glyph when naming a
#      set, so this is exactly as expected.
#
# Telling case 2 that their config "predates the error state" is simply false.
# So the branches are split and each says only what was OBSERVED, leaving the
# cause to the person who knows it. Both stay warnings, and neither ever fails
# doctor.
#
# The presence of the LINE is what separates them, not the value — which is
# why this reads the saved file through roost_cfg_file_has/roost_cfg_file_opt
# rather than roost_opt. roost_opt answers from a running server first, and a
# server has already filled the missing option in with the global default, so
# case 1 and case 2 look identical through it. The advice is about the config
# file, so the observation must be too.
#
# `roost init`'s legacy migration now backfills case 1 for the configs it
# creates (roost_backfill_glyph_error). This check is still live for the ones
# it cannot reach: a roost.conf migrated before that fix, or a hand-edited
# one. doctor itself still never writes config.
. "$(dirname "$0")/roost-themes.sh"
. "$(dirname "$0")/lib/roost-config.sh"
cfgfile="$(roost_cfg_path)"
if [ -f "$cfgfile" ]; then
  cur="$(roost_current_glyphset)"
  if [ "$cur" != "custom" ]; then
    set -f; set -- $(roost_glyphset "$cur"); set +f
    want="$1"
    # The fallback is the emoji set's error glyph because that is literally
    # what tmux/roost.conf sets globally; naming it beats printing the empty
    # string roost_cfg_file_opt returns for a line that isn't there.
    set -f; set -- $(roost_glyphset emoji); set +f
    fallback="$1"
    if ! roost_cfg_file_has "$cfgfile" @roost-glyph-error; then
      warn "$cfgfile has no @roost-glyph-error line, so your saved '$cur' glyph set falls back to the built-in '$fallback' for the error badge — run: roost settings, and re-pick '$cur' to write all five"
    else
      have="$(roost_cfg_file_opt "$cfgfile" @roost-glyph-error)"
      if [ "$have" != "$want" ]; then
        warn "$cfgfile sets @roost-glyph-error to '$have', where the '$cur' set's own error glyph is '$want' — if you chose that yourself there is nothing to fix; otherwise run: roost settings, and re-pick '$cur'"
      fi
    fi
  fi
fi

# --- a pane that may be stuck on blocked (#38) ---
# Read-only, like every check in this file: it names panes and changes nothing.
#
# A pane stamped 🛑 for a long time with no permission dialog on its screen is
# probably one whose dialog was declined or dismissed and never cleared: a
# Claude hook wired before #38 records no transcript, a codex install whose
# Interrupt hook is not trusted yet fires nothing, and any other harness may
# have the same hole. `send`, `read` and `wait-done` clear the Claude case on
# their own when they can prove it from Claude's transcript. This is the line
# for everything they cannot prove.
#
# The screen is read ONLY to leave a pane out of this report. It is a guess and
# is worded as one ("may be stuck"), and nothing is ever set or cleared on it.
# roost_cfg_tmux addresses $ROOST_CONFIG_SOCK or the roost server by name, the
# same server the glyph check above reads.
stuck_after=600
now="$(date +%s)"
panes="$(roost_cfg_tmux list-panes -a -F '#{@agent_state} #{@agent_since} #{pane_id} #{session_name}:#{window_index}' 2>/dev/null || true)"
while read -r _st _since _id _where; do
  [ "$_st" = "blocked" ] || continue
  case "$_since" in ''|*[!0-9]*) continue ;; esac
  case "$_id" in %[0-9]*) : ;; *) continue ;; esac
  _age=$((now - 10#$_since))
  [ "$_age" -ge "$stuck_after" ] || continue
  if roost_cfg_tmux capture-pane -p -t "$_id" 2>/dev/null \
      | grep -qiE 'do you want|would you like to run|esc to cancel|enter to (select|confirm)|allow (once|always)'; then
    continue
  fi
  warn "$_id ($_where) has read blocked for ${_age}s with no permission dialog on screen — it may be stuck. If nothing is waiting there, type into it, or run: roost send --force $_id \"...\""
done <<< "$panes"

printf '\n  notify backend: %s\n' \
  "$("$(dirname "$0")/roost-notify" --which 2>/dev/null || echo 'auto (run roost init to choose)')"

[ "$required_fail" -eq 0 ]
