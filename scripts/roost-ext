#!/usr/bin/env bash
# roost ext — the extension seam's own subcommand. bin/roost's `ext)` arm
# execs straight into this file, the same shape `install`/`update`
# (scripts/roost-install) and `validate` (scripts/roost-validate) already
# use, so this file's own `case` is where the VERB lives.
#
# Only `list` and `info` exist so far. `install`, `verify`, `update` and
# `remove` are tasks 6-8 of the same plan; the usage error below already
# names all six so a user typing one of the not-yet-built ones is told it is
# coming rather than told it is a typo. See
# docs/airig/specs/2026-09-08-extension-seam.md, "Commands".
#
# Read-only, no network: neither verb here writes ext.lock or ext.index, and
# neither touches tmux. `set -euo pipefail`, the same as bin/roost, because
# this file has the same shape (a `case` dispatching short, mostly-linear
# branches) and the same hazard -- a command substitution whose failure
# should be CAUGHT, not left to fall through -- so every fallible
# substitution below is written `if x="$(...)"; then ... else ... fi`, never
# a bare assignment. `roost_ext_index_lookup`'s own header spells out why a
# bare call under `set -e` is the wrong shape to copy.
set -euo pipefail

. "$(dirname "$0")/lib/roost-ext.sh"

# --- reading ext.lock for display (NOT the dispatcher's authority read) -----
#
# This is a SEPARATE reader from roost_ext_index_write's, on purpose. That one
# lives in scripts/lib/roost-ext.sh because it decides a GRANT -- the
# fourth column of ext.index the dispatcher trusts -- and nothing about
# reading a lockfile for a human to look at should share code with the
# function that makes a security decision. This reader only ever feeds
# `roost ext list`/`info`'s stdout; it is not consulted by bin/roost's
# dispatcher and never will be.
#
# One row per lockfile entry, TAB-separated, sorted by name (matching
# roost_ext__index_py/jq's own sort, so the two are easy to eyeball side by
# side): name, repo, ref, commit, tree, contract, needs (comma-separated),
# commands (comma-separated), installed. An absent or empty field prints the
# placeholder `-` rather than nothing, the same way `list`/`info` show it --
# NOT the empty string roost_ext_manifest_read's contract uses for the same
# case. That is a deliberate departure, not an inconsistency: this row has
# NINE columns and several of them are routinely absent (tree, contract,
# needs, installed are all optional), so a real lockfile puts more than one
# EMPTY field in the MIDDLE of a row. bash's `read` with `IFS=$'\t'` still
# squeezes consecutive tab characters as if they were plain whitespace --
# measured directly: `IFS=$'\t'; read -r a b c d e <<<$'x\t\t\ty\t'` reads
# back as `a=x b=y c= d= e=`, not `a=x b= c= d=y e=`. Every field this reader
# produces is therefore guaranteed non-empty, which is what actually defeats
# the squeeze; a caller may still show `-` as "none" or "unknown" itself.
_ext_lock_rows_py() {
  cat <<'PY'
import json
import sys


def w(text):
    sys.stdout.buffer.write(text.encode("utf-8"))


def die(msg):
    w("roost-ext-error=" + msg + "\n")
    raise SystemExit(0)


try:
    data = json.load(sys.stdin)
except Exception as exc:
    sys.stderr.write(str(exc) + "\n")
    raise SystemExit(1)
if not isinstance(data, dict):
    die("top-level JSON value must be an object")


def scalar(entry, key, name):
    if key not in entry:
        return "-"
    value = entry[key]
    # bool is an int subclass in python -- "contract": true must not read as 1.
    if isinstance(value, bool) or not isinstance(value, (str, int)):
        die("entry '%s' field '%s' must be a string or an integer" % (name, key))
    # `or "-"` catches a JSON value that is the empty string, not only an
    # absent key -- both mean "nothing here" to this reader, and only the
    # placeholder keeps a field from ever being genuinely empty (see the
    # header comment on why that matters for `read` on the caller's side).
    return (value if isinstance(value, str) else "%d" % value) or "-"


def strlist(entry, key, name):
    if key not in entry:
        return "-"
    value = entry[key]
    if not isinstance(value, list):
        die("entry '%s' field '%s' must be an array" % (name, key))
    out = []
    for item in value:
        if not isinstance(item, str) or not item:
            die("entry '%s' field '%s' must contain only non-empty strings" % (name, key))
        out.append(item)
    return ",".join(out) or "-"


rows = []
for name in sorted(data):
    entry = data[name]
    if not isinstance(entry, dict):
        die("entry '%s' is not an object" % name)
    fields = [
        name,
        scalar(entry, "repo", name),
        scalar(entry, "ref", name),
        scalar(entry, "commit", name),
        scalar(entry, "tree", name),
        scalar(entry, "contract", name),
        strlist(entry, "needs", name),
        strlist(entry, "commands", name),
        scalar(entry, "installed", name),
    ]
    # A value carrying a tab or a newline would turn one row into more than
    # one field, or more than one line, and the caller's `while IFS=$'\t'
    # read` has no escaping to undo that with.
    for field in fields:
        if "\n" in field or "\r" in field or "\t" in field:
            die("entry '%s' has a field containing a tab or newline" % name)
    rows.append("\t".join(fields))
w("\n".join(rows))
if rows:
    w("\n")
PY
}

# _ext_lock_rows_jq -- agrees with _ext_lock_rows_py line for line and message
# for message, the same discipline roost_ext__manifest_jq and
# roost_ext__index_jq hold themselves to: a machine with only jq must show a
# user exactly what a machine with only python3 would. tests/test-ext.sh has
# a `_ext_lock_rows_parity_case` harness (next to `parity_case` and
# `index_parity_case`, the same idea applied to this third engine pair) that
# runs both engines against the same lockfile and diffs their answers --
# every fix below came out of a case that harness caught.
#
# scalarv/strlistv take `$e` and `$k`, not a pre-extracted `$v` -- jq's `.foo`
# on an object cannot tell "key absent" from "key present with value null"
# apart, both come back as the jq value `null`, and those two have to answer
# DIFFERENTLY: python's `scalar`/`strlist` return the placeholder for a
# MISSING key but `die()` on a key that is explicitly `null` (`isinstance(None,
# ...)` is false, same as any other wrong type). A first version of this
# function read `$e.repo` at the call site and folded both cases into `"-"`,
# so `{"ref": null}` printed a placeholder row where python3 refused the
# lockfile outright -- caught by the parity harness, not by inspection.
_ext_lock_rows_jq() {
  cat <<'JQ'
def scalarv($n; $e; $k):
  if ($e | has($k)) then
    ($e[$k] as $v
     | if ($v | type) == "string" then
         (if ($v | test("[\n\r\t]")) then {err: ("entry '" + $n + "' has a field containing a tab or newline")}
          elif $v == "" then "-"
          else $v end)
       elif ($v | type) == "number" then
         (if ($v | tostring | test("^-?[0-9]+$")) then ($v | tostring)
          else {err: ("entry '" + $n + "' field '" + $k + "' must be a string or an integer")} end)
       else {err: ("entry '" + $n + "' field '" + $k + "' must be a string or an integer")} end)
  else "-" end;
def strlistv($n; $e; $k):
  if ($e | has($k)) then
    ($e[$k] as $v
     | if ($v | type) != "array" then {err: ("entry '" + $n + "' field '" + $k + "' must be an array")}
       elif any($v[]; (type != "string") or (. == "")) then {err: ("entry '" + $n + "' field '" + $k + "' must contain only non-empty strings")}
       elif any($v[]; test("[\n\r\t]")) then {err: ("entry '" + $n + "' has a field containing a tab or newline")}
       else (($v | join(",")) as $s | if $s == "" then "-" else $s end) end)
  else "-" end;
if type != "object" then ["roost-ext-error=top-level JSON value must be an object"]
else
  ( [ to_entries | sort_by(.key)[]
      | .key as $n | .value as $e
      | if ($e | type) != "object" then [{err: ("entry '" + $n + "' is not an object")}]
        # The NAME is a field too, and python3's tab/newline loop at
        # _ext_lock_rows_py:121-123 checks all nine fields it builds,
        # `name` (field 0) included -- a key of "a\tb" is exactly what the
        # parity harness's tab-in-the-key case sends through both engines.
        # Checked here, before any of the nine fields are built, rather than
        # folded into the same `any(.[]; ...)` sweep the OTHER eight already
        # get below: name is not inside that array (it is the array's first
        # ELEMENT, already a plain string by the time it is built), so a scan
        # over the finished row would need its own special case for element
        # zero -- checking $n on its own line here is the same rule with no
        # extra case to keep in sync.
        elif ($n | test("[\n\r\t]")) then [{err: ("entry '" + $n + "' has a field containing a tab or newline")}]
        else
          [ $n,
            scalarv($n; $e; "repo"),
            scalarv($n; $e; "ref"),
            scalarv($n; $e; "commit"),
            scalarv($n; $e; "tree"),
            scalarv($n; $e; "contract"),
            strlistv($n; $e; "needs"),
            strlistv($n; $e; "commands"),
            scalarv($n; $e; "installed") ]
        end
    ] ) as $rows
  | ([$rows[] | select(any(.[]; type == "object"))] | first) as $bad
  | if $bad != null then ["roost-ext-error=" + ($bad[] | select(type == "object") | .err)]
    else [$rows[] | join("\t")]
    end
end
| .[]
JQ
}

# _ext_lock_rows FILE -> the rows above, on stdout. Same 0/1/3 contract as
# roost_ext_manifest_read: 0 printed, 1 refused (message on stderr, naming
# what), 3 neither python3 nor jq is on PATH.
_ext_lock_rows() {
  roost_ext__json_read "$1" _ext_lock_rows_py _ext_lock_rows_jq
}

# _ext_join_comma -> read lines on stdin (blank ones skipped), print them
# comma-and-space joined on one line, no trailing newline. Only ever called
# once `list` has already found -- or is about to report -- a disagreement,
# so this is never a fork on an ordinary, agreeing run.
_ext_join_comma() {
  local line result=""
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    if [ -n "$result" ]; then
      result="$result, $line"
    else
      result="$line"
    fi
  done
  printf '%s' "$result"
}

# --- the disagreement check --------------------------------------------------
#
# A SECURITY check, not a tidiness one -- see
# docs/airig/specs/2026-09-08-extension-seam.md, "ext.index is the authority
# of record". Since task 3 the dispatcher in bin/roost reads the authority
# an extension runs with off ext.index ALONE and never opens ext.lock again,
# so a lockfile that has moved on -- an authority revoked, an extension
# removed by hand -- has no effect at all until something regenerates
# ext.index. Measured on this implementation: editing ext.lock's `needs` down
# to `[]` and leaving ext.index alone leaves the grant standing.
#
# This does NOT re-derive "agree" by reading ext.lock's fields itself and
# comparing them one by one to ext.index's columns -- that would be a THIRD
# definition of what the two files are supposed to say, alongside
# roost_ext_index_write's Python and jq engines, and a fourth place that could
# drift from the other three. Instead it asks those exact two engines what
# ext.index WOULD look like if regenerated right now, and compares that,
# byte for byte, against what is actually on disk. That is the same
# question roost_ext_index_write itself answers before it writes -- this
# function only stops short of the write.
_ext_index_disagrees() {
  # Sets _EXT_DISAGREE_NAMES: a comma-and-space-joined list of every
  # extension the disagreement is about. Cleared on entry, the same
  # discipline roost_ext_index_lookup's own output variables use, so a
  # caller under `set -u` can always read it whichever way this returns.
  _EXT_DISAGREE_NAMES=""
  local lock="$1" index="$2" data_dir="$3" all_rows="$4"
  local expected="" actual="" rc=0
  if [ -f "$lock" ]; then
    if expected="$(roost_ext__json_read "$lock" roost_ext__index_py roost_ext__index_jq "$data_dir" 2>/dev/null)"; then
      rc=0
    else
      rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
      # ext.lock parses well enough to DISPLAY -- the caller already read it
      # successfully with _ext_lock_rows, or this branch is never reached --
      # but not well enough to regenerate ext.index from: an empty
      # `commands` array, a name with a space, two entries claiming one
      # command by hand-edit, and so on. That is UNCONDITIONALLY a
      # disagreement, and every name ext.lock claims is named, not only the
      # ones a byte comparison happens to catch -- there is no well-formed
      # `expected` index left to compare any single one of them against.
      #
      # A first version of this function treated this branch as "expected
      # nothing" and compared THAT against `actual`, which reads as
      # agreement whenever the on-disk index also happens to be empty --
      # exactly the shape `{"a": {"repo":"o/a","commands":[]}}` with an
      # empty ext.index leaves. That lockfile names an extension ext.index
      # names none of, which is precisely the disagreement this function
      # exists to catch, and the old code printed nothing at all for it.
      _EXT_DISAGREE_NAMES="$(printf '%s\n' "$all_rows" | awk -F'\t' 'NF{print $1}' | sort -u | _ext_join_comma)"
      return 0
    fi
  fi
  if [ -f "$index" ]; then
    if actual="$(cat "$index" 2>/dev/null)"; then
      :
    else
      actual=""
    fi
  fi
  if [ "$expected" = "$actual" ]; then
    return 1
  fi
  # Which NAMES the disagreement is about, and how. Column 2 of either side
  # is the extension name (column 1 is the COMMAND, and one extension can
  # claim several, hence grouping by name rather than diffing lines
  # one-for-one); a name present on only one side, or whose full set of rows
  # differs between the two, is named, and its authority column is compared
  # explicitly -- "which authority" is the actionable half of a security
  # warning, and "the two files differ somewhere" is not.
  local n="" names="" exp_n="" act_n="" exp_needs="" act_needs="" detail="" disagreeing=""
  names="$(printf '%s\n%s\n' "$expected" "$actual" | awk -F'\t' 'NF{print $2}' | sort -u)"
  while IFS= read -r n || [ -n "$n" ]; do
    [ -n "$n" ] || continue
    exp_n="$(printf '%s\n' "$expected" | awk -F'\t' -v want="$n" '$2==want')"
    act_n="$(printf '%s\n' "$actual"   | awk -F'\t' -v want="$n" '$2==want')"
    if [ "$exp_n" = "$act_n" ]; then
      continue
    fi
    if [ -z "$exp_n" ]; then
      detail="$n (in ext.index only)"
    elif [ -z "$act_n" ]; then
      detail="$n (in ext.lock only)"
    else
      exp_needs="$(printf '%s\n' "$exp_n" | head -1 | awk -F'\t' '{print $4}')"
      act_needs="$(printf '%s\n' "$act_n" | head -1 | awk -F'\t' '{print $4}')"
      [ -n "$exp_needs" ] || exp_needs="none"
      [ -n "$act_needs" ] || act_needs="none"
      if [ "$exp_needs" != "$act_needs" ]; then
        detail="$n (authority: ext.lock now says '$exp_needs', ext.index still grants '$act_needs')"
      else
        detail="$n (claimed commands differ)"
      fi
    fi
    disagreeing="$disagreeing
$detail"
  done <<EOF
$names
EOF
  _EXT_DISAGREE_NAMES="$(printf '%s' "$disagreeing" | _ext_join_comma)"
  return 0
}

# The wording a user actually reads. Deliberately says WHICH file wins
# (ext.index), WHY (the dispatcher never opens ext.lock), and HOW to make them
# agree again (re-run whatever last wrote ext.lock, which regenerates
# ext.index in the same step) -- an untidiness warning would say only that the
# two differ, and that is the version of this message the design spec calls
# out as the wrong one to ship. Names the affected extension(s) (from
# _ext_index_disagrees's own _EXT_DISAGREE_NAMES) rather than speaking only
# in the abstract, and stays under 150 characters a line -- no user-facing
# line in roost-install or roost-validate runs longer than that.
_ext_index_disagree_warning() {
  local names="$1"
  printf 'roost ext list: SECURITY WARNING — ext.lock and ext.index disagree: %s\n' "$names"
  printf "roost ext list: bin/roost's dispatcher grants authority from ext.index alone and\n"
  printf 'roost ext list: never reads ext.lock again after install, so an extension can hold\n'
  printf 'roost ext list: (or lack) authority ext.lock no longer agrees with, until something\n'
  printf 'roost ext list: rewrites ext.index. See docs/airig/specs/2026-09-08-extension-seam.md,\n'
  printf 'roost ext list: "ext.index is the authority of record".\n'
  printf 'roost ext list: ext.index is the file being obeyed right now — NOT ext.lock.\n'
  printf 'roost ext list: every command that writes ext.lock (install, update, remove)\n'
  printf 'roost ext list: regenerates ext.index in the same step. Re-run whichever of those\n'
  printf 'roost ext list: last touched the extension(s) named above to fix this.\n'
}

case "${1:-}" in
  list)
    lock="$(roost_ext_lock)"
    index="$(roost_ext_index)"
    data_dir="$(roost_ext_data_dir)"

    rows=""
    if [ -f "$lock" ]; then
      if rows="$(_ext_lock_rows "$lock")"; then
        rc=0
      else
        rc=$?
      fi
      case "$rc" in
        0) : ;;
        3)
          echo "roost ext list: neither python3 nor jq found on PATH — cannot read $lock" >&2
          exit 1
          ;;
        *)
          # _ext_lock_rows already printed roost_ext__json_read's own message
          # naming what was wrong with the file.
          exit 1
          ;;
      esac
    fi

    if _ext_index_disagrees "$lock" "$index" "$data_dir" "$rows"; then
      _ext_index_disagree_warning "$_EXT_DISAGREE_NAMES" >&2
    fi

    if [ -z "$rows" ]; then
      echo "no extensions installed — install one with: roost ext install <org>/<repo>"
      exit 0
    fi

    # IFS pinned to TAB alone, the same reason roost_ext_index_lookup pins it:
    # an install path or a description can legitimately contain a space.
    # `|| [ -n "$name" ]` reads a final row with no trailing newline, which is
    # exactly what _ext_lock_rows_py/jq print when there is exactly one entry.
    while IFS=$'\t' read -r name repo ref commit tree contract needs commands installed \
        || [ -n "$name" ]; do
      [ -n "$name" ] || continue
      # commit is never the empty string here -- _ext_lock_rows_py/jq print
      # `-` for a missing one -- and `${-:0:7}` is `-` right back, so no
      # separate "was it recorded at all" check is needed.
      short="${commit:0:7}"
      disp_commands="${commands//,/, }"
      line="$name  $short  $disp_commands"
      # roost_ext_name_valid is the SAME grammar `roost ext install` enforces
      # on the directory name before anything is written to disk -- a name
      # that fails it could never have come from this feature's own writer,
      # only from a lockfile edited by hand. A name like "../secret" is
      # never used to touch the filesystem here: even the read-only
      # existence check below would be answering a question about somewhere
      # this feature has no business looking, which is the read-side version
      # of the traversal the spec already requires `install` to refuse on
      # the write side ("any path resolving outside the extension
      # directory").
      if roost_ext_name_valid "$name"; then
        if [ ! -d "$data_dir/$name" ]; then
          line="$line (missing)"
        fi
      else
        line="$line (invalid name, not something roost ext install could have written)"
      fi
      printf '%s\n' "$line"
    done <<EOF
$rows
EOF
    ;;

  info)
    shift
    name="${1:-}"
    if [ -z "$name" ]; then
      echo "usage: roost ext info NAME" >&2
      exit 2
    fi
    # A name is matched against ext.lock's own keys below by exact string
    # comparison, but refused HERE, before that lookup and before it is used
    # to build any path at all, if it fails roost_ext_name_valid -- the same
    # grammar `roost ext install` enforces on the install DIRECTORY name.
    # A name that fails it could never have been installed through this
    # feature, only written into ext.lock by hand, and a hand-edited key of
    # "../secret" is exactly what would otherwise make `info` read
    # $data_dir/../secret/roost-ext.json: a real file outside the
    # extensions directory entirely. The spec already requires `install` to
    # refuse "any path resolving outside the extension directory" on the
    # WRITE side; this is the same property, enforced on the READ side.
    if ! roost_ext_name_valid "$name"; then
      echo "roost ext info: no such extension: $name" >&2
      exit 1
    fi

    lock="$(roost_ext_lock)"
    data_dir="$(roost_ext_data_dir)"
    state_dir="$(roost_ext_state_dir)"
    clone_dir="$data_dir/$name"
    ext_state_dir="$state_dir/$name"

    found=0
    repo=""; ref=""; commit=""; tree=""; contract=""; needs=""; commands=""; installed=""
    if [ -f "$lock" ]; then
      if rows="$(_ext_lock_rows "$lock")"; then
        rc=0
      else
        rc=$?
      fi
      case "$rc" in
        0) : ;;
        3)
          echo "roost ext info: neither python3 nor jq found on PATH — cannot read $lock" >&2
          exit 1
          ;;
        *) exit 1 ;;
      esac
      while IFS=$'\t' read -r rname rrepo rref rcommit rtree rcontract rneeds rcommands rinstalled \
          || [ -n "$rname" ]; do
        [ -n "$rname" ] || continue
        if [ "$rname" = "$name" ]; then
          found=1
          repo="$rrepo"; ref="$rref"; commit="$rcommit"; tree="$rtree"
          contract="$rcontract"; needs="$rneeds"; commands="$rcommands"; installed="$rinstalled"
          break
        fi
      done <<EOF
$rows
EOF
    fi

    # The lockfile, not the clone, is the record of what is installed --
    # roost_ext_index_lookup's own header makes the same call for the
    # dispatcher. An unknown NAME is one that is not a key in ext.lock, full
    # stop; a clone sitting on disk under a name nothing installed does not
    # make it known.
    if [ "$found" -ne 1 ]; then
      echo "roost ext info: no such extension: $name" >&2
      exit 1
    fi

    # repo/ref/commit/tree/contract/installed are never the empty string here
    # -- _ext_lock_rows_py/jq already print `-` for a field that was absent,
    # so there is nothing left to default. `needs` gets its OWN word, "none",
    # because "-" reads as "unknown"; "none" is the actual claim the design
    # makes about an absent `needs` (see "Declared authority").
    disp_repo="$repo"
    disp_ref="$ref"
    disp_commit="$commit"
    disp_tree="$tree"
    disp_contract="$contract"
    disp_commands="${commands//,/, }"
    disp_installed="$installed"
    if [ "$needs" = "-" ]; then
      disp_needs="none"
    else
      disp_needs="$needs"
    fi

    echo "name: $name"
    echo
    echo "lockfile entry:"
    printf '  repo       %s\n' "$disp_repo"
    printf '  ref        %s\n' "$disp_ref"
    printf '  commit     %s\n' "$disp_commit"
    printf '  tree       %s\n' "$disp_tree"
    printf '  contract   %s\n' "$disp_contract"
    printf '  needs      %s\n' "$disp_needs"
    printf '  commands   %s\n' "$disp_commands"
    printf '  installed  %s\n' "$disp_installed"
    echo
    echo "manifest (from the clone):"
    manifest="$clone_dir/roost-ext.json"
    if [ -f "$manifest" ]; then
      if man="$(roost_ext_manifest_read "$manifest")"; then
        mrc=0
      else
        mrc=$?
      fi
      if [ "$mrc" -eq 0 ]; then
        while IFS='=' read -r mkey mval || [ -n "$mkey" ]; do
          [ -n "$mkey" ] || continue
          printf '  %-11s %s\n' "$mkey" "$mval"
        done <<EOF2
$man
EOF2
      else
        echo "  (could not be read — see the message above)"
      fi
    else
      # The clone can be gone while the lockfile entry above is not: the
      # lockfile is the record of what is installed, not the clone (the same
      # rule roost_ext_index_lookup enforces on the dispatch path). `info`
      # says so rather than failing outright -- there is still a real answer
      # to "what does roost think is installed here".
      echo "  missing — $manifest is not there; the clone may have been deleted"
    fi
    echo
    echo "paths:"
    printf '  clone  %s\n' "$clone_dir"
    printf '  state  %s\n' "$ext_state_dir"
    ;;

  *)
    # Every verb this feature will ever have, named even though only two of
    # them work today -- so `roost ext install ...` reads as "not built yet"
    # rather than as a typo, and a user who mistypes `list` still sees the
    # whole shape of the command.
    echo "usage: roost ext <install|list|info|verify|update|remove>" >&2
    exit 2
    ;;
esac
