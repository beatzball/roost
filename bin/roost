#!/usr/bin/env bash
# roost — launch an on-demand tmux "agent view" on its own isolated server.
#
# Your normal `tmux` is untouched: roost uses a separate socket (-L roost) and its
# own config (tmux/roost.conf), so it never sees or disturbs your regular
# sessions. Run your AI coding agents inside it; Claude Code hooks badge each
# pane by state (💥 error · 🛑 blocked · ⏳ working · ✅ done · 💤 idle).
#
# All roost sessions share one server, so the status counts and `prefix a`
# switcher roll up across every session.
#
#   roost                    start/attach the default session ("main")
#   roost session NAME       start/attach a named session (roost session a, ...)
#   roost new NAME [SESSION] open a new agent window and attach (default session "main")
#   roost spawn NAME [CMD]   open an agent window WITHOUT attaching; prints its target
#   roost split [-h|-v] [-t P] [-n NAME] [CMD]  open a helper pane in the current window; prints its %N
#   roost view [-n NAME] CMD...  show CMD to the human: a pane beside you if there is room, a window if not. No focus steal; a second call with the same NAME replaces the first
#   roost whoami [--json]    print this agent's own pane id (%N)
#   roost ssh HOST [ARGS]    run roost on a remote host (agents there, driven here)
#   roost send [--force] TGT TEXT
#                            paste TEXT + Enter into an agent, verifying the submit (exit 1 if it never leaves the input line; TGT = %N pane, @N window, or [SESSION:]WINDOW). Refuses a 🛑 blocked target unless --force
#   roost read [--turn N] [-r|--render|--json] TGT [N]
#                            print an agent's recorded reply; with none, falls back to its screen (last N non-blank lines, default 40) and says so on stderr. --render pipes the REPLY through preen to render its markdown; a screen fallback is never rendered (it is not markdown). --json prints one JSON document instead, for a program. Each turn is also kept whole on disk, so a reply past the 12 KB pane cap reads back in full, and a closed %N pane still reads its last reply. --turn N reads turn N (from 1), or with -N counts back from the newest (-1 is the newest); the newest 100 turns per pane are kept (ROOST_RECORD_KEEP)
#   roost forget TGT | --gone | --all
#                            delete kept replies: one pane's, every pane's that is closed or on a server that has stopped, or all of them. They live in ${XDG_STATE_HOME:-~/.local/state}/roost/panes (ROOST_RECORD_DIR overrides; set it to "" to keep none), and a closed pane's are deleted on their own 30 days after its last reply (ROOST_RECORD_DAYS)
#   roost screen [--json] TGT [N]  print what is ON that pane's screen — its last N non-blank lines (default 40), chrome included
#   roost reply TEXT...      record TEXT as this pane's reply, for another agent's `roost read`
#   roost wait-done TGT [T]  block until TGT (a %N pane, or every agent pane in a window) is done/idle
#   roost hooks [claude|codex]  print the hook config that powers the badges (default: claude)
#   roost state STATE [--json]  report this pane's agent state (working|blocked|done|error|idle); --json then says whether it landed
#   roost doctor             run preflight checks (tmux version, truecolor, hooks, ...)
#   roost validate [--quick] run every check a tester would run by hand -- suites, live drives, known bugs -- and write the report itself
#   roost ext SUBCOMMAND     add subcommands from a git repository: install, list, info, verify, update, remove
#   roost wiring on|off [-t SESSION] | remove
#                            roost's own route to claude and opencode in its panes, with no edit to your config: turn it on or off for the server or one session, or remove it (one claude run without it: ROOST_NO_SHIM=1 claude)
#   roost install            wire every installed agent (opencode, pi, copilot, claude, codex) to this checkout
#   roost update             re-wire every installed agent to this checkout: an alias for `install`, it does not pull new code
#   roost init               setup wizard: writes ~/.config/roost/roost.conf
#   roost settings           change theme/glyphs/separator/notifications, live
#   roost status [--json]    list running sessions + agents (--json: one JSON document; see the Driving a Fleet docs page)
#   roost kill [SESSION]     kill one session, or the whole server if none given
#   roost help               show this text
#   roost --version          print roost's version (-V, or `roost version`)
set -euo pipefail

# Resolve the repo root even when invoked via a symlink on PATH.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOST_HOME="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Two version numbers, deliberately kept apart. ROOST_VERSION is the product:
# semver, read from the VERSION file at the repo root, reported by
# `roost --version` and bumped on every release, however small. ROOST_CONTRACT
# is the extension seam's own version: a single integer that moves only when
# the SHAPE of extension wiring itself changes — a new required manifest
# field, a different lookup path — never when roost merely gains a feature or
# fixes a bug. Splitting them means an ordinary roost release, no matter how
# large, never invalidates an extension that was written against contract 1.
#
# `read` rather than `cat` under `set -e`: a missing or unreadable VERSION
# (a half-copied checkout, a stray permissions change) must not take EVERY
# roost command down with it, because this line runs before the subcommand
# case even sees what was asked for. `roost state` sits on that path and
# fires on every tool call of every live agent (AGENTS.md §2) — a damaged
# checkout breaking that would freeze real agents mid-session — and `roost
# doctor`, the tool a user reaches for to diagnose a damaged checkout, cannot
# be the thing a damaged checkout takes out first. So a read failure falls
# back to the literal string "unknown" instead of aborting.
# 2>/dev/null precedes the `<`: bash applies simple-command redirections
# left to right, and a MISSING file fails at the `<` step itself, before a
# trailing `2>/dev/null` would take effect — so that order still prints
# "No such file or directory" straight past this line. Put here first, the
# redirect is already in place when the open fails.
read -r ROOST_VERSION 2>/dev/null < "$ROOST_HOME/VERSION" || ROOST_VERSION=unknown
ROOST_CONTRACT=1
# The third version number, and kept apart from both of the above for the same
# reason they are kept apart from each other. ROOST_JSON_SCHEMA is the schema of
# the documents `--json` prints (#41), and it is the "schema" key of every one
# of them. It moves only when a document changes in a way that breaks a
# consumer -- a field removed, renamed, retyped or given a new meaning. Adding a
# field, or a command that takes --json, is not a bump. The full rule is under
# "Versioning" in docs/airig/specs/2026-09-15-json-output-design.md.
ROOST_JSON_SCHEMA=1

# Socket, in order: $ROOST_SOCKET (explicit seam — tests, a second server, a
# `roost ssh` one) -> the roost server we are running inside -> the shared
# production server by name. The same three steps scripts/roost-status,
# roost-switch and roost-notify already resolve in, and which
# tests/test-socket-seams.sh pins for them.
#
# The MIDDLE step is the one this file was missing, and its absence was not
# cosmetic: `roost state` execs scripts/roost-agent-state, which has always
# taken the socket from $TMUX, while everything here fell straight through to
# `-L roost`. On any roost server that is not the default one, the badge landed
# and `roost reply` exited 0 having written nothing — and `read`, `screen`,
# `send` and `wait-done` addressed the production server instead, where the
# caller's pane id is a valid id belonging to a stranger. Both halves now ask
# scripts/lib/roost-socket.sh the same question. Do not re-inline the rule.
#
# Note what the middle step deliberately does NOT do: inherit any $TMUX. A user
# who types `roost spawn` from inside their everyday tmux still means the roost
# server, so roost_self_socket recognises only a socket path ending /roost.
. "$ROOST_HOME/scripts/lib/roost-socket.sh"
roost_self_socket
# roost_hooks_claude / roost_hooks_codex print the JSON object `roost hooks`
# shows below its own explanatory comments. Shared with the installer, which
# needs the identical bytes — see that file's header for why editing them
# there or here is not safe.
#
# Note for anyone reading the frozen-handlers warning in the codex prose
# below: it is about the VALUES, not the layout. Codex hashes the parsed
# handler struct, so indentation and key order are free and a caller may
# reflow the object to fit its own output — measured on codex-cli 0.151.0 via
# `hooks/list`, written up in full in scripts/lib/roost-hooks.sh's header. The
# prose below is printed to users and is pinned byte-for-byte by
# tests/fixtures/hooks-codex.txt, which is why the detail lives in the lib
# rather than being added to it.
. "$ROOST_HOME/scripts/lib/roost-hooks.sh"
# The extension seam's helpers: the index lookup the `*)` fallback at the very
# bottom of this file dispatches through, and the two path roots it builds
# ROOST_EXT_DIR and ROOST_EXT_STATE from.
#
# Sourced up here with the other libraries rather than lazily inside that
# branch. A `.` buried in a case arm is the kind of line that gets moved
# during a refactor and then silently stops running, and what would break is
# a lookup that quietly finds nothing — an installed extension turning back
# into "unknown subcommand" with no error anywhere to explain it.
#
# This is read on EVERY roost invocation, `roost state` included, which fires
# on every tool call of every live agent (AGENTS.md §2). That cost is exactly
# why scripts/lib/roost-ext.sh does one path expansion at source time and
# nothing else, and why it defers roost-json.sh to the two functions that
# actually parse JSON. See its header before adding work to it.
. "$ROOST_HOME/scripts/lib/roost-ext.sh"
# roost_unblock_pane: the one place a Claude `blocked` badge left by a declined
# or dismissed permission dialog may be cleared (#38), and only cleared, from
# Claude's own transcript rather than the screen. `send`, `read` and
# `wait-done` all ask it before believing `blocked`, so the three cannot
# disagree about a pane. It defines functions and one constant and runs
# nothing at source time, so `roost state` on the hot path pays one file read.
. "$ROOST_HOME/scripts/lib/roost-unblock.sh"
SOCKET="${ROOST_SOCKET:-${ROOST_SELF_SOCK:-roost}}"
case "$SOCKET" in */*) _SOCKET_FLAG="-S" ;; *) _SOCKET_FLAG="-L" ;; esac
DEFAULT_SESSION="main"
CONF="$ROOST_HOME/tmux/roost.conf"

t() { tmux "$_SOCKET_FLAG" "$SOCKET" "$@"; }

server_running()  { t list-sessions >/dev/null 2>&1; }        # ≥1 session exists
session_exists()  { t has-session -t "=$1" 2>/dev/null; }      # exact-name match

# Create the session if missing. The first session boots the server with our
# config (server/global options + bindings apply to every later session too).
ensure_session() {
  local s="$1"
  session_exists "$s" && return 0
  if server_running; then
    t new-session -d -s "$s" -c "$PWD"
  else
    t -f "$CONF" new-session -d -s "$s" -c "$PWD"
    t set-environment -g ROOST_HOME "$ROOST_HOME"
    t set-option -g @roost-home "$ROOST_HOME"
    t set-environment -g PATH "$ROOST_HOME/scripts:$PATH"
    # User config: sourced AFTER the base conf so it overrides. -q: silent if absent.
    ROOST_USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/roost/roost.conf"
    t set-option -g @roost-user-conf "$ROOST_USER_CONF"
    t source-file -qF "#{@roost-user-conf}"
    # Roost-owned wiring (#58): the claude shim through default-command, and
    # OPENCODE_CONFIG_DIR. AFTER the user's conf, because
    # `set -g @roost-wiring-enabled off` there must stop it before anything is
    # generated, and a default-command the user set there must be seen and
    # kept. Only here, when a server starts, so no other roost command — and
    # least of all `roost state` on every tool call — pays for it.
    #
    # Never fatal: a server that cannot be wired still has to start, and the
    # global install (if any) still badges. `roost doctor` reports the state.
    ROOST_SOCKET="$SOCKET" "$ROOST_HOME/scripts/roost-wiring" apply >/dev/null 2>&1 || true
    # The first pane was created by the `new-session` above, BEFORE apply set
    # default-command, ROOST_TMUX and ROOST_WIRING_DIR — and it is the pane
    # `roost up` attaches a human to, where they type `claude`. Found in review:
    # without this, every pane of a fresh server was wired except that one.
    # Respawning is safe only here: nothing has run in it yet but the login
    # shell that just started.
    #
    # The command is passed explicitly. Measured on tmux 3.6: `respawn-pane`
    # with no command re-runs the command the pane was CREATED with — here
    # none — and does not consult default-command, so it exits 0 and changes
    # nothing. A default-command the user set themselves is what gets passed
    # then, which is what that pane would have run anyway.
    if pane_cmd_wired; then
      _defcmd="$(t show-options -gqv default-command 2>/dev/null || true)"
      if [ -n "$_defcmd" ]; then
        t respawn-pane -k -t "=$s:" -c "$PWD" "$_defcmd" 2>/dev/null || true
      fi
    fi
  fi
}

# pane_cmd_wired — true when this server is wired, which is when a command
# roost starts in a pane has to be run through roost-pane-shell. Kept separate
# from the `set --` that uses it because `set --` inside a function would
# change only the function's own arguments.
pane_cmd_wired() { [ "$(t show-options -gqv @roost-wiring-active 2>/dev/null || true)" = on ]; }

attach_session() { ensure_session "$1"; exec tmux "$_SOCKET_FLAG" "$SOCKET" attach -t "=$1"; }

# @N (window-id) / %N (pane-id) / anything with a colon → verbatim; a bare word → default session.
target() { case "$1" in @*|%*|*:*) printf '%s' "$1" ;; *) printf '%s:%s' "$DEFAULT_SESSION" "$1" ;; esac; }

# record_for RAW TGT — find the pane record (#74) that RAW names, for `read` and
# `forget`. Returns 1 when records are off or RAW names nothing that could have
# one. Otherwise sets:
#
#   RF_DIR    the record directory (it may not exist)
#   RF_PANE   the %N it belongs to
#   RF_LIVE   1 when the pane exists now, 0 when it is gone
#   RF_STATE  what roost_record_schema said: 0 usable, 1 none, 2 unreadable,
#             3 written by a newer roost
#
# A live target is filed under its own server's boot key, read in the same tmux
# call that resolves it. A target tmux cannot find is looked up only when it is
# a pane id, under the boot of the server `t` talks to: a window name or @N of a
# window that is gone no longer names any pane, and a %N from an EARLIER boot is
# a different pane (tmux restarts pane ids at %0), so neither is guessed at.
record_for() {
  local info boot pane
  RF_DIR="" RF_PANE="" RF_LIVE=0 RF_STATE=1
  . "$ROOST_HOME/scripts/lib/roost-record.sh"
  roost_record_root
  [ -n "$ROOST_RECORD_ROOT" ] || return 1
  info="$(t display-message -p -t "$2" '#{start_time}-#{pid} #{pane_id}' 2>/dev/null || true)"
  # tmux 3.6 does NOT fail display-message for a pane id that is gone: it
  # prints the server's own formats and an EMPTY #{pane_id} (measured while
  # building this). So "found" is a non-empty pane id, not a zero exit.
  boot="${info%% *}"; pane="${info#* }"
  case "$pane" in %[0-9]*) RF_LIVE=1 ;; *) pane="" ;; esac
  if [ "$RF_LIVE" = 0 ]; then
    case "$1" in %[0-9]*) ;; *) return 1 ;; esac
    boot="$(t display-message -p '#{start_time}-#{pid}' 2>/dev/null || true)"
    pane="$1"
  fi
  roost_record_pane_dir "$boot" "$pane" || return 1
  RF_PANE="$pane"
  RF_DIR="$ROOST_RECORD_PANE_DIR"
  RF_STATE=0
  roost_record_schema "$RF_DIR" || RF_STATE=$?
  return 0
}

# record_warn COMMAND LABEL — the one line a record this roost cannot use earns.
# A warning and never a failure: the pane option still answers, and a damaged
# file in a state directory must not break the command that stumbled on it.
# What the schema file held is printed only when it is short and plain.
record_warn() {
  local seen="${ROOST_RECORD_SCHEMA_SEEN:-}"
  case "$seen" in *[!A-Za-z0-9._-]*) seen="?" ;; esac
  [ "${#seen}" -le 20 ] || seen="?"
  case "$RF_STATE" in
    2) echo "roost $1: the record for '$2' is unreadable (schema: $seen) — ignored." >&2 ;;
    3) echo "roost $1: the record for '$2' was written by a newer roost (schema $seen) — ignored." >&2 ;;
  esac
}

# plural N WORD — "1 turn", "2 turns".
plural() { if [ "$1" = 1 ]; then printf '%s %s' "$1" "$2"; else printf '%s %ss' "$1" "$2"; fi; }

# A pane/window NAME containing a tab or newline corrupts every consumer that
# treats a line as one record: `roost status` emits one line PER pane, so a
# `\n` in the name splits it into two; the switcher's tab-delimited awk rows
# shift every field after a `\t`, producing a selectable row with empty
# session/window/pane key fields — selecting it runs `switch-client -t ""`,
# the exact hazard the comment in scripts/roost-switch warns about. Reject
# outright rather than silently stripping: a mangled name that still "worked"
# would be a more confusing surprise later than a loud, immediate error.
reject_bad_name() {
  # $'\t' / $'\n' ANSI-C quoting, NOT "$(printf '\t')" — command substitution
  # strips ALL trailing newlines, so "$(printf '\n')" collapses to the empty
  # string and the newline arm would then match (and reject) every name.
  case "$1" in
    *$'\t'*|*$'\n'*)
      echo "roost $2: NAME may not contain a tab or newline" >&2; exit 2 ;;
  esac
}

# What `roost screen` returns, and what `roost read` falls back to. Drop the
# pane's trailing blank rows, keep the last N non-empty lines.
#
# This is a RENDERING, not content: for a full-screen TUI the bottom of the
# pane is an input box and status bars, not the reply. That is the whole reason
# @roost-reply exists — see docs/airig/issues/2026-08-21-read-returns-tui-chrome.md.
screen_dump() {
  t capture-pane -p -t "$1" | grep -v '^[[:space:]]*$' | tail -n "$2"
}

# need_arg VALUE USAGE -> print USAGE and exit 1 when VALUE is empty.
#
# `${2:?usage: ...}` was the old spelling, and bash renders that as
# `/abs/path/to/bin/roost: line 905: 2: usage: ...` -- the checkout's absolute
# path and an internal line number, in front of a user who typed a command
# wrong. The path is noise at best and the author's home directory at worst,
# and the line number is meaningless to a reader. Found by review.
need_arg() {
  if [ -z "${1:-}" ]; then
    printf '%s\n' "$2" >&2
    exit 1
  fi
}

# The `--render` half of `roost read`: hand the text to preen
# (https://github.com/beatzball/preen), which renders markdown read on stdin.
#
# Opt-in, and nothing reaches this function unless --render was passed. The
# default path must stay byte-identical: callers pipe `roost read` into grep
# (tests/test-coordination.sh, tests/test-panes.sh) and one compares its whole
# output against the recorded reply (tests/test-reply-channel.sh), so a
# renderer in the default path would break every one of them.
#
# A renderer that is not installed must NOT fail the read. What the agent said
# is the payload; the colour is a convenience, and a `roost read --render` that
# exited non-zero on a machine without preen would strand a caller who only
# wanted the text. So print the text unchanged and say why on stderr — stderr
# for the same reason the screen-fallback notice below uses it: stdout is the
# caller's pipe.
#
# The text is BUFFERED first rather than streamed straight into preen, and
# that costs one variable to buy the property that matters: a renderer which
# fails must cost the caller the colour, never the text. Streaming spends the
# input before the exit status is known, leaving nothing to fall back to --
# and under `set -euo pipefail` (line 37) a preen that exits 3 took the whole
# command's status with it, so `roost read -r X || die` died on a read that
# had printed the reply perfectly. Found by review, with a stub renderer.
#
# `|| true` on the capture and an explicit status check rather than letting
# pipefail speak: the point here is to SWALLOW the renderer's failure after
# reporting it, which is the one place in this file that is the right thing to
# do. printf '%s\n', not echo, because a reply beginning with -n or -e is text.
render_stdin() {
  local text rendered rc visible
  text="$(cat)"
  if command -v preen >/dev/null 2>&1; then
    # preen's own stderr is NOT discarded. It is the only diagnosis available
    # when a renderer misbehaves, and swallowing it was the first version's
    # mistake: "preen exited 3" with no reason is barely better than silence.
    rendered="$(printf '%s\n' "$text" | preen -)" && rc=0 || rc=$?
    # A renderer that SUCCEEDS and returns nothing is the more common failure,
    # and the exit-status net does not catch it. Measured against the real
    # preen: `<ttyUSB0>` in, 2 bytes out (both newlines), exit 0, nothing on
    # stderr -- the whole reply gone. A renderer may change how text LOOKS; it
    # may not make it disappear.
    #
    # WHAT IS TESTED IS WHAT SURVIVES, NOT THE BYTE COUNT, and the first
    # version of this check got that wrong. preen pads every line to the
    # terminal width and wraps it in colour codes, so `$rendered` is never the
    # empty string: `&nbsp;` came back as 1754 bytes with NOTHING visible in
    # them -- the only non-padding bytes were a non-breaking space, which this
    # check deletes as whitespace like any other. A `[ -z "$rendered" ]` test
    # stepped aside for exactly the input it existed to catch. Escape
    # sequences and whitespace are stripped first, and what is left is the
    # question. Found by both reviewers, separately.
    #
    # `tr -d` rather than a shell glob: this runs on bash 3.2 with no regex
    # dependency, and the sed handles the CSI sequences preen actually emits.
    # Two strips, not one: SGR colour (CSI ... m) and OSC-8 hyperlinks
    # (ESC ] 8 ; ... BEL), whose URL is not text the reply ever contained. A
    # render carrying only a hyperlink is visually empty, and without the
    # second strip its URL counted as visible: the guard stepped aside and the
    # reply was lost, exit 0, silently. Both reviewers proved that end to end.
    #
    # THE ESCAPES ARE $'...' , NOT '\x07' INSIDE A BRACKET EXPRESSION, and the
    # first version of this line got that wrong in a way that read as correct.
    # BSD sed does not honour \x escapes inside `[...]`: `[^\x07]` means "not
    # one of \ x 0 7", so the expression matched nothing and the strip was a
    # no-op on macOS -- which CI also runs. Proved with `printf 'x07\ Q' | sed
    # 's/[^\x07]//g'` returning `x07\`. bash expands the escapes before sed
    # ever sees them, which works on both BSD and GNU.
    visible="$(printf '%s' "$rendered" \
      | sed $'s/\033\\[[0-9;]*m//g' \
      | sed $'s/\033\\]8;[^\a]*\a//g' \
      | tr -d '[:space:]')"
    if [ "${rc:-0}" -eq 0 ] && [ -n "$text" ] && [ -z "$visible" ]; then
      echo "roost read: preen returned nothing for a non-empty reply — printing the raw text instead." >&2
      printf '%s\n' "$text"
      return 0
    fi
    if [ "${rc:-0}" -eq 0 ]; then
      printf '%s\n' "$rendered"
      return 0
    fi
    echo "roost read: preen exited $rc — printing the raw text instead." >&2
    printf '%s\n' "$text"
    return 0
  fi
  echo "roost read: --render needs 'preen' on PATH — printing the raw text instead." >&2
  echo "roost read: (install it from https://github.com/beatzball/preen)" >&2
  printf '%s\n' "$text"
  return 0
}

case "${1:-up}" in
  up|start|"")
    attach_session "$DEFAULT_SESSION"
    ;;
  session|s)
    need_arg "${2:-}" "usage: roost session NAME"; sess="$2"
    attach_session "$sess"
    ;;
  new)
    name="${2:-agent}"; sess="${3:-$DEFAULT_SESSION}"
    reject_bad_name "$name" new
    ensure_session "$sess"
    # `=$sess:` — trailing colon so a numeric session name isn't parsed as a window
    # index (matches spawn; a bare `=0` fails "index 0 in use").
    t new-window -t "=$sess:" -n "$name" -c "$PWD"
    exec tmux "$_SOCKET_FLAG" "$SOCKET" attach -t "=$sess"
    ;;
  state)
    # The public state-reporting contract. Every state SOURCE calls this: the
    # Claude Code hooks below, adapters/opencode/roost.js, and anything a user
    # writes. It reads $TMUX and $TMUX_PANE to find the pane, and is a silent
    # no-op outside a roost server -- which is what makes an adapter safe to
    # leave installed when the agent runs somewhere else.
    #
    # `roost state STATE --json` (#41) sets the badge exactly as below and then
    # says what landed. The flag goes AFTER the state because that invocation
    # already set STATE and printed nothing before --json existed, so nothing
    # that worked changes. `roost state --json`, flag first, still means what it
    # always meant: --json is not a state, and an unknown state is idle.
    #
    # The point of the echo is the silent failure scripts/lib/roost-socket.sh
    # records: badges that did not land, exit 0, nothing printed. `recorded` is
    # a READ-BACK, so an adapter author can see a badge that went nowhere.
    #
    # Only `$3` is looked at, and nothing is forked when it is absent: the
    # hooks call scripts/roost-agent-state directly, but adapters come through
    # this arm, and the plain path must stay one `case` and an exec.
    if [ "${3:-}" = "--json" ]; then
      json_requested="${2-}"
      "$ROOST_HOME/scripts/roost-agent-state" "${2:-idle}"
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      json_pane="" json_state="" json_recorded=0
      # The same three conditions roost-agent-state checks before it writes
      # anything, and the same server: it takes the socket from $TMUX, which is
      # what ROOST_SELF_SOCK holds, NOT from $SOCKET, which $ROOST_SOCKET can
      # point somewhere else.
      if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ -n "${ROOST_SELF_SOCK:-}" ]; then
        json_pane="$TMUX_PANE"
        # The normalisation roost-agent-state applies ("anything unrecognised
        # is idle"). A second copy of a five-word list, kept beside the read-back
        # that needs it; if that script's list ever grows, this must grow too,
        # and tests/test-json-output.sh's `state bogus --json` case goes red.
        case "${2:-idle}" in
          blocked|working|done|error) json_want="$2" ;;
          *) json_want=idle ;;
        esac
        # show-options -p: pane scope only. A format lookup would fall back to
        # a window or global @agent_state and report a badge that is not there.
        if [ "$(tmux -S "$ROOST_SELF_SOCK" show-options -p -t "$TMUX_PANE" -qv @agent_state 2>/dev/null || true)" = "$json_want" ]; then
          json_state="$json_want"; json_recorded=1
        fi
      fi
      roost_jsonout_emit state requested s "$json_requested" state z "$json_state" \
        pane z "$json_pane" recorded b "$json_recorded" || roost_jsonout_fail state
      exit 0
    fi
    exec "$ROOST_HOME/scripts/roost-agent-state" "${2:-idle}"
    ;;
  help|--help|-h)
    # The command list is read back out of this file's own header comment
    # rather than duplicated here. A second copy would drift the first time
    # someone adds a subcommand and updates only one of them.
    #
    # The end of the header is found, not hardcoded: a line number here drifts
    # the moment the header grows by a line, and it fails by silently dropping
    # the LAST command from the help -- which is exactly what happened when
    # --force was documented. Start after the shebang, stop at the first line
    # that is not a comment.
    "$ROOST_HOME/scripts/roost-banner" || true
    printf '\n'
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' \
      "$ROOST_HOME/bin/roost"
    printf '\n'
    exit 0
    ;;
  doctor)
    exec "$ROOST_HOME/scripts/roost-doctor"
    ;;
  validate)
    # Next to doctor, and for the same reason: it is a thing a USER runs to
    # tell us what happened on their machine, not a test. tests/run.sh globs
    # tests/test-*.sh and cannot reach scripts/, which is the property that
    # keeps a forty-minute live run out of CI.
    #
    # Where doctor reads the machine's configuration, validate drives it: the
    # offline suites, this repo's live smoke suites, a real end-to-end drive of
    # every installed harness against local ollama, and the two known bugs as
    # explicit checks. It writes one file and prints its path.
    shift
    exec "$ROOST_HOME/scripts/roost-validate" "$@"
    ;;
  ext)
    # `roost ext <verb>` -- the extension seam's own subcommand, kept in its
    # own file (scripts/roost-ext) rather than folded into this case, the
    # same shape `install`/`update` (scripts/roost-install) and `validate`
    # (scripts/roost-validate) already use. All six verbs live there --
    # `install`, `list`, `info`, `verify`, `update` and `remove`. See
    # docs/airig/specs/2026-09-08-extension-seam.md.
    shift
    exec "$ROOST_HOME/scripts/roost-ext" "$@"
    ;;
  wiring)
    # Roost-owned wiring (#58): scripts/roost-wiring does the work. The socket
    # is passed explicitly, as `view` does for its children, so the script
    # resolves the same server this process did instead of falling through to
    # the production `-L roost`.
    shift
    ROOST_SOCKET="$SOCKET" exec "$ROOST_HOME/scripts/roost-wiring" "$@"
    ;;
  install|update)
    # `update` is an ALIAS, not a second arm: one shift, one exec, so the two
    # spellings cannot drift. They are the same command because re-running the
    # installer IS the update -- it is idempotent, it relinks whatever now
    # points somewhere else, and it names what it left alone. What it does NOT
    # do is fetch new roost code, which is why the help line for `update` says
    # so out loud; the installer prints its own note when this checkout is
    # behind its upstream.
    #
    # tests/test-adapter-install.sh compares the two --dry-run outputs byte for
    # byte, which is what pins the alias rather than merely the arm.
    shift
    exec "$ROOST_HOME/scripts/roost-install" "$@"
    ;;
  init)
    exec "$ROOST_HOME/scripts/roost-init"
    ;;
  settings)
    exec "$ROOST_HOME/scripts/roost-settings"
    ;;
  whoami)
    # prints the caller's pane id. $TMUX_PANE identifies the caller's pane.
    if [ -z "${TMUX_PANE:-}" ]; then echo "roost whoami: not inside a roost session" >&2; exit 1; fi
    me="$(t display-message -p -t "$TMUX_PANE" '#{pane_id}' 2>/dev/null || true)"
    [ -n "$me" ] || { echo "roost whoami: not inside a roost session" >&2; exit 1; }
    # --json (#41) only as the second word, the one place `whoami` ever looked.
    # Any other extra word is still ignored, as it always was. The failures
    # above stay exactly as they are: exit 1, stderr, and nothing on stdout.
    if [ "${2:-}" = "--json" ]; then
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      roost_jsonout_emit whoami pane s "$me" || roost_jsonout_fail whoami
      exit 0
    fi
    printf '%s\n' "$me"
    ;;
  spawn)
    need_arg "${2:-}" "usage: roost spawn NAME [CMD...]"; name="$2"; shift 2
    reject_bad_name "$name" spawn
    # Helper lands in the caller's own session when inside roost, else the default.
    if [ -n "${TMUX_PANE:-}" ]; then
      sess="$(t display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || echo "$DEFAULT_SESSION")"
    else
      sess="$DEFAULT_SESSION"
    fi
    ensure_session "$sess"
    # Background (-d) + non-attaching: create the window WITHOUT switching the
    # caller's focus to it (plain new-window selects it, so a client viewing the
    # session would jump there), and print its pane id target.
    # `=$sess:` — exact-match the session AND the trailing colon avoids tmux parsing
    # a numeric session name as a window index (e.g. `=0` fails "index 0 in use").
    #
    # On a wired server a command goes through roost-pane-shell, which puts
    # roost's claude shim first on PATH and then runs the command the way tmux
    # would have (a string through the shell, an argv directly). The server's
    # own PATH cannot do this: tmux hands a client-created pane the CLIENT's
    # PATH (#58, design M1). With no command, default-command already does it.
    if [ "$#" -gt 0 ] && pane_cmd_wired; then set -- "$ROOST_HOME/scripts/roost-pane-shell" "$@"; fi
    new="$(t new-window -d -P -F '#{pane_id}' -t "=$sess:" -n "$name" -c "$PWD" "$@")"
    # Naming is best-effort; the pane id is the contract. A short-lived CMD's
    # pane can already be gone by the time we set-option — don't let that abort
    # the command and swallow the id we already have.
    t set-option -p -t "$new" @roost-name "$name" 2>/dev/null || true
    printf '%s\n' "$new"
    ;;
  split)
    shift
    dir=""; from="${TMUX_PANE:-}"; name=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -h) dir="-h"; shift ;;
        -v) dir="-v"; shift ;;
        -t) [ "$#" -ge 2 ] || { echo "roost split: -t needs a target" >&2; exit 2; }
            from="$2"; shift 2 ;;
        -n) [ "$#" -ge 2 ] || { echo "roost split: -n needs a name" >&2; exit 2; }
            name="$2"; reject_bad_name "$name" split; shift 2 ;;
        --) shift; break ;;
        -*) echo "roost split: unknown flag '$1'" >&2; exit 2 ;;
        *)  break ;;
      esac
    done
    [ -n "$from" ] || { echo "roost split: not inside a roost session" >&2; exit 1; }
    # Background helper pane in FROM's window; -d = no focus steal; prints its %N.
    # A command on a wired server goes through roost-pane-shell, for the reason
    # given at the same line in `spawn`.
    if [ "$#" -gt 0 ] && pane_cmd_wired; then set -- "$ROOST_HOME/scripts/roost-pane-shell" "$@"; fi
    new="$(t split-window $dir -d -P -F '#{pane_id}' -t "$from" -c "$PWD" "$@")"
    # A label that survives what the process calls itself: #{pane_current_command}
    # reports a version string for some agents and changes every release.
    # Naming is best-effort; the pane id is the contract. A short-lived CMD's
    # pane can already be gone by the time we set-option — don't let that abort
    # the command and swallow the id we already have.
    [ -n "$name" ] && { t set-option -p -t "$new" @roost-name "$name" 2>/dev/null || true; }
    printf '%s\n' "$new"
    ;;
  view)
    # Put something a HUMAN has to look at where they can see it, without
    # taking their focus and without stacking a fresh copy beside the last one.
    #
    # This is the third shape of "open something", and the three are not
    # interchangeable:
    #
    #   spawn  a co-agent, in its own window, that you wait-done on
    #   split  a helper pane you keep addressing by %N
    #   view   a thing a human reads once — a diff, a log tail, a build watcher
    #
    # `view` names no command of its own. Whatever you hand it is what runs, so
    # a renderer, a pager and `tail -f` all reach a human the same way. What it
    # decides for you is pane-or-window, because that decision is about the
    # terminal's width and not about what you are showing.
    #
    # It is deliberately NOT a dashboard: calling it again with the same NAME
    # replaces the previous view rather than adding another. That replacement
    # is the whole reason NAME exists.
    shift
    name="view"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -n) [ "$#" -ge 2 ] || { echo "roost view: -n needs a name" >&2; exit 2; }
            name="$2"; reject_bad_name "$name" view; shift 2 ;;
        --) shift; break ;;
        -*) echo "roost view: unknown flag '$1'" >&2; exit 2 ;;
        *)  break ;;
      esac
    done
    # An EMPTY name is rejected rather than defaulted, and this guard is not
    # cosmetic: the replace step below compares NAME against every pane's
    # @roost-name, and an option that was never set reads back as the empty
    # string. With name="" that comparison is true for every pane a human
    # opened by hand, so `roost view -n '' less foo` would kill the whole
    # server's worth of unnamed panes. Fail loudly instead.
    [ -n "$name" ] || { echo "roost view: -n needs a non-empty name" >&2; exit 2; }
    [ "$#" -gt 0 ] || { echo "usage: roost view [-n NAME] CMD..." >&2; exit 1; }

    # Same guard as `roost split`, for the same reason: outside a roost session
    # there is no pane to measure, nothing to split beside, and no human
    # watching this server.
    me="${TMUX_PANE:-}"
    [ -n "$me" ] || { echo "roost view: not inside a roost session" >&2; exit 1; }
    # $TMUX_PANE alone is not proof, and here that matters more than it does in
    # `split`: the user's ordinary tmux sets it too, and a %N from THAT server
    # is a perfectly valid id belonging to a stranger's pane over here — which
    # this command would then use both as a width source and as the one pane
    # the kill below spares. Resolve it on the roost socket first, the same
    # question `roost whoami` asks.
    me="$(t display-message -p -t "$me" '#{pane_id}' 2>/dev/null || true)"
    [ -n "$me" ] || { echo "roost view: not inside a roost session" >&2; exit 1; }

    # Replace, don't stack. Only panes roost itself named, and never this pane.
    # A window left empty by the kill closes itself, so the window case needs
    # no separate cleanup. A pane a human opened by hand carries no
    # @roost-name and is not touched.
    #
    # `read -r p pname` puts the REST of the line in pname, so a name
    # containing spaces ("code reviewer") still compares whole. A tab or a
    # newline cannot get this far — reject_bad_name refuses both above.
    while read -r p pname; do
      [ "$pname" = "$name" ] || continue
      [ "$p" = "$me" ] && continue
      t kill-pane -t "$p" 2>/dev/null || true
    done < <(t list-panes -a -F '#{pane_id} #{@roost-name}' 2>/dev/null || true)

    # Measured AFTER that kill, never before. A leftover view is still holding
    # half the columns at this point, so reading the width first makes every
    # call after the first one believe the pane is too narrow to split — and
    # the view then walks off into a window when it should have shared. This
    # was a real bug in the script this command replaces; the ORDER here is
    # the fix, so do not hoist the measurement above the loop.
    width="$(t display-message -p -t "$me" '#{pane_width}' 2>/dev/null || true)"
    case "$width" in ''|*[!0-9]*) width=0 ;; esac

    # 180 columns, so both halves of the split still clear 80 — the width most
    # terminal output is still written for. Below that, a window keeps the view
    # readable instead of squeezing two unreadable columns out of one pane.
    min="${ROOST_VIEW_MIN_COLS:-180}"
    case "$min" in
      ''|*[!0-9]*)
        echo "roost view: ROOST_VIEW_MIN_COLS must be a number, got '$min'" >&2; exit 2 ;;
    esac

    # `split` and `spawn` are re-entered rather than re-implemented: they own
    # -d (no focus steal), the `=$sess:` session-targeting quirk, the
    # best-effort @roost-name write and the pane-id contract, and a second copy
    # of any of that here would drift the first time one of them changed.
    #
    # $ROOST_SOCKET is passed explicitly so the child resolves the SAME socket
    # this process did. A child inheriting nothing would fall through to the
    # production `-L roost` server — the exact failure the socket comment at
    # the top of this file describes — and this keeps the promise that no call
    # site spells a socket flag of its own.
    if [ "$width" -ge "$min" ]; then
      new="$(ROOST_SOCKET="$SOCKET" "$ROOST_HOME/bin/roost" split -h -t "$me" -n "$name" "$@")" \
        || { echo "roost view: split failed" >&2; exit 1; }
      where=pane
    else
      new="$(ROOST_SOCKET="$SOCKET" "$ROOST_HOME/bin/roost" spawn "$name" "$@")" \
        || { echo "roost view: spawn failed" >&2; exit 1; }
      where=window
    fi

    # The prefix is a user setting — tmux/roost.conf binds C-s, and the user
    # config sourced after it may rebind. Read the live one rather than
    # printing C-s and being confidently wrong for anyone who changed it.
    prefix="$(t show-options -gv prefix 2>/dev/null || true)"
    [ -n "$prefix" ] || prefix="C-s"
    # tmux spells it C-s; a human presses ctrl. Only the C- form is rewritten:
    # M-a and F1 are already how someone would say them out loud.
    prefix="${prefix/#C-/ctrl-}"

    # The pane id goes to stdout, because that is the contract every other
    # opening command keeps: a caller writes `v="$(roost view ...)"` and gets
    # one id and nothing else. The directions are for the human at the
    # terminal, so they go to stderr — the same division `roost read` makes
    # when it explains a fallback without putting the explanation in the
    # caller's pipe. `l`/`h` and `a` are the bindings in tmux/roost.conf
    # (select-pane -R / -L, and the switcher popup).
    printf '%s\n' "$new"
    if [ "$where" = pane ]; then
      printf 'roost view: open in the pane to the right (%s).\n' "$new" >&2
      printf 'roost view: press %s then l to go there; %s then h comes back.\n' "$prefix" "$prefix" >&2
    else
      printf 'roost view: open in a new window named %s (%s).\n' "$name" "$new" >&2
      printf 'roost view: press %s then a to switch to it.\n' "$prefix" >&2
    fi
    ;;
  hooks)
    # `roost hooks` with no argument keeps printing the CLAUDE config, and must.
    # That form is documented in this file's own header, in
    # site/content/docs/state-badges.md and in scripts/roost-doctor's advice
    # ("run: roost hooks"), so a second harness cannot be allowed to take the
    # default with it.
    case "${2:-claude}" in
      claude) ;;
      codex)
        cat <<JSON
# Write the JSON object below to \$CODEX_HOME/hooks.json (\$CODEX_HOME defaults
# to ~/.codex). Then start \`codex\`, and at its "Hooks need review" prompt
# choose "Trust all and continue". Until you do, every hook is skipped —
# see the warning further down. Outside roost these hooks are silent no-ops.
#
# Copy the object, NOT these comment lines: hooks.json is strict JSON and has
# no comment syntax.
#
# | codex hook          | state                                |
# |---------------------|--------------------------------------|
# | UserPromptSubmit    | working                              |
# | PostToolUse         | working (and it is what clears 🛑)    |
# | PermissionRequest   | blocked                              |
# | Stop                | done, plus the turn's reply          |
# | Stop, with no reply | error                                |
# | Interrupt           | idle (clears 🛑 after No or Esc)      |
#
# PostToolUse is what clears 🛑 after "Yes". No hook fires when you answer a
# permission dialog, so it is the first observable event afterwards — measured
# on codex-cli 0.151.0, one second after "1. Yes, proceed". After "No", or Esc,
# the tool never runs and Interrupt is what fires instead — measured on
# codex-cli 0.154.0, within 100ms, with no Stop after it.
#
# Interrupt was added in a later roost release than the other four. If you
# trusted roost's hooks before it was there, codex asks at "Hooks need review"
# again for that one handler: answer "Trust all and continue" once more. Until
# you do, a declined dialog leaves 🛑 stamped, and \`roost doctor\` says so.
#
# There is no error EVENT. Codex has twelve hook events and none of them reports
# an error, so 💥 is inferred: a Stop that carries no reply means the turn most
# likely never reached the model. Some dead turns still end ✅ done. See
# docs/known-gaps.md, which lists which ones, and the Codex section of
# site/content/docs/state-badges.md, which says it to users.
#
# THESE HANDLER OBJECTS ARE FROZEN, and that is not a style note. Codex
# stores a hash of each normalised handler in \$CODEX_HOME/config.toml and
# SKIPS any handler whose hash no longer matches — with nothing printed on
# stdout, on stderr, or in the TUI. Measured on codex-cli 0.150.1: appending one
# argument to a command string took 8 of 8 hooks down, and changing a single
# timeout from 10 to 11 took 7 of 8 down. So editing a command or a timeout in a
# later roost release would silently un-badge every machine that had already
# granted trust. Everything roost might want to change later lives inside
# adapters/codex/roost-codex-hook instead, which codex re-reads on every run and
# never hashes. Adding a NEW event to this file is safe (measured on 0.151.0:
# the handlers already trusted kept firing); editing one that is already here is
# not.
#
# The trust prompt vouches for a PATH, not for the code at that path. Anyone who
# can write adapters/codex/roost-codex-hook changes what runs, with no second
# review. That is codex's model, not something roost adds.
JSON
        roost_hooks_codex
        exit 0
        ;;
      *) echo "usage: roost hooks [claude|codex]" >&2; exit 2 ;;
    esac
    cat <<JSON
# Add this to ~/.claude/settings.json (merge into an existing "hooks" block).
# Then run \`claude\` inside a \`roost\` window and its badge tracks its state.
# Outside roost these hooks are silent no-ops.
# "matcher": "permission_prompt" matters — an unmatched Notification hook also
# fires for idle_prompt/auth_success, which would paint a finished agent red.
# PostToolUse is what clears the red: no hook fires when you answer a permission
# dialog, so without it the window stays blocked until the whole turn ends.
# --notification-hook on the Notification entry is what clears it after "No" or
# Esc, when no hook fires at all: it records the payload's transcript_path, and
# \`roost send\`, \`read\` and \`wait-done\` read Claude's own transcript to prove
# the dialog was declined. Leave it off and a declined dialog keeps its red
# until your next prompt.
# --stop-hook on the Stop entry is what powers \`roost read\`: it lets the hook
# read Stop's JSON payload, whose last_assistant_message field carries the
# turn's reply. Leave it off and everything still badges correctly — \`roost
# read\` just falls back to scraping the pane's screen, and tells you it did.
# StopFailure is what ends a turn that FAILED — a rate limit, an overload, a
# model that does not exist. Claude fires it instead of Stop and nothing after
# it, so without it the badge stays working on an agent that has stopped. It
# badges error, and --stop-failure-hook records which kind of API error for
# \`roost wait-done\` and \`read\` to print. It has no matcher on purpose: every
# kind Claude reports is a turn that did not finish.
#
# SessionStart is the odd one out: the other five report state OUTWARD, and it
# is the only one that feeds context IN. It tells the agent it is inside roost
# and gives it its own pane id, so it reaches for \`roost split\` rather than a
# bare \`tmux split-window\` that would target the user's ordinary tmux server.
#
# Its "matcher": "*" is a deliberate choice, not a default. SessionStart fires
# for five sources — startup, resume, clear, compact and fork — and NONE of
# them leaves the preamble in place: startup and fork have no context yet,
# /clear wipes it, and compact replaces it with a summary that drops it. So all
# five need the injection, and naming a subset would also silently skip
# whichever source Claude Code adds next. The cost of the one case that is
# arguably redundant (resume, where the original injection may still be in the
# transcript) is a few duplicated lines; the cost of missing one is an agent
# that has forgotten which server it is on.
JSON
    roost_hooks_claude
    ;;
  ssh)
    need_arg "${2:-}" "usage: roost ssh HOST [ARGS...]"; host="$2"; shift 2
    # Run roost on the remote (must be installed there); agents run remote,
    # you drive them from this terminal. Just SSH + a remote roost — no daemon.
    exec ssh -t "$host" roost "$@"
    ;;
  send)
    # --force is accepted only in front of the target. Anywhere later it would
    # be indistinguishable from a message that happens to begin with the word,
    # and a send whose first word is swallowed is worse than no flag at all.
    force=0
    if [ "${2:-}" = "--force" ]; then
      force=1
      # Drop "send" and "--force", then put the subcommand back so every
      # positional reference below keeps its original number.
      shift 2
      set -- send "$@"
    fi
    need_arg "${2:-}" "usage: roost send [--force] [SESSION:]WINDOW TEXT..."; raw="$2"; shift 2
    tgt="$(target "$raw")"
    # Validate: a typo'd target must fail loudly, not silently deliver nothing.
    # Also reject a DEAD pane: with `remain-on-exit on`, a pane whose command
    # has already exited still resolves #{window_id} fine (the pane object is
    # still there, frozen), but send-keys against it silently no-ops (exit 0)
    # and the frozen screen never gains the message — so the verification
    # below would see "not pending" (before == cur, no match in the frozen
    # last line) and report a clean send that delivered nothing. That is
    # exactly the silent false-success this command exists to eliminate, and
    # a dead target is its most likely real-world instance. One
    # display-message call fetches both fields so the two checks read the
    # SAME snapshot of the target rather than racing two separate lookups.
    # Separator is a plain space, NOT a tab: the split below is
    # `wid="${info%% *}"` / `dead="${info#* }"`, plain parameter expansion
    # that only splits on the literal character between the quotes. A tab
    # separator would leave both expansions matching nothing — `wid` becomes
    # the whole string (non-empty, so a bad target's emptiness check never
    # fires) and `dead` never equals "1". #{window_id} and #{pane_dead}
    # never contain a space, so a space is a safe, boring delimiter that
    # this split actually breaks on.
    #
    # @agent_state joins the same snapshot for the same reason: the blocked
    # check below must describe the pane that is about to be pasted into, not
    # a pane re-resolved a moment later. With a WINDOW target, display-message
    # and send-keys both resolve to that window's active pane, so the guard
    # covers exactly the pane that would receive the keys.
    #
    # Three fields now, so the two-field `%% *` / `#* ` split no longer
    # reaches the last one; peel them off one at a time instead. The state is
    # last on purpose: it is the only field that can be EMPTY (an agent that
    # has never reported), and a trailing empty field survives this split
    # while a middle one would not.
    info="$(t display-message -p -t "$tgt" '#{window_id} #{pane_dead} #{@agent_state}' 2>/dev/null || true)"
    wid="${info%% *}"
    rest="${info#* }"
    dead="${rest%% *}"
    state="${rest#* }"
    if [ -z "$wid" ]; then
      echo "roost send: no such target '$raw'" >&2; exit 2
    fi
    # Same exit code as "no such target": a dead pane is unusable for exactly
    # the reason a nonexistent one is — the caller needs to pick a DIFFERENT
    # target, not retry this one (retrying is what exit 1 below means).
    if [ "$dead" = "1" ]; then
      echo "roost send: target '$raw' is a dead pane (its command has exited); nothing would be delivered" >&2
      exit 2
    fi
    # A blocked pane is showing a permission dialog. send pastes the text and
    # then presses Enter; against a dialog the text goes into the dialog and
    # the Enter activates whatever option is highlighted. One agent driving
    # another would then ANSWER a prompt that existed to ask a human — with
    # neither the sender nor the human intending it, and silently, because
    # the dialog consumes the text and the submit verification below sees a
    # clean send.
    #
    # This is why the check is on state rather than on screen content: roost
    # already stamps @agent_state=blocked from the agent's own hook, so the
    # signal is exact and needs no scraping.
    #
    # Exit 3, distinct from 2 (wrong target) and 1 (submit failed): the
    # target is right and retrying later is the correct response, once the
    # human has answered. A caller can tell those three apart.
    #
    # The one exception: a Claude dialog that was DECLINED or dismissed fires
    # no event, so the badge outlives it and this refusal would last forever
    # (#38). roost_unblock_pane clears such a badge only when Claude's own
    # transcript proves the decline is the newest thing that happened since the
    # stamp, and it only ever unsets. When it cannot prove it, it returns 1 and
    # the refusal stands. Still no screen: the evidence is the harness's own
    # record. It resolves $tgt the way send-keys will, so it judges the same
    # pane this guard protects.
    if [ "$state" = "blocked" ] && [ "$force" -eq 0 ] && ! roost_unblock_pane "$tgt"; then
      echo "roost send: target '$raw' is blocked — a permission dialog is open, and this text would be pasted into it" >&2
      echo "roost send: wait for it to be answered, or pass --force to send anyway" >&2
      exit 3
    fi
    # Two-step submit: literal text, a beat, then Enter. A single
    # `send-keys "$*" Enter` can drop or race the submit in a full-screen TUI.
    delay="$(t show-options -gqv @roost-send-enter-delay 2>/dev/null)"
    # Fall back to 0.3 for unset / non-numeric / multi-dot values, AND guard the
    # sleep itself, so NO value can ever abort after the text is pasted but before
    # Enter is sent (which would leave the prompt half-delivered in the input box).
    case "$delay" in ''|.|*.*.*|*[!0-9.]*) delay=0.3 ;; esac

    # An empty message is a legitimate, useful send on its own — a bare Enter,
    # e.g. to unstick a pane whose TUI already swallowed a previous submit.
    # There is no text to verify landed, so type nothing, press Enter once,
    # and stop right here. Do NOT run this through the verification loop
    # below: an empty pattern collapses `case "$last" in *""*)` to `*)`,
    # which matches ANY pane content, so `pending()` would always report
    # "still pending" and fire every retry into a pane that had nothing to
    # submit in the first place.
    if [ -z "$*" ]; then
      t send-keys -t "$tgt" Enter 2>/dev/null || true
      exit 0
    fi

    retries="$(t show-options -gqv @roost-send-retries 2>/dev/null)"
    case "$retries" in ''|*[!0-9]*) retries=3 ;; esac
    # A pathologically long digit string (thousands of chars) is clamped by
    # length BEFORE anything else touches it: `${#retries}` is an O(1) length
    # check, so this bound can never itself be slow, and it caps the work the
    # zero-stripping loop below could ever be asked to do.
    [ "${#retries}" -gt 40 ] && retries=20
    # Strip leading zeros so "007" reads as its actual value (7), not as a
    # 3-character string that the length clamp below mistakes for >= 100.
    # Bounded to `${#retries}` > 1 so "0" itself (and "000" once fully
    # stripped) settles on a single "0" rather than an empty string, which
    # would break the `[ "$n" -gt 0 ]` loop guard further down.
    while [ "${#retries}" -gt 1 ] && [ "${retries%${retries#?}}" = 0 ]; do
      retries="${retries#0}"
    done
    # Clamp to a sane upper bound. Do this by pattern first, not by `[ -gt ]`
    # alone: an absurd digit string (hundreds of digits) can make the numeric
    # test itself error out (or take a very long time) before it ever gets to
    # compare against the cap, so strings of 3+ digits are clamped directly.
    # Leading zeros are already gone above, so this now only fires for values
    # that are genuinely >= 100.
    case "$retries" in ???*) retries=20 ;; esac
    [ "$retries" -gt 20 ] 2>/dev/null && retries=20 || true

    # Still pending only if ALL THREE hold:
    #   1. the pane's last non-blank line still contains the whole message, AND
    #   2. the pane's full contents are byte-identical to how they looked right
    #      after typing — before ANY Enter was sent (captured into $before), AND
    #   3. the cursor position is unchanged from that same moment (captured
    #      into $cursor_before).
    # The substring check alone is not enough: a blank/empty prompt can leave
    # the already-scrolled, verbatim command line as the last non-blank row
    # even after a real submit, and a TUI can echo the submitted message into
    # its transcript before it clears the input box or renders a response. A
    # genuine submit almost always changes the screen somehow — prompt
    # redraw, output, a spinner, the transcript moving — so requiring
    # "nothing on screen changed at all" makes a false "not submitted" much
    # harder to reach than the substring check on its own.
    # But text-unchanged is NOT sufficient either: it cannot distinguish "the
    # Enter was never accepted" from "the Enter was accepted and the command
    # just hasn't printed anything yet". A command that is silent for the
    # ~1s retry window (a `sleep`, anything slow to start) looks identical to
    # a swallowed Enter on screen alone, and reports a false "not submitted"
    # 100% of the time — this is not a load-dependent flake, it is
    # deterministic. Cursor position resolves the ambiguity: the tty echoes
    # the newline through the line discipline the moment Enter is ACCEPTED,
    # independent of when (or whether) the command produces output. So a
    # real submit moves the cursor right away even in dead silence, while a
    # swallowed Enter leaves it exactly where it was.
    # Trade-off, accepted on purpose: a TUI that animates continuously (a
    # clock, a spinner) will never look byte-identical to its own earlier
    # snapshot, so this retry path will not fire there even for a genuinely
    # swallowed Enter. That is the side to be wrong on: a false "submitted"
    # just degrades to the old (pre-fix) behavior, while a false "not
    # submitted" fires a spurious Enter that can re-run a command. Adding the
    # cursor check is an additional conjunct, not a replacement, for the same
    # reason: requiring one more thing to hold only makes a false "not
    # submitted" harder to reach, never easier.
    pending() {
      local cur last cursor_now
      cur="$(t capture-pane -p -t "$tgt" 2>/dev/null || true)"
      [ "$cur" = "$before" ] || return 1
      cursor_now="$(t display-message -p -t "$tgt" '#{cursor_x} #{cursor_y}' 2>/dev/null || true)"
      [ "$cursor_now" = "$cursor_before" ] || return 1
      last="$(printf '%s\n' "$cur" | grep -v '^[[:space:]]*$' | tail -n 1)"
      case "$last" in *"$1"*) return 0 ;; *) return 1 ;; esac
    }

    # Typing is not delivery, and everything from here to the Enter exists to
    # keep those two apart.
    #
    # THE RACE THIS CLOSES. `roost spawn` prints a pane id the moment the PANE
    # exists, which is well before the agent inside it is reading its terminal.
    # A TUI takes the tty over by putting it in raw mode and DISCARDING
    # whatever is already buffered — that is how it avoids acting on keys that
    # were meant for the shell it replaced — so everything typed before that
    # instant is thrown away and the REMAINDER of the message arrives looking
    # exactly like a whole one. Measured in the field: 3466 bytes sent to a
    # freshly spawned Claude pane, roughly the last 450 delivered, the front
    # gone, `roost send` exit 0. That is nowhere near tmux's ~16344-byte
    # command cap — it is a startup race, not a size limit, which is why the
    # workaround people reached for was "write a file and send the path": a
    # file cannot be half-typed into a TUI that is not awake yet.
    #
    # The verification below this block could not see it, because it verifies
    # the SUBMIT and never the CONTENT: it asks whether the input line has
    # stopped holding the message, and a half-eaten message satisfies that
    # exactly as well as a whole one. So the check added here is on the
    # message's HEAD — the part a cold start eats, and therefore the only part
    # worth looking for.
    msg="$*"
    # How long to keep trying before giving up and saying so. Generous on
    # purpose: a cold agent can take several seconds to draw its input box, and
    # a send that gave up after one second would be a worse tool than the one
    # that lost the front quietly. Clamped by LENGTH first, then by value, the
    # same way @roost-send-retries is above and for the same reason — a
    # pathological digit string must not make the arithmetic itself slow.
    ready_timeout="$(t show-options -gqv @roost-send-ready-timeout 2>/dev/null)"
    case "$ready_timeout" in ''|*[!0-9]*) ready_timeout=15 ;; esac
    [ "${#ready_timeout}" -gt 6 ] && ready_timeout=120
    [ "$ready_timeout" -gt 120 ] 2>/dev/null && ready_timeout=120 || true

    # Whitespace is stripped from BOTH sides of every comparison below. A TUI
    # wraps a long line at its own width and `capture-pane` reports that wrap
    # as a real newline, so a contiguous byte match against the raw screen
    # would fail on any message wider than the input box — which is most of the
    # messages worth worrying about. 24 characters is short enough to stay
    # cheap and long enough not to collide with ordinary screen text.
    head="$(printf '%s' "$msg" | tr -d '[:space:]' | cut -c1-24)"

    # This check must only ever be wrong in ONE direction. If the head is
    # already on screen before a single key is typed — a very short message, or
    # a pane still showing an earlier copy of the same one — then finding it
    # afterwards proves nothing at all. In that case verification is skipped
    # rather than trusted: skipping degrades that one send to the pre-fix
    # behaviour, while trusting it would hand back a false success, which is
    # the exact failure being removed.
    pre="$(t capture-pane -p -t "$tgt" 2>/dev/null | tr -d '[:space:]' || true)"
    verifiable=1
    [ -z "$head" ] && verifiable=0
    case "$pre" in *"$head"*) verifiable=0 ;; esac

    screen_has_head() {
      case "$(t capture-pane -p -t "$tgt" 2>/dev/null | tr -d '[:space:]' || true)" in
        *"$head"*) return 0 ;;
        *) return 1 ;;
      esac
    }

    # THE TRANSPORT IS THE FIX. `send-keys -l` types the message as very fast
    # KEYSTROKES, and Claude Code 2.1.263 answers that by keeping only the last
    # partial chunk of it: measured, discarded = 1022 x floor(n/1022), so a
    # 3502-byte brief arrives as its last 436 bytes. A bracketed paste is a
    # different thing to the receiving application — the \e[200~ / \e[201~
    # markers say "this is one block of pasted text, not typing" — and the same
    # 3502 bytes then arrive whole, proven by putting the instruction at the
    # very START of the message and getting it obeyed.
    #
    # The message travels over STDIN to load-buffer, never on a tmux command
    # line, so the ~16344-byte command-length ceiling stops applying to it
    # as well. Two problems, one transport.
    #
    # -b names ONE buffer that every send reuses, so sends cannot pile up in the
    # buffer stack. -d deletes it as it is pasted. Neither is tidiness: tmux
    # buffers are visible to the human at `prefix + =`, and an agent's message
    # is not something to leave sitting in a picker. -w is the flag that would
    # reach the SYSTEM clipboard and is never passed — measured, with a canary:
    # the macOS pasteboard is byte-identical across a send.
    ROOST_SEND_BUF=roost-send
    # Deletes the buffer on EVERY way out of this command, not just the happy
    # one. A send that dies between the load and the paste — a pane that goes
    # away, a signal — would otherwise leave the whole message in the buffer
    # list, which is the exact thing -d exists to prevent.
    trap 't delete-buffer -b "$ROOST_SEND_BUF" 2>/dev/null || true' EXIT INT TERM

    # stderr is captured rather than dropped so that tmux's failures here can be
    # told apart: a pane that has gone away says one thing, and an over-long
    # command another ("command too long", or "failed to send command" right at
    # the boundary — the same cause wearing a different message). Reporting
    # either as "pane may have died" sent callers to inspect a pane that was
    # alive, idle and blameless.
    type_message() {
      local rc
      senderr="$(printf '%s' "$msg" | t load-buffer -b "$ROOST_SEND_BUF" - 2>&1 >/dev/null)"; rc=$?
      [ "$rc" -eq 0 ] || return "$rc"
      senderr="$(t paste-buffer -p -d -b "$ROOST_SEND_BUF" -t "$tgt" 2>&1 >/dev/null)"; rc=$?
      return "$rc"
    }

    # This one's status is NOT discarded: unlike the Enters below (where
    # aborting mid-loop is the worse outcome), a failure HERE means the text
    # never reached the pane at all — there is nothing to retry or verify, so
    # let it surface as a loud failure instead of falling through to report
    # exit 0 for a message that was never typed.
    if ! type_message; then
      case "$senderr" in
        *"too long"*|*"failed to send command"*)
          # A byte count, not ${#msg}: the budget tmux enforces is bytes, and
          # under a UTF-8 locale bash would report characters — which would
          # print a number smaller than the limit next to a message saying the
          # limit was exceeded.
          bytes="$(printf '%s' "$msg" | LC_ALL=C wc -c | tr -d ' ')"
          # Reachable only if tmux refuses the load or the paste itself. The
          # command-length ceiling that used to dominate here does not apply to
          # the message any more — it travels over stdin — so this no longer
          # tells anyone to go and write a file.
          echo "roost send: tmux refused a $bytes-byte message — nothing was delivered: $senderr" >&2
          ;;
        *)
          echo "roost send: failed to paste text into '$raw' (pane may have died): $senderr" >&2
          ;;
      esac
      exit 1
    fi

    # Prove the head arrived, and keep trying until it does or the budget runs
    # out. Retyping — rather than merely waiting — is what actually fixes the
    # race: the first copy is GONE, not late. The flush that ate it happened
    # once, at takeover, so no amount of patience brings it back.
    #
    # C-u before each retry so that a pane which DID accept the earlier copy,
    # but renders it somewhere this check cannot see, ends up holding one
    # message rather than two. At an empty input line it is a no-op everywhere
    # it is understood.
    #
    # Measured, and it is why the Enter below still has to be sent: a bracketed
    # paste does NOT auto-submit. The text lands in the input box and stays
    # there, and the pane's state does not change — so the submit loop is not
    # double-submitting anything.
    if [ "$verifiable" = 1 ]; then
      waited=0
      until screen_has_head; do
        [ "$waited" -ge "$ready_timeout" ] && break
        sleep 2 2>/dev/null || true
        waited=$((waited + 2))
        screen_has_head && break
        t send-keys -t "$tgt" C-u 2>/dev/null || true
        type_message || true
        sleep "$delay" 2>/dev/null || true
      done
      if ! screen_has_head; then
        # Before failing, ask a weaker question that a real agent TUI can still
        # answer: did the screen change at all?
        #
        # Measured against a live Claude Code 2.1.263 pane: a bulk `send-keys
        # -l` is detected as a PASTE and collapsed to `[Pasted text #N]`
        # placeholders — sometimes several for one send. The text is then
        # nowhere on screen, so the head check above cannot pass no matter how
        # long it waits or how often it retypes. Without this branch `roost
        # send` retyped seven times and exited 1 having submitted nothing, on
        # exactly the target it exists to drive. That trades a silent partial
        # delivery for a loud total one, which is not the trade that was asked
        # for.
        #
        # A changed screen proves the keystrokes were ACCEPTED. It does not
        # prove all of them arrived, so this is not silent: the notice goes to
        # stderr and names what could not be checked. The distinction that
        # matters is kept — a pane that ate the keys and drew nothing still
        # falls through to the failure below, which is the cold-start case.
        post="$(t capture-pane -p -t "$tgt" 2>/dev/null | tr -d '[:space:]' || true)"
        if [ "$post" != "$pre" ]; then
          # A paste PLACEHOLDER is not an unknown, it is the expected success
          # rendering: the pane took the block, decided it was a paste, and drew
          # a stand-in for it. Warning about that would fire on every long send
          # to a real agent — noise that trains a reader to ignore the notice
          # for the case where it means something. So the notice is kept for the
          # genuinely unexplained shape only: the screen changed, the message is
          # not on it, and there is no placeholder to account for that either.
          case "$post" in
            *Pastedtext*) : ;;
            *) echo "roost send: '$raw' accepted the keys but does not show them (a pane that does not echo what it is given), so the CONTENT could not be verified — submitting anyway" >&2 ;;
          esac
        else
          # Exit 1, the documented "delivery to a valid target failed — retry
          # the same target" code. NOTHING has been submitted: the Enter below
          # is never reached, so a caller that retries cannot double-run
          # anything.
          echo "roost send: could not confirm the message reached '$raw' within ${ready_timeout}s — nothing was submitted" >&2
          echo "roost send: the pane may still be starting up, or may not echo what it is given; \`roost screen $raw\` to look" >&2
          exit 1
        fi
      fi
    fi
    sleep "$delay" 2>/dev/null || true
    before="$(t capture-pane -p -t "$tgt" 2>/dev/null || true)"
    # Same call shape as the #{window_id} #{pane_dead} fetch above, and the
    # same reasoning applies to the separator: #{cursor_x} and #{cursor_y}
    # are always plain digits, so a plain space can never appear inside
    # either field and is a safe, boring delimiter. Unlike that earlier call
    # we never split this value — it is only ever compared for equality
    # against a later snapshot taken the same way — so there is nothing here
    # for a wrong separator to silently break; the space is kept anyway for
    # consistency and so the raw string is readable if ever logged.
    cursor_before="$(t display-message -p -t "$tgt" '#{cursor_x} #{cursor_y}' 2>/dev/null || true)"
    t send-keys -t "$tgt" Enter 2>/dev/null || true

    n="$retries"
    while [ "$n" -gt 0 ]; do
      sleep "$delay" 2>/dev/null || true
      pending "$*" || break
      # A cold TUI can swallow the first Enter entirely; try again. Guarded:
      # a pane that dies mid-loop must not abort the script with tmux's raw
      # error — it should fall through to the same conservative handling as
      # any other "can no longer tell" case below.
      t send-keys -t "$tgt" Enter 2>/dev/null || true
      n=$((n - 1))
    done

    if [ "$retries" -gt 0 ] && pending "$*"; then
      echo "roost send: text pasted into '$raw' but never submitted (tried $retries extra Enter(s))" >&2
      exit 1
    fi
    ;;
  read)
    # --render (-r) is accepted only in front of the target, matching send's
    # --force above — but for a different reason. Here the flag is unambiguous
    # wherever it appears, because read's positionals are a target and a line
    # count and neither can look like it; the rule is kept anyway so the two
    # commands are learned once, and so LINES stays the third word it has
    # always been rather than moving when a flag is added after the target.
    #
    # --json (#41) lives in the same slots, under the same rules: before the
    # target, once. It cannot be combined with --render, and that is refused
    # rather than resolved: JSON is for a program and --render is for a person,
    # so a caller passing both has made a mistake that neither choice would fix.
    render=0
    json=0
    # --turn N (#42) reads one kept turn. It is taken out of the flag slots
    # FIRST, wherever it sits among them — before or after -r/--json — and the
    # flag handling below then runs on what is left exactly as it always has,
    # so every message it prints is unchanged down to the byte. Like the other
    # flags it goes before the target, once; after the target it is refused by
    # the sweep further down, as any flag is.
    turn="" turn_given=0
    read_turn_value() {
      local n="${1#-}"
      case "$n" in ''|*[!0-9]*|0*) n="" ;; esac
      if [ -z "$n" ] || [ "${#n}" -gt 15 ]; then
        echo "roost read: --turn needs a turn number — N counts from the first turn, -N back from the newest (-1 is the newest)." >&2
        echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
        exit 1
      fi
      turn="$1"; turn_given=1
    }
    case "${2:-}" in
      --turn)
        read_turn_value "${3:-}"
        shift 3; set -- read "$@" ;;
      --render|-r|--json)
        if [ "${3:-}" = "--turn" ]; then
          read_turn_value "${4:-}"
          _flag="$2"; shift 4; set -- read "$_flag" "$@"
        fi ;;
    esac
    if [ "$turn_given" = 1 ]; then
      case "${2:-}|${3:-}" in
        --turn\|*|--render\|--turn|-r\|--turn|--json\|--turn)
          echo "roost read: '--turn' is not valid here — --turn may be given once, before the target." >&2
          echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
          exit 1 ;;
      esac
    fi
    case "${2:-}" in
      # An unknown flag in the flag slot used to fall through and be treated as
      # the TARGET, which failed later with an empty read and exit 1 -- a typo
      # like `--renderr` came back as tmux's "can't find session" instead.
      # Refused by name here, so the message names the typo rather than the
      # session it was mistaken for.
      # No `-[0-9]*` exemption: slot 2 is the flag-or-TARGET slot, and no
      # target begins with a dash. `roost read -5` used to take `-5` as the
      # target and fall through to the screen fallback for it, while
      # `roost read -r -5` refused the same word -- two slots disagreeing
      # about the same input. Found by review.
      --render|-r|--json) ;;
      -*)
        echo "roost read: unknown flag '$2'." >&2
        echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
        exit 1 ;;
    esac
    # Consumed once, and a SECOND one is refused rather than absorbed. The
    # first version checked for an unknown flag once, before the shift, so a
    # repeated `-r` landed in the target slot, was never looked at again, and
    # became the target -- an empty read at exit 1 that surfaced as tmux's
    # "can't find session". Found by review.
    #
    # A loop that consumed flags until they ran out was tried and removed: it
    # was dead code, because the second flag is an error rather than something
    # to consume. A mutation that made the loop run only once turned nothing
    # red, which is what exposed it.
    case "${2:-}" in
      --render|-r|--json)
        if [ "$2" = "--json" ]; then json=1; else render=1; fi
        # Drop "read" and the flag, then put the subcommand back so every
        # positional reference below keeps its original number.
        shift 2
        set -- read "$@"
        # The one flag pair that is refused for what it MEANS rather than for
        # being repeated. Checked before the repeat refusal below, so the
        # message names the real mistake.
        case "${2:-}" in
          --render|-r)
            if [ "$json" -eq 1 ]; then
              echo "roost read: --json and --render cannot be combined — JSON is for programs, --render is for people." >&2
              echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
              exit 1
            fi ;;
          --json)
            if [ "$render" -eq 1 ]; then
              echo "roost read: --json and --render cannot be combined — JSON is for programs, --render is for people." >&2
              echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
              exit 1
            fi ;;
        esac
        # The word after a consumed flag is a flag slot too. A second --render,
        # or a typo following a good flag, must not fall through to the target.
        # No `-[0-9]*` exemption here, unlike the LINES sweep below: a line
        # count comes AFTER the target, never before it, so `roost read -r -3
        # TGT` is malformed and used to make `-3` the target.
        case "${2:-}" in
          -*)
            # The --render wording is unchanged down to the byte; only a
            # repeat after --json gets a sentence that names --json.
            if [ "$json" -eq 1 ]; then
              echo "roost read: '$2' is not valid here — --json may be given once, before the target." >&2
            else
              echo "roost read: '$2' is not valid here — --render/-r may be given once, before the target." >&2
            fi
            echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
            exit 1 ;;
        esac
        ;;
    esac
    need_arg "${2:-}" "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]"; raw="$2"; lines="${3:-40}"
    # A flag AFTER the target is refused rather than swallowed. It used to land
    # in $lines: with a recorded reply that printed the raw text at exit 0 with
    # no warning (the flag looked like it worked and did nothing), and on the
    # fallback path it reached `tail -n --render` and produced `tail: illegal
    # offset` with no output at all. Both were found by review.
    #
    # EVERY remaining word is checked, not just the LINES slot. The first
    # version read $3 alone, so `roost read TGT 20 --render` was swallowed
    # exactly as `roost read TGT --render` had been -- the same bug moved one
    # word right. Found by both reviewers, separately.
    #
    # A NEGATIVE INTEGER IS NOT A FLAG. `tail -n -3` has always meant "the last
    # 3 lines", so `roost read TGT -3` worked before this guard existed and the
    # first version broke it. The test is therefore "starts with a dash and is
    # not a number", not "starts with a dash".
    for _arg in "${@:3}"; do
      case "$_arg" in
        -[0-9]*) continue ;;          # a negative line count, which tail takes
        -*)
          echo "roost read: '$_arg' looks like a flag, and flags go BEFORE the target." >&2
          echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
          exit 1 ;;
      esac
    done
    tgt="$(target "$raw")"
    # --turn N: one kept turn, from the record only (#42). It never falls back
    # to the screen — the caller asked for a particular turn, and the screen is
    # not it — and it carries no staleness notice, because the caller chose the
    # turn. A turn that is not there says whether it was pruned (ROOST_RECORD_KEEP)
    # and which turns are kept: a bound is reported, never silent.
    if [ "$turn_given" = 1 ]; then
      ROOST_RECORD_COUNT=0
      if record_for "$raw" "$tgt"; then
        if [ "$RF_STATE" -eq 0 ]; then
          roost_record_scan "$RF_DIR/replies"
        else
          record_warn read "$raw"
        fi
      fi
      if [ "$ROOST_RECORD_COUNT" -eq 0 ]; then
        echo "roost read: no recorded turns for '$raw'." >&2
        exit 1
      fi
      roost_record_keep
      rt_min="$ROOST_RECORD_MIN" rt_max="$ROOST_RECORD_MAX"
      if [ "$turn" -gt 0 ]; then
        want="$turn"
      else
        # Counting back walks the turns that EXIST, newest first, so a gap a
        # human made by deleting a file is stepped over rather than counted.
        want=""
        if [ "${turn#-}" -le "$ROOST_RECORD_COUNT" ]; then
          roost_record_back "$RF_DIR" "${turn#-}"
          want="$ROOST_RECORD_BACK"
        fi
      fi
      if [ -n "$want" ]; then
        roost_record_turn_file "$RF_DIR" "$want"
        roost_record_read "$ROOST_RECORD_FILE" || want=""
      fi
      if [ -z "$want" ]; then
        if { [ "$turn" -gt 0 ] && [ "$turn" -lt "$rt_min" ]; } \
           || { [ "$turn" -lt 0 ] && [ "${turn#-}" -gt "$ROOST_RECORD_COUNT" ] && [ "$rt_min" -gt 1 ]; }; then
          echo "roost read: turn $turn of '$raw' was pruned — turns $rt_min to $rt_max are kept (ROOST_RECORD_KEEP=$ROOST_RECORD_KEEP_N)." >&2
        else
          echo "roost read: turn $turn of '$raw' is not recorded — turns $rt_min to $rt_max are kept." >&2
        fi
        exit 1
      fi
      if [ "$RF_LIVE" = 0 ]; then
        echo "roost read: '$raw' is gone — this is its recorded turn $want." >&2
      fi
      if [ "$json" -eq 1 ]; then
        . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
        json_state=""
        if [ "$RF_LIVE" = 1 ]; then
          json_state="$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)"
        fi
        roost_jsonout_emit read target s "$raw" pane z "$RF_PANE" source s record state z "$json_state" \
          stale b 0 error_reason z "" turn i "$want" text t "$ROOST_RECORD_TEXT" || roost_jsonout_fail read
        exit 0
      fi
      if [ "$render" -eq 1 ]; then
        printf '%s\n' "$ROOST_RECORD_TEXT" | render_stdin
      else
        printf '%s\n' "$ROOST_RECORD_TEXT"
      fi
      exit 0
    fi
    # A closed pane (#42): `roost read %N` on a pane that is gone prints its
    # last kept reply, and says on stderr that the pane is gone. Only a %N, and
    # only on the boot of the server `t` talks to — see record_for. A pane that
    # never had a record falls through to exactly today's failure, and so does a
    # record this roost cannot use, after one warning line.
    case "$raw" in
      %[0-9]*)
        if record_for "$raw" "$tgt" && [ "$RF_LIVE" = 0 ]; then
          if [ "$RF_STATE" -eq 0 ]; then
            roost_record_scan "$RF_DIR/replies"
            if [ "$ROOST_RECORD_COUNT" -gt 0 ]; then
              roost_record_turn_file "$RF_DIR" "$ROOST_RECORD_MAX"
              if roost_record_read "$ROOST_RECORD_FILE"; then
                echo "roost read: '$raw' is gone — this is its last recorded reply (turn $ROOST_RECORD_MAX)." >&2
                if [ "$json" -eq 1 ]; then
                  . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
                  roost_jsonout_emit read target s "$raw" pane z "$RF_PANE" source s record state z "" \
                    stale b 0 error_reason z "" turn i "$ROOST_RECORD_MAX" text t "$ROOST_RECORD_TEXT" || roost_jsonout_fail read
                  exit 0
                fi
                if [ "$render" -eq 1 ]; then
                  printf '%s\n' "$ROOST_RECORD_TEXT" | render_stdin
                else
                  printf '%s\n' "$ROOST_RECORD_TEXT"
                fi
                exit 0
              fi
            fi
          else
            record_warn read "$raw"
          fi
        fi ;;
    esac
    # Prefer what the agent SAID over what its pane is DRAWING. An adapter
    # (the Claude Stop hook, adapters/opencode/roost.js) stamps @roost-reply
    # with the turn's last assistant message before it stamps the state, so a
    # caller following the documented `wait-done` then `read` idiom cannot land
    # in the gap between the two and miss it.
    #
    # show-options -p, NOT display-message '#{@roost-reply}': -p reads PANE
    # scope only, where the adapters write. A format lookup falls back
    # pane -> window -> global, so a stray outer-scope @roost-reply — the exact
    # accident that @agent_state has a `set -gu` in tmux/roost.conf to undo —
    # would be served here as if it were this agent's own reply.
    #
    # Verified on tmux 3.6: a stored value containing newlines, a tab,
    # `#{pane_id}`, `#[fg=red]` and a literal `%` comes back byte-identical
    # under od -c. tmux does not re-expand a substituted option value, so an
    # agent reply containing tmux format syntax is safe here.
    #
    # A `blocked` left behind by a declined Claude dialog (#38) is offered to
    # the helper `send` and `wait-done` use BEFORE the reply is read, so read
    # agrees with them whether or not a reply is stored. A clear also unsets
    # @roost-reply — a declined turn fired no Stop, so what was stored is the
    # previous turn's — and read then falls back to the screen and says so.
    if [ "$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)" = "blocked" ]; then
      roost_unblock_pane "$tgt" || true
    fi
    reply="$(t show-options -p -t "$tgt" -qv @roost-reply 2>/dev/null || true)"
    if [ -n "$reply" ]; then
      # A reply recorded at the end of turn N is still on the pane during turn
      # N+1. It is not cleared at the turn start — that would throw away a
      # reply the caller was merely slow to collect — so say when it is not
      # current instead. @agent_state already answers this exactly: a pane that
      # is working or blocked has not finished the turn whose reply this would
      # be, so whatever is stored came from an earlier one.
      state="$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)"
      # `error` belongs here alongside working and blocked, and for a different
      # reason than theirs. Those two mean the turn has not finished, so
      # whatever is stored predates it. `error` means the turn finished BADLY,
      # and every adapter drops the half-built reply on that path
      # (adapters/opencode/roost.js and its copilot and pi equivalents all say
      # so) precisely because a failed turn has no answer to publish. So a
      # reply sitting on an errored pane cannot be that turn's, either — and
      # this is the more ordinary route of the two, because a provider outage
      # is an ordinary event where an interrupted turn is not.
      case "$state" in
        working|blocked|error)
          echo "roost read: '$raw' is $state — this reply is from its previous turn." >&2 ;;
      esac
      # The kept copy of this reply (#42). @roost-reply-turn names the turn file
      # the writer made with it, and roost_record_match lets that file stand in
      # for the pane value only while the pane still holds exactly what tmux
      # stored for that turn (its .pane sidecar). So a reply prints whole and as
      # the agent wrote it — including on tmux 3.4/3.5a, which store some bytes
      # rewritten — and a pane value set any other way afterwards (by hand, by a
      # writer that recorded nothing, by an older roost) is printed as it is.
      # The pane wins.
      json_turn=""
      if record_for "$raw" "$tgt" && [ "$RF_LIVE" = 1 ]; then
        ptr="$(t show-options -p -t "$tgt" -qv @roost-reply-turn 2>/dev/null || true)"
        case "$ptr" in ''|*[!0-9]*|0*) ptr="" ;; esac
        if [ -n "$ptr" ] && [ "${#ptr}" -le 15 ]; then
          if [ "$RF_STATE" -eq 0 ]; then
            # Compared as a UTF-8 client (-u), the way the writer read it back:
            # without a UTF-8 locale outside tmux, a plain client PRINTS newline,
            # tab and non-ASCII as `_`, and the two would never be equal. $reply
            # itself — what a match does not replace — is left exactly as
            # this command has always printed it.
            reply_u="$(t -u show-options -p -t "$tgt" -qv @roost-reply 2>/dev/null || true)"
            if roost_record_match "$reply_u" "$RF_DIR" "$ptr"; then
              reply="$ROOST_RECORD_TEXT"
              json_turn="$ptr"
            fi
          else
            record_warn read "$raw"
          fi
        fi
      fi
      # --json: the values this branch has already read, as a document. The
      # notice above has gone to stderr either way, and `stale` is that same
      # decision as a field. The pane id and the error reason are the two extra
      # reads, both silenced: the human mode reads neither here, and neither
      # may add a line to stderr the human mode would not print.
      if [ "$json" -eq 1 ]; then
        . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
        json_pane="$(t display-message -p -t "$tgt" '#{pane_id}' 2>/dev/null || true)"
        json_stale=0 json_why=""
        case "$state" in working|blocked|error) json_stale=1 ;; esac
        if [ "$state" = "error" ]; then
          json_why="$(t show-options -p -t "$tgt" -qv @roost-error-reason 2>/dev/null || true)"
        fi
        # tmux 3.4 and 3.5a store control bytes and invalid UTF-8 as escape
        # text that cannot be decoded exactly (roost_jsonout_looks_escaped says
        # why). The text is left as stored -- what the human mode prints -- and
        # marked lossy when it could be such a rewrite. The server is asked only
        # when the text looks escaped, so an ordinary reply costs nothing more.
        json_text_kind=t
        # Text served from the kept turn file is the agent's raw bytes, never a
        # value tmux rewrote, so the "may be tmux's escape text" marking below
        # applies only to a pane value printed as it is.
        if [ -z "$json_turn" ] && roost_jsonout_looks_escaped "$reply" && roost_jsonout_server_escapes "$tgt"; then
          json_text_kind=T
        fi
        roost_jsonout_emit read target s "$raw" pane z "$json_pane" source s reply state z "$state" \
          stale b "$json_stale" error_reason z "$json_why" turn i "$json_turn" text "$json_text_kind" "$reply" || roost_jsonout_fail read
        exit 0
      fi
      # $lines is deliberately NOT applied. A recorded reply is returned whole:
      # `tail -n` on it would chop the BEGINNING off a long answer, and
      # skills/roost/SKILL.md passes 40 today, which would silently truncate
      # anything longer. N describes the screen, and only the screen.
      # Branch rather than always piping: with --render absent the reply must
      # leave this command by exactly the printf it always has, unchanged down
      # to the byte, because that is what callers diff against.
      if [ "$render" -eq 1 ]; then
        printf '%s\n' "$reply" | render_stdin
      else
        printf '%s\n' "$reply"
      fi
      exit 0
    fi
    # Never return nothing. An empty result would be a worse failure than the
    # chrome this command was fixed to stop returning — the caller cannot tell
    # "no reply recorded" from "the agent said nothing". Fall back to the
    # screen, and say so: a SILENT fallback would re-create the original bug
    # quietly, which is the one outcome ruled out.
    #
    # stderr, not stdout, for three reasons that all have callers today:
    # tests/test-coordination.sh:242 and tests/test-panes.sh:31 both pipe this
    # into `grep -q`; the site's `for w in api web worker; do roost read "$w";
    # done` idiom would gain a notice per agent; and a shell pane — which
    # legitimately has no reply channel at all — would otherwise have this
    # prepended to every single read.
    echo "roost read: no recorded reply for '$raw' — showing the pane's screen instead." >&2
    # The second line is a GUESS at why, and on an errored pane with a recorded
    # reason the guess is wrong twice: the pane has an adapter, and its turn
    # finished. A codex dead turn (#39) lands exactly here, because it clears
    # its reply — so say the reason the adapter recorded, which is what a
    # caller that just got exit 1 from `wait-done` needs to see again here.
    # Pane scope only (-p), for the reason given at the @roost-reply read above.
    why="$(t show-options -p -t "$tgt" -qv @roost-error-reason 2>/dev/null || true)"
    if [ -n "$why" ] && [ "$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)" = "error" ]; then
      echo "roost read: ('$raw' is in error state: $why; roost screen reads the screen without this notice)" >&2
    else
      echo "roost read: (that pane has no roost adapter, or its turn has not finished; roost screen reads the screen without this notice)" >&2
    fi
    # THE FALLBACK IS NOT RENDERED, and this is a deliberate reversal of the
    # obvious reading of the flag. A recorded reply is markdown because an
    # agent wrote it. A pane's SCREEN is not: it is terminal output, and a
    # markdown renderer DELETES the characters in it that look like syntax.
    # Measured against the real preen:
    #
    #   CANARY <ttyUSB0> port  ->  CANARY  port    (an HTML-ish tag, gone)
    #   2*3*4 = 24             ->  234 = 24        (*3* read as emphasis)
    #   rate _low_ now         ->  rate low now    (underscores eaten)
    #
    # Silently dropping bytes out of the one output a human reads to work out
    # what a pane is doing is a worse trade than leaving it uncoloured -- and
    # it is the exact class of quiet loss this command exists to stop, since
    # the caller cannot tell a deleted token from one the pane never printed.
    #
    # Said on stderr rather than done silently, for the reason the previous
    # version of this comment gave: a flag that appears to stop working looks
    # like a broken renderer. So it is stated, on the stream that is not the
    # caller's pipe.
    if [ "$render" -eq 1 ]; then
      echo "roost read: the screen is not markdown, so it is not rendered — a renderer would delete <tags>, *stars* and _underscores_ that are the pane's own output." >&2
    fi
    # --json: the screen as a document, after the same notices on stderr.
    # roost_jsonout_screen fails where screen_dump fails, except on a blank
    # screen, which is a valid empty document at exit 0 -- see that function.
    if [ "$json" -eq 1 ]; then
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      roost_jsonout_screen "$tgt" "$lines" || exit 1
      json_pane="$(t display-message -p -t "$tgt" '#{pane_id}' 2>/dev/null || true)"
      json_state="$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)"
      json_why=""
      if [ "$json_state" = "error" ]; then json_why="$why"; fi
      roost_jsonout_emit read target s "$raw" pane z "$json_pane" source s screen state z "$json_state" \
        stale b 0 error_reason z "$json_why" turn i "" text t "$ROOST_JSONOUT_TEXT" || roost_jsonout_fail read
      exit 0
    fi
    screen_dump "$tgt" "$lines"
    ;;
  screen)
    # What `read` did before it learned to prefer a recorded reply, under a
    # name that promises only what capture-pane can deliver. AGENTS.md section 7
    # and the issue doc both argue `read` over-promises; this is the honest
    # half. skills/roost/SKILL.md's "roost read it to see what's stuck"
    # guidance points here, because a stuck TUI is exactly the case where the
    # rendering IS the thing you want, chrome included.
    # --json (#41) is the one flag the target slot accepts, once. It is taken
    # off the front and the positionals renumbered, so everything below reads
    # $2 and $3 as it always has.
    json=0
    if [ "${2:-}" = "--json" ]; then
      json=1
      shift 2
      set -- screen "$@"
    fi
    need_arg "${2:-}" "usage: roost screen [SESSION:]WINDOW [LINES]"; raw="$2"; lines="${3:-40}"
    # No target begins with a dash, so a word that does is a flag or a typo.
    # `roost read` refuses it; without this, `roost screen -5` took `-5` as a
    # target and read a pane for it, so the two commands disagreed about the
    # same input. Found by review.
    # Both slots, not just the target. Fixing slot 2 alone left
    # `roost screen TGT --render` reaching `tail -n --render` and printing
    # `tail: illegal offset` -- the exact leak that was removed from `read`,
    # still live here under a commit claiming the two commands agreed. A
    # negative LINES is allowed in the count slot for the reason read's is:
    # `tail -n -3` means "the last 3 lines".
    case "$raw" in
      -*)
        if [ "$json" -eq 1 ]; then
          echo "roost screen: '$raw' is not a target — --json may be given once, before the target." >&2
        else
          echo "roost screen: '$raw' is not a target — roost screen takes no flags." >&2
        fi
        echo "usage: roost screen [SESSION:]WINDOW [LINES]" >&2
        exit 1 ;;
    esac
    for _arg in "${@:3}"; do
      case "$_arg" in
        -[0-9]*) continue ;;
        -*)
          # After --json the old sentence would be false -- screen now takes one
          # flag -- so that case names where it goes. Without --json the wording
          # is unchanged down to the byte.
          if [ "$json" -eq 1 ]; then
            echo "roost screen: '$_arg' is not valid here — --json goes before the target, once." >&2
          else
            echo "roost screen: '$_arg' is not valid — roost screen takes no flags." >&2
          fi
          echo "usage: roost screen [SESSION:]WINDOW [LINES]" >&2
          exit 1 ;;
      esac
    done
    if [ "$json" -eq 1 ]; then
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      roost_jsonout_screen "$(target "$raw")" "$lines" || exit 1
      json_pane="$(t display-message -p -t "$(target "$raw")" '#{pane_id}' 2>/dev/null || true)"
      # A negative LINES is reported as its count, the way tail reads it. Any
      # other spelling tail accepts (`+3`, "from line 3") is not a count, and
      # roost_jsonout_int turns it into null.
      json_lines="${lines#-}"
      # A count tail honours with leading zeros (`007`) is still a count, so it
      # is reported as 7 rather than as null. The zeros are stripped as TEXT,
      # not with $((10#...)): bash arithmetic wraps a 20-digit count to a
      # plausible-looking wrong number, and GNU tail accepts such a count. Past
      # 18 digits it is reported as null (roost_jsonout_int turns "" into null)
      # rather than as a value JSON consumers may not hold exactly. Found by review.
      case "$json_lines" in
        ''|*[!0-9]*) ;;
        *)
          json_lines="${json_lines#"${json_lines%%[!0]*}"}"
          [ -n "$json_lines" ] || json_lines=0
          [ "${#json_lines}" -le 18 ] || json_lines="" ;;
      esac
      roost_jsonout_emit screen target s "$raw" pane z "$json_pane" lines i "$json_lines" \
        text t "$ROOST_JSONOUT_TEXT" || roost_jsonout_fail screen
      exit 0
    fi
    screen_dump "$(target "$raw")" "$lines"
    ;;
  reply)
    shift
    # The public write end of the reply channel: an agent records what it just
    # said, so a sibling's `roost read` gets content instead of a screen. The
    # adapters use it (adapters/opencode/roost.js), and it completes the story
    # `roost state` already tells a harness with no adapter — badge yourself,
    # and post your reply.
    #
    # Text comes from argv, never stdin. `roost reply` is a documented public
    # command a human can type, and an unconditional stdin read would block
    # forever on a terminal. The Claude hook path reads stdin instead, but only
    # behind an explicit flag — see scripts/roost-agent-state.
    [ -n "${TMUX:-}" ] || exit 0
    [ -n "${TMUX_PANE:-}" ] || exit 0
    # Silent no-op unless the caller is a pane on THIS server — same contract as
    # `roost state`, so an adapter is safe to leave installed when its agent
    # runs somewhere else.
    #
    # The guard survives the socket-resolution fix above, and is not made
    # redundant by it. With $ROOST_SOCKET unset the two now agree by
    # construction — `t` is already pointed at the caller's own server — but an
    # explicit $ROOST_SOCKET still outranks $TMUX, so a caller in a pane on
    # server B with the seam naming server A reaches this line with a pane id
    # that means something different on each. That is exactly the case below.
    #
    # The check is on the server PID, not on the socket path. $TMUX is
    # "<socket-path>,<pid>,<session>", so the pid is exact and needs no
    # normalising; comparing paths instead would have to reconcile a socket
    # NAME (-L roost) against the absolute path tmux reports, and on macOS
    # /tmp vs /private/tmp on top of that. Getting that wrong fails in the
    # worst direction: $TMUX_PANE from another server is a perfectly valid
    # pane id HERE, so an unguarded write lands on a real, unrelated pane and
    # nothing reports an error.
    caller_pid="${TMUX#*,}"; caller_pid="${caller_pid%%,*}"
    # The server's start time rides on the same read as its pid: it is the other
    # half of the boot key the record below is filed under, and a second round
    # trip for it would be spent on every turn of every adapter.
    our="$(t display-message -p '#{pid} #{start_time}' 2>/dev/null || true)"
    our_pid="${our%% *}"
    [ -n "$our_pid" ] && [ "$caller_pid" = "$our_pid" ] || exit 0
    . "$ROOST_HOME/scripts/lib/roost-reply.sh"
    # The durable copy (#42), before the pane option — the Stop hook in
    # scripts/roost-agent-state does the same, and its comment says why. An
    # empty reply is not recorded: it reads as no reply at all.
    #
    # The socket recorded is the caller's own, from $TMUX: the guard above has
    # just proved it is the server `t` talks to, and it is an absolute path
    # where $SOCKET may be a -L name.
    . "$ROOST_HOME/scripts/lib/roost-record.sh"
    turn=""
    roost_record_root
    if [ -n "$*" ] && [ -n "$ROOST_RECORD_ROOT" ] \
       && roost_record_pane_dir "${our#* }-$our_pid" "$TMUX_PANE" \
       && roost_record_append "$ROOST_RECORD_PANE_DIR" "${TMUX%%,*}" "$*"; then
      turn="$ROOST_RECORD_TURN"
    fi
    # One tmux command for both options and the read-back of what tmux stored,
    # kept as the turn's .pane sidecar — for the reasons given at the Stop hook.
    if [ -n "$turn" ]; then
      stored="$(t set-option -p -t "$TMUX_PANE" @roost-reply "$(roost_reply_encode "$*")" \; \
        set-option -p -t "$TMUX_PANE" @roost-reply-turn "$turn" \; \
        show-options -pqv -t "$TMUX_PANE" @roost-reply 2>/dev/null || true)"
      roost_record_put_pane "$ROOST_RECORD_PANE_DIR" "$turn" "$stored" || true
    else
      t set-option -p -t "$TMUX_PANE" @roost-reply "$(roost_reply_encode "$*")" 2>/dev/null || true
    fi
    ;;
  wait-done|wait)
    need_arg "${2:-}" "usage: roost wait-done [SESSION:]WINDOW [TIMEOUT_SEC]"; raw="$2"; timeout=0
    # TIMEOUT_SEC is refused here, before any polling, unless it is a whole
    # number of seconds (#66). It flows into `[ "$timeout" -gt 0 ]` and
    # `$((timeout * 4))` in the loop below, and measured on the old code:
    #
    #   - `abc`, `1.5`, or a number too big for bash's integers: the `[` test
    #     errors rather than succeeds, so the loop never ended and printed
    #     `bin/roost: line N: [: abc: integer expression expected` — the
    #     checkout's path — four times a second.
    #   - `-5`: `-5 -gt 0` is false, so it silently waited with no limit.
    #   - an EMPTY string: `${3:-0}` read it as omitted, and waited with no
    #     limit. So the test is on $#, not on emptiness: omitted is the
    #     default, an empty value is a caller's bug (an unset variable) and is
    #     refused like any other.
    #   - `08`: a leading zero made the arithmetic octal, so 08 was a bash
    #     error and 010 meant eight seconds. Leading zeros are stripped, so
    #     both are decimal.
    #
    # At most 15 digits once the zeros are gone, which is 31 million years:
    # `timeout * 4` has to fit a 64-bit integer, and a longer value would wrap
    # to a negative number and wait with no limit.
    #
    # Exit 1 and a usage line, as need_arg does, and echo rather than a
    # `${3:?}` expansion for need_arg's reason: no path, no line number.
    if [ "$#" -ge 3 ]; then
      timeout="$3"
      case "$timeout" in
        ''|*[!0-9]*) timeout=bad ;;
        *) timeout="${timeout#"${timeout%%[!0]*}"}"; timeout="${timeout:-0}"
           [ "${#timeout}" -le 15 ] || timeout=bad ;;
      esac
      if [ "$timeout" = bad ]; then
        echo "roost wait-done: TIMEOUT_SEC must be a whole number of seconds from 0 to 999999999999999, got '$3'" >&2
        echo "usage: roost wait-done [SESSION:]WINDOW [TIMEOUT_SEC]" >&2
        exit 1
      fi
    fi
    tgt="$(target "$raw")"
    # A %N target is pane-precise; anything else aggregates the window's agent
    # panes. The two cases MUST branch on the target form: `list-panes -t %N`
    # lists that pane's whole WINDOW, not the single pane.
    # State is a PANE option, so it is read with display-message (which resolves
    # pane scope). `show-options -wqv` exits 0 with EMPTY output for a pane
    # option, so a `|| echo idle` fallback never fires and the empty string
    # matches neither done nor idle — the wait loop would hang until timeout.
    #
    # Every `blocked` pane is offered to roost_unblock_pane first, on every
    # pass. A declined Claude dialog fires no event, so without this a waiter
    # on that pane would burn its whole timeout (#38). It is the helper `send`
    # and `read` use, so all three agree, and it costs nothing on a pane that
    # does not read `blocked`.
    #
    # A dead agent is told apart from a busy one with tmux facts only (#54):
    # whether the pane still exists, and #{pane_dead}. Never a process-tree
    # walk or a screen regex — both guess, and a guess that says "died" about a
    # working agent aborts the coordinator waiting on it.
    #
    # One more fact joins them for an agent typed at a shell prompt (#64): the
    # job that held the pane's terminal when its hook stamped busy, which
    # scripts/roost-agent-state records in @roost-agent-job. It is still not a
    # walk: the sink recorded which job, and this checks two kernel facts about
    # it — see job_gone below.
    #
    # What each way of dying looks like, MEASURED on tmux 3.6 with a stand-in
    # agent and with a real Claude Code killed mid-turn:
    #
    #   - launched as the pane's command (`roost spawn NAME CMD`) and killed:
    #     the pane closes. Before this, wait-done exited 0 — a dead agent
    #     reported as finished — because `display-message -p -t %GONE` exits 0
    #     with every format EMPTY, which read as "no badge", which read as done.
    #     `kill-pane` and `kill-window` looked the same.
    #   - `remain-on-exit on`: the pane stays with pane_dead=1 and its badge
    #     still `working`, and wait-done burned its whole timeout.
    #   - killed inside a shell: the pane stays alive at a prompt, pane_dead is
    #     0 and the badge stays `working`. No tmux fact changes except
    #     #{pane_current_command}, which is a process NAME and is not trusted
    #     here. Until #64 that case timed out with exit 1; now the recorded
    #     foreground job catches it (job_gone). A pane with no record — an older
    #     install, or an agent that was not a job of the pane's shell — still
    #     times out, exactly as before; docs/known-gaps.md.
    #
    # snapshot() prints one "id dead pane_pid jJOB state" line per pane the
    # target covers,
    # and fails when the target is gone. list-panes, never display-message,
    # for the reason above: list-panes exits non-zero on a target that does not
    # exist. A %N target is matched by id out of `list-panes -a`, because
    # `list-panes -t %N` lists that pane's whole WINDOW, not the single pane.
    # The state is last on purpose: it is the only field that can be EMPTY (a
    # pane no hook has stamped), and `read` leaves a trailing empty field empty.
    # @roost-agent-job can be empty too, so it carries a fixed `j` prefix: an
    # unrecorded pane reads `j`, never a missing field that would shift the
    # state one place left. Its value is "PGID:PANE_PID", with no space.
    #
    # A read loop over a captured string, not a pipe into `grep`/`awk ... exit`:
    # bin/roost runs under `set -o pipefail`, and a reader exiting early can
    # SIGPIPE list-panes, so the pipeline would report failure even when the
    # pane IS there — and wait-done would call a live agent gone.
    snapshot() {
      local _all _id _dead _pp _job _st
      case "$tgt" in
        %*)
          _all="$(t list-panes -a -F '#{pane_id} #{pane_dead} #{pane_pid} j#{@roost-agent-job} #{@agent_state}' 2>/dev/null)" || return 1
          while read -r _id _dead _pp _job _st; do
            [ "$_id" = "$tgt" ] && { printf '%s %s %s %s %s\n' "$_id" "$_dead" "$_pp" "$_job" "$_st"; return 0; }
          done <<< "$_all"
          return 1
          ;;
        *)
          t list-panes -t "$tgt" -F '#{pane_id} #{pane_dead} #{pane_pid} j#{@roost-agent-job} #{@agent_state}' 2>/dev/null
          ;;
      esac
    }
    # A vanished pane is only a death if it vanished while busy. A one-shot
    # agent stamps done and then its pane closes on its own — measured with
    # `claude -p` in a `roost spawn` window at 531ms, 1297ms and 1348ms from
    # done to gone — and a waiter that saw done must not call that died. So
    # $busy_seen keeps the "id state" of every pane the LAST poll saw busy,
    # and only those count when they disappear. A pane that was already gone
    # on the first poll has no history at all, and says so.
    #
    # The poll is a quarter second rather than the old one, for that same
    # measurement: a 1s poll lands inside a 531ms done-to-gone gap about half
    # the time, and the other half it sees working, then nothing, and would
    # report a finished agent as died. $timeout stays in seconds; $ticks
    # counts quarters.
    #
    # died_if_vanished ROWS: a pane $busy_seen names that ROWS no longer lists
    # closed mid-turn — exit 2, naming it. In a window, a pane that was NOT busy
    # closing is not a death, and a window target must give the answer a pane
    # target would.
    died_if_vanished() {
      local _id _st
      while read -r _id _st; do
        [ -n "$_id" ] || continue
        case "$1" in
          "$_id "*|*$'\n'"$_id "*) ;;
          *) echo "roost: '$raw' died: pane $_id closed while it read $_st" >&2; exit 2 ;;
        esac
      done <<< "$busy_seen"
    }
    # job_gone PANE_PID jJOB: true when the agent this busy pane recorded has
    # died inside the pane's shell (#64). Both facts are needed, and both are
    # read from the kernel, not inferred:
    #
    #   1. `kill -0 -- -PGID` fails: no process of the recorded job is left. A
    #      live wrapper, a child the agent restarted as, or a background process
    #      it left in its job all keep this true, so none of them reads as died.
    #      (A wrapper that outlives its agent is therefore missed, and times
    #      out: docs/known-gaps.md. So, for up to about 300 s, is a Claude killed
    #      mid-reply: it runs `caffeinate -i -t 300` inside its own job, and
    #      that helper outlives it — measured 305 s. Kept on purpose: "the
    #      leader is gone" would answer at once but calls an agent that restarts
    #      itself as a child died.) A pgid that has been reused can only make a
    #      dead job look alive, never a live one look dead.
    #   2. the pane's shell holds the terminal again (its tpgid is PANE_PID). If
    #      another job holds it, that may be a new agent typed at the same
    #      prompt that has not stamped yet — the record is stale, not a death.
    #
    # No record, a malformed one, or one whose PANE_PID is not the pane's
    # current process (respawn-pane -k keeps pane options) → false: exactly the
    # pre-#64 behaviour. Step 1 is a builtin and runs every poll; the `ps` of
    # step 2 forks only once step 1 has failed.
    job_gone() {
      local _j="${2#j}" _pg _jp _fg
      [ -n "$_j" ] || return 1
      _pg="${_j%%:*}"; _jp="${_j#*:}"
      case "$_pg:$_jp" in *[!0-9:]*|:*|*:) return 1 ;; esac
      [ "$_jp" = "$1" ] && [ "$_pg" != "$1" ] && [ "$_pg" -gt 1 ] || return 1
      kill -0 -- "-$_pg" 2>/dev/null && return 1
      _fg="$(ps -o tpgid= -p "$1" 2>/dev/null)" || return 1
      _fg="${_fg//[[:space:]]/}"
      [ "$_fg" = "$1" ]
    }
    busy_seen=""; first=1; ticks=0
    while :; do
      if ! rows="$(snapshot)"; then
        if [ "$first" = 1 ]; then
          echo "roost: '$raw' is gone: no such pane or window. roost cannot tell an agent that finished and closed its pane from one that died" >&2
        else
          # Not first, so the last poll saw something busy — or it would have
          # exited 0 — and $busy_seen is not empty.
          read -r _id _st <<< "$busy_seen"
          echo "roost: '$raw' died: its pane closed while $_id read $_st" >&2
        fi
        exit 2
      fi
      # Every `blocked` pane is offered to roost_unblock_pane (see above), then
      # the snapshot is taken again so the checks below read what it left.
      # Once a second, not on every quarter-second tick: the helper reads a
      # transcript, and the recovery it exists for is not a race.
      if [ $((ticks % 4)) = 0 ]; then
        offered=0
        while read -r _id _dead _pp _job _st; do
          [ "$_st" = "blocked" ] && { roost_unblock_pane "$_id" || true; offered=1; }
        done <<< "$rows"
        if [ "$offered" = 1 ]; then
          # The snapshot ABOVE becomes the history before the snapshot is taken
          # again: first judged against the last poll's history, then made the
          # history itself. Without the second step, a blocked pane that closes
          # between the two reads — on the first poll, or on the pass it first
          # turned busy — is simply missing from the second read, $busy_seen does
          # not name it yet, and a window target whose sibling keeps the window
          # open exits 0 on a pane that died. Found by review (flock round 1).
          #
          # REBUILT, not appended to. A pane the last poll saw busy and the read
          # above saw done has finished; if it then closes while the helper runs
          # — which reads a transcript, and can take as long as a one-shot
          # agent's done-to-gone gap — an appended history would still name it
          # busy and report the finish as a death. Found by review (flock round
          # 2). A pane the helper clears is still listed below, so it never
          # matches the vanished-while-busy check.
          died_if_vanished "$rows"
          busy_seen=""
          while read -r _id _dead _pp _job _st; do
            case "$_st" in working|blocked) busy_seen="$busy_seen$_id $_st"$'\n' ;; esac
          done <<< "$rows"
          first=0
          # Gone between the two reads: the next pass reports it as died, with
          # the history just recorded.
          rows="$(snapshot)" || { sleep 0.25; ticks=$((ticks + 1)); continue; }
        fi
      fi
      # An errored agent will never become done, so treating it as "still busy"
      # would wait forever, and falling through to the default *) arm (as
      # working|blocked's absence used to) would report a dead agent as
      # successfully finished — the one wrong answer a coordinating agent
      # cannot recover from. Check and stop explicitly instead.
      #
      # It also keeps the errored pane's id in $err_pane, so the refusal can say
      # WHY: an adapter that inferred `error` rather than being told it (codex,
      # #39) records its reason in @roost-error-reason, and "error" alone does not
      # tell a coordinator whether to retry, re-prompt or go and look.
      #
      # Error is checked before death, so an errored pane keeps exit 1 even
      # once its process has gone: the reason it records is the better answer.
      err_pane=""
      while read -r _id _dead _pp _job _st; do
        [ "$_st" = "error" ] && { err_pane="$_id"; break; }
      done <<< "$rows"
      if [ -n "$err_pane" ]; then
        echo "roost: '$raw' is in error state, not done" >&2
        # show-options -p, as `read` does for @roost-reply: pane scope only, so
        # a stray window- or global-scope value is never reported as this
        # pane's reason. A pane with none (every adapter that has a real error
        # event) prints the one line it always has.
        why="$(t show-options -p -t "$err_pane" -qv @roost-error-reason 2>/dev/null || true)"
        [ -n "$why" ] && echo "roost: $err_pane: $why" >&2
        exit 1
      fi
      died_if_vanished "$rows"
      # A dead pane still badged busy: its process exited without finishing,
      # and a dead pane never runs another hook. One whose badge reads done or
      # idle finished first, and keeps its old answer below.
      busy_seen=""
      while read -r _id _dead _pp _job _st; do
        case "$_st" in
          working|blocked)
            if [ "$_dead" = 1 ]; then
              echo "roost: '$raw' died: pane $_id is dead (its process exited) while it read $_st" >&2
              exit 2
            fi
            if job_gone "$_pp" "$_job"; then
              echo "roost: '$raw' died: the agent in pane $_id exited inside its shell while it read $_st — the job that held its terminal has no process left, and the shell has the terminal back" >&2
              exit 2
            fi
            busy_seen="$busy_seen$_id $_st"$'\n'
            ;;
        esac
      done <<< "$rows"
      [ -n "$busy_seen" ] || break
      first=0
      sleep 0.25; ticks=$((ticks + 1))
      if [ "$timeout" -gt 0 ] && [ "$ticks" -ge $((timeout * 4)) ]; then
        echo "roost: timed out waiting for '$raw'" >&2; exit 1
      fi
    done
    exit 0
    ;;
  forget)
    # Delete kept replies (#42). The pane records live under one directory the
    # user can remove in one command; this is that command, with two narrower
    # forms. It never touches a pane option: the pane stays the truth, and a
    # live pane's current reply still reads after its record is gone.
    #
    #   forget TGT     one pane's record — a live pane, or a closed %N on this
    #                  server's boot (see record_for)
    #   forget --gone  every record whose pane is closed, or whose server has
    #                  stopped or restarted: the liveness check asks the server
    #                  at each record's socket, never a pid. A record it cannot
    #                  check is KEPT and named (roost_record_liveness)
    #   forget --all   every record
    #
    # Every form removes only what roost_record_is_record recognises: a
    # pane-number directory under a boot-key directory, holding the `schema`
    # file a writer creates first. A directory of the right shape without one is
    # left alone, and so is anything else under a ROOST_RECORD_DIR pointed
    # somewhere by mistake. What a user put INSIDE a record goes with it.
    . "$ROOST_HOME/scripts/lib/roost-record.sh"
    roost_record_root
    if [ -z "$ROOST_RECORD_ROOT" ]; then
      echo "roost forget: no record directory — ROOST_RECORD_DIR is not an absolute path, or HOME is unset." >&2
      exit 1
    fi
    case "${2:-}" in
      --all)
        n=0
        for _p in "$ROOST_RECORD_ROOT"/*/*; do
          roost_record_is_record "$_p" || continue
          rm -rf "$_p"
          rmdir "${_p%/*}" 2>/dev/null || true
          n=$((n + 1))
        done
        rmdir "$ROOST_RECORD_ROOT" 2>/dev/null || true
        echo "roost forget: removed $(plural "$n" record) under $ROOST_RECORD_ROOT"
        ;;
      --gone)
        removed=0 kept=0 unknown=0
        for _p in "$ROOST_RECORD_ROOT"/*/*; do
          roost_record_is_record "$_p" || continue
          _n="${_p##*/}"; _b="${_p%/*}"; _boot="${_b##*/}"
          roost_record__socket "$_p" || true
          roost_record_liveness "$ROOST_RECORD_SOCKET_SEEN" "$_boot" "%$_n"
          case "$ROOST_RECORD_LIVENESS" in
            live) kept=$((kept + 1)); continue ;;
            unknown)
              echo "roost forget: kept $_boot/$_n — could not ask its server whether the pane is still there"
              unknown=$((unknown + 1)); continue ;;
          esac
          roost_record_scan "$_p/replies"
          rm -rf "$_p"
          rmdir "$_b" 2>/dev/null || true
          echo "roost forget: removed $_boot/$_n ($(plural "$ROOST_RECORD_COUNT" turn))"
          removed=$((removed + 1))
        done
        if [ "$unknown" -gt 0 ]; then
          echo "roost forget: removed $(plural "$removed" record), kept $kept live and $unknown that could not be checked."
        else
          echo "roost forget: removed $(plural "$removed" record), kept $kept live."
        fi
        ;;
      ''|-*)
        echo "usage: roost forget TGT | --gone | --all" >&2
        exit 1
        ;;
      *)
        tgt="$(target "$2")"
        if ! record_for "$2" "$tgt" || ! roost_record_is_record "$RF_DIR"; then
          echo "roost forget: no record for '$2'." >&2
          exit 1
        fi
        roost_record_scan "$RF_DIR/replies"
        kb="$(du -sk "$RF_DIR" 2>/dev/null | awk '{print $1}')"
        rm -rf "$RF_DIR"
        rmdir "${RF_DIR%/*}" 2>/dev/null || true
        echo "roost forget: removed the record for '$2' ($(plural "$ROOST_RECORD_COUNT" turn), ${kb:-0} KB)"
        ;;
    esac
    ;;
  status)
    # --json (#41) only as the second word; any other extra word is ignored, as
    # it always was. The document reads the same tmux formats as the lines
    # below, without trusting a delimiter -- see roost_jsonout_list.
    if [ "${2:-}" = "--json" ]; then
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      roost_jsonout_status
      exit 0
    fi
    if server_running; then
      echo "roost: running (socket=$SOCKET)"
      t list-sessions -F '  session #{session_name} — #{session_windows} windows#{?session_attached, [attached],}'
      # Emptiness test, not truthiness: #{?@roost-name,...} treats the string "0"
      # as false, so a pane literally named "0" would wrongly fall back to
      # #{pane_current_command} here.
      # The "/LABEL" suffix is suppressed when LABEL == window_name: `spawn NAME`
      # names the window AND the pane from the same NAME, so an unconditional
      # suffix would print "api-agent/api-agent" — an echo of the window name
      # where real signal (what's running) belongs. LABEL is inlined twice
      # (once in the #{==:} test, once as the shown suffix) rather than
      # factored through a second #{E:} indirection — see tmux/roost.conf's
      # window-status-format comment for why.
      t list-panes -a -F '    #{pane_id}  #{session_name}:#{window_index}.#{pane_index} #{window_name}#{?#{==:#{?#{==:#{@roost-name},},#{pane_current_command},#{@roost-name}},#{window_name}},,/#{?#{==:#{@roost-name},},#{pane_current_command},#{@roost-name}}}  [#{?@agent_state,#{@agent_state},-}]'
    else echo "roost: not running"; fi
    ;;
  kill|down|stop)
    if [ -n "${2:-}" ]; then
      t kill-session -t "=$2" 2>/dev/null && echo "roost: session '$2' killed." || echo "roost: no session '$2'."
    else
      t kill-server 2>/dev/null && echo "roost: server stopped (all sessions)." || echo "roost: not running."
    fi
    ;;
  --version|-V|version)
    printf '%s\n' "$ROOST_VERSION"
    exit 0
    ;;
  *)
    # --- the extension seam -------------------------------------------------
    #
    # THE FALLBACK *IS* THE SEAM, and where it sits is the security control.
    # An installed extension is looked for here and nowhere else, so `send`,
    # `spawn`, `read`, `status` and every other label above have already
    # matched by the time control reaches this line: shadowing a core command
    # is structurally impossible, not merely refused. `roost ext install` does
    # refuse a manifest claiming a core name, and that refusal is what makes
    # the rule comprehensible to an extension author -- but it is a list
    # (roost_ext_core_commands) and lists go stale, whereas this branch
    # cannot. An extension able to intercept `roost send` would sit between
    # every message the user's agents exchange, reading and rewriting prompts
    # on their way past.
    #
    # Nothing above this line was touched to add the seam, and nothing inside
    # it changes what an unknown subcommand does: on a miss it still falls
    # through to the usage error at the bottom, on the same stream, with the
    # same exit status it had before extensions existed. The BYTES of that
    # line did change -- it gained `ext` when this arm landed, and `--version`
    # with the version flag -- so what is pinned is the line itself, written
    # out literally in tests/test-ext.sh, and it has to move in lockstep with
    # the usage string here. Ripping the whole feature out is deleting this
    # body back to that one line, which is a constraint on the implementation
    # rather than a hope -- so keep new work inside this branch.
    #
    # ROOST_NO_EXT is the cheapest rung of the design's "ripping it out"
    # ladder: with it set the seam is inert and roost behaves exactly as it
    # did before extensions existed. Non-EMPTY rather than merely set, because
    # `export ROOST_NO_EXT=` in a profile, or a launcher that exports every
    # name it knows whether or not it has a value, is not a request to turn
    # anything off -- the same distinction scripts/lib/roost-ext.sh draws over
    # an empty XDG variable.
    if [ -z "${ROOST_NO_EXT:-}" ]; then
      # Called inside an `if`, NEVER as a bare statement. This file runs under
      # `set -e` and a lookup MISS is the ORDINARY case here -- every mistyped
      # subcommand lands in this branch -- so a bare
      # `roost_ext_index_lookup "$1"` would exit the shell on the failing
      # lookup and `roost stauts` would print nothing at all where it used to
      # print the usage error.
      #
      # stdout is discarded and the answer read back out of the two variables
      # the lookup sets. A `$(...)` would put a fork on the one path that
      # function exists to keep fork-free, and would throw those variables
      # away with the subshell that set them.
      if roost_ext_index_lookup "$1" >/dev/null; then
        ext_name="$ROOST_EXT_LOOKUP_NAME"
        ext_exe="$ROOST_EXT_LOOKUP_PATH"
        # The second kill switch, `set -g @roost-ext-enabled off` in
        # roost.conf. Asked AFTER the lookup, where the design lists it
        # before: the observable behaviour is identical either way -- a miss
        # is the usage error whatever the option says -- and this order keeps
        # tmux, a fork and a round trip to a server, off the path every typo
        # takes.
        #
        # `|| true` because there may be no server running at all, and `set
        # -e` would otherwise take an ordinary mistyped command down with it.
        if [ "$(t show-options -gqv @roost-ext-enabled 2>/dev/null || true)" != "off" ]; then
          # This extension's two directories. roost_ext__roots SETS the roots
          # rather than printing them, which is the documented no-fork way to
          # build these paths; `$(roost_ext_data_dir)` would be a subshell for
          # a string the lookup has already resolved once.
          roost_ext__roots
          ext_dir="$ROOST_EXT_DATA_ROOT/ext/$ext_name"
          ext_state="$ROOST_EXT_STATE_ROOT/ext/$ext_name"

          # What authority the user consented to. It arrives in the fourth
          # column of the line the lookup has already read, and NOTHING here
          # reads ext.lock. roost_ext_index_write resolved it out of the
          # lockfile with a real JSON parser, once, at install and removal
          # time, and wrote the answer down.
          #
          # That indirection is the fix for a real bypass, not a convenience.
          # This branch used to parse ext.lock itself with shell string
          # operations, because neither python3 nor jq may be a runtime
          # dependency of roost (scripts/lib/roost-json.sh opens by saying
          # so). It matched the bytes `"needs"` anywhere in an entry and took
          # the next `[`, so an entry declaring `"needs": []` was handed the
          # fleet by two ordinary strings a manifest author controls --
          # `"description": "needs"` beside `"commands": ["fleet"]`. The user
          # read "asks for no access to your agents" at the consent prompt and
          # the extension got the run of the fleet.
          #
          # The rule that came out of it, and it is in the design now: decide
          # a grant where a real parser is available, carry the decision
          # forward, and never re-derive it somewhere cheaper. So no JSON is
          # parsed on this path, there is no assumption about the lockfile's
          # layout, and a typo costs one `while read` over a small text file.
          # Both files sit in the same 0600 state directory, so nothing about
          # the trust boundary moved when the decision did.
          ext_needs="$ROOST_EXT_LOOKUP_NEEDS"

          # roost_ext_needs_valid REFUSES an authority it does not recognise
          # rather than ignoring it, and that refusal has to be honoured here
          # too: a roost that silently granted nothing would leave the
          # extension believing it had everything, and that surfaces as
          # corrupted behaviour instead of a clean stop. `roost ext install`
          # refuses such a manifest and roost_ext_index_write will not write
          # an authority with whitespace in it, so a column that says this was
          # hand-edited or written by a newer roost than this one.
          if ! roost_ext_needs_valid "$ext_needs"; then
            echo "roost $1: extension '$ext_name' asks for an authority this roost does not know: $ROOST_EXT_NEEDS_UNKNOWN" >&2
            echo "roost $1: refusing, rather than running it with less than it expects" >&2
            # The way out, because a refusal a user cannot act on is a dead
            # end. Both of these are things they can type right now: one
            # takes the extension off the machine, the other turns the whole
            # seam off and gets every other roost command working again.
            echo "roost $1: remove it with 'roost ext remove $ext_name', or turn the seam off with ROOST_NO_EXT=1" >&2
            exit 1
          fi
          # Split, not a `*fleet*` substring test: a later contract adding an
          # authority whose name merely CONTAINS fleet would otherwise be
          # handed the fleet without asking for it. IFS is saved and put back
          # by hand because this is not inside a function and `local` is not
          # available here -- the same reason roost_ext_needs_valid restores
          # `set -f` itself. The same three separators, too: a split here that
          # disagreed with the one that VALIDATED is where an unknown value
          # gets dropped on the floor.
          #
          # No `set -f` around this unquoted expansion, unlike the split
          # inside roost_ext_needs_valid, because that call has already run:
          # every token left is the literal word `fleet`, and anything with a
          # glob character in it was refused above and never reached here.
          ext_fleet=0
          ext_saved_ifs="${IFS-}"
          IFS=$', \t\n'
          for ext_need in $ext_needs; do
            # An `if`, not `[ ... ] && ext_fleet=1`: under `set -e` a false
            # test on the LAST iteration would make the whole `for` return 1
            # and take roost down where it meant "this one is not fleet".
            if [ "$ext_need" = fleet ]; then ext_fleet=1; fi
          done
          IFS="$ext_saved_ifs"

          # Always on, whatever the extension declared.
          export ROOST_HOME ROOST_VERSION ROOST_CONTRACT
          export ROOST_EXT_DIR="$ext_dir"
          export ROOST_EXT_STATE="$ext_state"
          # Created before the exec, so an extension's first run already has
          # somewhere to write and no extension author has to repeat this. It
          # is also the ONLY path `roost ext remove --purge` knows to delete,
          # which is why an extension writing anywhere else has to say so in
          # its README. No `|| true`: handing an extension a ROOST_EXT_STATE
          # that is not there is the corrupted-behaviour shape this branch
          # keeps refusing, and mkdir has already said why on stderr.
          mkdir -p -- "$ext_state"

          if [ "$ext_fleet" -eq 1 ]; then
            # The grant, in the pieces a pane already gets: WHICH server to
            # talk to, HOW to address it, and roost's own scripts ahead of
            # PATH so that `roost read %N` and `roost send %N` resolve at all.
            export ROOST_SOCKET="$SOCKET"
            # The flag is handed over, not left for the extension to work out,
            # and that is a correction rather than a convenience. tmux needs
            # -L for a socket NAME and -S for a socket PATH; the line at the
            # top of this file that computes _SOCKET_FLAG makes exactly that
            # distinction, and scripts/roost-status, roost-switch and
            # roost-notify each make it again. An extension handed only the
            # value writes the obvious `tmux -L "$ROOST_SOCKET"`, which works
            # against the production server -- whose socket is the NAME
            # `roost` -- and silently addresses a different server everywhere
            # else, because every other one is a path: a `roost ssh` server,
            # a second server, every server the test suite builds.
            #
            # Silently talking to the wrong tmux is the failure this project
            # has already had once, and scripts/lib/roost-socket.sh's header
            # records it: roost-agent-state took the socket from $TMUX while
            # this file fell through to `-L roost`, and the result was that
            # "badges landed and replies vanished, exit 0, nothing printed."
            # Handing over the bare value would be asking every extension
            # author to rediscover that outage on their own users. It is
            # reused from _SOCKET_FLAG rather than re-derived here, so there
            # is one rule in this file and not two that can drift.
            export ROOST_SOCKET_FLAG="$_SOCKET_FLAG"
            export PATH="$ROOST_HOME/scripts:$PATH"
          else
            # UNSET, not empty, and doing it HERE is the whole point. An
            # extension that read an empty ROOST_SOCKET would address the
            # DEFAULT tmux server -- the user's own everyday tmux, the one
            # thing roost exists to leave alone -- and would do it silently.
            # Absent, the same read fails loudly instead.
            #
            # Withheld at exec time rather than checked, because a check the
            # extension runs is a check the extension can skip. There is
            # nothing here to pass and then bypass: the variable is simply not
            # in its environment.
            #
            # BOTH are withheld, together. Leaving ROOST_SOCKET_FLAG in
            # the environment would be handing out half a capability and a
            # misleading signal with it: an extension that found a flag and no
            # socket would be reading the leftovers of a grant it was refused.
            # They are one grant and they leave together.
            #
            # What this does NOT do is make the fleet unreachable, and
            # reading it that way is the mistake. `needs` governs what roost
            # HANDS OUT. It is not confinement, and the design says so in
            # "Non-goals" and in "Declared authority" -- read those before
            # relying on this line for anything.
            #
            # Two ways past it, neither of them exotic. An extension started
            # from inside a roost pane inherits that pane's $TMUX and its
            # PATH, and reaches the fleet through those. And outside a pane,
            # `tmux` is an ordinary binary that an extension may run itself:
            # the production server's socket is `-L roost`, a guessable
            # string, so withholding ROOST_SOCKET withholds a convenience and
            # a signal of intent, not access.
            #
            # What it does buy is still worth having: the accident above
            # cannot happen, and an extension that reaches the fleet anyway
            # has to contain the code that does it, in a repository the user
            # can read at the commit they pinned.
            unset ROOST_SOCKET ROOST_SOCKET_FLAG
          fi

          # The subcommand itself is dropped, so `roost mark %200` reaches
          # bin/roost-mark as `%200` -- the arguments it would have had if the
          # user had run that binary directly.
          shift
          # exec, not a call: the extension REPLACES roost in this process, so
          # its exit status is the user's unwrapped, its stdout and stderr are
          # the terminal's with nothing of roost's around them, and a signal
          # reaches it rather than a shell that would have to forward one.
          exec "$ext_exe" "$@"
        fi
      fi
    fi
    echo "usage: roost [up|session NAME|new NAME [SESSION]|spawn NAME [CMD]|split [-h|-v] [-t P] [-n NAME] [CMD]|view [-n NAME] CMD...|whoami|ssh HOST|send [--force] TGT TEXT|read [-r|--render] TGT [N]|screen TGT [N]|reply TEXT|wait-done TGT [T]|state STATE|hooks|doctor|validate|ext|install|update|init|settings|status|kill [SESSION]|--version|help]" >&2; exit 2
    ;;
esac
