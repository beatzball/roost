#!/usr/bin/env bash
# roost — launch an on-demand tmux "agent view" on its own isolated server.
#
# Your normal `tmux` is untouched: roost uses a separate socket (-L roost) and its
# own config (tmux/roost.conf), so it never sees or disturbs your regular
# sessions. Run your AI coding agents inside it; Claude Code hooks badge each
# pane by state (💥 error · 🛑 blocked · ⏳ working · ✅ done · 💤 idle).
#
# All roost sessions share one server, so the status counts and `prefix a`
# switcher roll up across every session.
#
#   roost                    start/attach the default session ("main")
#   roost session NAME       start/attach a named session (roost session a, ...)
#   roost new NAME [SESSION] open a new agent window and attach (default session "main")
#   roost spawn NAME [CMD]   open an agent window WITHOUT attaching; prints its target
#   roost split [-h|-v] [-t P] [-n NAME] [CMD]  open a helper pane in the current window; prints its %N
#   roost view [-n NAME] CMD...  show CMD to the human: a pane beside you if there is room, a window if not. No focus steal; a second call with the same NAME replaces the first
#   roost whoami [--json]    print this agent's own pane id (%N)
#   roost ssh HOST [ARGS]    run roost on a remote host (agents there, driven here)
#   roost send [--force] [--json] [--when-idle] [--from LABEL] TGT TEXT
#                            paste TEXT + Enter into an agent, verifying the submit (exit 1 if it never leaves the input line; TGT = %N pane, @N window, or [SESSION:]WINDOW). Refuses a 🛑 blocked target unless --force. On a ✅/💤 agent it then waits, briefly, for a NEW turn to begin and prints "%N TURN" on stdout — the pane it delivered to and the turn that prompt started, ready for `wait-done --turn` and `read --turn` (exit 4 if no turn begins — the text WAS submitted, so do not resend). Both fields or neither: a pane with no badge is not an agent, and with no reply record there are no turn numbers. --from LABEL records who sent the prompt beside that turn (one word, at most 64 bytes, not beginning with a dash; exit 2 if not; a bare %N is kept as pane:%N); without it, `pane:%N` for a send from a pane on this server, else `human`. The text pasted is unchanged either way. --when-idle holds the send while TGT reads ⏳ working, then sends it as usual (a 🛑 blocked TGT is still refused); the bound is @roost-send-idle-timeout, 300 s by default, at most 3600, and past it nothing is typed and the exit is 6. --json prints one JSON document instead, for a program
#   roost read [--turn N] [-r|--render|--json] TGT [N]
#                            print an agent's recorded reply; with none, falls back to its screen (last N non-blank lines, default 40) and says so on stderr. --render pipes the REPLY through preen to render its markdown; a screen fallback is never rendered (it is not markdown). --json prints one JSON document instead, for a program. Each turn is also kept whole on disk, so a reply past the 12 KB pane cap reads back in full, and a closed %N pane still reads its last reply. --turn N reads turn N (from 1), or with -N counts back from the newest (-1 is the newest); the newest 100 turns per pane are kept (ROOST_RECORD_KEEP)
#   roost forget TGT | --gone | --all
#                            delete kept replies: one pane's, every pane's that is closed or on a server that has stopped, or all of them. They live in ${XDG_STATE_HOME:-~/.local/state}/roost/panes (ROOST_RECORD_DIR overrides; set it to "" to keep none), and a closed pane's are deleted on their own 30 days after its last reply (ROOST_RECORD_DAYS). --all also clears the event log
#   roost events [--since CURSOR] [--follow] [--pane %N]
#                            print this server's state changes, one JSON line each with a cursor; --since resumes after one, --follow keeps printing until the server stops. Exit 3: the cursor was rotated away — re-read `status --json` and start again. ROOST_EVENTS="" turns the log off; see the Driving a Fleet docs page
#   roost screen [--json] TGT [N]  print what is ON that pane's screen — its last N non-blank lines (default 40), chrome included
#   roost reply TEXT... | roost reply -
#                            record this pane's reply, for another agent's `roost read`. TEXT... is read from the command line; `-` (or `--stdin`, or no argument at all) reads the reply from STDIN instead. Use stdin for a reply of more than a few KB, and for any reply built from a file: Linux refuses a single argument of 131072 bytes or more, so the command-line form loses a long reply outright
#   roost wait-done [--turn N] TGT [T]
#                            block until TGT (a %N pane, or every agent pane in a window) is done/idle. --turn N waits until TGT has recorded turn N — the number `roost send` printed — so the wait cannot be satisfied by the PREVIOUS turn's ✅; it needs a %N
#   roost answer [--json] [--force] [--expect FP] TGT --approve|--deny|--option N
#                            a PERSON'S verb: answer the dialog TGT is blocked on, with one key, once. FP is the dialog's fingerprint from `status --json`; it is required to approve or pick an option, so the key cannot land on a newer dialog. Refuses a caller in an agent's pane unless --force (a guard against an accident, not a lock); a dialog roost has no measured keys for; a pane that shows no dialog. Exit 0 answered and seen to land, 6 nothing to answer, 7 a different dialog, 8 no measured keys, 9 called from an agent's pane, 10 the key was sent and not seen to land: do NOT answer again. roost never answers on its own
#   roost close [--force] [--json] TGT [T]
#                            end ONE agent its harness's own way (/exit, /quit), wait up to T seconds (default 10) for it to leave, then close that pane and no other. Refuses a ⏳ working or 🛑 blocked pane unless --force, which skips the exit command; a window of more than one pane; and a session's last pane. If the harness opens a dialog on the way out, it stops and answers nothing. Kept replies stay, so `roost read %N` still works. Exit 0 closed, 1 refused or timed out, 2 already gone
#   roost hooks [claude|codex]  print the hook config that powers the badges (default: claude)
#   roost state STATE [--json]  report this pane's agent state (working|blocked|done|error|idle); --json then says whether it landed
#   roost identify --session ID --cwd DIR --harness NAME [--transcript PATH]  record who the agent in this pane is, for `status --json` (an adapter calls it at session start); a no-op outside roost
#   roost doctor             run preflight checks (tmux version, truecolor, hooks, ...)
#   roost validate [--quick] run every check a tester would run by hand -- suites, live drives, known bugs -- and write the report itself
#   roost ext SUBCOMMAND     add subcommands from a git repository: install, list, info, verify, update, remove
#   roost wiring on|off [-t SESSION] | remove
#                            roost's own route to claude and opencode in its panes, with no edit to your config: turn it on or off for the server or one session, or remove it (one claude run without it: ROOST_NO_SHIM=1 claude)
#   roost install            wire every installed agent (opencode, pi, copilot, claude, codex) to this checkout; never fetches code
#   roost upgrade            pull new roost code into this checkout (fast-forward only), then wire every agent to it; refused on a dev tree
#   roost update             the same as `upgrade`
#   roost init               setup wizard: writes ~/.config/roost/roost.conf
#   roost settings           change theme/glyphs/separator/notifications, live
#   roost status [--json]    list running sessions + agents (--json: one JSON document; see the Driving a Fleet docs page)
#   roost save [--to FILE]   write this server's shape — sessions, windows, panes, names, directories, layouts and agent keys — as a plain text file: ${XDG_STATE_HOME:-~/.local/state}/roost/shapes/<server>/shape, earlier saves under history/ (ROOST_SHAPE_DIR overrides; set it to "" to save nothing). `rm -rf` that shapes directory forgets every shape and nothing else
#   roost restore [--from FILE|STAMP-GEN] [--list] [--dry-run] [--only SEL ...]
#                            put a saved shape back as shells in their saved directories, at their saved indices and layouts; agents are not resumed yet. A session that exists is skipped and named (exit 12); --dry-run prints the plan and starts nothing; --list shows every save; --only takes a session, SESSION:WINDOW or an old %N. Run it from a plain terminal, not from inside roost (see the Persistent Sessions docs page)
#   roost kill [--yes] [SESSION]
#                            end one session, or with no SESSION stop the whole server: every session and every agent on it. The bare form asks first on a terminal (only y stops it) and, off a terminal, refuses unless --yes (or -y). `roost stop` and `roost down` are the same command
#   roost help               show this text
#   roost --version          print roost's version (-V, or `roost version`)
set -euo pipefail

# Resolve the repo root even when invoked via a symlink on PATH.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOST_HOME="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Two version numbers, deliberately kept apart. ROOST_VERSION is the product:
# semver, read from the VERSION file at the repo root, reported by
# `roost --version` and bumped on every release, however small. ROOST_CONTRACT
# is the extension seam's own version: a single integer that moves only when
# the SHAPE of extension wiring itself changes — a new required manifest
# field, a different lookup path — never when roost merely gains a feature or
# fixes a bug. Splitting them means an ordinary roost release, no matter how
# large, never invalidates an extension that was written against contract 1.
#
# `read` rather than `cat` under `set -e`: a missing or unreadable VERSION
# (a half-copied checkout, a stray permissions change) must not take EVERY
# roost command down with it, because this line runs before the subcommand
# case even sees what was asked for. `roost state` sits on that path and
# fires on every tool call of every live agent (AGENTS.md §2) — a damaged
# checkout breaking that would freeze real agents mid-session — and `roost
# doctor`, the tool a user reaches for to diagnose a damaged checkout, cannot
# be the thing a damaged checkout takes out first. So a read failure falls
# back to the literal string "unknown" instead of aborting.
# 2>/dev/null precedes the `<`: bash applies simple-command redirections
# left to right, and a MISSING file fails at the `<` step itself, before a
# trailing `2>/dev/null` would take effect — so that order still prints
# "No such file or directory" straight past this line. Put here first, the
# redirect is already in place when the open fails.
read -r ROOST_VERSION 2>/dev/null < "$ROOST_HOME/VERSION" || ROOST_VERSION=unknown
ROOST_CONTRACT=1
# The third version number, and kept apart from both of the above for the same
# reason they are kept apart from each other. ROOST_JSON_SCHEMA is the schema of
# the documents `--json` prints (#41), and it is the "schema" key of every one
# of them. It moves only when a document changes in a way that breaks a
# consumer -- a field removed, renamed, retyped or given a new meaning. Adding a
# field, or a command that takes --json, is not a bump. The full rule is under
# "Versioning" in docs/airig/specs/2026-09-15-json-output-design.md.
ROOST_JSON_SCHEMA=1

# Socket, in order: $ROOST_SOCKET (explicit seam — tests, a second server, a
# `roost ssh` one) -> the roost server we are running inside -> the shared
# production server by name. The same three steps scripts/roost-status,
# roost-switch and roost-notify already resolve in, and which
# tests/test-socket-seams.sh pins for them.
#
# The MIDDLE step is the one this file was missing, and its absence was not
# cosmetic: `roost state` execs scripts/roost-agent-state, which has always
# taken the socket from $TMUX, while everything here fell straight through to
# `-L roost`. On any roost server that is not the default one, the badge landed
# and `roost reply` exited 0 having written nothing — and `read`, `screen`,
# `send` and `wait-done` addressed the production server instead, where the
# caller's pane id is a valid id belonging to a stranger. Both halves now ask
# scripts/lib/roost-socket.sh the same question. Do not re-inline the rule.
#
# Note what the middle step deliberately does NOT do: inherit any $TMUX. A user
# who types `roost spawn` from inside their everyday tmux still means the roost
# server, so roost_self_socket recognises only a socket path ending /roost.
. "$ROOST_HOME/scripts/lib/roost-socket.sh"
roost_self_socket
# roost_hooks_claude / roost_hooks_codex print the JSON object `roost hooks`
# shows below its own explanatory comments. Shared with the installer, which
# needs the identical bytes — see that file's header for why editing them
# there or here is not safe.
#
# Note for anyone reading the frozen-handlers warning in the codex prose
# below: it is about the VALUES, not the layout. Codex hashes the parsed
# handler struct, so indentation and key order are free and a caller may
# reflow the object to fit its own output — measured on codex-cli 0.151.0 via
# `hooks/list`, written up in full in scripts/lib/roost-hooks.sh's header. The
# prose below is printed to users and is pinned byte-for-byte by
# tests/fixtures/hooks-codex.txt, which is why the detail lives in the lib
# rather than being added to it.
. "$ROOST_HOME/scripts/lib/roost-hooks.sh"
# The extension seam's helpers: the index lookup the `*)` fallback at the very
# bottom of this file dispatches through, and the two path roots it builds
# ROOST_EXT_DIR and ROOST_EXT_STATE from.
#
# Sourced up here with the other libraries rather than lazily inside that
# branch. A `.` buried in a case arm is the kind of line that gets moved
# during a refactor and then silently stops running, and what would break is
# a lookup that quietly finds nothing — an installed extension turning back
# into "unknown subcommand" with no error anywhere to explain it.
#
# This is read on EVERY roost invocation, `roost state` included, which fires
# on every tool call of every live agent (AGENTS.md §2). That cost is exactly
# why scripts/lib/roost-ext.sh does one path expansion at source time and
# nothing else, and why it defers roost-json.sh to the two functions that
# actually parse JSON. See its header before adding work to it.
. "$ROOST_HOME/scripts/lib/roost-ext.sh"
# roost_unblock_pane: the one place a Claude `blocked` badge left by a declined
# or dismissed permission dialog may be cleared (#38), and only cleared, from
# Claude's own transcript rather than the screen. `send`, `read` and
# `wait-done` all ask it before believing `blocked`, so the three cannot
# disagree about a pane. It defines functions and one constant and runs
# nothing at source time, so `roost state` on the hot path pays one file read.
. "$ROOST_HOME/scripts/lib/roost-unblock.sh"
SOCKET="${ROOST_SOCKET:-${ROOST_SELF_SOCK:-roost}}"
case "$SOCKET" in */*) _SOCKET_FLAG="-S" ;; *) _SOCKET_FLAG="-L" ;; esac
DEFAULT_SESSION="main"
CONF="$ROOST_HOME/tmux/roost.conf"

t() { tmux "$_SOCKET_FLAG" "$SOCKET" "$@"; }

server_running()  { t list-sessions >/dev/null 2>&1; }        # ≥1 session exists
session_exists()  { t has-session -t "=$1" 2>/dev/null; }      # exact-name match

# Create the session if missing. The first session boots the server with our
# config (server/global options + bindings apply to every later session too).
ensure_session() {
  local s="$1"
  session_exists "$s" && return 0
  if server_running; then
    t new-session -d -s "$s" -c "$PWD"
  else
    t -f "$CONF" new-session -d -s "$s" -c "$PWD"
    server_init
    # The first pane was created by the `new-session` above, BEFORE apply set
    # default-command, ROOST_TMUX and ROOST_WIRING_DIR — and it is the pane
    # `roost up` attaches a human to, where they type `claude`. Found in review:
    # without this, every pane of a fresh server was wired except that one.
    # Respawning is safe only here: nothing has run in it yet but the login
    # shell that just started.
    #
    # The command is passed explicitly. Measured on tmux 3.6: `respawn-pane`
    # with no command re-runs the command the pane was CREATED with — here
    # none — and does not consult default-command, so it exits 0 and changes
    # nothing. A default-command the user set themselves is what gets passed
    # then, which is what that pane would have run anyway.
    if pane_cmd_wired; then
      _defcmd="$(t show-options -gqv default-command 2>/dev/null || true)"
      if [ -n "$_defcmd" ]; then
        t respawn-pane -k -t "=$s:" -c "$PWD" "$_defcmd" 2>/dev/null || true
      fi
    fi
  fi
}

# server_init — what a server roost just started gets, once, after its first
# `new-session`: roost's globals, the user's conf, and roost's wiring. Shared
# by ensure_session and `roost restore` (#51), which starts a server the same
# way but with a placeholder as its first pane (spec §4.3), so the two cannot
# drift. It does not touch the first pane: each caller decides that.
server_init() {
  t set-environment -g ROOST_HOME "$ROOST_HOME"
  t set-option -g @roost-home "$ROOST_HOME"
  t set-environment -g PATH "$ROOST_HOME/scripts:$PATH"
  # User config: sourced AFTER the base conf so it overrides. -q: silent if absent.
  ROOST_USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/roost/roost.conf"
  t set-option -g @roost-user-conf "$ROOST_USER_CONF"
  t source-file -qF "#{@roost-user-conf}"
  # Roost-owned wiring (#58): the claude shim through default-command, and
  # OPENCODE_CONFIG_DIR. AFTER the user's conf, because
  # `set -g @roost-wiring-enabled off` there must stop it before anything is
  # generated, and a default-command the user set there must be seen and
  # kept. Only here, when a server starts, so no other roost command — and
  # least of all `roost state` on every tool call — pays for it.
  #
  # Never fatal: a server that cannot be wired still has to start, and the
  # global install (if any) still badges. `roost doctor` reports the state.
  ROOST_SOCKET="$SOCKET" "$ROOST_HOME/scripts/roost-wiring" apply >/dev/null 2>&1 || true
}

# pane_cmd_wired — true when this server is wired, which is when a command
# roost starts in a pane has to be run through roost-pane-shell. Kept separate
# from the `set --` that uses it because `set --` inside a function would
# change only the function's own arguments.
pane_cmd_wired() { [ "$(t show-options -gqv @roost-wiring-active 2>/dev/null || true)" = on ]; }

attach_session() { ensure_session "$1"; exec tmux "$_SOCKET_FLAG" "$SOCKET" attach -t "=$1"; }

# @N (window-id) / %N (pane-id) / anything with a colon → verbatim; a bare word → default session.
target() { case "$1" in @*|%*|*:*) printf '%s' "$1" ;; *) printf '%s:%s' "$DEFAULT_SESSION" "$1" ;; esac; }

# record_for RAW TGT — find the pane record (#74) that RAW names, for `read` and
# `forget`. Returns 1 when records are off or RAW names nothing that could have
# one. Otherwise sets:
#
#   RF_DIR    the record directory (it may not exist)
#   RF_PANE   the %N it belongs to
#   RF_LIVE   1 when the pane exists now, 0 when it is gone
#   RF_STATE  what roost_record_schema said: 0 usable, 1 none, 2 unreadable,
#             3 written by a newer roost
#
# A live target is filed under its own server's boot key, read in the same tmux
# call that resolves it. A target tmux cannot find is looked up only when it is
# a pane id, under the boot of the server `t` talks to: a window name or @N of a
# window that is gone no longer names any pane, and a %N from an EARLIER boot is
# a different pane (tmux restarts pane ids at %0), so neither is guessed at.
record_for() {
  local info boot pane
  RF_DIR="" RF_PANE="" RF_LIVE=0 RF_STATE=1
  . "$ROOST_HOME/scripts/lib/roost-record.sh"
  roost_record_root
  [ -n "$ROOST_RECORD_ROOT" ] || return 1
  info="$(t display-message -p -t "$2" '#{start_time}-#{pid} #{pane_id}' 2>/dev/null || true)"
  # tmux 3.6 does NOT fail display-message for a pane id that is gone: it
  # prints the server's own formats and an EMPTY #{pane_id} (measured while
  # building this). So "found" is a non-empty pane id, not a zero exit.
  boot="${info%% *}"; pane="${info#* }"
  case "$pane" in %[0-9]*) RF_LIVE=1 ;; *) pane="" ;; esac
  if [ "$RF_LIVE" = 0 ]; then
    case "$1" in %[0-9]*) ;; *) return 1 ;; esac
    boot="$(t display-message -p '#{start_time}-#{pid}' 2>/dev/null || true)"
    pane="$1"
  fi
  roost_record_pane_dir "$boot" "$pane" || return 1
  RF_PANE="$pane"
  RF_DIR="$ROOST_RECORD_PANE_DIR"
  RF_STATE=0
  roost_record_schema "$RF_DIR" || RF_STATE=$?
  return 0
}

# record_warn COMMAND LABEL — the one line a record this roost cannot use earns.
# A warning and never a failure: the pane option still answers, and a damaged
# file in a state directory must not break the command that stumbled on it.
# What the schema file held is printed only when it is short and plain.
record_warn() {
  local seen="${ROOST_RECORD_SCHEMA_SEEN:-}"
  case "$seen" in *[!A-Za-z0-9._-]*) seen="?" ;; esac
  [ "${#seen}" -le 20 ] || seen="?"
  case "$RF_STATE" in
    2) echo "roost $1: the record for '$2' is unreadable (schema: $seen) — ignored." >&2 ;;
    3) echo "roost $1: the record for '$2' was written by a newer roost (schema $seen) — ignored." >&2 ;;
  esac
}

# plural N WORD — "1 turn", "2 turns".
plural() { if [ "$1" = 1 ]; then printf '%s %s' "$1" "$2"; else printf '%s %ss' "$1" "$2"; fi; }

# job_gone is shared by `wait-done` and `close` (#143): both need to know
# whether the agent a pane recorded has left it, and a second definition in
# `close` would be a second answer to one question. Moved here unchanged from
# the `wait-done` branch; its comment below still speaks from there.
# job_gone PANE_PID jJOB: true when the agent this busy pane recorded has
# died inside the pane's shell (#64). Both facts are needed, and both are
# read from the kernel, not inferred:
#
#   1. `kill -0 -- -PGID` fails: no process of the recorded job is left. A
#      live wrapper, a child the agent restarted as, or a background process
#      it left in its job all keep this true, so none of them reads as died.
#      (A wrapper that outlives its agent is therefore missed, and times
#      out: docs/known-gaps.md. So, for up to about 300 s, is a Claude killed
#      mid-reply: it runs `caffeinate -i -t 300` inside its own job, and
#      that helper outlives it — measured 305 s. Kept on purpose: "the
#      leader is gone" would answer at once but calls an agent that restarts
#      itself as a child died.) A pgid that has been reused can only make a
#      dead job look alive, never a live one look dead.
#   2. the pane's shell holds the terminal again (its tpgid is PANE_PID). If
#      another job holds it, that may be a new agent typed at the same
#      prompt that has not stamped yet — the record is stale, not a death.
#
# No record, a malformed one, or one whose PANE_PID is not the pane's
# current process (respawn-pane -k keeps pane options) → false: exactly the
# pre-#64 behaviour. Step 1 is a builtin and runs every poll; the `ps` of
# step 2 forks only once step 1 has failed.
job_gone() {
  local _j="${2#j}" _pg _jp _fg
  [ -n "$_j" ] || return 1
  _pg="${_j%%:*}"; _jp="${_j#*:}"
  case "$_pg:$_jp" in *[!0-9:]*|:*|*:) return 1 ;; esac
  [ "$_jp" = "$1" ] && [ "$_pg" != "$1" ] && [ "$_pg" -gt 1 ] || return 1
  kill -0 -- "-$_pg" 2>/dev/null && return 1
  _fg="$(ps -o tpgid= -p "$1" 2>/dev/null)" || return 1
  _fg="${_fg//[[:space:]]/}"
  [ "$_fg" = "$1" ]
}

# A pane/window NAME containing a tab or newline corrupts every consumer that
# treats a line as one record: `roost status` emits one line PER pane, so a
# `\n` in the name splits it into two; the switcher's tab-delimited awk rows
# shift every field after a `\t`, producing a selectable row with empty
# session/window/pane key fields — selecting it runs `switch-client -t ""`,
# the exact hazard the comment in scripts/roost-switch warns about. Reject
# outright rather than silently stripping: a mangled name that still "worked"
# would be a more confusing surprise later than a loud, immediate error.
reject_bad_name() {
  # $'\t' / $'\n' ANSI-C quoting, NOT "$(printf '\t')" — command substitution
  # strips ALL trailing newlines, so "$(printf '\n')" collapses to the empty
  # string and the newline arm would then match (and reject) every name.
  case "$1" in
    *$'\t'*|*$'\n'*)
      echo "roost $2: NAME may not contain a tab or newline" >&2; exit 2 ;;
  esac
}

# What `roost screen` returns, and what `roost read` falls back to. Drop the
# pane's trailing blank rows, keep the last N non-empty lines.
#
# This is a RENDERING, not content: for a full-screen TUI the bottom of the
# pane is an input box and status bars, not the reply. That is the whole reason
# @roost-reply exists — see docs/airig/issues/2026-08-21-read-returns-tui-chrome.md.
screen_dump() {
  t capture-pane -p -t "$1" | grep -v '^[[:space:]]*$' | tail -n "$2"
}

# need_arg VALUE USAGE -> print USAGE and exit 1 when VALUE is empty.
#
# `${2:?usage: ...}` was the old spelling, and bash renders that as
# `/abs/path/to/bin/roost: line 905: 2: usage: ...` -- the checkout's absolute
# path and an internal line number, in front of a user who typed a command
# wrong. The path is noise at best and the author's home directory at worst,
# and the line number is meaningless to a reader. Found by review.
roost_sq() {
  # Single-quote one string for a POSIX shell (and fish): every ' becomes '\''.
  local q="'"
  printf "'%s'" "${1//$q/$q\\$q$q}"
}

need_arg() {
  if [ -z "${1:-}" ]; then
    printf '%s\n' "$2" >&2
    exit 1
  fi
}

# The `--render` half of `roost read`: hand the text to preen
# (https://github.com/beatzball/preen), which renders markdown read on stdin.
#
# Opt-in, and nothing reaches this function unless --render was passed. The
# default path must stay byte-identical: callers pipe `roost read` into grep
# (tests/test-coordination.sh, tests/test-panes.sh) and one compares its whole
# output against the recorded reply (tests/test-reply-channel.sh), so a
# renderer in the default path would break every one of them.
#
# A renderer that is not installed must NOT fail the read. What the agent said
# is the payload; the colour is a convenience, and a `roost read --render` that
# exited non-zero on a machine without preen would strand a caller who only
# wanted the text. So print the text unchanged and say why on stderr — stderr
# for the same reason the screen-fallback notice below uses it: stdout is the
# caller's pipe.
#
# The text is BUFFERED first rather than streamed straight into preen, and
# that costs one variable to buy the property that matters: a renderer which
# fails must cost the caller the colour, never the text. Streaming spends the
# input before the exit status is known, leaving nothing to fall back to --
# and under `set -euo pipefail` (line 37) a preen that exits 3 took the whole
# command's status with it, so `roost read -r X || die` died on a read that
# had printed the reply perfectly. Found by review, with a stub renderer.
#
# `|| true` on the capture and an explicit status check rather than letting
# pipefail speak: the point here is to SWALLOW the renderer's failure after
# reporting it, which is the one place in this file that is the right thing to
# do. printf '%s\n', not echo, because a reply beginning with -n or -e is text.
render_stdin() {
  local text rendered rc visible
  text="$(cat)"
  if command -v preen >/dev/null 2>&1; then
    # preen's own stderr is NOT discarded. It is the only diagnosis available
    # when a renderer misbehaves, and swallowing it was the first version's
    # mistake: "preen exited 3" with no reason is barely better than silence.
    rendered="$(printf '%s\n' "$text" | preen -)" && rc=0 || rc=$?
    # A renderer that SUCCEEDS and returns nothing is the more common failure,
    # and the exit-status net does not catch it. Measured against the real
    # preen: `<ttyUSB0>` in, 2 bytes out (both newlines), exit 0, nothing on
    # stderr -- the whole reply gone. A renderer may change how text LOOKS; it
    # may not make it disappear.
    #
    # WHAT IS TESTED IS WHAT SURVIVES, NOT THE BYTE COUNT, and the first
    # version of this check got that wrong. preen pads every line to the
    # terminal width and wraps it in colour codes, so `$rendered` is never the
    # empty string: `&nbsp;` came back as 1754 bytes with NOTHING visible in
    # them -- the only non-padding bytes were a non-breaking space, which this
    # check deletes as whitespace like any other. A `[ -z "$rendered" ]` test
    # stepped aside for exactly the input it existed to catch. Escape
    # sequences and whitespace are stripped first, and what is left is the
    # question. Found by both reviewers, separately.
    #
    # `tr -d` rather than a shell glob: this runs on bash 3.2 with no regex
    # dependency, and the sed handles the CSI sequences preen actually emits.
    # Two strips, not one: SGR colour (CSI ... m) and OSC-8 hyperlinks
    # (ESC ] 8 ; ... BEL), whose URL is not text the reply ever contained. A
    # render carrying only a hyperlink is visually empty, and without the
    # second strip its URL counted as visible: the guard stepped aside and the
    # reply was lost, exit 0, silently. Both reviewers proved that end to end.
    #
    # THE ESCAPES ARE $'...' , NOT '\x07' INSIDE A BRACKET EXPRESSION, and the
    # first version of this line got that wrong in a way that read as correct.
    # BSD sed does not honour \x escapes inside `[...]`: `[^\x07]` means "not
    # one of \ x 0 7", so the expression matched nothing and the strip was a
    # no-op on macOS -- which CI also runs. Proved with `printf 'x07\ Q' | sed
    # 's/[^\x07]//g'` returning `x07\`. bash expands the escapes before sed
    # ever sees them, which works on both BSD and GNU.
    visible="$(printf '%s' "$rendered" \
      | sed $'s/\033\\[[0-9;]*m//g' \
      | sed $'s/\033\\]8;[^\a]*\a//g' \
      | tr -d '[:space:]')"
    if [ "${rc:-0}" -eq 0 ] && [ -n "$text" ] && [ -z "$visible" ]; then
      echo "roost read: preen returned nothing for a non-empty reply — printing the raw text instead." >&2
      printf '%s\n' "$text"
      return 0
    fi
    if [ "${rc:-0}" -eq 0 ]; then
      printf '%s\n' "$rendered"
      return 0
    fi
    echo "roost read: preen exited $rc — printing the raw text instead." >&2
    printf '%s\n' "$text"
    return 0
  fi
  echo "roost read: --render needs 'preen' on PATH — printing the raw text instead." >&2
  echo "roost read: (install it from https://github.com/beatzball/preen)" >&2
  printf '%s\n' "$text"
  return 0
}

case "${1:-up}" in
  up|start|"")
    attach_session "$DEFAULT_SESSION"
    ;;
  session|s)
    need_arg "${2:-}" "usage: roost session NAME"; sess="$2"
    attach_session "$sess"
    ;;
  new)
    name="${2:-agent}"; sess="${3:-$DEFAULT_SESSION}"
    reject_bad_name "$name" new
    ensure_session "$sess"
    # `=$sess:` — trailing colon so a numeric session name isn't parsed as a window
    # index (matches spawn; a bare `=0` fails "index 0 in use").
    t new-window -t "=$sess:" -n "$name" -c "$PWD"
    exec tmux "$_SOCKET_FLAG" "$SOCKET" attach -t "=$sess"
    ;;
  state)
    # The public state-reporting contract. Every state SOURCE calls this: the
    # Claude Code hooks below, adapters/opencode/roost.js, and anything a user
    # writes. It reads $TMUX and $TMUX_PANE to find the pane, and is a silent
    # no-op outside a roost server -- which is what makes an adapter safe to
    # leave installed when the agent runs somewhere else.
    #
    # `roost state STATE --json` (#41) sets the badge exactly as below and then
    # says what landed. The flag goes AFTER the state because that invocation
    # already set STATE and printed nothing before --json existed, so nothing
    # that worked changes. `roost state --json`, flag first, still means what it
    # always meant: --json is not a state, and an unknown state is idle.
    #
    # The point of the echo is the silent failure scripts/lib/roost-socket.sh
    # records: badges that did not land, exit 0, nothing printed. `recorded` is
    # a READ-BACK, so an adapter author can see a badge that went nowhere.
    #
    # Only `$3` is looked at, and nothing is forked when it is absent: the
    # hooks call scripts/roost-agent-state directly, but adapters come through
    # this arm, and the plain path must stay one `case` and an exec.
    if [ "${3:-}" = "--json" ]; then
      json_requested="${2-}"
      "$ROOST_HOME/scripts/roost-agent-state" "${2:-idle}"
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      json_pane="" json_state="" json_recorded=0 json_refused="" json_verified=""
      # The same three conditions roost-agent-state checks before it writes
      # anything, and the same server: it takes the socket from $TMUX, which is
      # what ROOST_SELF_SOCK holds, NOT from $SOCKET, which $ROOST_SOCKET can
      # point somewhere else.
      if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ -n "${ROOST_SELF_SOCK:-}" ]; then
        json_pane="$TMUX_PANE"
        # The normalisation roost-agent-state applies ("anything unrecognised
        # is idle"). A second copy of a five-word list, kept beside the read-back
        # that needs it; if that script's list ever grows, this must grow too,
        # and tests/test-json-output.sh's `state bogus --json` case goes red.
        case "${2:-idle}" in
          blocked|working|done|error) json_want="$2" ;;
          *) json_want=idle ;;
        esac
        # What the report filter made of this call (#105). The sink above was
        # this process's CHILD, so its walk started here: the same walk, from
        # this process, reaches the same answer, and that is asked again here
        # rather than passed back, because the sink has no channel to say it
        # and an unchanged state bails there before walking at all. Only
        # under --json, so the plain path forks nothing new.
        #
        #   in       verified: true
        #   unknown  verified: false -- accepted, and marked (the human's Q4)
        #   out      refused, with the reason; nothing this report asked for
        #            was recorded, so `recorded` is false and `state` null
        #            even when the badge happens to read the state asked for
        #            -- a coincidence, not this report's write
        . "$ROOST_HOME/scripts/lib/roost-ancestry.sh"
        roost_pid_in_pane "$$" "$(tmux -S "$ROOST_SELF_SOCK" display-message -p -t "$TMUX_PANE" '#{pane_pid}' 2>/dev/null || true)" || true
        case "$ROOST_ANCESTRY" in
          in) json_verified=1 ;;
          out) json_refused="not in this pane's process tree" ;;
          *) json_verified=0 ;;
        esac
        # show-options -p: pane scope only. A format lookup would fall back to
        # a window or global @agent_state and report a badge that is not there.
        if [ -z "$json_refused" ] \
           && [ "$(tmux -S "$ROOST_SELF_SOCK" show-options -p -t "$TMUX_PANE" -qv @agent_state 2>/dev/null || true)" = "$json_want" ]; then
          json_state="$json_want"; json_recorded=1
        fi
      fi
      roost_jsonout_emit state requested s "$json_requested" state z "$json_state" \
        pane z "$json_pane" recorded b "$json_recorded" refused z "$json_refused" \
        verified n "$json_verified" || roost_jsonout_fail state
      exit 0
    fi
    # `roost state idle --interrupted` (#95): the turn ended because a human
    # stopped it. The copilot adapter says so for an aborted turn; codex's
    # calls the sink directly. One more word, passed through, and the plain
    # path above it stays one `case` and an exec.
    if [ "${3:-}" = "--interrupted" ]; then
      exec "$ROOST_HOME/scripts/roost-agent-state" "${2:-idle}" --interrupted
    fi
    exec "$ROOST_HOME/scripts/roost-agent-state" "${2:-idle}"
    ;;
  identify)
    # The public identity-reporting contract (#141), in the shape of `state`
    # above: an adapter calls it, it finds the pane from $TMUX and $TMUX_PANE,
    # and it is a silent no-op outside a roost server. opencode, copilot and pi
    # call it at their session start; Claude Code and codex are identified from
    # their hook payloads instead (scripts/lib/roost-identity.sh has both
    # paths, and the rules every value must pass).
    #
    # Flags, not positions: the transcript is optional, and a harness that
    # later learns a fifth fact must not shift the meaning of the first four.
    #
    # A refused value is exit 2 and one line on stderr, INSIDE roost or out. It
    # is checked before the "am I in roost?" test on purpose: an adapter
    # author's bug should show the first time they run it, not only once it is
    # installed in a pane. Adapters discard both, so a harness never sees it.
    shift
    id_session="" id_cwd="" id_harness="" id_transcript="" id_seen=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --session|--cwd|--harness|--transcript)
          if [ "$#" -lt 2 ]; then
            echo "roost identify: $1 needs a value" >&2
            exit 2
          fi
          case "$1" in
            --session) id_session="$2" ;;
            --cwd) id_cwd="$2" ;;
            --harness) id_harness="$2" ;;
            --transcript) id_transcript="$2" ;;
          esac
          id_seen="$id_seen ${1#--}"
          shift 2
          ;;
        *)
          echo "usage: roost identify --session ID --cwd DIR --harness NAME [--transcript PATH]" >&2
          exit 2
          ;;
      esac
    done
    for id_need in session cwd harness; do
      case "$id_seen " in
        *" $id_need "*) ;;
        *)
          echo "usage: roost identify --session ID --cwd DIR --harness NAME [--transcript PATH]" >&2
          exit 2
          ;;
      esac
    done
    . "$ROOST_HOME/scripts/lib/roost-identity.sh"
    if ! roost_identity_valid "$id_session" "$id_cwd" "$id_harness" "$id_transcript"; then
      case "$ROOST_IDENTITY_BAD" in
        session) echo "roost identify: refused --session: 1-128 letters, digits, '.', '_', ':' or '-', not starting with '-'" >&2 ;;
        harness) echo "roost identify: refused --harness: 1-32 lower-case letters, digits, '_' or '-', not starting with '-'" >&2 ;;
        *) echo "roost identify: refused --$ROOST_IDENTITY_BAD: an absolute path of at most 1024 bytes, one line, no control characters, not ending in ';'" >&2 ;;
      esac
      exit 2
    fi
    # The same three conditions roost-agent-state checks, and the same server:
    # the one this process is INSIDE (ROOST_SELF_SOCK), never $SOCKET, which
    # $ROOST_SOCKET can point at a server this pane is not on.
    [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ -n "${ROOST_SELF_SOCK:-}" ] || exit 0
    roost_identity_stamp "$ROOST_SELF_SOCK" "$TMUX_PANE" \
      "$id_session" "$id_cwd" "$id_harness" "$id_transcript" || true
    exit 0
    ;;
  save)
    # `roost save [--to FILE] [--trigger NAME] [--auto]` (#51): write this
    # server's shape — its sessions, windows, panes, names, directories,
    # layouts and agent keys — as a plain file. The work is in
    # scripts/lib/roost-shape.sh; this arm parses flags. `--auto` is what the
    # hooks will call (Part 4); until then it takes the same path, silently.
    shift
    save_to="" save_trigger="save" save_auto=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --to) [ "$#" -ge 2 ] || { echo "roost save: --to needs a file" >&2; exit 2; }
              save_to="$2"; shift 2 ;;
        --trigger) [ "$#" -ge 2 ] || { echo "roost save: --trigger needs a name" >&2; exit 2; }
              save_trigger="$2"; shift 2 ;;
        --auto) save_auto=1; shift ;;
        *) echo "usage: roost save [--to FILE] [--trigger NAME]" >&2; exit 2 ;;
      esac
    done
    case "$save_trigger" in ''|*[!a-z0-9-]*)
      echo "roost save: --trigger takes lower-case letters, digits and '-'" >&2; exit 2 ;;
    esac
    . "$ROOST_HOME/scripts/lib/roost-shape.sh"
    if [ "$save_auto" = 1 ]; then
      roost_shape_save "$_SOCKET_FLAG" "$SOCKET" "$save_to" "$save_trigger" >/dev/null 2>&1 || true
      exit 0
    fi
    roost_shape_save "$_SOCKET_FLAG" "$SOCKET" "$save_to" "$save_trigger" || exit 1
    exit 0
    ;;
  restore)
    # `roost restore` (#51): put this server's saved shape back — its
    # sessions, windows, panes, names, directories and layouts — as shells.
    # Agents are not resumed in this part. The work is in
    # scripts/lib/roost-restore.sh; this arm finds the save and maps the
    # result to the exit codes of spec §4.3 (0, 2, 12, 16, 1).
    shift
    restore_from="" restore_mode=run
    ROOST_RESTORE_ONLY=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --from) [ "$#" -ge 2 ] || { echo "roost restore: --from needs a file or a STAMP-GEN" >&2; exit 2; }
                restore_from="$2"; shift 2 ;;
        --only) [ "$#" -ge 2 ] || { echo "roost restore: --only needs a session, SESSION:WINDOW or %N" >&2; exit 2; }
                ROOST_RESTORE_ONLY+=("$2"); shift 2 ;;
        --dry-run) restore_mode=dry; shift ;;
        --list) restore_mode=list; shift ;;
        *) echo "usage: roost restore [--from FILE|STAMP-GEN] [--list] [--dry-run] [--only SEL ...]" >&2; exit 2 ;;
      esac
    done
    . "$ROOST_HOME/scripts/lib/roost-shape.sh"
    . "$ROOST_HOME/scripts/lib/roost-restore.sh"
    restore_dir="$(roost_shape_dir "$_SOCKET_FLAG" "$SOCKET" 2>/dev/null || true)"
    if [ "$restore_mode" = list ]; then
      roost_restore_list "$restore_dir"
      exit 0
    fi
    restore_rc=0
    roost_restore_pick "$restore_dir" "$restore_from" || exit $?
    [ "$ROOST_RESTORE_BYFILE" = 1 ] && roost_restore__host_line "$ROOST_RESTORE_FILE"
    roost_restore_prepare "$ROOST_RESTORE_FILE" || restore_rc=$?
    if [ "$restore_rc" = 0 ]; then
      if [ "$restore_mode" = dry ]; then
        roost_restore_dry_run || restore_rc=$?
      else
        roost_restore_run "$ROOST_RESTORE_FILE" "$restore_dir" || restore_rc=$?
      fi
    fi
    rm -rf "${ROOST_RESTORE_PD:-}"
    exit "$restore_rc"
    ;;
  help|--help|-h)
    # The command list is read back out of this file's own header comment
    # rather than duplicated here. A second copy would drift the first time
    # someone adds a subcommand and updates only one of them.
    #
    # The end of the header is found, not hardcoded: a line number here drifts
    # the moment the header grows by a line, and it fails by silently dropping
    # the LAST command from the help -- which is exactly what happened when
    # --force was documented. Start after the shebang, stop at the first line
    # that is not a comment.
    "$ROOST_HOME/scripts/roost-banner" || true
    printf '\n'
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' \
      "$ROOST_HOME/bin/roost"
    printf '\n'
    exit 0
    ;;
  doctor)
    exec "$ROOST_HOME/scripts/roost-doctor"
    ;;
  validate)
    # Next to doctor, and for the same reason: it is a thing a USER runs to
    # tell us what happened on their machine, not a test. tests/run.sh globs
    # tests/test-*.sh and cannot reach scripts/, which is the property that
    # keeps a forty-minute live run out of CI.
    #
    # Where doctor reads the machine's configuration, validate drives it: the
    # offline suites, this repo's live smoke suites, a real end-to-end drive of
    # every installed harness against local ollama, and the two known bugs as
    # explicit checks. It writes one file and prints its path.
    shift
    exec "$ROOST_HOME/scripts/roost-validate" "$@"
    ;;
  ext)
    # `roost ext <verb>` -- the extension seam's own subcommand, kept in its
    # own file (scripts/roost-ext) rather than folded into this case, the
    # same shape `install` (scripts/roost-install), `upgrade` and `validate`
    # (scripts/roost-validate) already use. All six verbs live there --
    # `install`, `list`, `info`, `verify`, `update` and `remove`. See
    # docs/airig/specs/2026-09-08-extension-seam.md.
    shift
    exec "$ROOST_HOME/scripts/roost-ext" "$@"
    ;;
  wiring)
    # Roost-owned wiring (#58): scripts/roost-wiring does the work. The socket
    # is passed explicitly, as `view` does for its children, so the script
    # resolves the same server this process did instead of falling through to
    # the production `-L roost`.
    shift
    ROOST_SOCKET="$SOCKET" exec "$ROOST_HOME/scripts/roost-wiring" "$@"
    ;;
  install)
    # Wires harnesses to THIS checkout and never fetches code: a dev tree can
    # run it freely. See scripts/roost-install.
    shift
    exec "$ROOST_HOME/scripts/roost-install" "$@"
    ;;
  upgrade|update)
    # `update` is an ALIAS of `upgrade`, not a second arm: one shift, one
    # exec, so the two spellings cannot drift. It used to alias `install`,
    # but it always sounded like it pulled, and a command people reach for
    # after hearing of a release should do that. The socket is passed
    # explicitly, as the `wiring` arm does, so an upgrade typed in a pane
    # re-wires the server that pane is on rather than falling through to the
    # production `-L roost`.
    #
    # tests/test-adapter-install.sh compares the two --dry-run outputs byte
    # for byte, which is what pins the alias rather than merely the arm.
    shift
    ROOST_SOCKET="$SOCKET" exec "$ROOST_HOME/scripts/roost-upgrade" "$@"
    ;;
  init)
    exec "$ROOST_HOME/scripts/roost-init"
    ;;
  settings)
    exec "$ROOST_HOME/scripts/roost-settings"
    ;;
  whoami)
    # prints the caller's pane id. $TMUX_PANE identifies the caller's pane.
    if [ -z "${TMUX_PANE:-}" ]; then echo "roost whoami: not inside a roost session" >&2; exit 1; fi
    me="$(t display-message -p -t "$TMUX_PANE" '#{pane_id}' 2>/dev/null || true)"
    [ -n "$me" ] || { echo "roost whoami: not inside a roost session" >&2; exit 1; }
    # --json (#41) only as the second word, the one place `whoami` ever looked.
    # Any other extra word is still ignored, as it always was. The failures
    # above stay exactly as they are: exit 1, stderr, and nothing on stdout.
    if [ "${2:-}" = "--json" ]; then
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      roost_jsonout_emit whoami pane s "$me" || roost_jsonout_fail whoami
      exit 0
    fi
    printf '%s\n' "$me"
    ;;
  spawn)
    need_arg "${2:-}" "usage: roost spawn NAME [CMD...]"; name="$2"; shift 2
    reject_bad_name "$name" spawn
    # Helper lands in the caller's own session when inside roost, else the default.
    if [ -n "${TMUX_PANE:-}" ]; then
      sess="$(t display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || echo "$DEFAULT_SESSION")"
    else
      sess="$DEFAULT_SESSION"
    fi
    ensure_session "$sess"
    # Background (-d) + non-attaching: create the window WITHOUT switching the
    # caller's focus to it (plain new-window selects it, so a client viewing the
    # session would jump there), and print its pane id target.
    # `=$sess:` — exact-match the session AND the trailing colon avoids tmux parsing
    # a numeric session name as a window index (e.g. `=0` fails "index 0 in use").
    #
    # On a wired server a command goes through roost-pane-shell, which puts
    # roost's claude shim first on PATH and then runs the command the way tmux
    # would have (a string through the shell, an argv directly). The server's
    # own PATH cannot do this: tmux hands a client-created pane the CLIENT's
    # PATH (#58, design M1). With no command, default-command already does it.
    # The command as handed, before roost-pane-shell wraps it: the `launch`
    # hint a saved shape keeps (#51, spec §3.2) — what this pane was started
    # as, for a person and for restore's report, never run by restore.
    # Redacted at save, not here.
    launch="$*"
    if [ "$#" -gt 0 ] && pane_cmd_wired; then set -- "$ROOST_HOME/scripts/roost-pane-shell" "$@"; fi
    new="$(t new-window -d -P -F '#{pane_id}' -t "=$sess:" -n "$name" -c "$PWD" "$@")"
    # Naming is best-effort; the pane id is the contract. A short-lived CMD's
    # pane can already be gone by the time we set-option — don't let that abort
    # the command and swallow the id we already have.
    t set-option -p -t "$new" @roost-name "$name" 2>/dev/null || true
    [ -n "$launch" ] && { t set-option -p -t "$new" @roost-launch "$launch" 2>/dev/null || true; }
    printf '%s\n' "$new"
    ;;
  split)
    shift
    dir=""; from="${TMUX_PANE:-}"; name=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -h) dir="-h"; shift ;;
        -v) dir="-v"; shift ;;
        -t) [ "$#" -ge 2 ] || { echo "roost split: -t needs a target" >&2; exit 2; }
            from="$2"; shift 2 ;;
        -n) [ "$#" -ge 2 ] || { echo "roost split: -n needs a name" >&2; exit 2; }
            name="$2"; reject_bad_name "$name" split; shift 2 ;;
        --) shift; break ;;
        -*) echo "roost split: unknown flag '$1'" >&2; exit 2 ;;
        *)  break ;;
      esac
    done
    [ -n "$from" ] || { echo "roost split: not inside a roost session" >&2; exit 1; }
    # Background helper pane in FROM's window; -d = no focus steal; prints its %N.
    # A command on a wired server goes through roost-pane-shell, for the reason
    # given at the same line in `spawn`.
    # The `launch` hint, as in `spawn`: the command as handed, before the wrap.
    launch="$*"
    if [ "$#" -gt 0 ] && pane_cmd_wired; then set -- "$ROOST_HOME/scripts/roost-pane-shell" "$@"; fi
    new="$(t split-window $dir -d -P -F '#{pane_id}' -t "$from" -c "$PWD" "$@")"
    # A label that survives what the process calls itself: #{pane_current_command}
    # reports a version string for some agents and changes every release.
    # Naming is best-effort; the pane id is the contract. A short-lived CMD's
    # pane can already be gone by the time we set-option — don't let that abort
    # the command and swallow the id we already have.
    [ -n "$name" ] && { t set-option -p -t "$new" @roost-name "$name" 2>/dev/null || true; }
    [ -n "$launch" ] && { t set-option -p -t "$new" @roost-launch "$launch" 2>/dev/null || true; }
    printf '%s\n' "$new"
    ;;
  view)
    # Put something a HUMAN has to look at where they can see it, without
    # taking their focus and without stacking a fresh copy beside the last one.
    #
    # This is the third shape of "open something", and the three are not
    # interchangeable:
    #
    #   spawn  a co-agent, in its own window, that you wait-done on
    #   split  a helper pane you keep addressing by %N
    #   view   a thing a human reads once — a diff, a log tail, a build watcher
    #
    # `view` names no command of its own. Whatever you hand it is what runs, so
    # a renderer, a pager and `tail -f` all reach a human the same way. What it
    # decides for you is pane-or-window, because that decision is about the
    # terminal's width and not about what you are showing.
    #
    # It is deliberately NOT a dashboard: calling it again with the same NAME
    # replaces the previous view rather than adding another. That replacement
    # is the whole reason NAME exists.
    shift
    # Its own arguments, kept for the `launch` hint below: the pane `split` or
    # `spawn` makes is stamped with the command they were handed, and what a
    # person would retype to get this view back is `roost view ...`.
    view_launch="roost view $*"
    name="view"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -n) [ "$#" -ge 2 ] || { echo "roost view: -n needs a name" >&2; exit 2; }
            name="$2"; reject_bad_name "$name" view; shift 2 ;;
        --) shift; break ;;
        -*) echo "roost view: unknown flag '$1'" >&2; exit 2 ;;
        *)  break ;;
      esac
    done
    # An EMPTY name is rejected rather than defaulted, and this guard is not
    # cosmetic: the replace step below compares NAME against every pane's
    # @roost-name, and an option that was never set reads back as the empty
    # string. With name="" that comparison is true for every pane a human
    # opened by hand, so `roost view -n '' less foo` would kill the whole
    # server's worth of unnamed panes. Fail loudly instead.
    [ -n "$name" ] || { echo "roost view: -n needs a non-empty name" >&2; exit 2; }
    [ "$#" -gt 0 ] || { echo "usage: roost view [-n NAME] CMD..." >&2; exit 1; }

    # Same guard as `roost split`, for the same reason: outside a roost session
    # there is no pane to measure, nothing to split beside, and no human
    # watching this server.
    me="${TMUX_PANE:-}"
    [ -n "$me" ] || { echo "roost view: not inside a roost session" >&2; exit 1; }
    # $TMUX_PANE alone is not proof, and here that matters more than it does in
    # `split`: the user's ordinary tmux sets it too, and a %N from THAT server
    # is a perfectly valid id belonging to a stranger's pane over here — which
    # this command would then use both as a width source and as the one pane
    # the kill below spares. Resolve it on the roost socket first, the same
    # question `roost whoami` asks.
    me="$(t display-message -p -t "$me" '#{pane_id}' 2>/dev/null || true)"
    [ -n "$me" ] || { echo "roost view: not inside a roost session" >&2; exit 1; }

    # Replace, don't stack. Only panes roost itself named, and never this pane.
    # A window left empty by the kill closes itself, so the window case needs
    # no separate cleanup. A pane a human opened by hand carries no
    # @roost-name and is not touched.
    #
    # `read -r p pname` puts the REST of the line in pname, so a name
    # containing spaces ("code reviewer") still compares whole. A tab or a
    # newline cannot get this far — reject_bad_name refuses both above.
    while read -r p pname; do
      [ "$pname" = "$name" ] || continue
      [ "$p" = "$me" ] && continue
      t kill-pane -t "$p" 2>/dev/null || true
    done < <(t list-panes -a -F '#{pane_id} #{@roost-name}' 2>/dev/null || true)

    # Measured AFTER that kill, never before. A leftover view is still holding
    # half the columns at this point, so reading the width first makes every
    # call after the first one believe the pane is too narrow to split — and
    # the view then walks off into a window when it should have shared. This
    # was a real bug in the script this command replaces; the ORDER here is
    # the fix, so do not hoist the measurement above the loop.
    width="$(t display-message -p -t "$me" '#{pane_width}' 2>/dev/null || true)"
    case "$width" in ''|*[!0-9]*) width=0 ;; esac

    # 180 columns, so both halves of the split still clear 80 — the width most
    # terminal output is still written for. Below that, a window keeps the view
    # readable instead of squeezing two unreadable columns out of one pane.
    min="${ROOST_VIEW_MIN_COLS:-180}"
    case "$min" in
      ''|*[!0-9]*)
        echo "roost view: ROOST_VIEW_MIN_COLS must be a number, got '$min'" >&2; exit 2 ;;
    esac

    # `split` and `spawn` are re-entered rather than re-implemented: they own
    # -d (no focus steal), the `=$sess:` session-targeting quirk, the
    # best-effort @roost-name write and the pane-id contract, and a second copy
    # of any of that here would drift the first time one of them changed.
    #
    # $ROOST_SOCKET is passed explicitly so the child resolves the SAME socket
    # this process did. A child inheriting nothing would fall through to the
    # production `-L roost` server — the exact failure the socket comment at
    # the top of this file describes — and this keeps the promise that no call
    # site spells a socket flag of its own.
    if [ "$width" -ge "$min" ]; then
      new="$(ROOST_SOCKET="$SOCKET" "$ROOST_HOME/bin/roost" split -h -t "$me" -n "$name" "$@")" \
        || { echo "roost view: split failed" >&2; exit 1; }
      where=pane
    else
      new="$(ROOST_SOCKET="$SOCKET" "$ROOST_HOME/bin/roost" spawn "$name" "$@")" \
        || { echo "roost view: spawn failed" >&2; exit 1; }
      where=window
    fi
    # Best effort, the way the name write is: the hint §4.3's report quotes.
    t set-option -p -t "$new" @roost-launch "$view_launch" 2>/dev/null || true

    # The prefix is a user setting — tmux/roost.conf binds C-s, and the user
    # config sourced after it may rebind. Read the live one rather than
    # printing C-s and being confidently wrong for anyone who changed it.
    prefix="$(t show-options -gv prefix 2>/dev/null || true)"
    [ -n "$prefix" ] || prefix="C-s"
    # tmux spells it C-s; a human presses ctrl. Only the C- form is rewritten:
    # M-a and F1 are already how someone would say them out loud.
    prefix="${prefix/#C-/ctrl-}"

    # The pane id goes to stdout, because that is the contract every other
    # opening command keeps: a caller writes `v="$(roost view ...)"` and gets
    # one id and nothing else. The directions are for the human at the
    # terminal, so they go to stderr — the same division `roost read` makes
    # when it explains a fallback without putting the explanation in the
    # caller's pipe. `l`/`h` and `a` are the bindings in tmux/roost.conf
    # (select-pane -R / -L, and the switcher popup).
    printf '%s\n' "$new"
    if [ "$where" = pane ]; then
      printf 'roost view: open in the pane to the right (%s).\n' "$new" >&2
      printf 'roost view: press %s then l to go there; %s then h comes back.\n' "$prefix" "$prefix" >&2
    else
      printf 'roost view: open in a new window named %s (%s).\n' "$name" "$new" >&2
      printf 'roost view: press %s then a to switch to it.\n' "$prefix" >&2
    fi
    ;;
  hooks)
    # `roost hooks` with no argument keeps printing the CLAUDE config, and must.
    # That form is documented in this file's own header, in
    # site/content/docs/state-badges.md and in scripts/roost-doctor's advice
    # ("run: roost hooks"), so a second harness cannot be allowed to take the
    # default with it.
    case "${2:-claude}" in
      claude) ;;
      codex)
        cat <<JSON
# Write the JSON object below to \$CODEX_HOME/hooks.json (\$CODEX_HOME defaults
# to ~/.codex). Then start \`codex\`, and at its "Hooks need review" prompt
# choose "Trust all and continue". Until you do, every hook is skipped —
# see the warning further down. Outside roost these hooks are silent no-ops.
#
# Copy the object, NOT these comment lines: hooks.json is strict JSON and has
# no comment syntax.
#
# | codex hook          | state                                |
# |---------------------|--------------------------------------|
# | UserPromptSubmit    | working                              |
# | PostToolUse         | working (and it is what clears 🛑)    |
# | PermissionRequest   | blocked                              |
# | Stop                | done, plus the turn's reply          |
# | Stop, with no reply | error                                |
# | Interrupt           | idle (clears 🛑 after No or Esc)      |
#
# PostToolUse is what clears 🛑 after "Yes". No hook fires when you answer a
# permission dialog, so it is the first observable event afterwards — measured
# on codex-cli 0.151.0, one second after "1. Yes, proceed". After "No", or Esc,
# the tool never runs and Interrupt is what fires instead — measured on
# codex-cli 0.154.0, within 100ms, with no Stop after it.
#
# Interrupt was added in a later roost release than the other four. If you
# trusted roost's hooks before it was there, codex asks at "Hooks need review"
# again for that one handler: answer "Trust all and continue" once more. Until
# you do, a declined dialog leaves 🛑 stamped, and \`roost doctor\` says so.
#
# Interrupt asks for 3 seconds where the other four ask for 10, and that is
# codex's own cap, not a roost preference: codex clamps an Interrupt hook to 3s
# and used to print \`warning: clamping Interrupt hook timeout to 3s\` — naming
# this file's full path — on every start. The hook always ran with 3 seconds;
# only the warning has gone. Codex 0.154.0 does not include a timeout in the
# hash it stores when you trust a hook, so on that version the number changes
# under an existing trust entry and codex asks you nothing. An older codex does
# hash it; if yours asks at "Hooks need review" for Interrupt, answer "Trust all
# and continue" once. Until that is answered a declined dialog leaves 🛑
# stamped, and \`roost doctor\` says so.
#
# There is no error EVENT. Codex has twelve hook events and none of them reports
# an error, so 💥 is inferred: a Stop that carries no reply means the turn most
# likely never reached the model. Some dead turns still end ✅ done. See
# docs/known-gaps.md, which lists which ones, and the Codex section of
# site/content/docs/state-badges.md, which says it to users.
#
# THESE HANDLER OBJECTS ARE FROZEN, and that is not a style note. Codex
# stores a hash of each normalised handler in \$CODEX_HOME/config.toml and
# SKIPS any handler whose hash no longer matches — with nothing printed on
# stdout, on stderr, or in the TUI. Measured on codex-cli 0.150.1: appending one
# argument to a command string took 8 of 8 hooks down, and changing a single
# timeout from 10 to 11 took 7 of 8 down. So editing a command or a timeout in a
# later roost release would silently un-badge every machine that had already
# granted trust. Everything roost might want to change later lives inside
# adapters/codex/roost-codex-hook instead, which codex re-reads on every run and
# never hashes. Adding a NEW event to this file is safe (measured on 0.151.0:
# the handlers already trusted kept firing); editing one that is already here is
# not.
#
# Interrupt's timeout is the single exception ever made, and it cleared a bar
# no other edit has: codex was already clamping that number, so the edit
# changed nothing the hook does. An edit that also changed behaviour would
# trade a working badge on every trusted machine for the fix, and does not
# clear it. Timeouts in particular are no longer hashed on 0.154.0, measured
# with a control; they were on 0.151.0, so which codex you run decides whether
# an edit costs a re-trust, and the command string is hashed on both.
#
# The trust prompt vouches for a PATH, not for the code at that path. Anyone who
# can write adapters/codex/roost-codex-hook changes what runs, with no second
# review. That is codex's model, not something roost adds.
JSON
        roost_hooks_codex
        exit 0
        ;;
      *) echo "usage: roost hooks [claude|codex]" >&2; exit 2 ;;
    esac
    cat <<JSON
# Add this to ~/.claude/settings.json (merge into an existing "hooks" block).
# Then run \`claude\` inside a \`roost\` window and its badge tracks its state.
# Outside roost these hooks are silent no-ops.
# PermissionRequest is what paints the red, and it fires as the dialog opens.
# Measured on Claude Code 2.1.278: 11-16 ms after the dialog appears, where the
# permission_prompt Notification below arrives a flat 6.00 s after it — and a
# dialog answered inside those six seconds fires no Notification at all, so it
# was never painted and \`roost send\` typed into it. The hook prints nothing and
# decides nothing: an \`allow\` or a \`deny\` on this event would answer the dialog
# on your behalf, and roost never does that.
# "matcher": "permission_prompt" matters on the Notification entry — an
# unmatched Notification hook also fires for idle_prompt/auth_success, which
# would paint a finished agent red. That entry stays as the fallback for a
# Claude too old for PermissionRequest; on a current one it only moves the
# stamp for a dialog that is still open.
# PostToolUse and PostToolUseFailure are what clear the red: no hook fires when
# you answer a permission dialog, so without them the window stays blocked
# until the whole turn ends. BOTH are needed — PostToolUse fires only when the
# tool SUCCEEDS, so a command that exits non-zero after you said Yes would
# otherwise leave the window red for the rest of the turn.
# --notification-hook on the Notification entry, and
# --permission-request-hook on the PermissionRequest entry, are what clear the
# red after "No" or Esc, when no hook fires at all: they record the payload's
# transcript_path, and \`roost send\`, \`read\` and \`wait-done\` read Claude's own
# transcript to prove the dialog was declined. Leave them off and a declined
# dialog keeps its red until your next prompt.
# --prompt-hook on the UserPromptSubmit entry records the turn's transcript
# path, so an Esc mid-answer or mid-tool -- which fires no hook at all -- can
# be read from Claude's own transcript by \`roost send\`, \`read\` and
# \`wait-done\`, and the turn reported as interrupted. Leave it off and the
# badge reads working until your next prompt after such an Esc.
# --stop-hook on the Stop entry is what powers \`roost read\`: it lets the hook
# read Stop's JSON payload, whose last_assistant_message field carries the
# turn's reply. Leave it off and everything still badges correctly — \`roost
# read\` just falls back to scraping the pane's screen, and tells you it did.
# StopFailure is what ends a turn that FAILED — a rate limit, an overload, a
# model that does not exist. Claude fires it instead of Stop and nothing after
# it, so without it the badge stays working on an agent that has stopped. It
# badges error, and --stop-failure-hook records which kind of API error for
# \`roost wait-done\` and \`read\` to print. It has no matcher on purpose: every
# kind Claude reports is a turn that did not finish.
# SubagentStart and SubagentStop keep a COUNT, not a state: how many subagents
# this agent has running, and their ids, which \`roost status --json\` reports as
# \`subagents\`. They never change the badge. Leave them off and every badge is
# still right; the count is just never there.
# SessionEnd is what lets go of a pane held ⏳ working by background work when
# Claude exits before that work ends: Claude fires it and no Stop, so without
# it the badge reads working for ever. It badges nothing; it unsets the badge
# and records the turn as died, so \`roost wait-done\` exits 2 -- or, after
# \`/clear\` or \`/resume\`, which leave Claude at its prompt, as interrupted,
# exit 5. For any pane that is not held it changes nothing.
#
# SessionStart is the odd one out: the other ten report OUTWARD, and it
# is the only one that feeds context IN. It tells the agent it is inside roost
# and gives it its own pane id, so it reaches for \`roost split\` rather than a
# bare \`tmux split-window\` that would target the user's ordinary tmux server.
#
# Its "matcher": "*" is a deliberate choice, not a default. SessionStart fires
# for five sources — startup, resume, clear, compact and fork — and NONE of
# them leaves the preamble in place: startup and fork have no context yet,
# /clear wipes it, and compact replaces it with a summary that drops it. So all
# five need the injection, and naming a subset would also silently skip
# whichever source Claude Code adds next. The cost of the one case that is
# arguably redundant (resume, where the original injection may still be in the
# transcript) is a few duplicated lines; the cost of missing one is an agent
# that has forgotten which server it is on.
JSON
    roost_hooks_claude
    ;;
  ssh)
    need_arg "${2:-}" "usage: roost ssh HOST [ARGS...]"; host="$2"; shift 2
    # Run roost on the remote (must be installed there); agents run remote,
    # you drive them from this terminal. Just SSH + a remote roost — no daemon.
    #
    # Not `ssh -t HOST roost "$@"`, for two reasons. ssh joins its arguments
    # into ONE line and the remote's login shell runs that line with -c: a
    # non-login shell, which reads no profile file, so a PATH or LANG set only
    # there never arrives and `roost` itself is "command not found" on any
    # machine that keeps it under ~/.local/bin or a Homebrew prefix. And the
    # join means a multi-word prompt arrives as several words, so the caller
    # had to quote it twice.
    #
    # So the remote line is `"$SHELL" -lc '<roost ...>'`. $SHELL expands THERE,
    # to that user's own login shell; -l makes it read its profile, which is
    # where PATH and LANG live; and the roost command line is quoted here, one
    # argument at a time, so it reaches that shell as exactly the words it
    # left with. Single quotes with the '\'' seam are the one quoting every
    # Bourne shell and fish read the same way.
    remote="roost"
    for arg in "$@"; do remote="$remote $(roost_sq "$arg")"; done
    exec ssh -t "$host" "\"\$SHELL\" -lc $(roost_sq "$remote")"
    ;;
  send)
    # --force is accepted only in front of the target. Anywhere later it would
    # be indistinguishable from a message that happens to begin with the word,
    # and a send whose first word is swallowed is worse than no flag at all.
    #
    # --json (#92) sits in the same slots under the same rule, and the two may
    # be given in either order. A REPEAT of either is deliberately NOT consumed:
    # the loop breaks on it, so the word falls through into the target slot and
    # fails as "no such target", which is exactly what `roost send --force
    # --force X Y` did before this loop existed. Keeping that shape means the
    # new flag cannot change the outcome of any call that was already valid.
    #
    # --from LABEL (#56) is the third flag in these slots, and the one that
    # takes a word of its own. The label is who is sending: it is kept beside
    # the turn this prompt starts (roost_record_put_turn_field, further down),
    # and it is NOT put into the text — the pane receives exactly the bytes it
    # would have received without the flag. The envelope half of #56 is a
    # separate cut. Checked HERE, before the target is even resolved, so a
    # label that cannot be kept refuses the whole send at exit 2 with nothing
    # pasted: a label that was silently dropped would leave a turn attributed
    # to nobody, which is the record lying by omission.
    #
    # One word — no space, no control byte — of at most 64 BYTES, counted
    # under LC_ALL=C so a UTF-8 label is measured the way the file system and
    # the sidecar's reader measure it. Non-ASCII is fine; it is the bytes that
    # are kept. Nothing else is interpreted, because this value is a file's
    # CONTENT and never a path, an option or a format string.
    #
    # Except a leading dash (flock review, fix loop 1): `roost send --from
    # --json %1 hi` is a mistyped flag order, not a sender called `--json`,
    # and taking it as a label would record that name AND print the human
    # `%N TURN` line to a program that asked for a document. Refused, so the
    # mistake stays loud.
    send_label_ok() {
      local LC_ALL=C
      case "$1" in ''|-*|*[[:space:]]*|*[[:cntrl:]]*) return 1 ;; esac
      [ "${#1}" -le 64 ]
    }
    #
    # --when-idle (#56, "Delivery timing") is the fourth, and like --force and
    # --json it takes no word of its own and a repeat is not consumed. It
    # holds the send, bounded, until the target stops reading `working`; the
    # wait itself is further down, just before the send lock is taken.
    force=0
    json=0
    when_idle=0
    from="" from_given=0
    while [ "${2:-}" = "--force" ] || [ "${2:-}" = "--json" ] || [ "${2:-}" = "--when-idle" ] || [ "${2:-}" = "--from" ]; do
      if [ "$2" = "--force" ]; then
        if [ "$force" -eq 1 ]; then break; fi
        force=1
      elif [ "$2" = "--json" ]; then
        if [ "$json" -eq 1 ]; then break; fi
        json=1
      elif [ "$2" = "--when-idle" ]; then
        if [ "$when_idle" -eq 1 ]; then break; fi
        when_idle=1
      else
        if [ "$from_given" -eq 1 ]; then break; fi
        from_given=1
        if [ "$#" -lt 3 ]; then
          echo "roost send: --from needs a label — who is sending, one word of at most 64 bytes" >&2
          echo "usage: roost send [--force] [--json] [--when-idle] [--from LABEL] [SESSION:]WINDOW TEXT..." >&2
          exit 2
        fi
        from="$3"
        # The label itself is not echoed back: it may be the very control
        # byte that got it refused, and stderr is a terminal.
        if ! send_label_ok "$from"; then
          echo "roost send: --from needs one word of at most 64 bytes, with no space or control character and not beginning with a dash — nothing was sent" >&2
          exit 2
        fi
        # A bare %N — what `roost whoami` prints, and what skills/roost/SKILL.md
        # tells a coordinator to pass — names the same sender as the checked
        # default's `pane:%N`, and is kept in that spelling, so one sender has
        # one name in the record and a consumer grouping by sent_by does not
        # split a coordinator in two (flock review, fix loop 1). Only `%` and
        # digits, nothing else; it is not checked against the server, because
        # a passed label is still a claim (docs/known-gaps.md) — only a claim
        # spelled the one way.
        case "$from" in
          %[0-9]*) case "${from#%}" in *[!0-9]*) ;; *) from="pane:$from" ;; esac ;;
        esac
        # Drop "send", the flag and its label, then put the subcommand back,
        # for the same reason as the two-word shift below.
        shift 3
        set -- send "$@"
        continue
      fi
      # Drop "send" and the flag, then put the subcommand back so every
      # positional reference below keeps its original number.
      shift 2
      set -- send "$@"
    done
    need_arg "${2:-}" "usage: roost send [--force] [--json] [--when-idle] [--from LABEL] [SESSION:]WINDOW TEXT..."; raw="$2"; shift 2
    tgt="$(target "$raw")"

    # ONE SEND PER TARGET AT A TIME (#175). Two `roost send`s running at once
    # used to interfere, and the failure was in the wrong direction: REPRODUCED
    # on a throwaway server with a non-echoing TUI (the shape pi and opencode 2
    # have), two concurrent sends into one pane over 15 trials gave 7 silent
    # losses — both exit 0, one message never delivered — and 8 loud ones where
    # a healthy pane was reported as "may have died". Two sends to DIFFERENT
    # panes failed one of the pair 15 times out of 15. Seen live: two workers
    # finishing together each sent a report to one coordinator, and one report
    # was in neither its input box nor its session store.
    #
    # Three things cooperated. Every send loaded its text into one shared tmux
    # buffer, so sender A could paste B's text and delete it from under B (the
    # buffer name is per-process now, below). Nothing kept two senders out of
    # one input box, so the head-check retry's C-u erased the OTHER sender's
    # paste. And the "does not echo" fallback takes any screen change as proof
    # of delivery, so a sender whose text never landed still pressed Enter on
    # whatever the other one had typed, and exited 0. The last two are closed
    # by this lock; the first by the buffer name.
    #
    # The lock itself — a directory beside the server's socket, with a dead
    # holder's lock taken over — lives in scripts/lib/roost-panelock.sh, so
    # that `answer` (#142), the other command that types into a pane, takes
    # the same one rather than a copy (#181): a `send --force` and an
    # `answer` aimed at one dialog cannot both land.
    #
    # HELD FROM HERE TO EXIT, not just around the paste. The turn watch at the
    # end of this command is part of what the lock protects: two senders that
    # both watched an idle badge leave `idle` both predicted the same turn
    # number and the second overwrote the first's sent_by sidecar (last writer
    # wins — seen live, `%7 1` printed twice). Under the lock the second sender
    # re-reads the badge once it is in, finds `working`, and correctly hands
    # back no number at all.
    #
    # BOUNDED. A legitimate holder can take a while: up to the ready timeout,
    # the Enter retries and the turn watch — 26 s at the defaults, more if a
    # user raised them. So the wait is 60 s by default, from
    # @roost-send-lock-timeout, clamped to 600 the way the other knobs are. 0
    # means do not wait at all. Past the bound this is exit 1, the documented
    # "nothing was submitted, retry the same target" code, which is exactly
    # true: not one byte has been typed when the wait gives up.
    #
    # The pane is resolved HERE, once, and the socket read with it: the id is
    # what the lock is named for, and a WINDOW target has to lock the pane the
    # keys will go to. AND THEN THE PANE BECOMES THE TARGET for everything
    # below: a window target left as a window re-resolves on every tmux call,
    # so a window whose active pane moved during the lock wait would have
    # this send holding pane P's lock while typing into pane Q — beside
    # whoever holds Q's (found by review). A %N resolves to itself. A target
    # that resolves to nothing takes no lock and fails as "no such target"
    # just below, exactly as before. The pane id comes first in the format
    # because it can never hold a space and the socket path can, so the
    # first-space split is the one that is safe.
    . "$ROOST_HOME/scripts/lib/roost-panelock.sh"
    lock_info="$(t display-message -p -t "$tgt" '#{pane_id} #{socket_path}' 2>/dev/null || true)"
    lock_pane="${lock_info%% *}"
    lock_sock="${lock_info#* }"
    # Cleanup on EVERY way out of this command, not just the happy one: the
    # buffer (see ROOST_SEND_BUF below — a send that dies between the load and
    # the paste would otherwise leave the whole message in the buffer list,
    # which is the exact thing -d exists to prevent) and the lock, which
    # roost_panelock_drop removes only when THIS process holds it. The trap is
    # installed the moment the lock is taken, so a signal during the wait
    # removes nothing that belongs to another send.
    # `|| true` on the delete, and it is load-bearing under `set -e`: on the
    # happy path the paste's `-d` has already deleted the buffer, so this
    # delete FAILS, and a failing last command of an `&&` list exits the
    # shell — from inside the trap, turning a delivered send into exit 1
    # with the lock left behind (measured, first run of
    # tests/test-send-lock.sh).
    # A DRAFT IS NOT LEFT BEHIND (flock review, 2 of 6). A send that pasted and
    # then stopped before its Enter — a signal, a re-paste that failed, a head
    # that never showed — used to leave its text in the input box. The next
    # sender's head was then on screen at once (an echoing pane), so it never
    # sent C-u, and its Enter submitted both texts as one, exit 0. So on every
    # way out between the paste and the Enter, and only while the lock is
    # still this send's (a box that is another sender's by now is theirs to
    # clear), the draft is cleared with C-u. At an empty line C-u is a no-op
    # everywhere it is understood.
    send_pasted=0 send_entered=0
    send_cleanup() {
      if [ "$send_pasted" = 1 ] && [ "$send_entered" = 0 ] && roost_panelock_check; then
        t send-keys -t "$tgt" C-u 2>/dev/null || true
      fi
      [ -n "${ROOST_SEND_BUF:-}" ] && t delete-buffer -b "$ROOST_SEND_BUF" 2>/dev/null || true
      roost_panelock_drop
      return 0
    }
    # INT and TERM EXIT, they do not merely clean up. A handler that cleans
    # and returns lets the script carry on from the interrupted command
    # (found by review, reproduced): a send that took SIGTERM during its
    # retry sleep dropped the lock and then went on to C-u, paste and Enter,
    # beside whichever sender had just taken the lock it dropped. `exit`
    # runs the EXIT trap, which is the one that cleans. 130 and 143 are the
    # statuses a shell killed by those signals reports anyway.
    send_traps() {
      trap 'send_cleanup' EXIT
      trap 'exit 130' INT
      trap 'exit 143' TERM
    }
    # `|| true` inside the substitution, and it is not optional: this is the
    # first tmux call of `send` that is not guarded, and under `set -e` a
    # failed assignment exits. With no server at all it turned the documented
    # exit 2 "no such target" into an exit 1 with nothing on stderr (found by
    # review, with a tmux stub). The other knobs are read after the target
    # check and never saw this.
    # The clamp and the zero strip live in roost_panelock_timeout, shared with
    # `answer` (#181), so the two verbs cannot read one knob two ways.
    lock_timeout="$(roost_panelock_timeout "$(t show-options -gqv @roost-send-lock-timeout 2>/dev/null || true)")"

    # HOLD UNTIL NOT WORKING (--when-idle, #56). A plain send pastes at once,
    # and into a `working` pane the text queues in the harness's input line
    # and lands mid-turn: the agent folds it into the turn already running,
    # and there is no new turn for the watch below to name. A cross-harness
    # run lost a report exactly that way. With the flag the sender waits,
    # bounded, until the pane reads anything but `working`, and then goes
    # down the ordinary path unchanged — so `blocked` is still REFUSED below
    # (exit 3 unless --force), never waited on: holding is for a pane that is
    # busy, refusing is for a dialog a human has to answer. A pane with no
    # badge is not working and is sent to at once. A pane that goes away
    # stops the wait too, and the ordinary "no such target" exit 2 follows.
    #
    # BEFORE THE LOCK, not under it: two held senders at one busy pane would
    # otherwise spend the lock's own 60 s bound on each other while neither
    # could type. Once the pane stops reading `working` the lock is taken as
    # always, and the state is READ AGAIN UNDER IT: another sender that got
    # in first has just pasted, and the pane reads `working` again. Then this
    # send drops the lock and goes back to waiting, inside the SAME overall
    # bound — the deadline is fixed once, when the wait starts. A pane that a
    # harness keeps at `working` while background work runs holds this send
    # as well, which is the point.
    #
    # Polled with display-message about once a second, the pane resolved
    # above (so a window whose active pane moves is not re-resolved), and
    # with no dependency on the event log, which a user can turn off. A turn
    # shorter than a second can be missed by a poll; docs/known-gaps.md says
    # what that costs.
    #
    # The bound is @roost-send-idle-timeout, 300 s by default, clamped to
    # 3600, and parsed by the same function as the lock's bound (zeros
    # stripped, so `08` is eight and `0000000` is zero; 0 means one look and
    # no wait). Past it: exit 6, nothing typed, one stderr line. 6 because 1
    # to 4 are taken here, and `send` and `wait-done` must not share a code
    # (#43 plans to fuse them): wait-done has 0, 1, 2 and 5.
    #
    # A DEAD pane is not waited on (fix loop 1, found by review): one kept by
    # remain-on-exit after its agent died still has its id and its last
    # badge, which can be `working` forever. Without the flag it reaches the
    # dead-pane refusal below, exit 2, "pick another target"; the first cut
    # of this wait sat out the whole bound on it and said exit 6. So the poll
    # and the re-check both read #{pane_dead}, and a dead pane ends the wait
    # and goes down to that refusal.
    #
    # `waited` (--json) is the time spent HELD FOR `working` and nothing
    # else: it starts counting at a poll that read `working`, so a pane that
    # never read busy reports exactly 0, however long the lock wait after it
    # took and however the clock's second boundaries fell.
    idle_waited=0
    if [ "$when_idle" -eq 1 ] && [ -n "$lock_pane" ]; then
      idle_timeout="$(roost_panelock_timeout "$(t show-options -gqv @roost-send-idle-timeout 2>/dev/null || true)" 300 3600)"
      idle_deadline=$(( $(date +%s) + idle_timeout ))
    fi
    send_idle_timeout() {
      # Nothing was typed and no lock is held: the lock is dropped before
      # every return to the wait. Nothing on stdout, --json or not, like
      # every other failure of this command.
      echo "roost send: '$raw' still reads working after ${idle_timeout}s (--when-idle; @roost-send-idle-timeout) — nothing was submitted" >&2
      exit 6
    }
    # send_idle_wait -> 0 once $lock_pane reads anything but `working`, is
    # dead, or is gone; 1 at the deadline with it still working. Three
    # fields, the pane id first: an empty id is a pane that has gone, and the
    # state is last because it is the field that can be empty. Adds the
    # seconds it held to $idle_waited.
    send_idle_wait() {
      local info rest now held_from=""
      while :; do
        info="$(t display-message -p -t "$lock_pane" '#{pane_id} #{pane_dead} #{@agent_state}' 2>/dev/null || true)"
        rest="${info#* }"
        if [ -z "${info%% *}" ] || [ "${rest%% *}" = 1 ] || [ "${rest#* }" != working ]; then
          [ -z "$held_from" ] || idle_waited=$(( idle_waited + $(date +%s) - held_from ))
          return 0
        fi
        now="$(date +%s)"
        [ -n "$held_from" ] || held_from="$now"
        if [ "$now" -ge "$idle_deadline" ]; then
          idle_waited=$(( idle_waited + now - held_from ))
          return 1
        fi
        # A `working` badge is not always a turn (#105, fix round 1; found
        # by review, reproduced): an agent killed at its shell prompt leaves
        # it for ever, and the send sat out the whole bound and said the
        # pane "still reads working" about an agent that was gone. So each
        # poll offers the pane to the two checks wait-done makes once a
        # second, roost_died_pane and then roost_interrupted_pane (#95, an
        # Esc'd Claude turn, the same shape). Each only ever unsets, and only
        # on its own evidence; a clear goes straight back to the poll, which
        # now reads no badge and returns.
        if roost_died_pane "$lock_pane" || roost_interrupted_pane "$lock_pane"; then
          continue
        fi
        sleep 1 2>/dev/null || true
      done
    }
    while :; do
      if [ "$when_idle" -eq 1 ] && [ -n "$lock_pane" ] && ! send_idle_wait; then
        send_idle_timeout
      fi
      lock_rc=0
      roost_panelock_take "$lock_sock" "$lock_pane" "$lock_timeout" || lock_rc=$?
      # The re-check under the lock. Only on 0: every other code exits or
      # falls through to the "no such target" check below, as without the
      # flag. A dead pane passes, so the dead-pane exit 2 below is what the
      # caller sees.
      if [ "$when_idle" -eq 1 ] && [ "$lock_rc" = 0 ] \
         && [ "$(t display-message -p -t "$lock_pane" '#{pane_dead} #{@agent_state}' 2>/dev/null || true)" = "0 working" ]; then
        roost_panelock_drop
        # NOT straight back to the poll (fix loop 1, found by review,
        # reproduced with a bound of 0): the poll returns as soon as it reads
        # not-working, before it looks at the clock, so a pane that read idle
        # outside the lock and working under it went round this loop with no
        # sleep and no deadline, spinning the CPU and never timing out. The
        # deadline is checked here, and a second is slept — and counted as
        # held, because the pane did read working — before the next look.
        [ "$(date +%s)" -lt "$idle_deadline" ] || send_idle_timeout
        sleep 1 2>/dev/null || true
        idle_waited=$((idle_waited + 1))
        continue
      fi
      break
    done
    # `waited` joins the --json document only when --when-idle was given, so a
    # plain send's document stays byte for byte what it was. An array, and
    # expanded with `${a[@]+...}`, because an empty "${a[@]}" under `set -u`
    # aborts bash 3.2.
    send_waited_field=()
    if [ "$when_idle" -eq 1 ]; then send_waited_field=(waited i "$idle_waited"); fi
    case "$lock_rc" in
      0) send_traps
         tgt="$lock_pane" ;;
      1) echo "roost send: another send to '$raw' is still in progress after ${lock_timeout}s — nothing was submitted; retry the same target" >&2
         exit 1 ;;
      2) # Nothing to lock. With no pane that is the "no such target" exit 2
         # just below. With a pane it is a socket path that is not absolute —
         # tmux reports `#{socket_path}` exactly as the server was started
         # with, and `ROOST_SOCKET=./s` is such a server — and that is a
         # REFUSAL, not a send without a lock (flock review, 2 of 6: two
         # sends raced into one shell pane that way, the whole of #175 back
         # for one odd input). roost's own socket is always absolute.
         if [ -n "$lock_pane" ]; then
           echo "roost send: the server's socket path '$lock_sock' is not absolute, so no send lock can be named for '$raw' — nothing was submitted; start the server, or set ROOST_SOCKET, with an absolute path" >&2
           exit 1
         fi ;;
      3) # The lock directory could not be made, or could not keep its pid
         # file, and was given back rather than left to be taken from under
         # this send a minute later. A REFUSAL (flock review): the first cut
         # went on without a lock, and with `umask 0222` two sends then both
         # did, which is #175 again. A socket directory that cannot hold a
         # one-line file is a machine in trouble, and a send that says so and
         # types nothing is the honest answer there. Exit 1: nothing was
         # submitted, and a retry is right once the directory is fixed.
         echo "roost send: could not make or write the send lock beside '$lock_sock' for '$raw' — nothing was submitted; the socket directory must be writable" >&2
         exit 1 ;;
    esac
    # Validate: a typo'd target must fail loudly, not silently deliver nothing.
    # Also reject a DEAD pane: with `remain-on-exit on`, a pane whose command
    # has already exited still resolves #{window_id} fine (the pane object is
    # still there, frozen), but send-keys against it silently no-ops (exit 0)
    # and the frozen screen never gains the message — so the verification
    # below would see "not pending" (before == cur, no match in the frozen
    # last line) and report a clean send that delivered nothing. That is
    # exactly the silent false-success this command exists to eliminate, and
    # a dead target is its most likely real-world instance. One
    # display-message call fetches both fields so the two checks read the
    # SAME snapshot of the target rather than racing two separate lookups.
    # Separator is a plain space, NOT a tab: the split below is
    # `wid="${info%% *}"` / `dead="${info#* }"`, plain parameter expansion
    # that only splits on the literal character between the quotes. A tab
    # separator would leave both expansions matching nothing — `wid` becomes
    # the whole string (non-empty, so a bad target's emptiness check never
    # fires) and `dead` never equals "1". #{window_id} and #{pane_dead}
    # never contain a space, so a space is a safe, boring delimiter that
    # this split actually breaks on.
    #
    # @agent_state joins the same snapshot for the same reason: the blocked
    # check below must describe the pane that is about to be pasted into, not
    # a pane re-resolved a moment later. With a WINDOW target, display-message
    # and send-keys both resolve to that window's active pane, so the guard
    # covers exactly the pane that would receive the keys.
    #
    # Three fields now, so the two-field `%% *` / `#* ` split no longer
    # reaches the last one; peel them off one at a time instead. The state is
    # last on purpose: it is the only field that can be EMPTY (an agent that
    # has never reported), and a trailing empty field survives this split
    # while a middle one would not.
    info="$(t display-message -p -t "$tgt" '#{window_id} #{pane_dead} #{@agent_state}' 2>/dev/null || true)"
    wid="${info%% *}"
    rest="${info#* }"
    dead="${rest%% *}"
    state="${rest#* }"
    if [ -z "$wid" ]; then
      echo "roost send: no such target '$raw'" >&2; exit 2
    fi
    # Same exit code as "no such target": a dead pane is unusable for exactly
    # the reason a nonexistent one is — the caller needs to pick a DIFFERENT
    # target, not retry this one (retrying is what exit 1 below means).
    if [ "$dead" = "1" ]; then
      echo "roost send: target '$raw' is a dead pane (its command has exited); nothing would be delivered" >&2
      exit 2
    fi
    # A blocked pane is showing a permission dialog. send pastes the text and
    # then presses Enter; against a dialog the text goes into the dialog and
    # the Enter activates whatever option is highlighted. One agent driving
    # another would then ANSWER a prompt that existed to ask a human — with
    # neither the sender nor the human intending it, and silently, because
    # the dialog consumes the text and the submit verification below sees a
    # clean send.
    #
    # This is why the check is on state rather than on screen content: roost
    # already stamps @agent_state=blocked from the agent's own hook, so the
    # signal is exact and needs no scraping.
    #
    # Exit 3, distinct from 2 (wrong target) and 1 (submit failed): the
    # target is right and retrying later is the correct response, once the
    # human has answered. A caller can tell those three apart.
    #
    # The one exception: a Claude dialog that was DECLINED or dismissed fires
    # no event, so the badge outlives it and this refusal would last forever
    # (#38). roost_unblock_pane clears such a badge only when Claude's own
    # transcript proves the decline is the newest thing that happened since the
    # stamp, and it only ever unsets. When it cannot prove it, it returns 1 and
    # the refusal stands. Still no screen: the evidence is the harness's own
    # record. It resolves $tgt the way send-keys will, so it judges the same
    # pane this guard protects.
    #
    # First, though, the pane whose agent DIED inside its shell (#105, step 5
    # of the turn-over design): its badge reads working or blocked for ever,
    # and a blocked one was refused here with exit 3 for a dialog that no
    # longer exists. roost_died_pane is the check `wait-done` and `read` make
    # too -- the recorded job has no process left and the shell has the
    # terminal back -- and on a death it unsets the badge and records `died`.
    # This send then goes on as to any pane with no badge: there is no agent
    # behind it, and whatever is typed now reaches the shell at its prompt,
    # as it did before the badge was cleared.
    case "$state" in
      working|blocked) roost_died_pane "$tgt" && state="" ;;
    esac
    if [ "$state" = "blocked" ] && [ "$force" -eq 0 ] && ! roost_unblock_pane "$tgt"; then
      echo "roost send: target '$raw' is blocked — a permission dialog is open, and this text would be pasted into it" >&2
      echo "roost send: wait for it to be answered, or pass --force to send anyway" >&2
      exit 3
    fi
    # The working-pane sibling (#95): an Esc mid-stream or mid-tool fires no
    # event either, so a `working` badge can be a turn the human already
    # stopped. roost_interrupted_pane clears it only when Claude's transcript
    # proves the interrupt is the newest thing since the stamp, and it only
    # unsets; the turn watch below then re-reads the badge and sees a pane
    # with none, which is what such a pane is. When it cannot prove it, the
    # send goes on as to any working pane: the text queues.
    if [ "$state" = "working" ]; then
      roost_interrupted_pane "$tgt" || true
    fi
    # Two-step submit: literal text, a beat, then Enter. A single
    # `send-keys "$*" Enter` can drop or race the submit in a full-screen TUI.
    delay="$(t show-options -gqv @roost-send-enter-delay 2>/dev/null)"
    # Fall back to 0.3 for unset / non-numeric / multi-dot values, AND guard the
    # sleep itself, so NO value can ever abort after the text is pasted but before
    # Enter is sent (which would leave the prompt half-delivered in the input box).
    case "$delay" in ''|.|*.*.*|*[!0-9.]*) delay=0.3 ;; esac

    # An empty message is a legitimate, useful send on its own — a bare Enter,
    # e.g. to unstick a pane whose TUI already swallowed a previous submit.
    # There is no text to verify landed, so type nothing, press Enter once,
    # and stop right here. Do NOT run this through the verification loop
    # below: an empty pattern collapses `case "$last" in *""*)` to `*)`,
    # which matches ANY pane content, so `pending()` would always report
    # "still pending" and fire every retry into a pane that had nothing to
    # submit in the first place.
    if [ -z "$*" ]; then
      # Even a bare Enter is a key that cannot be taken back: on a box
      # another sender is typing into, it submits THEIR half-typed text.
      if ! roost_panelock_check; then
        echo "roost send: the send lock for '$raw' was taken from this send — nothing was submitted; retry the same target" >&2
        exit 1
      fi
      t send-keys -t "$tgt" Enter 2>/dev/null || true
      # No turn is claimed here, and none is waited for (#92). A bare Enter is
      # not a prompt: it is the "unstick this pane" gesture the paragraph above
      # describes, and a pane that submits nothing has no turn to start. --json
      # still prints a document, because a program that asked for one must get
      # one on every exit 0 — with turn null and started false, which is the
      # honest answer rather than an absent one. sent_by is null for the same
      # reason: no turn, so no turn to keep a label beside (#56).
      if [ "$json" -eq 1 ]; then
        . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
        roost_jsonout_emit send target s "$raw" \
          pane z "$(t display-message -p -t "$tgt" '#{pane_id}' 2>/dev/null || true)" \
          turn i "" started b 0 \
          state z "$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)" \
          sent_by z "" \
          ${send_waited_field[@]+"${send_waited_field[@]}"} \
          || roost_jsonout_fail send
      fi
      exit 0
    fi

    retries="$(t show-options -gqv @roost-send-retries 2>/dev/null)"
    case "$retries" in ''|*[!0-9]*) retries=3 ;; esac
    # A pathologically long digit string (thousands of chars) is clamped by
    # length BEFORE anything else touches it: `${#retries}` is an O(1) length
    # check, so this bound can never itself be slow, and it caps the work the
    # zero-stripping loop below could ever be asked to do.
    [ "${#retries}" -gt 40 ] && retries=20
    # Strip leading zeros so "007" reads as its actual value (7), not as a
    # 3-character string that the length clamp below mistakes for >= 100.
    # Bounded to `${#retries}` > 1 so "0" itself (and "000" once fully
    # stripped) settles on a single "0" rather than an empty string, which
    # would break the `[ "$n" -gt 0 ]` loop guard further down.
    while [ "${#retries}" -gt 1 ] && [ "${retries%${retries#?}}" = 0 ]; do
      retries="${retries#0}"
    done
    # Clamp to a sane upper bound. Do this by pattern first, not by `[ -gt ]`
    # alone: an absurd digit string (hundreds of digits) can make the numeric
    # test itself error out (or take a very long time) before it ever gets to
    # compare against the cap, so strings of 3+ digits are clamped directly.
    # Leading zeros are already gone above, so this now only fires for values
    # that are genuinely >= 100.
    case "$retries" in ???*) retries=20 ;; esac
    [ "$retries" -gt 20 ] 2>/dev/null && retries=20 || true

    # Still pending only if ALL THREE hold:
    #   1. the pane's last non-blank line still contains the whole message, AND
    #   2. the pane's full contents are byte-identical to how they looked right
    #      after typing — before ANY Enter was sent (captured into $before), AND
    #   3. the cursor position is unchanged from that same moment (captured
    #      into $cursor_before).
    # The substring check alone is not enough: a blank/empty prompt can leave
    # the already-scrolled, verbatim command line as the last non-blank row
    # even after a real submit, and a TUI can echo the submitted message into
    # its transcript before it clears the input box or renders a response. A
    # genuine submit almost always changes the screen somehow — prompt
    # redraw, output, a spinner, the transcript moving — so requiring
    # "nothing on screen changed at all" makes a false "not submitted" much
    # harder to reach than the substring check on its own.
    # But text-unchanged is NOT sufficient either: it cannot distinguish "the
    # Enter was never accepted" from "the Enter was accepted and the command
    # just hasn't printed anything yet". A command that is silent for the
    # ~1s retry window (a `sleep`, anything slow to start) looks identical to
    # a swallowed Enter on screen alone, and reports a false "not submitted"
    # 100% of the time — this is not a load-dependent flake, it is
    # deterministic. Cursor position resolves the ambiguity: the tty echoes
    # the newline through the line discipline the moment Enter is ACCEPTED,
    # independent of when (or whether) the command produces output. So a
    # real submit moves the cursor right away even in dead silence, while a
    # swallowed Enter leaves it exactly where it was.
    # Trade-off, accepted on purpose: a TUI that animates continuously (a
    # clock, a spinner) will never look byte-identical to its own earlier
    # snapshot, so this retry path will not fire there even for a genuinely
    # swallowed Enter. That is the side to be wrong on: a false "submitted"
    # just degrades to the old (pre-fix) behavior, while a false "not
    # submitted" fires a spurious Enter that can re-run a command. Adding the
    # cursor check is an additional conjunct, not a replacement, for the same
    # reason: requiring one more thing to hold only makes a false "not
    # submitted" harder to reach, never easier.
    pending() {
      local cur last cursor_now
      cur="$(t capture-pane -p -t "$tgt" 2>/dev/null || true)"
      [ "$cur" = "$before" ] || return 1
      cursor_now="$(t display-message -p -t "$tgt" '#{cursor_x} #{cursor_y}' 2>/dev/null || true)"
      [ "$cursor_now" = "$cursor_before" ] || return 1
      last="$(printf '%s\n' "$cur" | grep -v '^[[:space:]]*$' | tail -n 1)"
      case "$last" in *"$1"*) return 0 ;; *) return 1 ;; esac
    }

    # Typing is not delivery, and everything from here to the Enter exists to
    # keep those two apart.
    #
    # THE RACE THIS CLOSES. `roost spawn` prints a pane id the moment the PANE
    # exists, which is well before the agent inside it is reading its terminal.
    # A TUI takes the tty over by putting it in raw mode and DISCARDING
    # whatever is already buffered — that is how it avoids acting on keys that
    # were meant for the shell it replaced — so everything typed before that
    # instant is thrown away and the REMAINDER of the message arrives looking
    # exactly like a whole one. Measured in the field: 3466 bytes sent to a
    # freshly spawned Claude pane, roughly the last 450 delivered, the front
    # gone, `roost send` exit 0. That is nowhere near tmux's ~16344-byte
    # command cap — it is a startup race, not a size limit, which is why the
    # workaround people reached for was "write a file and send the path": a
    # file cannot be half-typed into a TUI that is not awake yet.
    #
    # The verification below this block could not see it, because it verifies
    # the SUBMIT and never the CONTENT: it asks whether the input line has
    # stopped holding the message, and a half-eaten message satisfies that
    # exactly as well as a whole one. So the check added here is on the
    # message's HEAD — the part a cold start eats, and therefore the only part
    # worth looking for.
    msg="$*"
    # How long to keep trying before giving up and saying so. Generous on
    # purpose: a cold agent can take several seconds to draw its input box, and
    # a send that gave up after one second would be a worse tool than the one
    # that lost the front quietly. Clamped by LENGTH first, then by value, the
    # same way @roost-send-retries is above and for the same reason — a
    # pathological digit string must not make the arithmetic itself slow.
    ready_timeout="$(t show-options -gqv @roost-send-ready-timeout 2>/dev/null)"
    case "$ready_timeout" in ''|*[!0-9]*) ready_timeout=15 ;; esac
    [ "${#ready_timeout}" -gt 6 ] && ready_timeout=120
    [ "$ready_timeout" -gt 120 ] 2>/dev/null && ready_timeout=120 || true

    # Whitespace is stripped from BOTH sides of every comparison below. A TUI
    # wraps a long line at its own width and `capture-pane` reports that wrap
    # as a real newline, so a contiguous byte match against the raw screen
    # would fail on any message wider than the input box — which is most of the
    # messages worth worrying about. 24 characters is short enough to stay
    # cheap and long enough not to collide with ordinary screen text.
    head="$(printf '%s' "$msg" | tr -d '[:space:]' | cut -c1-24)"

    # This check must only ever be wrong in ONE direction. If the head is
    # already on screen before a single key is typed — a very short message, or
    # a pane still showing an earlier copy of the same one — then finding it
    # afterwards proves nothing at all. In that case verification is skipped
    # rather than trusted: skipping degrades that one send to the pre-fix
    # behaviour, while trusting it would hand back a false success, which is
    # the exact failure being removed.
    pre="$(t capture-pane -p -t "$tgt" 2>/dev/null | tr -d '[:space:]' || true)"
    verifiable=1
    [ -z "$head" ] && verifiable=0
    case "$pre" in *"$head"*) verifiable=0 ;; esac

    # A paste PLACEHOLDER that was not there before is proof too (#176). Agent
    # TUIs collapse a long or multi-line bracketed paste into a stand-in for
    # it, so the message is nowhere on screen and the head check above can
    # never pass. Claude Code draws `[Pasted text #N]` (sometimes with
    # ` +K lines`), pi draws `[paste #N +K lines]` or `[paste #N K chars]`,
    # and opencode 2 draws `[Pasted ~K lines]`. Before this, only Claude's was
    # known, and only in the fallback below: every long send to pi or
    # opencode 2 ran the whole @roost-send-ready-timeout loop, re-pasted after
    # a C-u up to seven times, printed the "does not show them" warning and
    # exited 0 after about 19 s. Measured in a real four-agent run, all four
    # long sends — and the agents read the warning as a failed delivery.
    #
    # A small, explicit family, not "any bracket": each shape is the bracket,
    # the harness's own word, and a NUMBER (`[paste]` and `[pasted]` are not
    # in it). Matched on the whitespace-stripped screen, the same text the
    # head check reads, so `[paste #1 +12 lines]` is `[paste#1+12lines]` here.
    # ASCII words and digits only: tmux 3.4 and a C-locale client rewrite
    # bytes outside ASCII, and a Nerd Font glyph can be zero width in a
    # capture, so nothing else in a placeholder is safe to rely on.
    #
    # COUNTED, and against the baseline $pre, so an old placeholder from an
    # earlier send that is still on screen never counts: only one MORE than
    # there were before the paste does. A count and not a set, because
    # opencode 2's carries no paste number — a second paste of the same size
    # draws the same text again. Wrong only in the safe direction: if an old
    # one scrolls off as the new one appears, the count stands still and this
    # send falls back to the slow path below, which is loud and slow, not
    # lossy.
    #
    # LC_ALL=C on the grep: in a UTF-8 locale GNU grep (3.5+) reads a byte
    # string that is not valid UTF-8 as BINARY and prints no -o lines at all,
    # so a baseline capture that tripped it would count 0 and every old
    # placeholder would then read as new. The pattern is ASCII, so the C
    # locale matches exactly the same text everywhere else (found by review;
    # not measured, since tmux captures are normally valid UTF-8).
    placeholder_count() {
      printf '%s' "$1" \
        | LC_ALL=C grep -oE '\[(Pastedtext#[0-9]+|paste#[0-9]+|Pasted~[0-9]+)[A-Za-z0-9+~#]*\]' 2>/dev/null \
        | wc -l | tr -d ' ' || true
    }
    pre_placeholders="$(placeholder_count "$pre")"
    # NOT for a message that itself holds a placeholder shape (found by review,
    # reproduced with a control). Once a pane echoes, the message is part of
    # the screen: a cold start that eats the FRONT leaves the tail on screen,
    # and a tail that quotes `[Pasted text #1]` — a brief about this very code
    # does — raises the count on the first check. Enter then lands on the cut
    # tail with no retry and no warning, the exact loss the head check exists
    # to stop. Requiring more than the baseline PLUS the message's own count
    # is not enough, because the tail alone can carry every one of them. So
    # such a send is checked by its head only, the slow path as before #176:
    # slower on a collapsing pane, never a silent cut.
    placeholder_proof=1
    [ "$(placeholder_count "$(printf '%s' "$msg" | tr -d '[:space:]')")" -gt 0 ] 2>/dev/null && placeholder_proof=0 || true

    screen_has_head() {
      local now
      now="$(t capture-pane -p -t "$tgt" 2>/dev/null | tr -d '[:space:]' || true)"
      case "$now" in
        *"$head"*) return 0 ;;
      esac
      [ "$placeholder_proof" = 1 ] || return 1
      [ "$(placeholder_count "$now")" -gt "$pre_placeholders" ] 2>/dev/null
    }

    # THE TRANSPORT IS THE FIX. `send-keys -l` types the message as very fast
    # KEYSTROKES, and Claude Code 2.1.263 answers that by keeping only the last
    # partial chunk of it: measured, discarded = 1022 x floor(n/1022), so a
    # 3502-byte brief arrives as its last 436 bytes. A bracketed paste is a
    # different thing to the receiving application — the \e[200~ / \e[201~
    # markers say "this is one block of pasted text, not typing" — and the same
    # 3502 bytes then arrive whole, proven by putting the instruction at the
    # very START of the message and getting it obeyed.
    #
    # The message travels over STDIN to load-buffer, never on a tmux command
    # line, so the ~16344-byte command-length ceiling stops applying to it
    # as well. Two problems, one transport.
    #
    # -b names a buffer that is THIS send's alone, so sends cannot pile up in
    # the buffer stack and cannot read each other's text. It used to be one
    # name shared by every send on the server, and two concurrent sends then
    # pasted and deleted each other's messages (#175, measured: load A, load
    # B, paste into pane 1 delivers B, paste into pane 2 fails "no buffer").
    # The pid is unique among live processes and the trap (send_cleanup,
    # installed with the lock above) deletes the buffer on every way out, so a
    # name can never be inherited by a later send. -d deletes it as it is
    # pasted. Neither is tidiness: tmux buffers are visible to the human at
    # `prefix + =`, and an agent's message is not something to leave sitting
    # in a picker. -w is the flag that would reach the SYSTEM clipboard and is
    # never passed — measured, with a canary: the macOS pasteboard is
    # byte-identical across a send.
    ROOST_SEND_BUF="roost-send-$$"
    # A target that took no lock (one that resolved to no pane — it fails as
    # "no such target" above, so this is belt and braces — or one whose lock
    # could not keep a pid) still gets the buffer deleted on every way out.
    send_traps

    # stderr is captured rather than dropped so that tmux's failures here can be
    # told apart: a pane that has gone away says one thing, and an over-long
    # command another ("command too long", or "failed to send command" right at
    # the boundary — the same cause wearing a different message). Reporting
    # either as "pane may have died" sent callers to inspect a pane that was
    # alive, idle and blameless.
    type_message() {
      local rc
      senderr="$(printf '%s' "$msg" | t load-buffer -b "$ROOST_SEND_BUF" - 2>&1 >/dev/null)"; rc=$?
      [ "$rc" -eq 0 ] || return "$rc"
      senderr="$(t paste-buffer -p -d -b "$ROOST_SEND_BUF" -t "$tgt" 2>&1 >/dev/null)"; rc=$?
      return "$rc"
    }

    # WHERE THIS TARGET STANDS BEFORE A SINGLE KEY IS TYPED (#92).
    #
    # `send` verifies that the text arrived and that the submit left the input
    # line. Neither fact says a NEW TURN began, and the two questions a
    # coordinator asks next — `wait-done` then `read` — are both answered from
    # state that still belongs to the PREVIOUS turn until the target's
    # prompt-submit hook stamps `working`. MEASURED (tmux 3.6, macOS 26.3,
    # tests/fixtures/turn-agent.sh, a stand-in agent driving the real
    # scripts/roost-agent-state):
    #
    #   turn 1 finished, badge done, read -> REPLY-TO[first prompt]
    #   roost send %1 "second prompt"   exit 0 in 731 ms; badge still [done]
    #   roost wait-done %1 30           exit 0 after 35 ms
    #   roost read %1                -> REPLY-TO[first prompt]
    #
    # A well-formed answer to somebody else's question, at exit 0, silently.
    #
    # HOW WIDE THE WINDOW IS, and it is NOT what the issue assumed. `send`
    # presses Enter about 340 ms before it returns (two @roost-send-enter-delay
    # sleeps plus the verification loop), so a harness that stamps inside that
    # cushion never loses at all. Stale replies over 10 runs per latency:
    # 0 s 0/10, 0.1 s 0/10, 0.2 s 0/10, 0.3 s 0/10, then 0.4 s 4/10, 0.5 s 1/10,
    # 1.0 s 4/10, 3.0 s 8/10. roost's own hook costs 21.7/22.5/63.2 ms
    # (min/median/max, 10 runs), so nearly all of a real harness's latency is
    # its own submit handling — which is NOT measured here, because measuring it
    # means starting a real model.
    #
    # WHY ONLY A done/idle TARGET IS WATCHED, and this is the load-bearing
    # decision:
    #
    #   - NO BADGE AT ALL means the pane is not an agent. A shell helper, a log
    #     tail, a pager — skills/roost/SKILL.md documents `roost send` into all
    #     three. Nothing will ever stamp them, so waiting would add the whole
    #     bound and a new exit code to every such send. They keep today's
    #     behaviour exactly: no wait, no turn, exit 0.
    #   - working or blocked means the target is already mid-turn. The prompt
    #     queues inside the harness, the badge never changes, and the turn it
    #     will eventually take is not the next number — so there is nothing to
    #     watch and nothing honest to predict. Left alone.
    #   - error is left alone for the same reason: whether a prompt restarts
    #     such an agent is the harness's business, not something roost can
    #     prove from a badge.
    #
    # So done and idle — precisely the two states `wait-done` treats as
    # finished, which is what makes them the two that can hand back a stale
    # answer. The badge is re-read HERE rather than reused from the snapshot at
    # the top of this command, because roost_unblock_pane may have UNSET it in
    # between (#38) and the stale copy would still read `blocked`.
    #
    # THE TURN NUMBER IS A PREDICTION, and it is only sound in this same state.
    # Turns are numbered as replies are recorded (scripts/lib/roost-record.sh),
    # so on a target that has finished its last turn the next recorded reply is
    # base + 1 by construction. On a busy one it would be the turn already
    # running, which is why nothing is predicted there. A target with no usable
    # record — recording off, a record a newer roost wrote — still gets the
    # badge wait; it just has no number to hand back, and says so by printing
    # nothing.
    #
    # FOUR baselines, not one, and three of them exist because a turn can begin
    # AND END before the first poll. `send` returns about 340 ms after the
    # Enter, and a short turn against a fast model fits inside that, so the
    # badge is already back to `done` when the watch starts. Found by review
    # (flock round 1) in exactly the configuration the suite itself runs in:
    # with ROOST_RECORD_DIR="" there is no turn numbering either, and both of
    # the original signals were blind. Measured on that code: exit 4 after the
    # whole bound, with the reply sitting on the pane throughout.
    #
    #   turn_base   the recorded turn number. Absent when recording is off.
    #   turn_since  @agent_since, which EVERY state stamp rewrites
    #               (scripts/roost-agent-state). One second of resolution, so it
    #               can miss a done->working->done inside one second — which is
    #               why it is not alone.
    #   turn_reply  @roost-reply, which the adapter rewrites at the end of every
    #               turn. Read and compared as one opaque string, so whatever
    #               tmux does to it on the way in (3.4/3.5a rewrite control
    #               bytes; a non-UTF-8 client gets `_`) applies to both sides
    #               equally and the comparison still holds.
    #
    # Being wrong in the FALSE-STARTED direction is the safe way round, and that
    # is deliberate: it degrades one send to the behaviour it had before any of
    # this existed, where being wrong the other way reports a turn that ran as
    # one that never started — the caller then either re-sends a prompt that is
    # already running, or tells a human the agent is wedged when it is not.
    turn_watch=0 turn_base=0 turn_dir="" turn_num="" turn_started=0 turn_have_base=0
    turn_pane="" turn_since="" turn_reply="" turn_errored=0 turn_rec_bad=0 turn_reserved=""
    # @roost-turn-reserved rides in the same read (#188): a number a SessionEnd
    # release has reserved and not yet filed. It is digits or empty, and an
    # empty middle field keeps its place, as the measurement below shows for
    # @agent_since.
    turn_info="$(t display-message -p -t "$tgt" '#{pane_id} #{@roost-turn-reserved} #{@agent_since} #{@agent_state}' 2>/dev/null || true)"
    turn_pane="${turn_info%% *}"
    turn_rest="${turn_info#* }"
    turn_reserved="${turn_rest%% *}"
    turn_rest="${turn_rest#* }"
    turn_since="${turn_rest%% *}"
    turn_state="${turn_rest#* }"
    case "$turn_state" in
      done|idle) turn_watch=1 ;;
    esac
    # Only read when it will be compared: @roost-reply can be 12 KB, and a pane
    # that is not being watched must pay nothing for a signal nobody looks at.
    # show-options -p, never a #{@roost-reply} format, for the reason `read`
    # gives: a format lookup falls back pane -> window -> global, and a stray
    # outer-scope value would then be compared as if it were this pane's.
    if [ "$turn_watch" = 1 ]; then
      turn_reply="$(t show-options -p -t "$tgt" -qv @roost-reply 2>/dev/null || true)"
    fi
    # $turn_have_base, and not merely "$turn_base is 0": with recording off
    # there is no numbering at all, and base+1 would name a turn that will never
    # be written — a number a caller would then hand to `wait-done --turn`,
    # which can only time out on it. A pane whose record is simply EMPTY is the
    # opposite case and does have a base: its first reply will be turn 1.
    if [ "$turn_watch" = 1 ] && record_for "$raw" "$tgt" && [ "$RF_LIVE" = 1 ]; then
      case "$RF_STATE" in
        # 0 is a record this roost understands; 1 is no record yet, which is a
        # base of 0 and an honest prediction of turn 1 rather than a reason to
        # give up. 2 and 3 — unreadable, or written by a newer roost — are left
        # numberless on purpose: `read` already warns about them, and a guessed
        # number would be worse than none.
        0) roost_record_scan "$RF_DIR/replies"; turn_dir="$RF_DIR"; turn_base="$ROOST_RECORD_MAX"; turn_have_base=1 ;;
        1) turn_dir="$RF_DIR"; turn_base=0; turn_have_base=1 ;;
        # Kept only so the no-number line at the end can say which of the
        # two "no base" causes this was (#177).
        *) turn_rec_bad=1 ;;
      esac
      # A reserved number is a turn that is already over and not yet on disk
      # (#188): the SessionEnd release that ended it files it about 70 ms
      # later. Counted as the base, so the prediction is the turn after it,
      # and that file landing is not taken for this send's turn (signal 2
      # below). Flock round 2 on #188 found the prediction one short here.
      if [ "$turn_have_base" = 1 ]; then
        case "$turn_reserved" in
          ''|*[!0-9]*) ;;
          *) if [ "${#turn_reserved}" -le 15 ] && [ "$((10#$turn_reserved))" -gt "$turn_base" ]; then
               turn_base=$((10#$turn_reserved))
             fi ;;
        esac
      fi
    fi

    # This one's status is NOT discarded: unlike the Enters below (where
    # aborting mid-loop is the worse outcome), a failure HERE means the text
    # never reached the pane at all — there is nothing to retry or verify, so
    # let it surface as a loud failure instead of falling through to report
    # exit 0 for a message that was never typed.
    #
    # And first: still this send's pane? The lock was taken a few tmux calls
    # ago; a paste into a box that is another sender's by now is the start
    # of the merged-message case this lock exists to prevent.
    if ! roost_panelock_check; then
      echo "roost send: the send lock for '$raw' was taken from this send — nothing was submitted; retry the same target" >&2
      exit 1
    fi
    # Set BEFORE the paste, not after: a paste that tmux accepted and then
    # failed to report is still text in the box, and the cleanup must clear
    # it. A paste that never happened is cleared by a C-u that does nothing.
    send_pasted=1
    if ! type_message; then
      case "$senderr" in
        *"too long"*|*"failed to send command"*)
          # A byte count, not ${#msg}: the budget tmux enforces is bytes, and
          # under a UTF-8 locale bash would report characters — which would
          # print a number smaller than the limit next to a message saying the
          # limit was exceeded.
          bytes="$(printf '%s' "$msg" | LC_ALL=C wc -c | tr -d ' ')"
          # Reachable only if tmux refuses the load or the paste itself. The
          # command-length ceiling that used to dominate here does not apply to
          # the message any more — it travels over stdin — so this no longer
          # tells anyone to go and write a file.
          echo "roost send: tmux refused a $bytes-byte message — nothing was delivered: $senderr" >&2
          ;;
        *)
          echo "roost send: failed to paste text into '$raw' (pane may have died): $senderr" >&2
          ;;
      esac
      exit 1
    fi

    # Prove the head arrived, and keep trying until it does or the budget runs
    # out. Retyping — rather than merely waiting — is what actually fixes the
    # race: the first copy is GONE, not late. The flush that ate it happened
    # once, at takeover, so no amount of patience brings it back.
    #
    # C-u before each retry so that a pane which DID accept the earlier copy,
    # but renders it somewhere this check cannot see, ends up holding one
    # message rather than two. At an empty input line it is a no-op everywhere
    # it is understood.
    #
    # Measured, and it is why the Enter below still has to be sent: a bracketed
    # paste does NOT auto-submit. The text lands in the input box and stays
    # there, and the pane's state does not change — so the submit loop is not
    # double-submitting anything.
    if [ "$verifiable" = 1 ]; then
      waited=0
      until screen_has_head; do
        [ "$waited" -ge "$ready_timeout" ] && break
        sleep 2 2>/dev/null || true
        waited=$((waited + 2))
        screen_has_head && break
        # Still this send's pane? A C-u is the one key here that cannot be
        # taken back — it clears whatever is in the box — so if the lock was
        # taken from under this send, that box may hold another sender's
        # text now. One loud exit 1 (nothing submitted) beats two writers.
        if ! roost_panelock_check; then
          echo "roost send: the send lock for '$raw' was taken from this send — nothing was submitted; the box may still hold this send's draft; retry the same target" >&2
          exit 1
        fi
        t send-keys -t "$tgt" C-u 2>/dev/null || true
        # And again between the C-u and the re-paste: without it the gap
        # between a check and a key is three tmux calls here, not one, and a
        # lock lost after the C-u would paste this text into a box another
        # sender has just pasted into (flock review).
        if ! roost_panelock_check; then
          echo "roost send: the send lock for '$raw' was taken from this send — nothing was submitted; retry the same target" >&2
          exit 1
        fi
        # A re-paste that tmux refuses is exit 1 on the spot, never swallowed
        # (#175: `|| true` here hid the "no buffer" that a concurrent send
        # caused, and the loop went on as if the text were in the box). Exit,
        # not break (found by review): the C-u just sent may have cleared a
        # draft the pane was showing, so the screen now differs from $pre,
        # and the "does not echo" fallback below would read that change as
        # delivery and press Enter on an empty box. Nothing has been
        # submitted here — no Enter yet — so 1, the retry-the-same-target
        # code, is exactly right, the same as the first paste failing above.
        if ! type_message; then
          echo "roost send: failed to re-paste text into '$raw' (pane may have died) — nothing was submitted: $senderr" >&2
          exit 1
        fi
        sleep "$delay" 2>/dev/null || true
      done
      if ! screen_has_head; then
        # Before failing, ask a weaker question that a real agent TUI can still
        # answer: did the screen change at all?
        #
        # Measured against a live Claude Code 2.1.263 pane: a bulk `send-keys
        # -l` is detected as a PASTE and collapsed to `[Pasted text #N]`
        # placeholders — sometimes several for one send. The text is then
        # nowhere on screen, so the head check above cannot pass no matter how
        # long it waits or how often it retypes. Without this branch `roost
        # send` retyped seven times and exited 1 having submitted nothing, on
        # exactly the target it exists to drive. That trades a silent partial
        # delivery for a loud total one, which is not the trade that was asked
        # for.
        #
        # A changed screen proves the keystrokes were ACCEPTED. It does not
        # prove all of them arrived, so this is not silent: the notice goes to
        # stderr and names what could not be checked. The distinction that
        # matters is kept — a pane that ate the keys and drew nothing still
        # falls through to the failure below, which is the cold-start case.
        post="$(t capture-pane -p -t "$tgt" 2>/dev/null | tr -d '[:space:]' || true)"
        if [ "$post" != "$pre" ]; then
          # A paste PLACEHOLDER is not an unknown, it is the expected success
          # rendering: the pane took the block, decided it was a paste, and drew
          # a stand-in for it. Warning about that would fire on every long send
          # to a real agent — noise that trains a reader to ignore the notice
          # for the case where it means something. So the notice is kept for the
          # genuinely unexplained shape only: the screen changed, the message is
          # not on it, and there is no placeholder to account for that either.
          #
          # A NEW placeholder is now accepted by screen_has_head itself (#176),
          # so by here there is none: the notice is printed unconditionally.
          # This used to be a `*Pastedtext*` case on $post, and that case was
          # wrong in the dangerous direction — a Claude placeholder left on
          # screen by an EARLIER send silenced the notice for this one.
          echo "roost send: '$raw' accepted the keys but does not show them (a pane that does not echo what it is given), so the CONTENT could not be verified — submitting anyway" >&2
        else
          # Exit 1, the documented "delivery to a valid target failed — retry
          # the same target" code. NOTHING has been submitted: the Enter below
          # is never reached, so a caller that retries cannot double-run
          # anything.
          echo "roost send: could not confirm the message reached '$raw' within ${ready_timeout}s — nothing was submitted" >&2
          echo "roost send: the pane may still be starting up, or may not echo what it is given; \`roost screen $raw\` to look" >&2
          exit 1
        fi
      fi
    fi
    sleep "$delay" 2>/dev/null || true
    before="$(t capture-pane -p -t "$tgt" 2>/dev/null || true)"
    # Same call shape as the #{window_id} #{pane_dead} fetch above, and the
    # same reasoning applies to the separator: #{cursor_x} and #{cursor_y}
    # are always plain digits, so a plain space can never appear inside
    # either field and is a safe, boring delimiter. Unlike that earlier call
    # we never split this value — it is only ever compared for equality
    # against a later snapshot taken the same way — so there is nothing here
    # for a wrong separator to silently break; the space is kept anyway for
    # consistency and so the raw string is readable if ever logged.
    cursor_before="$(t display-message -p -t "$tgt" '#{cursor_x} #{cursor_y}' 2>/dev/null || true)"
    # The point of no return. Same check as before each C-u above, for the
    # same reason: an Enter on a box another sender is typing into submits
    # THEIR half-typed text. Nothing has been submitted when this fires.
    if ! roost_panelock_check; then
      echo "roost send: the send lock for '$raw' was taken from this send — nothing was submitted; the box may still hold this send's draft; retry the same target" >&2
      exit 1
    fi
    # From here the text is in: cleanup must not clear it.
    send_entered=1
    t send-keys -t "$tgt" Enter 2>/dev/null || true

    n="$retries"
    while [ "$n" -gt 0 ]; do
      sleep "$delay" 2>/dev/null || true
      pending "$*" || break
      # An extra Enter into a box that is another sender's by now would
      # submit their half-typed text. Not exit 1 here — the first Enter is
      # already in, and "nothing was submitted" would be a lie — just no more
      # Enters: the turn watch below says what became of the one that went.
      if ! roost_panelock_check; then
        echo "roost send: the send lock for '$raw' was taken from this send after its Enter — no more Enters will be sent" >&2
        break
      fi
      # A cold TUI can swallow the first Enter entirely; try again. Guarded:
      # a pane that dies mid-loop must not abort the script with tmux's raw
      # error — it should fall through to the same conservative handling as
      # any other "can no longer tell" case below.
      t send-keys -t "$tgt" Enter 2>/dev/null || true
      n=$((n - 1))
    done

    if [ "$retries" -gt 0 ] && pending "$*"; then
      echo "roost send: text pasted into '$raw' but never submitted (tried $retries extra Enter(s))" >&2
      exit 1
    fi

    # PROVE A NEW TURN BEGAN (#92). Everything above proves the text arrived and
    # the submit left the input line. This proves the target ACTED on it.
    #
    # Two independent pieces of evidence, and either one settles it:
    #
    #   1. the badge leaves done/idle — the prompt-submit hook fired, which is
    #      the ordinary case and the one the race is about;
    #   2. the recorded turn number moves past the baseline — a turn that began
    #      AND finished inside the poll interval, which the badge alone would
    #      miss because it is back to `done` by the time it is read. The record
    #      is also where the answer will be, so this is not a second-best
    #      signal: it is the stronger one, and it is why the number handed back
    #      on this path is the OBSERVED turn rather than the prediction.
    #
    # THE BOUND. Default 10 s, and it is only ever paid by a target that was
    # idle, took a prompt, and then did nothing — which is a real failure worth
    # 10 s to report. The measurements above put the whole race under 3 s at the
    # worst latency reproduced, and the healthy case returns in one poll, so a
    # bound this generous costs nothing on a working fleet. Read from
    # @roost-send-turn-timeout, and clamped by LENGTH first and then by value,
    # the same way @roost-send-ready-timeout is above and for the same reason: a
    # pathological digit string must not make the arithmetic itself slow.
    #
    # The poll is a quarter second, matching `wait-done`'s, so the two commands
    # cannot disagree about how quickly a badge change is noticed.
    #
    # A pane that has gone away or gone dead mid-wait stops the loop at once
    # rather than burning the bound on a target that can never answer. It is
    # reported as "never started", not as a death: the text WAS submitted, and
    # that is the fact the caller must not lose.
    turn_timeout="$(t show-options -gqv @roost-send-turn-timeout 2>/dev/null)"
    case "$turn_timeout" in ''|*[!0-9]*) turn_timeout=10 ;; esac
    # Clamped by LENGTH first — an O(1) test, so this bound can never itself be
    # slow, and it caps the work the strip loop below could ever be asked to do.
    [ "${#turn_timeout}" -gt 40 ] && turn_timeout=120
    # LEADING ZEROS ARE STRIPPED, and both of the bugs that earned this line were
    # measured on the version without it (bash 3.2):
    #
    #   00, 000  every arithmetic context reads them as ZERO, but the `= 0` test
    #            below is a STRING compare, so the off-switch did not fire and
    #            `$((turn_timeout * 4))` did — the poll loop ran zero times and
    #            EVERY send reported exit 4 on a target that was working fine.
    #   08, 09   a leading zero makes `[ -gt ]` and `$(( ))` read octal, and
    #            those two are not octal: `value too great for base (error token
    #            is "08")`. The `[ -gt ]` carries 2>/dev/null, but the `$(( ))`
    #            in the loop header does not and cannot — under `set -e` that
    #            aborted `send` AFTER the text had been submitted, which is the
    #            one outcome this whole branch exists to prevent.
    #
    # Bounded to length > 1 so "0" itself (and "000" once stripped) settles on a
    # single "0" rather than the empty string. Same loop, same reason, as
    # @roost-send-retries above.
    while [ "${#turn_timeout}" -gt 1 ] && [ "${turn_timeout%${turn_timeout#?}}" = 0 ]; do
      turn_timeout="${turn_timeout#0}"
    done
    # Zeros are gone, so 4+ digits is genuinely >= 1000 and over the cap. By
    # pattern before value, so a long digit string never reaches the arithmetic.
    case "$turn_timeout" in ????*) turn_timeout=120 ;; esac
    [ "$turn_timeout" -gt 120 ] 2>/dev/null && turn_timeout=120 || true
    # 0 turns the whole thing OFF, and it is the escape hatch rather than an
    # accident of the arithmetic. `$((0 * 4))` would make the loop below run
    # zero times and then report exit 4 on EVERY send — a knob that reads like
    # "do not wait" and instead breaks the command. So it is spelled out: 0
    # means a send behaves exactly as it did before this existed, which is what
    # someone whose harness stamps nothing actually wants.
    if [ "$turn_timeout" = 0 ]; then turn_watch=0; fi
    if [ "$turn_watch" = 1 ]; then
      turn_ticks=0 turn_gone=0
      while [ "$turn_ticks" -lt $((turn_timeout * 4)) ]; do
        # Four fields now, peeled one at a time, and the state stays LAST
        # because it is the field most often empty. @agent_since sits in the
        # middle and can be empty too — a pane somebody badged by hand has a
        # state and no stamp — and this split survives that: an empty middle
        # field still occupies its place between two spaces, so `${r#* }` steps
        # over it rather than swallowing the field after it.
        #
        # MEASURED on tmux 3.6, all four combinations, because "a middle empty
        # field would not survive this split" is exactly the kind of claim the
        # comment above the FIRST such call in this command warns about:
        #
        #   neither set   `%0 0  `            -> since [] state []
        #   state only    `%0 0  done`        -> since [] state [done]
        #   both          `%0 0 1790000000 done`
        #   since only    `%0 0 1790000000 `  -> state []
        turn_info="$(t display-message -p -t "$tgt" '#{pane_id} #{pane_dead} #{@agent_since} #{@agent_state}' 2>/dev/null || true)"
        turn_pid="${turn_info%% *}"
        turn_rest="${turn_info#* }"
        turn_dead="${turn_rest%% *}"
        turn_rest="${turn_rest#* }"
        turn_since_now="${turn_rest%% *}"
        turn_now="${turn_rest#* }"
        if [ -z "$turn_pid" ] || [ "$turn_dead" = "1" ]; then turn_gone=1; break; fi
        # 1. the badge left done/idle: the prompt-submit hook fired. The
        #    ordinary case, and the one the race is about.
        #
        #    `error` is the one arm that starts a turn and gets NO number.
        #    Found by review (flock round 2): an errored turn is never recorded
        #    — scripts/roost-agent-state clears the half-built reply on that
        #    path, and every adapter does the same, because a failed turn has no
        #    answer to publish — so `turn_base + 1` would name a file that will
        #    never be written, and `wait-done --turn` on it could only time out.
        #    A turn DID begin, so this is still exit 0 with started true; there
        #    is simply nothing to number.
        #
        #    `blocked` keeps its number: a turn that stopped at a dialog is not
        #    over, and it records a reply once the human answers.
        #
        #    This fixes only the error roost can SEE. A turn that starts
        #    `working` and errors later is numbered here and that number never
        #    arrives — unavoidable without predicting the turn, and exactly what
        #    `wait-done`'s timeout and its own `is in error state` exit are for.
        case "$turn_now" in
          ''|done|idle) ;;
          error) turn_started=1; turn_errored=1; break ;;
          *) turn_started=1
             if [ "$turn_have_base" = 1 ]; then turn_num=$((turn_base + 1)); fi
             break ;;
        esac
        # 2. the recorded turn number moved: a turn that began and ended between
        #    two polls, or inside the Enter cushion before the first one. This
        #    is the only signal that also NAMES the turn, so the number handed
        #    back here is the observed one, not the prediction.
        if [ -n "$turn_dir" ]; then
          roost_record_scan "$turn_dir/replies"
          if [ "$ROOST_RECORD_MAX" -gt "$turn_base" ]; then
            turn_started=1; turn_num="$ROOST_RECORD_MAX"; break
          fi
        fi
        # 3. the stamp moved. @agent_since is rewritten by EVERY state stamp, so
        #    a done -> working -> done that both of the above missed still shows
        #    here — unless all of it happened inside one second, which is the
        #    resolution `date +%s` gives it. Hence 4.
        #
        #    What it really says is "a stamp landed while the badge stayed
        #    done/idle", which is WIDER than "a turn ran": codex's SessionEnd
        #    rewrites the stamp on its way to `idle`, and any adapter that
        #    re-reports a finished state does the same. So this can read
        #    `started` for a stamp our prompt did not cause. That is the safe
        #    direction on purpose — see the four-baseline note above — and it is
        #    why no number is ever taken from here: only signal 2 names a turn.
        if [ -n "$turn_since_now" ] && [ "$turn_since_now" != "$turn_since" ]; then
          turn_started=1; break
        fi
        # 4. the reply changed. The adapter rewrites @roost-reply at the end of
        #    every turn, and clears it on one that errored, so either direction
        #    is a turn that ran. Read LAST, and only once the three cheap
        #    signals have all said nothing, so an ordinary send never pays for
        #    a second tmux call or for moving 12 KB.
        #
        #    It compares TEXT, so it is silent on a turn whose reply is
        #    byte-identical to the previous one — "ok", "done", an empty answer
        #    twice. That gap is real and is why this is the fourth signal rather
        #    than the only one: 1 catches any turn slower than a poll, 2 catches
        #    any turn at all when records are on, 3 catches any stamp inside the
        #    same second. All four have to miss at once to reach exit 4.
        if [ "$turn_reply" != "$(t show-options -p -t "$tgt" -qv @roost-reply 2>/dev/null || true)" ]; then
          turn_started=1; break
        fi
        sleep 0.25 2>/dev/null || true
        turn_ticks=$((turn_ticks + 1))
      done
      if [ "$turn_started" = 0 ]; then
        # Exit 4, and deliberately NOT 1. Exit 1 means nothing was submitted and
        # the same send may be repeated; here the text WAS submitted, so a
        # caller that treated this as 1 and retried would run the prompt twice.
        # 2 means pick a different target and 3 means wait for a human — neither
        # fits either. The three existing codes keep their meanings exactly.
        if [ "$turn_gone" = 1 ]; then
          # Still 4, not 2. Exit 2 means "the target was unusable, pick another
          # one and send this again", and that is the one thing a caller must
          # NOT do here: the text was already submitted into this pane before it
          # went. The death is named instead, which is what tells them to
          # re-resolve — without telling them the prompt never ran.
          echo "roost send: '$raw' took the prompt and then went away before it started a turn — the text WAS submitted, so do NOT send it again; re-resolve the target before anything else" >&2
        else
          echo "roost send: '$raw' took the prompt but never started a turn within ${turn_timeout}s — the text WAS submitted, so do NOT send it again" >&2
          echo "roost send: \`roost screen $raw\` to look, and \`roost doctor\` if its badge never moves" >&2
        fi
        exit 4
      fi
    fi

    # WHO SENT IT (#56), kept beside the turn as `replies/NNNNNN.sent_by` —
    # and only once there IS a turn to keep it beside. Everything above has
    # just proved one began and named it; a send that exits 4 never reaches
    # here, and a target with no number (not an agent, mid-turn, recording off,
    # an errored turn) has nowhere to file a label, so none is filed and --json
    # says null. The sidecar is written NOW, before the Stop hook writes the
    # turn file, because now is when the number is known. If this turn then
    # ends with no reply, nothing takes its number but the NEXT turn, and the
    # hook drops this file as that turn starts (roost_record_drop_pending):
    # the label never lands on a prompt this send did not send.
    #
    # The default label, when --from was not given, is decided from the two
    # variables tmux gives every pane. `pane:%N` only when $TMUX names THIS
    # server by pid and $TMUX_PANE is a pane it has: the same two checks
    # `reply` makes before it trusts $TMUX_PANE, and for the same reason — the
    # user's everyday tmux sets both variables too, and a %N from that server
    # is a stranger's id over here. Anything less certain is `human`, which is
    # what a send typed at a shell outside any pane is. One tmux call, and only
    # on this path.
    #
    # The write fails soft: a record that cannot be written has never failed a
    # send, and the sidecar is no exception. sent_by in the document names the
    # label only when the file holds it.
    sent_by=""
    if [ -n "$turn_num" ] && [ -n "$turn_dir" ]; then
      if [ "$from_given" -eq 0 ]; then
        from=human
        case "${TMUX_PANE:-}" in
          %[0-9]*)
            if [ -n "${TMUX:-}" ]; then
              caller_pid="${TMUX#*,}"; caller_pid="${caller_pid%%,*}"
              if [ "$(t display-message -p -t "$TMUX_PANE" '#{pid} #{pane_id}' 2>/dev/null || true)" = "$caller_pid $TMUX_PANE" ]; then
                from="pane:$TMUX_PANE"
              fi
            fi ;;
        esac
      fi
      # A record that does not exist yet (this is the pane's first turn) is
      # created by the writer, and it files the socket path so that `forget
      # --gone` can later ask the right server about it. Asked only in that
      # case: every later send finds the directory and pays nothing.
      sidecar_sock=""
      if [ ! -d "$turn_dir" ]; then
        sidecar_sock="$(t display-message -p '#{socket_path}' 2>/dev/null || true)"
      fi
      if roost_record_put_turn_field "$turn_dir" "$turn_num" sent_by "$from" "$sidecar_sock"; then
        sent_by="$from"
      fi
    fi

    # One line on stdout, "%N TURN": the pane this prompt went into, and the
    # turn it started. Both fields or neither.
    #
    # THE PANE IS NOT DECORATION. Found by review (flock round 1): a WINDOW
    # target — `roost send api …`, the form the site docs use throughout —
    # resolved to that window's active pane and printed ITS turn number, while
    # `wait-done --turn` refuses anything that is not a %N. So the documented
    # idiom "pass --turn whatever send gave you" produced exit 1 on the commonest
    # target form. Printing the pane beside the number closes that, and hands
    # the caller the id it wanted next anyway. It is the pane read at baseline,
    # which is the pane `send-keys` resolved the same target to, so it names
    # where the text really went rather than where it might go now.
    #
    # NOTHING is printed when there is no turn to name — a pane that is not an
    # agent, a target already mid-turn, recording off, a record this roost
    # cannot read — so an empty capture means exactly "you cannot use --turn
    # here" rather than a number that was guessed. Every existing caller ignores
    # `send`'s stdout, so nothing that worked before sees this at all.
    if [ "$json" -eq 1 ]; then
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      # The SAME pane the human line names, not a fresh lookup: the two modes
      # must not be able to disagree about which pane was written to, and a
      # re-resolve a second later can answer differently if the window's active
      # pane has moved.
      roost_jsonout_emit send target s "$raw" \
        pane z "$turn_pane" \
        turn i "$turn_num" started b "$turn_started" \
        state z "$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)" \
        sent_by z "$sent_by" \
        ${send_waited_field[@]+"${send_waited_field[@]}"} \
        || roost_jsonout_fail send
      exit 0
    fi
    if [ -n "$turn_num" ]; then printf '%s %s\n' "$turn_pane" "$turn_num"; fi
    # WHY THERE IS NO NUMBER (#177), one line on stderr, and only on the human
    # path: --json already carries started/turn/state and a program reading it
    # asked for no prose. The empty stdout above is correct and stays — it is
    # what tells a caller "--turn is not available here" — but on its own it
    # was read as a failed delivery: in a real two-worker run both agents took
    # the silence for a lost message, and one went on to write that it was
    # "unsure it was delivered, though the peer clearly responded". Every one
    # of these sends DID submit the text, so each line says which honest cause
    # left it unnumbered. The badge named is the one read at baseline, which is
    # the one that decided whether to watch at all. An unknown badge is not
    # echoed: it is a pane option anyone can set, and stderr is a terminal.
    if [ -z "$turn_num" ]; then
      case "$turn_state" in
        '') echo "roost send: no turn number: '$raw' has no badge yet (its first turn has not started)" >&2 ;;
        working) echo "roost send: no turn number: '$raw' is mid-turn; the prompt is queued inside the harness" >&2 ;;
        blocked) echo "roost send: no turn number: '$raw' is blocked at a dialog (sent with --force); a turn is watched only from done or idle" >&2 ;;
        done|idle)
          if [ "$turn_timeout" = 0 ]; then
            echo "roost send: no turn number: '$raw' was not watched (@roost-send-turn-timeout is 0)" >&2
          elif [ "$turn_errored" = 1 ]; then
            echo "roost send: no turn number: '$raw' started a turn that ended in error, and an errored turn is not numbered" >&2
          elif [ "$turn_have_base" = 0 ] && [ -z "${ROOST_RECORD_ROOT:-}" ]; then
            # Empty root has three causes, not one (roost_record_root in
            # scripts/lib/roost-record.sh): ROOST_RECORD_DIR set to "", set to a
            # RELATIVE path, or unset with neither XDG_STATE_HOME nor HOME
            # absolute. The line names all three rather than guess which.
            echo "roost send: no turn number: '$raw' started a turn, but recording is off (ROOST_RECORD_DIR is empty or not an absolute path, or there is no state directory), so turns are not numbered" >&2
          elif [ "$turn_have_base" = 0 ] && [ "$turn_rec_bad" = 1 ]; then
            echo "roost send: no turn number: '$raw' started a turn, but its record is one this roost cannot read (see \`roost read $raw\`)" >&2
          elif [ "$turn_have_base" = 0 ]; then
            echo "roost send: no turn number: '$raw' started a turn, but this pane has no record to number it by" >&2
          else
            # Signals 3 and 4 above: a stamp or a reply moved, and neither
            # names a turn, so none was taken from them.
            echo "roost send: no turn number: '$raw' started a turn, but roost saw only its badge stamp or reply change, and neither names the turn" >&2
          fi ;;
        *) echo "roost send: no turn number: '$raw' has a badge that is not watched; a turn is watched only from done or idle" >&2 ;;
      esac
    fi
    exit 0
    ;;
  answer)
    # roost answer [--json] [--force] [--expect FP] TGT --approve|--deny|--option N
    #
    # A PERSON'S verb for the dialog a pane is blocked on (#142). It sends one
    # key, once, into a harness's own dialog, and only after every check below
    # has passed; it never retries. The design, with the measurement behind
    # each rule, is docs/airig/specs/2026-09-30-roost-answer-design.md, and
    # the step numbers below are its §3.1. scripts/lib/roost-answer.sh holds
    # the record's parser, the key map and the one-command send.
    #
    # roost NEVER answers a dialog on its own. No hook, no adapter and no other
    # roost command runs this; tests/test-answer.sh fails if one does. It runs
    # when a person runs it, or when a person told an agent to run it.
    #
    # Exit codes: `send` owns 1 to 4 and `wait-done` 5, so this keeps 1 and 2
    # with their `send` meanings and takes 6 to 10. It never exits 3, 4 or 5.
    #
    #   0   answered, and roost saw it land
    #   1   a bad or missing argument, or tmux failed before the send
    #   2   no such target, a dead pane, or a window with two blocked panes
    #   6   nothing to answer: not blocked, no dialog on screen, already answered
    #   7   a different dialog: --expect does not match, or it changed before
    #       the send
    #   8   no measured keys for this harness, dialog kind or action
    #   9   the caller is an agent in a roost pane, and --force was not given
    #   10  the key WAS sent, and nothing confirmed it inside the bound: do not
    #       answer again
    #   11  the pane's lock could not be held (#181): another command — a
    #       `roost send` — was typing into it for the whole wait, or the lock
    #       could not be named or made, or it was taken from this call before
    #       the key. Nothing was sent; try again.
    #
    # Only exit 0 and 10 have sent anything. 10 is to `answer` what 4 is to
    # `send`: the input went in, so a second try would be a second input.
    . "$ROOST_HOME/scripts/lib/roost-answer.sh"
    ans_usage="usage: roost answer [--json] [--force] [--expect FP] TGT --approve|--deny|--option N"
    ans_bad() { printf '%s\n' "$ans_usage" >&2; exit 1; }
    shift
    # Flags go BEFORE the target, as with `send`, and exactly one action goes
    # after it. A repeated flag is not consumed: it falls into the target slot
    # and fails there, which is the shape `send` keeps for the same reason.
    #
    # --json prints one document instead of the line, under the rules in
    # docs/airig/specs/2026-09-15-json-output-design.md: the same exit codes,
    # the same stderr, and NOTHING on stdout for any failure -- exit 10
    # included, as `send --json` prints nothing for its 4.
    force=0 json=0 expect="" expect_given=0
    while :; do
      case "${1:-}" in
        --force) [ "$force" -eq 0 ] || break; force=1; shift ;;
        --json) [ "$json" -eq 0 ] || break; json=1; shift ;;
        --expect)
          [ "$expect_given" -eq 0 ] || break
          [ "$#" -ge 2 ] || ans_bad
          expect_given=1; expect="$2"; shift 2 ;;
        *) break ;;
      esac
    done
    raw="${1:-}"
    case "$raw" in ''|-*) ans_bad ;; esac
    shift
    action="" opt_n=""
    case "${1:-}" in
      --approve) action=approve; shift ;;
      --deny) action=deny; shift ;;
      --option)
        [ "$#" -ge 2 ] || ans_bad
        opt_n="$2"; action=option; shift 2
        # A number, or it is a usage error. Whether it is one of the dialog's
        # options is only known once the record is read (exit 8 there).
        # Leading zeros are dropped by base-10 arithmetic, so `02` is option 2
        # and never octal; nine digits at most, so the arithmetic cannot
        # overflow.
        case "$opt_n" in ''|*[!0123456789]*) ans_bad ;; esac
        [ "${#opt_n}" -le 9 ] || ans_bad
        opt_n=$((10#$opt_n)) ;;
      --text)
        # Reserved, and refused: no dialog that takes free text was measured
        # (the design's §9), and typing into a prompt box is the hazard this
        # whole verb exists to avoid.
        echo "roost answer: --text is not supported yet. Answer at the pane" >&2
        exit 8 ;;
      *) ans_bad ;;
    esac
    # No action, two actions, or anything after the one action.
    [ "$#" -eq 0 ] || ans_bad
    # Step 1, before anything is read. An approval always names the dialog it
    # approves (the human's decision Q3, §11): a second dialog can open 0.2 s
    # after the first closes with the same tool, input and summary (M4), a
    # wrong deny costs a re-prompt, and a wrong approve cannot be undone.
    if [ "$expect_given" -eq 0 ] && [ "$action" != deny ]; then
      echo "roost answer: --approve and --option need --expect FINGERPRINT. Read it from roost status --json" >&2
      ans_bad
    fi
    # The fingerprint is spliced into a tmux format in the send, so it is
    # checked as the record's own reader checks it: 12 lowercase hex. Anything
    # else cannot be any dialog's, and is a mistyped call rather than exit 7.
    if [ "$expect_given" -eq 1 ] && ! roost_answer_hex "$expect" 12; then
      echo "roost answer: --expect takes the 12-character fingerprint from roost status --json" >&2
      ans_bad
    fi

    # Step 1, the target: a %N pane, or a window, which means the ONE pane in
    # it that reads blocked. tmux 3.6 answers display-message for a pane that
    # is gone with exit 0 and an empty #{pane_id} (see record_for), so "found"
    # is a pane id that came back, not a zero exit.
    tgt="$(target "$raw")"
    pane="" dead=""
    case "$tgt" in
      %*)
        info="$(t display-message -p -t "$tgt" '#{pane_id} #{pane_dead}' 2>/dev/null || true)"
        pane="${info%% *}"; dead="${info#* }"
        case "$pane" in %[0-9]*) ;; *) pane="" ;; esac ;;
      *)
        rows="$(t list-panes -t "$tgt" -F '#{pane_id} #{pane_dead} #{@agent_state}' 2>/dev/null || true)"
        nb=0 blocked_ids=""
        while IFS=' ' read -r rid rdead rstate; do
          [ "$rstate" = blocked ] || continue
          nb=$((nb + 1)); blocked_ids="${blocked_ids:+$blocked_ids }$rid"
          pane="$rid"; dead="$rdead"
        done <<EOF
$rows
EOF
        if [ "$nb" -gt 1 ]; then
          echo "roost answer: '$raw' has more than one blocked pane ($blocked_ids). Name one" >&2
          exit 2
        fi
        # No blocked pane: the window's active one, so the refusal below can
        # say what it reads.
        if [ "$nb" -eq 0 ] && [ -n "$rows" ]; then
          info="$(t display-message -p -t "$tgt" '#{pane_id} #{pane_dead}' 2>/dev/null || true)"
          pane="${info%% *}"; dead="${info#* }"
          case "$pane" in %[0-9]*) ;; *) pane="" ;; esac
        fi ;;
    esac
    if [ -z "$pane" ]; then
      echo "roost answer: no such target '$raw'" >&2; exit 2
    fi
    if [ "$dead" = 1 ]; then
      echo "roost answer: target '$raw' is a dead pane" >&2; exit 2
    fi

    # Step 2, WHO IS CALLING (§7), before the pane is read, so an agent that
    # is refused learns nothing about the dialog from the refusal.
    #
    # roost cannot tell a person from a program. What it can see is where the
    # call came from: $TMUX names THIS server (by pid, the check `send` and
    # `reply` make, and for the reason `reply` gives: $TMUX_PANE alone is a
    # valid id on every server, `%0` on all of them), and $TMUX_PANE is a pane
    # an agent has REPORTED from -- it has a badge, or an identity (#141). That
    # last rule is the human's decision Q1 (§11): a person's own shell pane
    # inside roost passes with no flag, because a --force that has to be typed
    # every time stops meaning anything. The cost, stated plainly: an agent in
    # a harness with no adapter has no badge and is not caught, and one
    # `env -u TMUX -u TMUX_PANE` gets past all of it. It is a guard against an
    # accident -- an agent that reads the skill, sees a blocked peer and tries
    # the obvious command -- and NOT a permission system. docs/known-gaps.md
    # and the Driving a Fleet page say so in the same words.
    #
    # `by` is where the call ran, for the record (§8): `pane:%N` for any pane
    # on this server, `terminal` for a tty, `program` for neither. It does not
    # say who the person was.
    #
    # EVERY tmux read this verb splits uses `|` between fields, never a tab.
    # Measured on Ubuntu 24.04's tmux 3.4-1ubuntu0.2: a client whose locale
    # is C prints a tab in a format as `_`, so `#{a}<TAB>#{b}` came back as
    # one field and every check after it refused (fail closed, but a server on
    # a C-locale machine could answer nothing). Under C.UTF-8 it printed the
    # tab, and tmux 3.6 on macOS prints it in both, which is why only a
    # C-locale run on 3.4 shows it. `|` came back as `|` in both locales on
    # 3.4, as did `^`, `~`, `;` and `,`: tmux rewrites only bytes it cannot
    # print, and `|` is printable ASCII. It cannot appear in the fields that
    # come before the last one in any read below: a pid, a %N, a digit, a
    # state word, and the dialog and answer records, whose parsers refuse
    # anything but hex, fixed words and digits. A `|` set there by hand only
    # shifts what follows into a field its parser then refuses, so it fails
    # closed too. The free-text description is always the LAST field, so a
    # `|` inside it stays in it.
    by="" caller=""
    case "${TMUX_PANE:-}" in
      %[0-9]*)
        if [ -n "${TMUX:-}" ]; then
          caller_pid="${TMUX#*,}"; caller_pid="${caller_pid%%,*}"
          cinfo="$(t display-message -p -t "$TMUX_PANE" '#{pid} #{pane_id}|#{@agent_state}|#{@roost-session}' 2>/dev/null || true)"
          if [ "${cinfo%%|*}" = "$caller_pid $TMUX_PANE" ]; then
            caller="$TMUX_PANE"; by="pane:$TMUX_PANE"
            crest="${cinfo#*|}"
            if [ "$force" -eq 0 ] && { [ -n "${crest%%|*}" ] || [ -n "${crest#*|}" ]; }; then
              echo "roost answer: this is a person's command, and it was called from an agent's pane ($caller)" >&2
              echo "roost answer: pass --force only if a person told you to answer this dialog" >&2
              exit 9
            fi
          fi
        fi ;;
    esac
    if [ -z "$by" ]; then
      if [ -t 0 ]; then by=terminal; else by=program; fi
    fi

    # Step 3, the pane, in ONE read. The description is last because it is the
    # one free-text field: a `|` in it (a shell pipe is the common case) stays
    # in it, and never reaches the words the checks below use. The separator
    # is `|` for the locale reason given at the caller check above.
    pinfo="$(t display-message -p -t "$pane" '#{pane_in_mode}|#{@agent_state}|#{@roost-dialog}|#{@roost-answered}|#{@roost-blocked-on}' 2>/dev/null || true)"
    in_mode="${pinfo%%|*}"; prest="${pinfo#*|}"
    state="${prest%%|*}"; prest="${prest#*|}"
    drec="${prest%%|*}"; prest="${prest#*|}"
    arec="${prest%%|*}"; blocked_on="${prest#*|}"
    # Printed back to a terminal below, so no control byte survives it.
    blocked_on="$(printf '%s' "$blocked_on" | tr -d '[:cntrl:]')"

    # Step 4. A Claude dialog that was declined or dismissed at the pane fires
    # no hook, so its badge outlives it (#38). roost_unblock_pane clears such a
    # badge only when Claude's own transcript proves the decline, exactly as
    # `send` asks it, so a declined dialog is "not blocked" here and never a
    # target. It is fail-closed for every other pane.
    if [ "$state" = blocked ] && roost_unblock_pane "$pane"; then
      state="$(t show-options -pqv -t "$pane" @agent_state 2>/dev/null || true)"
    fi
    if [ "$state" != blocked ]; then
      echo "roost answer: '$raw' is not blocked (it reads ${state:-no badge}). There is nothing to answer" >&2
      exit 6
    fi

    # Step 5, which dialog. With --deny and no --expect, the fingerprint just
    # read is used, in the same two places, so the dialog cannot change
    # between this read and this key. It can have changed since the PERSON
    # looked; that is the cost Q3 accepted for a deny.
    if ! roost_answer_dialog_parse "$drec"; then
      echo "roost answer: '$raw' has no dialog record, so roost cannot tell which dialog this is" >&2
      if [ "$expect_given" -eq 1 ]; then exit 7; fi
      exit 8
    fi
    fp="$ROOST_DIALOG_FP"
    if [ "$expect_given" -eq 1 ] && [ "$expect" != "$fp" ]; then
      echo "roost answer: '$raw' is now blocked on a different dialog (expected $expect, found $fp). Nothing was sent" >&2
      exit 7
    fi

    # Step 6. Answered already: the approved tool may still be running, and
    # the pane reads blocked for all of it (M6), so a second key would land in
    # the prompt box (M7).
    if roost_answer_answered_parse "$arec" "$fp"; then
      ago=$(( $(date +%s) - ROOST_ANSWERED_AT ))
      [ "$ago" -ge 0 ] || ago=0
      said="$ROOST_ANSWERED_ACTION"; [ -z "$ROOST_ANSWERED_OPTION" ] || said="option $ROOST_ANSWERED_OPTION"
      echo "roost answer: this dialog was already answered ($said, $ago s ago). Nothing was sent" >&2
      exit 6
    fi

    # Step 7, the key map. A dialog kind or harness with no measured row is
    # refused here, before the screen is even looked at.
    if ! roost_answer_keys "$ROOST_DIALOG_HARNESS" "$ROOST_DIALOG_KIND" "$action" "$opt_n" "$ROOST_DIALOG_OPTIONS"; then
      echo "roost answer: $ROOST_ANSWER_REFUSAL" >&2
      exit 8
    fi

    # Step 8, the screen, which may REFUSE a send and never permits one by
    # itself (the human's decision Q2, §11). A pane in copy mode would take
    # the key itself. A pane whose visible screen does not show the dialog's
    # marker is the M6 case -- an approved tool still running under a badge
    # that says blocked -- or a dialog reworded by an upgrade (§12.5); either
    # way a key would land somewhere else.
    if [ "$in_mode" != 0 ]; then
      echo "roost answer: '$raw' is in copy mode, so keys would not reach the agent. Nothing was sent" >&2
      exit 6
    fi
    if ! roost_answer_marked "$(t capture-pane -p -J -t "$pane" 2>/dev/null || true)"; then
      echo "roost answer: '$raw' reads blocked, but no dialog is on its screen. Nothing was sent" >&2
      exit 6
    fi

    # THE PANE LOCK (#181), taken here and not earlier: every refusal above
    # needs no lock, and must not wait on one. `send` holds a per-pane lock
    # from before its first key to after its turn watch (#175), and a key
    # typed into a box another command is pasting into is the same two-writers
    # case the lock exists for — a `send --force` and an `answer` aimed at
    # one dialog. The same library, the same knob (@roost-send-lock-timeout,
    # 60 s by default), the same shapes: taken before the key, re-checked at
    # the key, held through the confirm wait below (so a `send` that is
    # waiting cannot slip in between the key and its proof), and dropped on
    # every way out by the EXIT trap. INT and TERM exit, they do not clean up
    # and carry on (the lesson `send` learned, flock review of #179).
    #
    # Exit 11 for every way the lock is not held, and nothing is sent on any
    # of them: another writer for the whole wait, a socket path that is not
    # absolute (tmux reports it as the server was started with), a lock
    # directory that cannot be made or written, or a lock taken from under
    # this call before the key.
    . "$ROOST_HOME/scripts/lib/roost-panelock.sh"
    ans_cleanup() { roost_panelock_drop; return 0; }
    trap 'ans_cleanup' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    lock_sock="$(t display-message -p '#{socket_path}' 2>/dev/null || true)"
    lock_timeout="$(roost_panelock_timeout "$(t show-options -gqv @roost-send-lock-timeout 2>/dev/null || true)")"
    lock_rc=0
    roost_panelock_take "$lock_sock" "$pane" "$lock_timeout" || lock_rc=$?
    case "$lock_rc" in
      0) # The wait may have been long, and the screen checks above are from
         # before it. The send itself re-tests the badge, the fingerprint, the
         # answered record and copy mode at the instant it sends, but not the
         # SCREEN: a slow tool approved at the pane during the wait leaves the
         # pane blocked with the same fingerprint and the dialog gone, and an
         # Escape would then interrupt the running tool (found by review).
         # So the marker is read once more, now, under the lock.
         if ! roost_answer_marked "$(t capture-pane -p -J -t "$pane" 2>/dev/null || true)"; then
           echo "roost answer: '$raw' changed while waiting for its pane lock: the dialog is no longer on its screen. Nothing was sent" >&2
           exit 7
         fi ;;
      1) echo "roost answer: another command is typing into '$raw' (a roost send holds its lock) and did not finish within ${lock_timeout}s. Nothing was sent; try again" >&2
         exit 11 ;;
      2) echo "roost answer: the server's socket path '$lock_sock' is not absolute, so no pane lock can be named for '$raw'. Nothing was sent; start the server, or set ROOST_SOCKET, with an absolute path" >&2
         exit 11 ;;
      *) echo "roost answer: could not make or write the pane lock beside '$lock_sock' for '$raw'. Nothing was sent; the socket directory must be writable" >&2
         exit 11 ;;
    esac

    # Step 9, the send: ONE key group, ONCE, in one tmux command that tests
    # everything above again at the instant it sends (roost_answer_send says
    # how). There is no retry anywhere.
    act_word="$action"; [ "$action" != option ] || act_word="option$opt_n"
    if [ "$expect_given" -eq 0 ]; then
      echo "roost answer: denying '$pane': ${blocked_on:-the dialog}" >&2
    fi
    sent_at="$(date +%s)"
    nonce="$$.$RANDOM"
    # Still this call's pane? The one tmux call between here and the key is
    # the gap the lock cannot close; everything wider, it does.
    if ! roost_panelock_check; then
      echo "roost answer: the pane lock for '$raw' was taken from this call. Nothing was sent; try again" >&2
      exit 11
    fi
    src=0
    roost_answer_send "$pane" "$fp" "$ROOST_ANSWER_KEY" "$fp $sent_at $act_word $by" "$nonce" || src=$?
    if [ "$src" -eq 1 ]; then
      echo "roost answer: '$raw' changed before the key was sent (a new dialog, an answer at the pane, or copy mode). Nothing was sent" >&2
      exit 7
    elif [ "$src" -ne 0 ]; then
      echo "roost answer: tmux failed before the key was sent to '$raw'. Nothing was sent" >&2
      exit 1
    fi

    # Step 10, CONFIRM (§6), inside the bound. The proof must fit the action:
    #
    #   approve, option  @agent_state is working or done         -> state
    #                    @roost-dialog holds a new fingerprint   -> dialog
    #                    the marker is off the visible screen, the pane
    #                    still reads blocked, and the transcript shows no
    #                    decline                                 -> screen
    #   deny (Claude)    roost_unblock_pane clears the pane from the
    #                    transcript                              -> transcript
    #
    # `screen` is the only proof for an approved slow tool (M6), and it is the
    # weakest, which is why the record and the JSON say which proof was used.
    # It is also the FIRST to appear on every approval: the dialog leaves the
    # screen 12 to 76 ms after the key, the badge moves at +70 to +170 ms, and
    # a decline writes its transcript records 5 to 55 ms after the key (M1,
    # M5). Taken at the first poll that saw it, it would win nearly every
    # time, and it could be read in the gap before a decline is written. So it
    # counts only once it has HELD for ten polls -- about half a second to a
    # second depending on tmux's speed, since a poll is a 50 ms sleep plus up
    # to four tmux calls (0.92 s for ten on a reviewer's Mac); at least three
    # times the slowest badge change measured and twice the slowest next
    # dialog -- and any stronger proof, or a decline, seen in that time wins
    # over it. The run of a slow tool lasts far longer, so the case `screen`
    # exists for still ends here, that much later. (This hold is the builder's
    # reading of §6, not a measured number: no run measured how long the
    # stronger proofs can lag.)
    # An approve that ends in a decline, or a deny that ends in `working`, was
    # not done by this call: somebody at the pane got there first. That is
    # exit 10 too, saying what the pane shows. Nothing here writes state: the
    # only writes this verb makes are @roost-answered, the record below, and
    # the unsets roost_unblock_pane already makes after a decline.
    #
    # The bound is @roost-answer-timeout, in seconds, default 3, clamped to 1
    # to 30 the way @roost-send-turn-timeout is: by length first, then leading
    # zeros, then value, so no value can make the arithmetic slow or octal.
    # The slowest proof measured was 0.24 s.
    #
    # It is WALL CLOCK, not a count of polls. A poll is a 50 ms sleep plus two
    # to four tmux calls, and a transcript read while the marker is gone, so a
    # count of 20 per second made the default "3 s" take about 4 (review). The
    # clock is bash's $SECONDS, which costs no process: set to 0 here, it
    # reads N from N whole seconds after the second it was set in, so the
    # first tick can come in under a second. The loop runs while it is at
    # most the bound, so it ends between the bound and the bound plus one
    # second -- never before the bound, which is what the stderr line names.
    #
    # THE BOUND SAYS WHEN A PROOF MAY START, not when it must be finished. A
    # screen hold that STARTED inside the bound runs on past it to its full
    # ten polls, or until a stronger proof, a decline, a gone or dead pane, or
    # the marker coming back ends it. Ten polls took 0.92 s on a fast Mac and
    # more than the whole 3 s bound on a GitHub macOS runner, where each tmux
    # call is far slower: cutting the hold at the bound reported exit 10 there
    # for an answer that had landed (CI on #178). A marker that has not left
    # by the end of the bound is still exit 10, as before. The ceiling, the
    # bound plus 10 s, is there so that a tmux that has stopped answering
    # cannot hold this command for ever while a hold is open; ten polls need
    # nowhere near that on any machine measured.
    ans_timeout="$(t show-options -gqv @roost-answer-timeout 2>/dev/null || true)"
    case "$ans_timeout" in ''|*[!0123456789]*) ans_timeout=3 ;; esac
    [ "${#ans_timeout}" -gt 2 ] && ans_timeout=30
    while [ "${#ans_timeout}" -gt 1 ] && [ "${ans_timeout%${ans_timeout#?}}" = 0 ]; do
      ans_timeout="${ans_timeout#0}"
    done
    [ "$ans_timeout" -ge 1 ] || ans_timeout=1
    [ "$ans_timeout" -le 30 ] || ans_timeout=30
    confirmed="" wrong="" now_state="" screen_at="" gone=0
    i=0
    SECONDS=0
    while { [ "$SECONDS" -le "$ans_timeout" ] || [ -n "$screen_at" ]; } \
          && [ "$SECONDS" -le $((ans_timeout + 10)) ]; do
      cinfo="$(t display-message -p -t "$pane" '#{pane_id}|#{pane_dead}|#{@agent_state}|#{@roost-dialog}' 2>/dev/null || true)"
      # The pane is gone: nothing on it can confirm anything any more, and a
      # screen that had lost its marker before it went proves nothing.
      if [ "${cinfo%%|*}" != "$pane" ]; then gone=1; break; fi
      crest="${cinfo#*|}"
      # A DEAD pane is gone too, though tmux still answers for it: with
      # remain-on-exit on (a user's roost.conf can set it) a pane whose process
      # exited keeps its id, its blocked badge and a screen with no marker, so
      # without this its ten polls would confirm `screen` (review round 2).
      # Step 1 refuses the same pane as dead before the send; this is that
      # rule after it.
      if [ "${crest%%|*}" = 1 ]; then gone=1; break; fi
      crest="${crest#*|}"
      now_state="${crest%%|*}"; cdrec="${crest#*|}"
      if [ "$action" = deny ]; then
        case "$now_state" in
          working|done) wrong="it went on working: the dialog was approved, not by this call"; break ;;
        esac
        if [ "$now_state" = blocked ] && roost_unblock_pane "$pane"; then
          confirmed=transcript
          now_state="$(t show-options -pqv -t "$pane" @agent_state 2>/dev/null || true)"
          break
        fi
      else
        case "$now_state" in
          working|done) confirmed=state; break ;;
          blocked) ;;
          *) wrong="it no longer reads blocked (${now_state:-no badge}): the dialog was declined, not by this call"; break ;;
        esac
        case "$cdrec" in "$fp "*) ;; ?*) confirmed=dialog; break ;; esac
        if ! roost_answer_marked "$(t capture-pane -p -J -t "$pane" 2>/dev/null || true)"; then
          # The marker is gone and the badge still says blocked. For Claude,
          # a decline would write its three records into the transcript 5 to
          # 55 ms after the key (M1), so the screen proves an approval only
          # when they are not there.
          rec="$(t show-options -pqv -t "$pane" @roost-transcript 2>/dev/null || true)"
          since="$(t show-options -pqv -t "$pane" @agent_since 2>/dev/null || true)"
          rpath="${rec#* }"
          if [ "$ROOST_DIALOG_HARNESS" = claude ] && [ -n "$rec" ] && [ "${rec%% *}" = "$since" ] \
             && roost_claude_declined "$rpath" "$since"; then
            wrong="its transcript shows the dialog was declined, not by this call"; break
          fi
          # Ten polls, about half a second to a second depending on tmux's
          # speed: the hold the comment above explains.
          [ -n "$screen_at" ] || screen_at="$i"
          if [ $((i - screen_at)) -ge 10 ]; then confirmed=screen; break; fi
        else
          # The marker is back: a dialog is on screen again, so whatever was
          # seen before is not a proof any more.
          screen_at=""
        fi
      fi
      sleep 0.05
      i=$((i + 1))
    done
    # NO PROOF IS TAKEN AFTER THE LOOP. `screen` counts only once it has held
    # for the full ten polls, inside the loop, with the pane still there and
    # still reading blocked (§6). A hold the bound cut short, or a pane that
    # went away while its marker was gone, proves nothing, and is exit 10
    # below like any other answer nothing confirmed (review: an earlier
    # fallback here took both as `screen`, and a killed pane exited 0).
    [ "$gone" -eq 0 ] || wrong="the pane is gone or dead, so nothing can confirm it"

    # Step 11, the record (§8): one line per answer, appended after the
    # confirmation, whatever it found -- exit 10 included, because the key went
    # in either way. Off with ROOST_RECORD_DIR="", as replies are. The
    # description is the last field because it is free text.
    . "$ROOST_HOME/scripts/lib/roost-record.sh"
    roost_record_root
    if [ -n "$ROOST_RECORD_ROOT" ]; then
      rboot="$(t display-message -p '#{start_time}-#{pid}' 2>/dev/null || true)"
      if roost_record_pane_dir "$rboot" "$pane"; then
        rsock=""
        [ -d "$ROOST_RECORD_PANE_DIR" ] || rsock="$(t display-message -p '#{socket_path}' 2>/dev/null || true)"
        roost_record_put_answer "$ROOST_RECORD_PANE_DIR" \
          "$sent_at $fp $ROOST_DIALOG_HARNESS $ROOST_DIALOG_KIND $act_word $by forced=$force confirmed=${confirmed:-none} $blocked_on" \
          "$rsock" || true
      fi
    fi

    if [ -z "$confirmed" ]; then
      if [ -n "$wrong" ]; then
        echo "roost answer: the key was sent to '$pane', but $wrong" >&2
      else
        echo "roost answer: the key was sent to '$pane', and nothing confirmed it inside $ans_timeout s" >&2
      fi
      echo "roost answer: it was sent once and will not be resent. Do NOT answer again. Look: roost screen $pane" >&2
      exit 10
    fi
    if [ "$json" -eq 1 ]; then
      # `state` is the badge the confirming poll saw: null after a deny that
      # roost_unblock_pane cleared, which unsets the badge rather than set
      # one. `option` is the number for --option, null otherwise.
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      roost_jsonout_emit answer target s "$raw" pane s "$pane" action s "$action" \
        option i "$opt_n" fingerprint s "$fp" harness s "$ROOST_DIALOG_HARNESS" \
        kind s "$ROOST_DIALOG_KIND" confirmed s "$confirmed" state z "$now_state" \
        forced b "$force" \
        || roost_jsonout_fail answer
      exit 0
    fi
    said="$action"; [ "$action" != option ] || said="option $opt_n"
    printf '%s %s %s\n' "$pane" "$said" "$fp"
    exit 0
    ;;
  read)
    # --render (-r) is accepted only in front of the target, matching send's
    # --force above — but for a different reason. Here the flag is unambiguous
    # wherever it appears, because read's positionals are a target and a line
    # count and neither can look like it; the rule is kept anyway so the two
    # commands are learned once, and so LINES stays the third word it has
    # always been rather than moving when a flag is added after the target.
    #
    # --json (#41) lives in the same slots, under the same rules: before the
    # target, once. It cannot be combined with --render, and that is refused
    # rather than resolved: JSON is for a program and --render is for a person,
    # so a caller passing both has made a mistake that neither choice would fix.
    render=0
    json=0
    # --turn N (#42) reads one kept turn. It is taken out of the flag slots
    # FIRST, wherever it sits among them — before or after -r/--json — and the
    # flag handling below then runs on what is left exactly as it always has,
    # so every message it prints is unchanged down to the byte. Like the other
    # flags it goes before the target, once; after the target it is refused by
    # the sweep further down, as any flag is.
    turn="" turn_given=0
    read_turn_value() {
      local n="${1#-}"
      case "$n" in ''|*[!0-9]*|0*) n="" ;; esac
      if [ -z "$n" ] || [ "${#n}" -gt 15 ]; then
        echo "roost read: --turn needs a turn number — N counts from the first turn, -N back from the newest (-1 is the newest)." >&2
        echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
        exit 1
      fi
      turn="$1"; turn_given=1
    }
    case "${2:-}" in
      --turn)
        read_turn_value "${3:-}"
        shift 3; set -- read "$@" ;;
      --render|-r|--json)
        if [ "${3:-}" = "--turn" ]; then
          read_turn_value "${4:-}"
          _flag="$2"; shift 4; set -- read "$_flag" "$@"
        fi ;;
    esac
    if [ "$turn_given" = 1 ]; then
      case "${2:-}|${3:-}" in
        --turn\|*|--render\|--turn|-r\|--turn|--json\|--turn)
          echo "roost read: '--turn' is not valid here — --turn may be given once, before the target." >&2
          echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
          exit 1 ;;
      esac
    fi
    case "${2:-}" in
      # An unknown flag in the flag slot used to fall through and be treated as
      # the TARGET, which failed later with an empty read and exit 1 -- a typo
      # like `--renderr` came back as tmux's "can't find session" instead.
      # Refused by name here, so the message names the typo rather than the
      # session it was mistaken for.
      # No `-[0-9]*` exemption: slot 2 is the flag-or-TARGET slot, and no
      # target begins with a dash. `roost read -5` used to take `-5` as the
      # target and fall through to the screen fallback for it, while
      # `roost read -r -5` refused the same word -- two slots disagreeing
      # about the same input. Found by review.
      --render|-r|--json) ;;
      -*)
        echo "roost read: unknown flag '$2'." >&2
        echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
        exit 1 ;;
    esac
    # Consumed once, and a SECOND one is refused rather than absorbed. The
    # first version checked for an unknown flag once, before the shift, so a
    # repeated `-r` landed in the target slot, was never looked at again, and
    # became the target -- an empty read at exit 1 that surfaced as tmux's
    # "can't find session". Found by review.
    #
    # A loop that consumed flags until they ran out was tried and removed: it
    # was dead code, because the second flag is an error rather than something
    # to consume. A mutation that made the loop run only once turned nothing
    # red, which is what exposed it.
    case "${2:-}" in
      --render|-r|--json)
        if [ "$2" = "--json" ]; then json=1; else render=1; fi
        # Drop "read" and the flag, then put the subcommand back so every
        # positional reference below keeps its original number.
        shift 2
        set -- read "$@"
        # The one flag pair that is refused for what it MEANS rather than for
        # being repeated. Checked before the repeat refusal below, so the
        # message names the real mistake.
        case "${2:-}" in
          --render|-r)
            if [ "$json" -eq 1 ]; then
              echo "roost read: --json and --render cannot be combined — JSON is for programs, --render is for people." >&2
              echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
              exit 1
            fi ;;
          --json)
            if [ "$render" -eq 1 ]; then
              echo "roost read: --json and --render cannot be combined — JSON is for programs, --render is for people." >&2
              echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
              exit 1
            fi ;;
        esac
        # The word after a consumed flag is a flag slot too. A second --render,
        # or a typo following a good flag, must not fall through to the target.
        # No `-[0-9]*` exemption here, unlike the LINES sweep below: a line
        # count comes AFTER the target, never before it, so `roost read -r -3
        # TGT` is malformed and used to make `-3` the target.
        case "${2:-}" in
          -*)
            # The --render wording is unchanged down to the byte; only a
            # repeat after --json gets a sentence that names --json.
            if [ "$json" -eq 1 ]; then
              echo "roost read: '$2' is not valid here — --json may be given once, before the target." >&2
            else
              echo "roost read: '$2' is not valid here — --render/-r may be given once, before the target." >&2
            fi
            echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
            exit 1 ;;
        esac
        ;;
    esac
    need_arg "${2:-}" "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]"; raw="$2"; lines="${3:-40}"
    # A flag AFTER the target is refused rather than swallowed. It used to land
    # in $lines: with a recorded reply that printed the raw text at exit 0 with
    # no warning (the flag looked like it worked and did nothing), and on the
    # fallback path it reached `tail -n --render` and produced `tail: illegal
    # offset` with no output at all. Both were found by review.
    #
    # EVERY remaining word is checked, not just the LINES slot. The first
    # version read $3 alone, so `roost read TGT 20 --render` was swallowed
    # exactly as `roost read TGT --render` had been -- the same bug moved one
    # word right. Found by both reviewers, separately.
    #
    # A NEGATIVE INTEGER IS NOT A FLAG. `tail -n -3` has always meant "the last
    # 3 lines", so `roost read TGT -3` worked before this guard existed and the
    # first version broke it. The test is therefore "starts with a dash and is
    # not a number", not "starts with a dash".
    for _arg in "${@:3}"; do
      case "$_arg" in
        -[0-9]*) continue ;;          # a negative line count, which tail takes
        -*)
          echo "roost read: '$_arg' looks like a flag, and flags go BEFORE the target." >&2
          echo "usage: roost read [-r|--render] [SESSION:]WINDOW [LINES]" >&2
          exit 1 ;;
      esac
    done
    tgt="$(target "$raw")"
    # --turn N: one kept turn, from the record only (#42). It never falls back
    # to the screen — the caller asked for a particular turn, and the screen is
    # not it — and it carries no staleness notice, because the caller chose the
    # turn. A turn that is not there says whether it was pruned (ROOST_RECORD_KEEP)
    # and which turns are kept: a bound is reported, never silent.
    if [ "$turn_given" = 1 ]; then
      ROOST_RECORD_COUNT=0
      if record_for "$raw" "$tgt"; then
        if [ "$RF_STATE" -eq 0 ]; then
          roost_record_scan "$RF_DIR/replies"
        else
          record_warn read "$raw"
        fi
      fi
      if [ "$ROOST_RECORD_COUNT" -eq 0 ]; then
        echo "roost read: no recorded turns for '$raw'." >&2
        exit 1
      fi
      roost_record_keep
      rt_min="$ROOST_RECORD_MIN" rt_max="$ROOST_RECORD_MAX"
      if [ "$turn" -gt 0 ]; then
        want="$turn"
      else
        # Counting back walks the turns that EXIST, newest first, so a gap a
        # human made by deleting a file is stepped over rather than counted.
        want=""
        if [ "${turn#-}" -le "$ROOST_RECORD_COUNT" ]; then
          roost_record_back "$RF_DIR" "${turn#-}"
          want="$ROOST_RECORD_BACK"
        fi
      fi
      if [ -n "$want" ]; then
        roost_record_turn_file "$RF_DIR" "$want"
        roost_record_read "$ROOST_RECORD_FILE" || want=""
      fi
      if [ -z "$want" ]; then
        if { [ "$turn" -gt 0 ] && [ "$turn" -lt "$rt_min" ]; } \
           || { [ "$turn" -lt 0 ] && [ "${turn#-}" -gt "$ROOST_RECORD_COUNT" ] && [ "$rt_min" -gt 1 ]; }; then
          echo "roost read: turn $turn of '$raw' was pruned — turns $rt_min to $rt_max are kept (ROOST_RECORD_KEEP=$ROOST_RECORD_KEEP_N)." >&2
        else
          echo "roost read: turn $turn of '$raw' is not recorded — turns $rt_min to $rt_max are kept." >&2
        fi
        exit 1
      fi
      if [ "$RF_LIVE" = 0 ]; then
        echo "roost read: '$raw' is gone — this is its recorded turn $want." >&2
      fi
      # An interrupted turn (#95) is an EMPTY file with an `outcome` sidecar:
      # the empty reply is printed, as any turn's is, and stderr says why it
      # is empty, so an empty line is never mistaken for an agent that said
      # nothing.
      #
      # An interrupt that ended a turn held by background work (#97) saves
      # the turn's main reply instead of an empty file, so the "no reply"
      # half of the notice is said only when the text really is empty.
      roost_record_get_turn_field "$RF_DIR" "$want" outcome || true
      if [ "$ROOST_RECORD_FIELD" = interrupted ]; then
        if [ -n "$ROOST_RECORD_TEXT" ]; then
          echo "roost read: turn $want of '$raw' was interrupted; this is the main reply it had given." >&2
        else
          echo "roost read: turn $want of '$raw' was interrupted, and recorded no reply." >&2
        fi
      fi
      # A turn whose agent exited while its background work held it (#188):
      # the main reply is all there is, and the work never reported back.
      if [ "$ROOST_RECORD_FIELD" = died ]; then
        if [ -n "$ROOST_RECORD_TEXT" ]; then
          echo "roost read: turn $want of '$raw' died: the agent exited before its background work finished; this is the main reply it had given." >&2
        else
          echo "roost read: turn $want of '$raw' died: the agent exited before its background work finished, and recorded no reply." >&2
        fi
      fi
      # A turn whose agent exited inside its shell (#105, step 5): the
      # dead-agent clear files it with its own word, because #188's sentence
      # above is about background work, and this agent simply exited. Its
      # text is the held main reply when the pane was held, else empty.
      if [ "$ROOST_RECORD_FIELD" = died_in_shell ]; then
        if [ -n "$ROOST_RECORD_TEXT" ]; then
          echo "roost read: turn $want of '$raw' died: the agent exited inside its shell before the turn finished; this is the main reply it had given." >&2
        else
          echo "roost read: turn $want of '$raw' died: the agent exited inside its shell before the turn finished, and recorded no reply." >&2
        fi
      fi
      if [ "$json" -eq 1 ]; then
        . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
        json_state=""
        if [ "$RF_LIVE" = 1 ]; then
          json_state="$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)"
        fi
        # sent_by (#56): the label `send --from` kept beside this turn, from
        # its `.sent_by` sidecar; null when the turn has none. Read only for
        # --json, so the human mode's file reads are unchanged.
        roost_record_get_turn_field "$RF_DIR" "$want" sent_by || true
        # `final` and `background` (#97): a kept turn is a final reply by
        # construction -- the hold writes no turn file -- and no count applies.
        roost_jsonout_emit read target s "$raw" pane z "$RF_PANE" source s record state z "$json_state" \
          stale b 0 error_reason z "" turn i "$want" text t "$ROOST_RECORD_TEXT" \
          sent_by z "$ROOST_RECORD_FIELD" final b 1 background i "" || roost_jsonout_fail read
        exit 0
      fi
      if [ "$render" -eq 1 ]; then
        printf '%s\n' "$ROOST_RECORD_TEXT" | render_stdin
      else
        printf '%s\n' "$ROOST_RECORD_TEXT"
      fi
      exit 0
    fi
    # A closed pane (#42): `roost read %N` on a pane that is gone prints its
    # last kept reply, and says on stderr that the pane is gone. Only a %N, and
    # only on the boot of the server `t` talks to — see record_for. A pane that
    # never had a record falls through to exactly today's failure, and so does a
    # record this roost cannot use, after one warning line.
    case "$raw" in
      %[0-9]*)
        if record_for "$raw" "$tgt" && [ "$RF_LIVE" = 0 ]; then
          if [ "$RF_STATE" -eq 0 ]; then
            roost_record_scan "$RF_DIR/replies"
            if [ "$ROOST_RECORD_COUNT" -gt 0 ]; then
              roost_record_turn_file "$RF_DIR" "$ROOST_RECORD_MAX"
              if roost_record_read "$ROOST_RECORD_FILE"; then
                echo "roost read: '$raw' is gone — this is its last recorded reply (turn $ROOST_RECORD_MAX)." >&2
                if [ "$json" -eq 1 ]; then
                  . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
                  # The last kept turn's sent_by (#56), as on the --turn path.
                  roost_record_get_turn_field "$RF_DIR" "$ROOST_RECORD_MAX" sent_by || true
                  roost_jsonout_emit read target s "$raw" pane z "$RF_PANE" source s record state z "" \
                    stale b 0 error_reason z "" turn i "$ROOST_RECORD_MAX" text t "$ROOST_RECORD_TEXT" \
                    sent_by z "$ROOST_RECORD_FIELD" final b 1 background i "" || roost_jsonout_fail read
                  exit 0
                fi
                if [ "$render" -eq 1 ]; then
                  printf '%s\n' "$ROOST_RECORD_TEXT" | render_stdin
                else
                  printf '%s\n' "$ROOST_RECORD_TEXT"
                fi
                exit 0
              fi
            fi
          else
            record_warn read "$raw"
          fi
        fi ;;
    esac
    # Prefer what the agent SAID over what its pane is DRAWING. An adapter
    # (the Claude Stop hook, adapters/opencode/roost.js) stamps @roost-reply
    # with the turn's last assistant message before it stamps the state, so a
    # caller following the documented `wait-done` then `read` idiom cannot land
    # in the gap between the two and miss it.
    #
    # show-options -p, NOT display-message '#{@roost-reply}': -p reads PANE
    # scope only, where the adapters write. A format lookup falls back
    # pane -> window -> global, so a stray outer-scope @roost-reply — the exact
    # accident that @agent_state has a `set -gu` in tmux/roost.conf to undo —
    # would be served here as if it were this agent's own reply.
    #
    # Verified on tmux 3.6: a stored value containing newlines, a tab,
    # `#{pane_id}`, `#[fg=red]` and a literal `%` comes back byte-identical
    # under od -c. tmux does not re-expand a substituted option value, so an
    # agent reply containing tmux format syntax is safe here.
    #
    # A `blocked` left behind by a declined Claude dialog (#38) is offered to
    # the helper `send` and `wait-done` use BEFORE the reply is read, so read
    # agrees with them whether or not a reply is stored. A clear also unsets
    # @roost-reply — a declined turn fired no Stop, so what was stored is the
    # previous turn's — and read then falls back to the screen and says so.
    #
    # And a `working` left by an interrupted turn (#95) is offered to
    # roost_interrupted_pane the same way: it clears the stale badge and the
    # previous turn's reply, and read falls back to the screen and says so.
    #
    # Both are asked only after roost_died_pane (#105), the check `send` and
    # `wait-done` share: a busy badge whose agent died inside its shell is
    # unset and recorded as `died`, and read then answers for a pane with no
    # badge -- the previous turn's reply cleared with it, a held main reply
    # kept and said to be a dead agent's.
    case "$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)" in
      blocked) roost_died_pane "$tgt" || roost_unblock_pane "$tgt" || true ;;
      working) roost_died_pane "$tgt" || roost_interrupted_pane "$tgt" || true ;;
    esac
    reply="$(t show-options -p -t "$tgt" -qv @roost-reply 2>/dev/null || true)"
    if [ -n "$reply" ]; then
      # A reply recorded at the end of turn N is still on the pane during turn
      # N+1. It is not cleared at the turn start — that would throw away a
      # reply the caller was merely slow to collect — so say when it is not
      # current instead. @agent_state already answers this exactly: a pane that
      # is working or blocked has not finished the turn whose reply this would
      # be, so whatever is stored came from an earlier one.
      state="$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)"
      # A pane HELD at working by its own background work (#97) is the one
      # exception to "working means the reply is from an earlier turn": the
      # Claude Stop hook stored this turn's MAIN reply and @roost-background
      # as "<@agent_since> N" beside it, and the turn is not over only because
      # N tasks it started still run in the pane (the turn-over design, step
      # 1, §10 item 5). The record counts only while its first word equals the
      # pane's @agent_since -- the @roost-transcript rule -- so a record left by
      # an earlier stamp can never make an old reply read as current. `?` is a
      # count roost could not read (a malformed list, held on purpose): still
      # this turn's main reply, and null in the JSON rather than 0.
      #
      # `blocked` too: a dialog inside a held turn carries the record onto its
      # stamp (scripts/roost-agent-state, hold_carry), and the reply on the
      # pane is still that turn's main reply.
      read_held=0 read_bg="" json_final=1 json_bg=""
      if [ "$state" = working ] || [ "$state" = blocked ]; then
        read_bg_rec="$(t display-message -p -t "$tgt" '#{@agent_since}|#{@roost-background}' 2>/dev/null || true)"
        read_bg_since="${read_bg_rec%%|*}"; read_bg_rec="${read_bg_rec#*|}"
        case "$read_bg_since" in ''|*[!0-9]*) read_bg_since="" ;; esac
        # The held test is roost_hold's (scripts/lib/roost-jsonout.sh): a
        # malformed record is no hold, so the reply reads stale as it would
        # with no record at all.
        . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
        if roost_hold "$read_bg_since" "$read_bg_rec"; then
          read_bg="$ROOST_HOLD_COUNT"
          read_held=1 json_final=0
          [ "$read_bg" = "?" ] || json_bg="$read_bg"
        fi
      fi
      # `error` belongs here alongside working and blocked, and for a different
      # reason than theirs. Those two mean the turn has not finished, so
      # whatever is stored predates it. `error` means the turn finished BADLY,
      # and every adapter drops the half-built reply on that path
      # (adapters/opencode/roost.js and its copilot and pi equivalents all say
      # so) precisely because a failed turn has no answer to publish. So a
      # reply sitting on an errored pane cannot be that turn's, either — and
      # this is the more ordinary route of the two, because a provider outage
      # is an ordinary event where an interrupted turn is not.
      if [ "$read_held" = 1 ]; then
        # One line, on stderr like the stale notice, and in its place: the
        # answer is ready and the turn is not over. `?` reads as "tasks still
        # running" with no number, which is all roost knows then.
        if [ "$read_bg" = "?" ]; then
          echo "roost read: '$raw' main reply; tasks still running — the turn is not over yet." >&2
        else
          echo "roost read: '$raw' main reply; $(plural "$read_bg" task) still running — the turn is not over yet." >&2
        fi
      else
        case "$state" in
          working|blocked|error)
            echo "roost read: '$raw' is $state — this reply is from its previous turn." >&2 ;;
          '')
            # No badge, and the Claude SessionEnd hook's `died` for this
            # stamp (#188): the reply is the main reply of a turn whose agent
            # exited while its background work held it. It is this turn's,
            # so it is not stale; say that the work never reported back. One
            # read, only for a pane with no badge.
            read_end="$(t display-message -p -t "$tgt" '#{@agent_since}|#{@roost-ended}' 2>/dev/null || true)"
            read_end_since="${read_end%%|*}"
            case "$read_end_since" in ''|*[!0-9]*) read_end_since="" ;; esac
            if [ -n "$read_end_since" ] && [ "${read_end#*|}" = "$read_end_since died" ]; then
              echo "roost read: '$raw' died: the agent exited before its background work finished; this is the main reply it had given." >&2
            fi ;;
        esac
      fi
      # The kept copy of this reply (#42). @roost-reply-turn names the turn file
      # the writer made with it, and roost_record_match lets that file stand in
      # for the pane value only while the pane still holds exactly what tmux
      # stored for that turn (its .pane sidecar). So a reply prints whole and as
      # the agent wrote it — including on tmux 3.4/3.5a, which store some bytes
      # rewritten — and a pane value set any other way afterwards (by hand, by a
      # writer that recorded nothing, by an older roost) is printed as it is.
      # The pane wins.
      json_turn=""
      if record_for "$raw" "$tgt" && [ "$RF_LIVE" = 1 ]; then
        ptr="$(t show-options -p -t "$tgt" -qv @roost-reply-turn 2>/dev/null || true)"
        case "$ptr" in ''|*[!0-9]*|0*) ptr="" ;; esac
        if [ -n "$ptr" ] && [ "${#ptr}" -le 15 ]; then
          if [ "$RF_STATE" -eq 0 ]; then
            # Compared as a UTF-8 client (-u), the way the writer read it back:
            # without a UTF-8 locale outside tmux, a plain client PRINTS newline,
            # tab and non-ASCII as `_`, and the two would never be equal. $reply
            # itself — what a match does not replace — is left exactly as
            # this command has always printed it.
            reply_u="$(t -u show-options -p -t "$tgt" -qv @roost-reply 2>/dev/null || true)"
            if roost_record_match "$reply_u" "$RF_DIR" "$ptr"; then
              reply="$ROOST_RECORD_TEXT"
              json_turn="$ptr"
            fi
          else
            record_warn read "$raw"
          fi
        fi
      fi
      # --json: the values this branch has already read, as a document. The
      # notice above has gone to stderr either way, and `stale` is that same
      # decision as a field. The pane id and the error reason are the two extra
      # reads, both silenced: the human mode reads neither here, and neither
      # may add a line to stderr the human mode would not print.
      if [ "$json" -eq 1 ]; then
        . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
        json_pane="$(t display-message -p -t "$tgt" '#{pane_id}' 2>/dev/null || true)"
        json_stale=0 json_why=""
        case "$state" in working|blocked|error) json_stale=1 ;; esac
        # A held pane's main reply is THIS turn's: not stale, not final (#97).
        [ "$read_held" = 1 ] && json_stale=0
        if [ "$state" = "error" ]; then
          json_why="$(t show-options -p -t "$tgt" -qv @roost-error-reason 2>/dev/null || true)"
        fi
        # tmux 3.4 and 3.5a store control bytes and invalid UTF-8 as escape
        # text that cannot be decoded exactly (roost_jsonout_looks_escaped says
        # why). The text is left as stored -- what the human mode prints -- and
        # marked lossy when it could be such a rewrite. The server is asked only
        # when the text looks escaped, so an ordinary reply costs nothing more.
        json_text_kind=t
        # Text served from the kept turn file is the agent's raw bytes, never a
        # value tmux rewrote, so the "may be tmux's escape text" marking below
        # applies only to a pane value printed as it is.
        if [ -z "$json_turn" ] && roost_jsonout_looks_escaped "$reply" && roost_jsonout_server_escapes "$tgt"; then
          json_text_kind=T
        fi
        # sent_by (#56) belongs to the TURN, so it is read only when the pane
        # value was matched to a kept turn above: a reply the pane holds that
        # no turn file agrees with has no turn, and so no sender, to report.
        json_sent_by=""
        if [ -n "$json_turn" ]; then
          roost_record_get_turn_field "$RF_DIR" "$json_turn" sent_by || true
          json_sent_by="$ROOST_RECORD_FIELD"
        fi
        roost_jsonout_emit read target s "$raw" pane z "$json_pane" source s reply state z "$state" \
          stale b "$json_stale" error_reason z "$json_why" turn i "$json_turn" text "$json_text_kind" "$reply" \
          sent_by z "$json_sent_by" final b "$json_final" background i "$json_bg" || roost_jsonout_fail read
        exit 0
      fi
      # $lines is deliberately NOT applied. A recorded reply is returned whole:
      # `tail -n` on it would chop the BEGINNING off a long answer, and
      # skills/roost/SKILL.md passes 40 today, which would silently truncate
      # anything longer. N describes the screen, and only the screen.
      # Branch rather than always piping: with --render absent the reply must
      # leave this command by exactly the printf it always has, unchanged down
      # to the byte, because that is what callers diff against.
      if [ "$render" -eq 1 ]; then
        printf '%s\n' "$reply" | render_stdin
      else
        printf '%s\n' "$reply"
      fi
      exit 0
    fi
    # Never return nothing. An empty result would be a worse failure than the
    # chrome this command was fixed to stop returning — the caller cannot tell
    # "no reply recorded" from "the agent said nothing". Fall back to the
    # screen, and say so: a SILENT fallback would re-create the original bug
    # quietly, which is the one outcome ruled out.
    #
    # stderr, not stdout, for three reasons that all have callers today:
    # tests/test-coordination.sh:242 and tests/test-panes.sh:31 both pipe this
    # into `grep -q`; the site's `for w in api web worker; do roost read "$w";
    # done` idiom would gain a notice per agent; and a shell pane — which
    # legitimately has no reply channel at all — would otherwise have this
    # prepended to every single read.
    echo "roost read: no recorded reply for '$raw' — showing the pane's screen instead." >&2
    # The second line is a GUESS at why, and on an errored pane with a recorded
    # reason the guess is wrong twice: the pane has an adapter, and its turn
    # finished. A codex dead turn (#39) lands exactly here, because it clears
    # its reply — so say the reason the adapter recorded, which is what a
    # caller that just got exit 1 from `wait-done` needs to see again here.
    # Pane scope only (-p), for the reason given at the @roost-reply read above.
    why="$(t show-options -p -t "$tgt" -qv @roost-error-reason 2>/dev/null || true)"
    if [ -n "$why" ] && [ "$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)" = "error" ]; then
      echo "roost read: ('$raw' is in error state: $why; roost screen reads the screen without this notice)" >&2
    else
      echo "roost read: (that pane has no roost adapter, or its turn has not finished; roost screen reads the screen without this notice)" >&2
    fi
    # THE FALLBACK IS NOT RENDERED, and this is a deliberate reversal of the
    # obvious reading of the flag. A recorded reply is markdown because an
    # agent wrote it. A pane's SCREEN is not: it is terminal output, and a
    # markdown renderer DELETES the characters in it that look like syntax.
    # Measured against the real preen:
    #
    #   CANARY <ttyUSB0> port  ->  CANARY  port    (an HTML-ish tag, gone)
    #   2*3*4 = 24             ->  234 = 24        (*3* read as emphasis)
    #   rate _low_ now         ->  rate low now    (underscores eaten)
    #
    # Silently dropping bytes out of the one output a human reads to work out
    # what a pane is doing is a worse trade than leaving it uncoloured -- and
    # it is the exact class of quiet loss this command exists to stop, since
    # the caller cannot tell a deleted token from one the pane never printed.
    #
    # Said on stderr rather than done silently, for the reason the previous
    # version of this comment gave: a flag that appears to stop working looks
    # like a broken renderer. So it is stated, on the stream that is not the
    # caller's pipe.
    if [ "$render" -eq 1 ]; then
      echo "roost read: the screen is not markdown, so it is not rendered — a renderer would delete <tags>, *stars* and _underscores_ that are the pane's own output." >&2
    fi
    # --json: the screen as a document, after the same notices on stderr.
    # roost_jsonout_screen fails where screen_dump fails, except on a blank
    # screen, which is a valid empty document at exit 0 -- see that function.
    if [ "$json" -eq 1 ]; then
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      roost_jsonout_screen "$tgt" "$lines" || exit 1
      json_pane="$(t display-message -p -t "$tgt" '#{pane_id}' 2>/dev/null || true)"
      json_state="$(t display-message -p -t "$tgt" '#{@agent_state}' 2>/dev/null || true)"
      json_why=""
      if [ "$json_state" = "error" ]; then json_why="$why"; fi
      roost_jsonout_emit read target s "$raw" pane z "$json_pane" source s screen state z "$json_state" \
        stale b 0 error_reason z "$json_why" turn i "" text t "$ROOST_JSONOUT_TEXT" \
        sent_by z "" final b 1 background i "" || roost_jsonout_fail read
      exit 0
    fi
    screen_dump "$tgt" "$lines"
    ;;
  screen)
    # What `read` did before it learned to prefer a recorded reply, under a
    # name that promises only what capture-pane can deliver. AGENTS.md section 7
    # and the issue doc both argue `read` over-promises; this is the honest
    # half. skills/roost/SKILL.md's "roost read it to see what's stuck"
    # guidance points here, because a stuck TUI is exactly the case where the
    # rendering IS the thing you want, chrome included.
    # --json (#41) is the one flag the target slot accepts, once. It is taken
    # off the front and the positionals renumbered, so everything below reads
    # $2 and $3 as it always has.
    json=0
    if [ "${2:-}" = "--json" ]; then
      json=1
      shift 2
      set -- screen "$@"
    fi
    need_arg "${2:-}" "usage: roost screen [SESSION:]WINDOW [LINES]"; raw="$2"; lines="${3:-40}"
    # No target begins with a dash, so a word that does is a flag or a typo.
    # `roost read` refuses it; without this, `roost screen -5` took `-5` as a
    # target and read a pane for it, so the two commands disagreed about the
    # same input. Found by review.
    # Both slots, not just the target. Fixing slot 2 alone left
    # `roost screen TGT --render` reaching `tail -n --render` and printing
    # `tail: illegal offset` -- the exact leak that was removed from `read`,
    # still live here under a commit claiming the two commands agreed. A
    # negative LINES is allowed in the count slot for the reason read's is:
    # `tail -n -3` means "the last 3 lines".
    case "$raw" in
      -*)
        if [ "$json" -eq 1 ]; then
          echo "roost screen: '$raw' is not a target — --json may be given once, before the target." >&2
        else
          echo "roost screen: '$raw' is not a target — roost screen takes no flags." >&2
        fi
        echo "usage: roost screen [SESSION:]WINDOW [LINES]" >&2
        exit 1 ;;
    esac
    for _arg in "${@:3}"; do
      case "$_arg" in
        -[0-9]*) continue ;;
        -*)
          # After --json the old sentence would be false -- screen now takes one
          # flag -- so that case names where it goes. Without --json the wording
          # is unchanged down to the byte.
          if [ "$json" -eq 1 ]; then
            echo "roost screen: '$_arg' is not valid here — --json goes before the target, once." >&2
          else
            echo "roost screen: '$_arg' is not valid — roost screen takes no flags." >&2
          fi
          echo "usage: roost screen [SESSION:]WINDOW [LINES]" >&2
          exit 1 ;;
      esac
    done
    if [ "$json" -eq 1 ]; then
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      roost_jsonout_screen "$(target "$raw")" "$lines" || exit 1
      json_pane="$(t display-message -p -t "$(target "$raw")" '#{pane_id}' 2>/dev/null || true)"
      # A negative LINES is reported as its count, the way tail reads it. Any
      # other spelling tail accepts (`+3`, "from line 3") is not a count, and
      # roost_jsonout_int turns it into null.
      json_lines="${lines#-}"
      # A count tail honours with leading zeros (`007`) is still a count, so it
      # is reported as 7 rather than as null. The zeros are stripped as TEXT,
      # not with $((10#...)): bash arithmetic wraps a 20-digit count to a
      # plausible-looking wrong number, and GNU tail accepts such a count. Past
      # 18 digits it is reported as null (roost_jsonout_int turns "" into null)
      # rather than as a value JSON consumers may not hold exactly. Found by review.
      case "$json_lines" in
        ''|*[!0-9]*) ;;
        *)
          json_lines="${json_lines#"${json_lines%%[!0]*}"}"
          [ -n "$json_lines" ] || json_lines=0
          [ "${#json_lines}" -le 18 ] || json_lines="" ;;
      esac
      roost_jsonout_emit screen target s "$raw" pane z "$json_pane" lines i "$json_lines" \
        text t "$ROOST_JSONOUT_TEXT" || roost_jsonout_fail screen
      exit 0
    fi
    screen_dump "$(target "$raw")" "$lines"
    ;;
  reply)
    shift
    # The public write end of the reply channel: an agent records what it just
    # said, so a sibling's `roost read` gets content instead of a screen. The
    # adapters use it (adapters/opencode/roost.js), and it completes the story
    # `roost state` already tells a harness with no adapter — badge yourself,
    # and post your reply.
    #
    # TEXT COMES FROM ARGV OR FROM STDIN, and which one is decided below, after
    # the guards. It used to be argv and never stdin, because `roost reply` is a
    # documented public command a human can type and an unconditional stdin read
    # would block forever on a terminal. The Claude hook path has always read
    # stdin instead, but only behind an explicit flag — see
    # scripts/roost-agent-state.
    #
    # That cost a bug (#86). Linux caps a SINGLE argument at 131072 bytes
    # (MAX_ARG_STRLEN), separately from the far larger ARG_MAX total, so an
    # adapter publishing a long turn as `execFile("roost", ["reply", text])`
    # fails at exec: roost never runs, nothing is recorded, and a sibling's
    # `roost read` scrapes the screen instead. Measured in ubuntu:24.04, kernel
    # 6.11.11 aarch64, `getconf ARG_MAX` 2097152 — a 131071-byte argument exits
    # 0 and a 131072-byte one exits 126 with "Argument list too long".
    #
    # macOS has no per-argument cap at all: only the ARG_MAX total applies.
    # Measured on Darwin 25.3.0 arm64, `getconf ARG_MAX` 1048576, by binary
    # search: 1041390 bytes accepted, 1041391 refused, the difference being the
    # caller's own environment. So `roost reply <200 KB>` is fine here and dies
    # on the CI image, which is exactly why this was not found by running it.
    #
    # Stdin has neither limit. That is the same reasoning `send` already uses
    # when it loads its message into a tmux buffer over stdin rather than
    # putting it on a command line — see the transport comment there.
    [ -n "${TMUX:-}" ] || exit 0
    [ -n "${TMUX_PANE:-}" ] || exit 0
    # Silent no-op unless the caller is a pane on THIS server — same contract as
    # `roost state`, so an adapter is safe to leave installed when its agent
    # runs somewhere else.
    #
    # The guard survives the socket-resolution fix above, and is not made
    # redundant by it. With $ROOST_SOCKET unset the two now agree by
    # construction — `t` is already pointed at the caller's own server — but an
    # explicit $ROOST_SOCKET still outranks $TMUX, so a caller in a pane on
    # server B with the seam naming server A reaches this line with a pane id
    # that means something different on each. That is exactly the case below.
    #
    # The check is on the server PID, not on the socket path. $TMUX is
    # "<socket-path>,<pid>,<session>", so the pid is exact and needs no
    # normalising; comparing paths instead would have to reconcile a socket
    # NAME (-L roost) against the absolute path tmux reports, and on macOS
    # /tmp vs /private/tmp on top of that. Getting that wrong fails in the
    # worst direction: $TMUX_PANE from another server is a perfectly valid
    # pane id HERE, so an unguarded write lands on a real, unrelated pane and
    # nothing reports an error.
    caller_pid="${TMUX#*,}"; caller_pid="${caller_pid%%,*}"
    # The server's start time rides on the same read as its pid: it is the other
    # half of the boot key the record below is filed under, and a second round
    # trip for it would be spent on every turn of every adapter.
    our="$(t display-message -p '#{pid} #{start_time}' 2>/dev/null || true)"
    our_pid="${our%% *}"
    [ -n "$our_pid" ] && [ "$caller_pid" = "$our_pid" ] || exit 0

    # Now resolve the text, AFTER the guards. Order matters: a `roost reply`
    # that is not in a pane on this server is a silent no-op by contract — an
    # adapter is safe to leave installed when its agent runs somewhere else —
    # and reaching a `cat` before those guards would turn that no-op into a
    # wait on a stdin nobody is going to close. The cost is that a caller
    # piping into a roost that no-ops sees EPIPE rather than a drained pipe;
    # that is the cheaper failure, because it is loud and it is not a hang.
    #
    # Stdin is read when the first argument is `-` or `--stdin`, or when there
    # is no argument at all. Three spellings rather than one because an adapter
    # with a stream and no argv to build reaches for the bare form, and a shell
    # caller reaches for `-`.
    #
    # Only the FIRST argument, and only exactly those two spellings. A reply
    # that merely begins with a dash ("-- not a flag") is text. A reply that is
    # literally "-" has to arrive on stdin, the same convention every other
    # tool with a `-` argument keeps.
    #
    # The tty check is what keeps the old promise. A human who types `roost
    # reply` and presses Enter gets the silent no-op they got before, not a
    # `cat` waiting for ^D. Typing `-` or `--stdin` at a terminal is a
    # different mistake — that caller asked for stdin in so many words — so it
    # is refused out loud instead of quietly recording nothing.
    #
    # What is NOT covered: a bare `roost reply`, inside a roost pane, whose
    # stdin is an open pipe nobody ever closes, waits. There is no check that
    # tells that apart from a slow writer. Pass the text as an argument, or
    # close the pipe.
    reply_src=argv
    if [ "$#" -eq 0 ]; then
      reply_src=implicit
    else
      case "$1" in
        -|--stdin) reply_src=flag; shift ;;
      esac
    fi
    if [ "$reply_src" = argv ]; then
      reply_text="$*"
    else
      if [ "$reply_src" = flag ] && [ "$#" -gt 0 ]; then
        echo "usage: roost reply - < FILE   (with - or --stdin the reply is read from stdin, so no other argument is taken)" >&2; exit 2
      fi
      if [ ! -t 0 ]; then
        # The `printf x` sentinel is not decoration. A plain `$(cat)` strips
        # EVERY trailing newline, and the argv form does not — `$*` is handed
        # to the record untouched — so the same reply published the two ways
        # landed on disk as two different files, and the adapters had just
        # been moved from the path that kept them onto the path that did not.
        # The sentinel is the idiom roost_record_read already uses for exactly
        # this, in scripts/lib/roost-record.sh; measured on tmux 3.6 with an
        # 8-byte body `answer\n\n`, the kept turn file went from 6 bytes to 8.
        #
        # This fixes the bytes that are STORED, and nothing else moves:
        # `roost read` and `roost read --json` still drop trailing newlines on
        # every path, deliberately, because roost_record_read serves the
        # stripped form so that a file and the pane option it must agree with
        # compare alike. NUL bytes are still dropped too — by the shell
        # variable, not by this read — and docs/known-gaps.md records both.
        reply_text="$(cat 2>/dev/null; printf x)"
        reply_text="${reply_text%x}"
      elif [ "$reply_src" = flag ]; then
        echo "roost reply: - and --stdin read the reply from stdin, and stdin here is a terminal. Pipe the text in, or pass it as an argument." >&2; exit 2
      else
        reply_text=""
      fi
    fi
    . "$ROOST_HOME/scripts/lib/roost-reply.sh"
    # The durable copy (#42), before the pane option — the Stop hook in
    # scripts/roost-agent-state does the same, and its comment says why. An
    # empty reply is not recorded: it reads as no reply at all.
    #
    # The socket recorded is the caller's own, from $TMUX: the guard above has
    # just proved it is the server `t` talks to, and it is an absolute path
    # where $SOCKET may be a -L name.
    . "$ROOST_HOME/scripts/lib/roost-record.sh"
    turn=""
    roost_record_root
    if [ -n "$reply_text" ] && [ -n "$ROOST_RECORD_ROOT" ] \
       && roost_record_pane_dir "${our#* }-$our_pid" "$TMUX_PANE" \
       && roost_record_append "$ROOST_RECORD_PANE_DIR" "${TMUX%%,*}" "$reply_text"; then
      turn="$ROOST_RECORD_TURN"
    fi
    # One tmux command for both options and the read-back of what tmux stored,
    # kept as the turn's .pane sidecar — for the reasons given at the Stop hook.
    if [ -n "$turn" ]; then
      stored="$(t set-option -p -t "$TMUX_PANE" @roost-reply "$(roost_reply_encode "$reply_text")" \; \
        set-option -p -t "$TMUX_PANE" @roost-reply-turn "$turn" \; \
        show-options -pqv -t "$TMUX_PANE" @roost-reply 2>/dev/null || true)"
      roost_record_put_pane "$ROOST_RECORD_PANE_DIR" "$turn" "$stored" || true
    else
      t set-option -p -t "$TMUX_PANE" @roost-reply "$(roost_reply_encode "$reply_text")" 2>/dev/null || true
    fi
    ;;
  wait-done|wait)
    # --turn N (#92): wait for the turn `roost send` said this prompt started,
    # not merely for the target to stop being busy. Without it, the previous
    # turn's `done` satisfies the wait at once — see the measurements in the
    # `send` branch above.
    #
    # It goes before the target, once, like `read --turn` and `send --force`.
    # Taken out FIRST, so every message and every positional below is unchanged
    # down to the byte: tests/test-wait-done-timeout.sh compares one of them for
    # EQUALITY, and the usage lines here deliberately do not mention this flag
    # for that reason. `roost help` carries it instead.
    #
    # Only a positive number. `read --turn` also takes -N, counting back from
    # the newest, and that form is refused here on purpose: counting back from
    # a newest turn that has not happened yet is not a thing to wait for.
    #
    # --json (#110) sits in the same slot, once, in either order with --turn.
    # The document is printed by wd_exit below on every OUTCOME -- done,
    # error, timeout, died, gone, interrupted -- because for this one command
    # a non-zero exit is a result, not a failure
    # (docs/airig/specs/2026-09-15-json-output-design.md, "Adding wait-done
    # later"); a usage refusal prints nothing, like every other --json.
    wt_turn="" wt_turn_given=0 wt_dir="" wd_json=0 wd_start="$(date +%s)"
    while :; do
      case "${2:-}" in
        --json)
          if [ "$wd_json" = 1 ]; then
            echo "roost wait-done: '--json' may be given once, before the target." >&2
            echo "usage: roost wait-done [SESSION:]WINDOW [TIMEOUT_SEC]" >&2
            exit 1
          fi
          wd_json=1
          shift 2
          set -- wait-done "$@" ;;
        --turn)
          wt_turn="${3:-}"
          case "$wt_turn" in ''|*[!0-9]*|0*) wt_turn=bad ;; esac
          if [ "$wt_turn" != bad ] && [ "${#wt_turn}" -gt 15 ]; then wt_turn=bad; fi
          if [ "$wt_turn" = bad ]; then
            echo "roost wait-done: --turn needs a turn number — N counts from the first turn, and \`roost send\` prints the one its prompt started." >&2
            echo "usage: roost wait-done [SESSION:]WINDOW [TIMEOUT_SEC]" >&2
            exit 1
          fi
          wt_turn_given=1
          # Drop "wait-done" and the two flag words, then put the subcommand back so
          # every positional reference below keeps its original number.
          shift 3
          set -- wait-done "$@" ;;
        *) break ;;
      esac
    done
    need_arg "${2:-}" "usage: roost wait-done [SESSION:]WINDOW [TIMEOUT_SEC]"; raw="$2"; timeout=0
    # TIMEOUT_SEC is refused here, before any polling, unless it is a whole
    # number of seconds (#66). It flows into `[ "$timeout" -gt 0 ]` and
    # `$((timeout * 4))` in the loop below, and measured on the old code:
    #
    #   - `abc`, `1.5`, or a number too big for bash's integers: the `[` test
    #     errors rather than succeeds, so the loop never ended and printed
    #     `bin/roost: line N: [: abc: integer expression expected` — the
    #     checkout's path — four times a second.
    #   - `-5`: `-5 -gt 0` is false, so it silently waited with no limit.
    #   - an EMPTY string: `${3:-0}` read it as omitted, and waited with no
    #     limit. So the test is on $#, not on emptiness: omitted is the
    #     default, an empty value is a caller's bug (an unset variable) and is
    #     refused like any other.
    #   - `08`: a leading zero made the arithmetic octal, so 08 was a bash
    #     error and 010 meant eight seconds. Leading zeros are stripped, so
    #     both are decimal.
    #
    # At most 15 digits once the zeros are gone, which is 31 million years:
    # `timeout * 4` has to fit a 64-bit integer, and a longer value would wrap
    # to a negative number and wait with no limit.
    #
    # Exit 1 and a usage line, as need_arg does, and echo rather than a
    # `${3:?}` expansion for need_arg's reason: no path, no line number.
    if [ "$#" -ge 3 ]; then
      timeout="$3"
      case "$timeout" in
        ''|*[!0-9]*) timeout=bad ;;
        *) timeout="${timeout#"${timeout%%[!0]*}"}"; timeout="${timeout:-0}"
           [ "${#timeout}" -le 15 ] || timeout=bad ;;
      esac
      if [ "$timeout" = bad ]; then
        echo "roost wait-done: TIMEOUT_SEC must be a whole number of seconds from 0 to 999999999999999, got '$3'" >&2
        echo "usage: roost wait-done [SESSION:]WINDOW [TIMEOUT_SEC]" >&2
        exit 1
      fi
    fi
    tgt="$(target "$raw")"
    # --turn is resolved to a record directory ONCE, here, and the loop below
    # then costs one stat(2) per poll rather than a tmux round trip.
    #
    # A %N ONLY. Turn numbers belong to one pane (scripts/lib/roost-record.sh
    # keys the record by pane), and a window target aggregates every agent pane
    # in it, so there is no single numbering to wait on. Quietly waiting on the
    # window's active pane would be a guess dressed as an answer — the exact
    # shape of failure this flag exists to remove — so it is refused instead.
    #
    # A target with no usable record is refused too, and loudly. Turn N will
    # never be written there, so the alternative is a wait that can only ever
    # end in a timeout: a caller would read that as "the agent is slow" when the
    # truth is "this question cannot be asked here".
    if [ "$wt_turn_given" = 1 ]; then
      case "$raw" in
        %[0-9]*) ;;
        *)
          echo "roost wait-done: --turn needs a %N pane — '$raw' names a window, and its agent panes number their turns separately." >&2
          exit 1 ;;
      esac
      if record_for "$raw" "$tgt"; then
        case "$RF_STATE" in
          # 0 is a record this roost understands; 1 is a pane that has recorded
          # nothing yet, which is the ordinary state of an agent waiting for its
          # first turn and must not be refused.
          0|1) wt_dir="$RF_DIR" ;;
          *) record_warn wait-done "$raw" ;;
        esac
      fi
      if [ -z "$wt_dir" ]; then
        echo "roost wait-done: --turn $wt_turn cannot be answered for '$raw' — it has no usable turn record, so turn $wt_turn will never be written and this wait could only ever time out." >&2
        exit 1
      fi
    fi
    # turn_reached -> 0 when there is nothing to wait for beyond the badge, or
    # when turn N has been recorded. One stat(2), no fork, no tmux call: it runs
    # on every quarter-second pass.
    turn_reached() {
      [ "$wt_turn_given" = 1 ] || return 0
      roost_record_turn_file "$wt_dir" "$wt_turn"
      [ -f "$ROOST_RECORD_FILE" ]
    }
    # wd_reply_json PANE -> WD_REPLY, the object `read --json` would print for
    # PANE's recorded reply, less the four fields that belong to the outer
    # document (schema, command, target, pane); 1 when the pane holds no
    # reply. The same reads and the same rules as `read`: the pane value is
    # the truth, the kept turn file stands in for it only while
    # roost_record_match agrees, a held pane's main reply is `final: false`
    # and not stale, and text tmux may have rewritten is marked lossy.
    wd_reply_json() {
      local reply info state since bgrec held=0 bg="" final=1 stale=0 why="" ptr turn="" kind=t sent_by="" reply_u lossy
      reply="$(t show-options -p -t "$1" -qv @roost-reply 2>/dev/null || true)"
      [ -n "$reply" ] || return 1
      info="$(t display-message -p -t "$1" '#{@agent_state}|#{@agent_since}|#{@roost-background}' 2>/dev/null || true)"
      state="${info%%|*}"; info="${info#*|}"; since="${info%%|*}"; bgrec="${info#*|}"
      case "$since" in ''|*[!0-9]*) since="" ;; esac
      # roost_hold is THE held test (scripts/lib/roost-jsonout.sh, sourced
      # before this runs): the same one `read` and every badge apply.
      if { [ "$state" = working ] || [ "$state" = blocked ]; } && roost_hold "$since" "$bgrec"; then
        held=1 final=0
        bg="$ROOST_HOLD_COUNT"
        [ "$bg" = "?" ] && bg=""
      fi
      case "$state" in working|blocked|error) stale=1 ;; esac
      [ "$held" = 1 ] && stale=0
      [ "$state" = error ] && why="$(t show-options -p -t "$1" -qv @roost-error-reason 2>/dev/null || true)"
      if record_for "$1" "$1" && [ "$RF_LIVE" = 1 ] && [ "$RF_STATE" -eq 0 ]; then
        ptr="$(t show-options -p -t "$1" -qv @roost-reply-turn 2>/dev/null || true)"
        case "$ptr" in ''|*[!0-9]*|0*) ptr="" ;; esac
        if [ -n "$ptr" ] && [ "${#ptr}" -le 15 ]; then
          reply_u="$(t -u show-options -p -t "$1" -qv @roost-reply 2>/dev/null || true)"
          if roost_record_match "$reply_u" "$RF_DIR" "$ptr"; then
            reply="$ROOST_RECORD_TEXT"; turn="$ptr"
            roost_record_get_turn_field "$RF_DIR" "$turn" sent_by || true
            sent_by="$ROOST_RECORD_FIELD"
          fi
        fi
      fi
      if [ -z "$turn" ] && roost_jsonout_looks_escaped "$reply" && roost_jsonout_server_escapes "$1"; then kind=T; fi
      roost_jsonout_encode "$state" "$why" "$reply" "$sent_by" || return 1
      lossy=false
      if [ "$kind" = T ] || [ "${ROOST_JSONOUT_LOSSY:2:1}" = 1 ]; then lossy=true; fi
      WD_REPLY='{"source":"reply","state":'
      if [ -n "$state" ]; then WD_REPLY="$WD_REPLY${ROOST_JSONOUT_STR[0]}"; else WD_REPLY="${WD_REPLY}null"; fi
      if [ "$stale" = 1 ]; then WD_REPLY="$WD_REPLY,\"stale\":true"; else WD_REPLY="$WD_REPLY,\"stale\":false"; fi
      if [ -n "$why" ]; then WD_REPLY="$WD_REPLY,\"error_reason\":${ROOST_JSONOUT_STR[1]}"; else WD_REPLY="$WD_REPLY,\"error_reason\":null"; fi
      roost_jsonout_int "$turn"; WD_REPLY="$WD_REPLY,\"turn\":$ROOST_JSONOUT_INT"
      WD_REPLY="$WD_REPLY,\"text\":${ROOST_JSONOUT_STR[2]},\"lossy\":$lossy"
      if [ -n "$sent_by" ]; then WD_REPLY="$WD_REPLY,\"sent_by\":${ROOST_JSONOUT_STR[3]}"; else WD_REPLY="$WD_REPLY,\"sent_by\":null"; fi
      if [ "$final" = 1 ]; then WD_REPLY="$WD_REPLY,\"final\":true"; else WD_REPLY="$WD_REPLY,\"final\":false"; fi
      roost_jsonout_int "$bg"; WD_REPLY="$WD_REPLY,\"background\":$ROOST_JSONOUT_INT}"
      return 0
    }
    # wd_exit CODE OUTCOME PANE STATE [REASON] -- every way out of the wait
    # below once the target has been resolved. The stderr line has already
    # been printed by the caller, unchanged; this prints the --json document
    # when one was asked for, and exits CODE. PANE is "" when no single pane
    # is the outcome's (a window that finished, a target that is gone).
    wd_exit() {
      local code="$1" outcome="$2" pane="$3" state="$4" reason="${5:-}" info bg reply=null elapsed pane_j state_j reason_j
      if [ "$wd_json" = 1 ]; then
        . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
        elapsed=$(( $(date +%s) - wd_start ))
        bg=null
        if [ -n "$pane" ]; then
          info="$(t display-message -p -t "$pane" '#{@agent_since}|#{@roost-background}' 2>/dev/null || true)"
          roost_jsonout_background "${info%%|*}" "${info#*|}"; bg="$ROOST_JSONOUT_INT"
          if [ "$outcome" = done ]; then wd_reply_json "$pane" && reply="$WD_REPLY"; fi
        fi
        roost_jsonout_encode "$raw" "$pane" "$state" "$outcome" "$reason" || roost_jsonout_fail wait-done
        pane_j=null; [ -n "$pane" ] && pane_j="${ROOST_JSONOUT_STR[1]}"
        state_j=null; [ -n "$state" ] && state_j="${ROOST_JSONOUT_STR[2]}"
        reason_j=null; [ -n "$reason" ] && reason_j="${ROOST_JSONOUT_STR[4]}"
        roost_jsonout_int "$wt_turn"
        printf '{"schema":%s,"command":%s,"target":%s,"pane":%s,"state":%s,"outcome":%s,"error_reason":%s,"background":%s,"elapsed":%s,"turn":%s,"reply":%s}\n' \
          "$ROOST_JSON_SCHEMA" '"wait-done"' "${ROOST_JSONOUT_STR[0]}" "$pane_j" "$state_j" "${ROOST_JSONOUT_STR[3]}" "$reason_j" "$bg" "$elapsed" "$ROOST_JSONOUT_INT" "$reply"
      fi
      exit "$code"
    }
    # wd_state_of PANE -> the badge PANE reads in the last snapshot, or "".
    wd_state_of() {
      local _id _dead _pp _job _st
      while read -r _id _dead _pp _job _st; do
        [ "$_id" = "$1" ] && { printf '%s' "$_st"; return 0; }
      done <<< "${rows:-}"
      return 0
    }
    # A %N target is pane-precise; anything else aggregates the window's agent
    # panes. The two cases MUST branch on the target form: `list-panes -t %N`
    # lists that pane's whole WINDOW, not the single pane.
    # State is a PANE option, so it is read with display-message (which resolves
    # pane scope). `show-options -wqv` exits 0 with EMPTY output for a pane
    # option, so a `|| echo idle` fallback never fires and the empty string
    # matches neither done nor idle — the wait loop would hang until timeout.
    #
    # Every `blocked` pane is offered to roost_unblock_pane first, on every
    # pass. A declined Claude dialog fires no event, so without this a waiter
    # on that pane would burn its whole timeout (#38). It is the helper `send`
    # and `read` use, so all three agree, and it costs nothing on a pane that
    # does not read `blocked`.
    #
    # A dead agent is told apart from a busy one with tmux facts only (#54):
    # whether the pane still exists, and #{pane_dead}. Never a process-tree
    # walk or a screen regex — both guess, and a guess that says "died" about a
    # working agent aborts the coordinator waiting on it.
    #
    # One more fact joins them for an agent typed at a shell prompt (#64): the
    # job that held the pane's terminal when its hook stamped busy, which
    # scripts/roost-agent-state records in @roost-agent-job. It is still not a
    # walk: the sink recorded which job, and this checks two kernel facts about
    # it — see job_gone below.
    #
    # What each way of dying looks like, MEASURED on tmux 3.6 with a stand-in
    # agent and with a real Claude Code killed mid-turn:
    #
    #   - launched as the pane's command (`roost spawn NAME CMD`) and killed:
    #     the pane closes. Before this, wait-done exited 0 — a dead agent
    #     reported as finished — because `display-message -p -t %GONE` exits 0
    #     with every format EMPTY, which read as "no badge", which read as done.
    #     `kill-pane` and `kill-window` looked the same.
    #   - `remain-on-exit on`: the pane stays with pane_dead=1 and its badge
    #     still `working`, and wait-done burned its whole timeout.
    #   - killed inside a shell: the pane stays alive at a prompt, pane_dead is
    #     0 and the badge stays `working`. No tmux fact changes except
    #     #{pane_current_command}, which is a process NAME and is not trusted
    #     here. Until #64 that case timed out with exit 1; now the recorded
    #     foreground job catches it (job_gone). A pane with no record — an older
    #     install, or an agent that was not a job of the pane's shell — still
    #     times out, exactly as before; docs/known-gaps.md.
    #
    # snapshot() prints one "id dead pPANE_PID jJOB state" line per pane the
    # target covers,
    # and fails when the target is gone. list-panes, never display-message,
    # for the reason above: list-panes exits non-zero on a target that does not
    # exist. A %N target is matched by id out of `list-panes -a`, because
    # `list-panes -t %N` lists that pane's whole WINDOW, not the single pane.
    # The state is last on purpose: it is the only field that can be EMPTY (a
    # pane no hook has stamped), and `read` leaves a trailing empty field empty.
    # @roost-agent-job can be empty too, so it carries a fixed `j` prefix: an
    # unrecorded pane reads `j`, never a missing field that would shift the
    # state one place left. Its value is "PGID:PANE_PID", with no space.
    # #{pane_pid} carries a fixed `p` for the same reason (#165): tmux 3.8
    # prints it EMPTY once the pane's process has gone (its format callback
    # now checks the pane's fd; 3.7c and earlier print the old pid). Without
    # the prefix a dead pane read `%N 1  j working`, `read` shifted `working`
    # into the job field, the state came out empty, and a dead agent exited 0
    # as finished. Strip the `p` before using the pid.
    #
    # A read loop over a captured string, not a pipe into `grep`/`awk ... exit`:
    # bin/roost runs under `set -o pipefail`, and a reader exiting early can
    # SIGPIPE list-panes, so the pipeline would report failure even when the
    # pane IS there — and wait-done would call a live agent gone.
    snapshot() {
      local _all _id _dead _pp _job _st
      case "$tgt" in
        %*)
          _all="$(t list-panes -a -F '#{pane_id} #{pane_dead} p#{pane_pid} j#{@roost-agent-job} #{@agent_state}' 2>/dev/null)" || return 1
          while read -r _id _dead _pp _job _st; do
            [ "$_id" = "$tgt" ] && { printf '%s %s %s %s %s\n' "$_id" "$_dead" "$_pp" "$_job" "$_st"; return 0; }
          done <<< "$_all"
          return 1
          ;;
        *)
          t list-panes -t "$tgt" -F '#{pane_id} #{pane_dead} p#{pane_pid} j#{@roost-agent-job} #{@agent_state}' 2>/dev/null
          ;;
      esac
    }
    # A vanished pane is only a death if it vanished while busy. A one-shot
    # agent stamps done and then its pane closes on its own — measured with
    # `claude -p` in a `roost spawn` window at 531ms, 1297ms and 1348ms from
    # done to gone — and a waiter that saw done must not call that died. So
    # $busy_seen keeps the "id state" of every pane the LAST poll saw busy,
    # and only those count when they disappear. A pane that was already gone
    # on the first poll has no history at all, and says so.
    #
    # The poll is a quarter second rather than the old one, for that same
    # measurement: a 1s poll lands inside a 531ms done-to-gone gap about half
    # the time, and the other half it sees working, then nothing, and would
    # report a finished agent as died. $timeout stays in seconds; $ticks
    # counts quarters.
    #
    # died_if_vanished ROWS: a pane $busy_seen names that ROWS no longer lists
    # closed mid-turn — exit 2, naming it. In a window, a pane that was NOT busy
    # closing is not a death, and a window target must give the answer a pane
    # target would.
    died_if_vanished() {
      local _id _st
      while read -r _id _st; do
        [ -n "$_id" ] || continue
        case "$1" in
          "$_id "*|*$'\n'"$_id "*) ;;
          *) echo "roost: '$raw' died: pane $_id closed while it read $_st" >&2; wd_exit 2 died "$_id" "$_st" ;;
        esac
      done <<< "$busy_seen"
    }
    # job_gone (#64) lives near the top of this file, after plural(), and is
    # called below exactly as it was when it was defined here. `roost close`
    # (#143) asks the same question — has the agent left this pane? — of the
    # same facts, and one definition is what keeps the two commands from
    # disagreeing about it.
    busy_seen=""; first=1; ticks=0
    while :; do
      if ! rows="$(snapshot)"; then
        if [ "$first" = 1 ]; then
          echo "roost: '$raw' is gone: no such pane or window. roost cannot tell an agent that finished and closed its pane from one that died" >&2
          wd_exit 2 gone "" ""
        elif [ -n "$busy_seen" ]; then
          # Not first, and the last poll saw something busy.
          read -r _id _st <<< "$busy_seen"
          echo "roost: '$raw' died: its pane closed while $_id read $_st" >&2
          wd_exit 2 died "$_id" "$_st"
        else
          # Reachable only with --turn (#92), and only now. Before it, an empty
          # $busy_seen on a later pass was impossible — the loop broke out the
          # moment nothing was busy — so the branch above could assume a name to
          # print. With --turn the loop keeps going on a pane that is idle but
          # has not recorded the turn yet, and if THAT pane closes there is no
          # busy state to name. Saying "closed while  read " would be the old
          # message with two holes in it.
          echo "roost: '$raw' died: its pane closed before turn $wt_turn was recorded" >&2
        fi
        wd_exit 2 died "" ""
      fi
      # Every `blocked` pane is offered to roost_unblock_pane (see above), then
      # the snapshot is taken again so the checks below read what it left.
      # Once a second, not on every quarter-second tick: the helper reads a
      # transcript, and the recovery it exists for is not a race.
      #
      # And every `working` pane to roost_interrupted_pane (#95), for the
      # same reason: an Esc mid-turn fires no event, and a waiter on that
      # pane would burn its whole timeout on a turn the human already ended.
      if [ $((ticks % 4)) = 0 ]; then
        offered=0
        while read -r _id _dead _pp _job _st; do
          [ "$_st" = "blocked" ] && { roost_unblock_pane "$_id" || true; offered=1; }
          [ "$_st" = "working" ] && { roost_interrupted_pane "$_id" || true; offered=1; }
        done <<< "$rows"
        if [ "$offered" = 1 ]; then
          # The snapshot ABOVE becomes the history before the snapshot is taken
          # again: first judged against the last poll's history, then made the
          # history itself. Without the second step, a blocked pane that closes
          # between the two reads — on the first poll, or on the pass it first
          # turned busy — is simply missing from the second read, $busy_seen does
          # not name it yet, and a window target whose sibling keeps the window
          # open exits 0 on a pane that died. Found by review (flock round 1).
          #
          # REBUILT, not appended to. A pane the last poll saw busy and the read
          # above saw done has finished; if it then closes while the helper runs
          # — which reads a transcript, and can take as long as a one-shot
          # agent's done-to-gone gap — an appended history would still name it
          # busy and report the finish as a death. Found by review (flock round
          # 2). A pane the helper clears is still listed below, so it never
          # matches the vanished-while-busy check.
          died_if_vanished "$rows"
          busy_seen=""
          while read -r _id _dead _pp _job _st; do
            case "$_st" in working|blocked) busy_seen="$busy_seen$_id $_st"$'\n' ;; esac
          done <<< "$rows"
          first=0
          # Gone between the two reads: the next pass reports it as died, with
          # the history just recorded.
          rows="$(snapshot)" || { sleep 0.25; ticks=$((ticks + 1)); continue; }
        fi
      fi
      # An errored agent will never become done, so treating it as "still busy"
      # would wait forever, and falling through to the default *) arm (as
      # working|blocked's absence used to) would report a dead agent as
      # successfully finished — the one wrong answer a coordinating agent
      # cannot recover from. Check and stop explicitly instead.
      #
      # It also keeps the errored pane's id in $err_pane, so the refusal can say
      # WHY: an adapter that inferred `error` rather than being told it (codex,
      # #39) records its reason in @roost-error-reason, and "error" alone does not
      # tell a coordinator whether to retry, re-prompt or go and look.
      #
      # Error is checked before death, so an errored pane keeps exit 1 even
      # once its process has gone: the reason it records is the better answer.
      err_pane=""
      while read -r _id _dead _pp _job _st; do
        [ "$_st" = "error" ] && { err_pane="$_id"; break; }
      done <<< "$rows"
      if [ -n "$err_pane" ]; then
        echo "roost: '$raw' is in error state, not done" >&2
        # show-options -p, as `read` does for @roost-reply: pane scope only, so
        # a stray window- or global-scope value is never reported as this
        # pane's reason. A pane with none (every adapter that has a real error
        # event) prints the one line it always has.
        why="$(t show-options -p -t "$err_pane" -qv @roost-error-reason 2>/dev/null || true)"
        [ -n "$why" ] && echo "roost: $err_pane: $why" >&2
        wd_exit 1 error "$err_pane" error "$why"
      fi
      died_if_vanished "$rows"
      # A dead pane still badged busy: its process exited without finishing,
      # and a dead pane never runs another hook. One whose badge reads done or
      # idle finished first, and keeps its old answer below.
      busy_seen=""
      while read -r _id _dead _pp _job _st; do
        case "$_st" in
          working|blocked)
            if [ "$_dead" = 1 ]; then
              echo "roost: '$raw' died: pane $_id is dead (its process exited) while it read $_st" >&2
              wd_exit 2 died "$_id" "$_st"
            fi
            if job_gone "${_pp#p}" "$_job"; then
              # The same check `send` and `read` make (#105, step 5), and
              # the same recovery: the badge is unset and `died` recorded,
              # so the pane stops claiming a turn after this wait has told
              # its caller. Its answer does not change the exit: job_gone
              # has already said the agent is gone.
              roost_died_pane "$_id" || true
              echo "roost: '$raw' died: the agent in pane $_id exited inside its shell while it read $_st — the job that held its terminal has no process left, and the shell has the terminal back" >&2
              wd_exit 2 died "$_id" "$_st"
            fi
            busy_seen="$busy_seen$_id $_st"$'\n'
            ;;
          '')
            # A pane whose death is already RECORDED (#105): an earlier
            # `send`, `read` or `wait-done` found its agent gone inside its
            # shell and unset the badge with @roost-ended "<stamp> died", or
            # the Claude SessionEnd hook released it so (#188). The job_gone
            # test above cannot see it any more -- the badge and the job
            # record went in the clear -- so the record answers instead, and
            # at once, as a dead pane does: in a window whose sibling is
            # still busy, waiting for the sibling would hide the death behind
            # an unrelated agent's turn. Once a second, like the recoveries,
            # and only for an unbadged pane, so a busy fleet pays nothing.
            # Not with --turn N: the record describes the pane's NEWEST turn,
            # and says nothing about turn N, whose own sidecar answers below
            # (the rule the interrupted record keeps, flock round 1 on #95).
            if [ "$wt_turn_given" = 0 ] && [ $((ticks % 4)) = 0 ]; then
              _ended="$(t display-message -p -t "$_id" '#{@agent_since}|#{@roost-session-ended}|#{@roost-ended}' 2>/dev/null || true)"
              _esince="${_ended%%|*}"; _ended="${_ended#*|}"
              _sesend="${_ended%%|*}"; _ended="${_ended#*|}"
              case "$_esince" in ''|*[!0-9]*) ;; *)
                if [ "$_ended" = "$_esince died" ]; then
                  case "$_sesend" in
                    "$_esince by="*) echo "roost: '$raw' died: the agent in pane $_id exited while its background work still ran" >&2 ;;
                    *) echo "roost: '$raw' died: the agent in pane $_id exited inside its shell before its turn finished" >&2 ;;
                  esac
                  wd_exit 2 died "$_id" ""
                fi ;;
              esac
            fi
            ;;
        esac
      done <<< "$rows"
      # Not busy is where this used to stop. With --turn it is only half the
      # question: the turn that was asked for must also be on disk. Both
      # conditions, in this order, so a pane that is still working is never
      # stat'd for a turn it cannot have finished yet.
      if [ -z "$busy_seen" ] && turn_reached; then break; fi
      first=0
      sleep 0.25; ticks=$((ticks + 1))
      if [ "$timeout" -gt 0 ] && [ "$ticks" -ge $((timeout * 4)) ]; then
        # The turn is named when there was one: "timed out waiting for %7" and
        # "timed out waiting for turn 4 of %7" send a caller to different
        # places, and the second is the one that says the wait was specific.
        if [ "$wt_turn_given" = 1 ]; then
          echo "roost: timed out waiting for turn $wt_turn of '$raw'" >&2
        else
          echo "roost: timed out waiting for '$raw'" >&2
        fi
        # The pane and its badge, for --json: a %N target's own; a window
        # target has no single pane to name.
        case "$tgt" in
          %*) wd_exit 1 timeout "$tgt" "$(wd_state_of "$tgt")" ;;
          *) wd_exit 1 timeout "" "" ;;
        esac
      fi
    done
    # Not busy, and the turn (if one was asked for) is on disk. That used to be
    # exit 0 without a further look, and it was wrong for a turn the human
    # STOPPED (#95): a codex Interrupt leaves idle, a copilot abort leaves
    # idle, a Claude Esc or declined dialog leaves no badge once roost has
    # recovered it, and every one of them read as "finished". Each of those
    # now records @roost-ended "<@agent_since> interrupted" in the same tmux
    # command as the badge it leaves, and that record counts only while its
    # first word is still the pane's @agent_since -- the @roost-transcript
    # rule, so a stamp from the next turn retires it. A turn asked for by
    # number carries the same answer in its `outcome` sidecar: the empty turn
    # file the recovery wrote so the numbering stayed aligned.
    #
    # Exit 5, not 1 (already error, timeout and usage, and a retry-on-timeout
    # loop would retry an interrupted turn) and not 3 or 4 (`send`'s, and #43
    # may fuse the two commands); the design's Q2.
    #
    # `died` is the same record with the other word (#188): the Claude
    # SessionEnd hook writes it when the agent exits while its background
    # work holds the pane, and it exits 2, the code a pane whose agent is
    # gone already gives. Never 0: the work the turn was waiting on was
    # stopped, or left the pane, with the agent.
    if [ "$wt_turn_given" = 1 ]; then
      roost_record_get_turn_field "$wt_dir" "$wt_turn" outcome || true
      if [ "$ROOST_RECORD_FIELD" = interrupted ]; then
        echo "roost: turn $wt_turn of '$raw' was interrupted, not done" >&2
        wd_exit 5 interrupted "$tgt" "$(wd_state_of "$tgt")"
      fi
      if [ "$ROOST_RECORD_FIELD" = died ]; then
        echo "roost: turn $wt_turn of '$raw' died: the agent exited while its background work still ran" >&2
        wd_exit 2 died "$tgt" "$(wd_state_of "$tgt")"
      fi
      # The dead-agent clear's own word (#105, step 5; fix round 1): the
      # agent exited inside its shell. Same exit and outcome, its own
      # sentence -- the first `wait-done --turn N` that saw the death said
      # so from job_gone, and this is what every later one reads.
      if [ "$ROOST_RECORD_FIELD" = died_in_shell ]; then
        echo "roost: turn $wt_turn of '$raw' died: the agent exited inside its shell before the turn finished" >&2
        wd_exit 2 died "$tgt" "$(wd_state_of "$tgt")"
      fi
    fi
    # The pane's own record describes its NEWEST turn, so it answers only a
    # wait that asked about the newest turn. With --turn N the sidecar above
    # is the whole answer: a later turn that was interrupted says nothing
    # about turn N (flock round 1, reproduced: turn 1 done, turn 2
    # interrupted, `wait-done --turn 1` exited 5).
    if [ "$wt_turn_given" = 0 ]; then
      while read -r _id _dead _pp _job _st; do
        [ -n "$_id" ] || continue
        # @roost-session-ended rides along: it says WHICH writer recorded a
        # `died`. The SessionEnd hook (#188) writes it with its release; the
        # dead-agent recovery (#105, roost_died_pane) does not, and its death
        # is the agent's own, inside its shell, not background work cut off.
        # The two get their own sentences; the exit is 2 for both.
        _ended="$(t display-message -p -t "$_id" '#{@agent_since}|#{@roost-session-ended}|#{@roost-ended}' 2>/dev/null || true)"
        _esince="${_ended%%|*}"; _ended="${_ended#*|}"
        _sesend="${_ended%%|*}"; _ended="${_ended#*|}"
        case "$_esince" in ''|*[!0-9]*) continue ;; esac
        if [ "$_ended" = "$_esince interrupted" ]; then
          echo "roost: '$raw' was interrupted, not done" >&2
          wd_exit 5 interrupted "$_id" "$_st"
        fi
        if [ "$_ended" = "$_esince died" ]; then
          case "$_sesend" in
            "$_esince by="*) echo "roost: '$raw' died: the agent in pane $_id exited while its background work still ran" >&2 ;;
            *) echo "roost: '$raw' died: the agent in pane $_id exited inside its shell before its turn finished" >&2 ;;
          esac
          wd_exit 2 died "$_id" "$_st"
        fi
      done <<< "$rows"
    fi
    case "$tgt" in
      %*) wd_exit 0 done "$tgt" "$(wd_state_of "$tgt")" ;;
      *) wd_exit 0 done "" "" ;;
    esac
    ;;
  forget)
    # Delete kept replies (#42). The pane records live under one directory the
    # user can remove in one command; this is that command, with two narrower
    # forms. It never touches a pane option: the pane stays the truth, and a
    # live pane's current reply still reads after its record is gone.
    #
    #   forget TGT     one pane's record — a live pane, or a closed %N on this
    #                  server's boot (see record_for)
    #   forget --gone  every record whose pane is closed, or whose server has
    #                  stopped or restarted: the liveness check asks the server
    #                  at each record's socket, never a pid. A record it cannot
    #                  check is KEPT and named (roost_record_liveness)
    #   forget --all   every record
    #
    # Every form removes only what roost_record_is_record recognises: a
    # pane-number directory under a boot-key directory, holding the `schema`
    # file a writer creates first. A directory of the right shape without one is
    # left alone, and so is anything else under a ROOST_RECORD_DIR pointed
    # somewhere by mistake. What a user put INSIDE a record goes with it.
    #
    # `--all` also clears the event log (#98), which lives in `events/` inside
    # the same root unless ROOST_EVENTS moved it. The other forms leave it: a
    # line names a pane but holds nothing the pane said, and cutting one pane's
    # lines out would move every cursor after them.
    . "$ROOST_HOME/scripts/lib/roost-record.sh"
    . "$ROOST_HOME/scripts/lib/roost-events.sh"
    roost_record_root
    if [ -z "$ROOST_RECORD_ROOT" ]; then
      # Kept replies are off, but ROOST_EVENTS can still name a log of its own.
      if [ "${2:-}" = "--all" ]; then
        roost_events_clear
        if [ "$ROOST_EVENTS_CLEARED" = 1 ]; then
          echo "roost forget: cleared the event log in $ROOST_EVENTS_DIR"
          exit 0
        fi
      fi
      echo "roost forget: no record directory — ROOST_RECORD_DIR is not an absolute path, or HOME is unset." >&2
      exit 1
    fi
    case "${2:-}" in
      --all)
        n=0
        for _p in "$ROOST_RECORD_ROOT"/*/*; do
          roost_record_is_record "$_p" || continue
          rm -rf "$_p"
          rmdir "${_p%/*}" 2>/dev/null || true
          n=$((n + 1))
        done
        roost_events_clear
        rmdir "$ROOST_RECORD_ROOT" 2>/dev/null || true
        echo "roost forget: removed $(plural "$n" record) under $ROOST_RECORD_ROOT"
        if [ "$ROOST_EVENTS_CLEARED" = 1 ]; then
          echo "roost forget: cleared the event log in $ROOST_EVENTS_DIR"
        fi
        ;;
      --gone)
        removed=0 kept=0 unknown=0
        for _p in "$ROOST_RECORD_ROOT"/*/*; do
          roost_record_is_record "$_p" || continue
          _n="${_p##*/}"; _b="${_p%/*}"; _boot="${_b##*/}"
          roost_record__socket "$_p" || true
          roost_record_liveness "$ROOST_RECORD_SOCKET_SEEN" "$_boot" "%$_n"
          case "$ROOST_RECORD_LIVENESS" in
            live) kept=$((kept + 1)); continue ;;
            unknown)
              echo "roost forget: kept $_boot/$_n — could not ask its server whether the pane is still there"
              unknown=$((unknown + 1)); continue ;;
          esac
          roost_record_scan "$_p/replies"
          rm -rf "$_p"
          rmdir "$_b" 2>/dev/null || true
          echo "roost forget: removed $_boot/$_n ($(plural "$ROOST_RECORD_COUNT" turn))"
          removed=$((removed + 1))
        done
        if [ "$unknown" -gt 0 ]; then
          echo "roost forget: removed $(plural "$removed" record), kept $kept live and $unknown that could not be checked."
        else
          echo "roost forget: removed $(plural "$removed" record), kept $kept live."
        fi
        ;;
      ''|-*)
        echo "usage: roost forget TGT | --gone | --all" >&2
        exit 1
        ;;
      *)
        tgt="$(target "$2")"
        if ! record_for "$2" "$tgt" || ! roost_record_is_record "$RF_DIR"; then
          echo "roost forget: no record for '$2'." >&2
          exit 1
        fi
        roost_record_scan "$RF_DIR/replies"
        kb="$(du -sk "$RF_DIR" 2>/dev/null | awk '{print $1}')"
        rm -rf "$RF_DIR"
        rmdir "${RF_DIR%/*}" 2>/dev/null || true
        echo "roost forget: removed the record for '$2' ($(plural "$ROOST_RECORD_COUNT" turn), ${kb:-0} KB)"
        ;;
    esac
    ;;
  events)
    # The event log (#98): every state change the hook recorded, one JSON line
    # each, with the cursor that resumes after it. scripts/lib/roost-events.sh
    # has the layout, the rotation and why no lock is needed.
    #
    #   events                 every line of this server still in the log
    #   events --since CURSOR  only the lines after that one
    #   events --follow        then keep printing, until the server stops
    #   events --pane %N       only that pane's lines
    #
    # Exit status: 0 printed (with --follow: the server stopped); 1 usage, or
    # the log is off; 2 no server is running here; 3 the cursor is no longer in
    # the log — re-read `status --json` and start again without --since.
    #
    # Only THIS server's lines, by boot key: the log is shared by every server
    # writing to the same state directory, and a %N means a different pane
    # after a restart.
    . "$ROOST_HOME/scripts/lib/roost-events.sh"
    # `events --reconcile SOCKET BOOT [PANE]` is not for people: tmux/roost.conf
    # runs it, in the background, from the hooks that fire when a pane goes,
    # and it writes a `closed` line for each pane of BOOT that is gone (see
    # roost_events_reconcile). Silent and exit 0 whatever happens: run-shell
    # would show anything else to whoever is looking at the server.
    if [ "${2:-}" = "--reconcile" ]; then
      roost_events_reconcile "${3:-}" "${4:-}" "${5:-}" >/dev/null 2>&1 || true
      exit 0
    fi
    ev_usage() { echo "usage: roost events [--since CURSOR] [--follow] [--pane %N]" >&2; exit 1; }
    ev_since="" ev_follow=0 ev_pane=""
    shift
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --since) [ "$#" -ge 2 ] || ev_usage; ev_since="$2"; shift 2 ;;
        --follow|-f) ev_follow=1; shift ;;
        --pane)
          [ "$#" -ge 2 ] || ev_usage
          case "$2" in %[0-9]*) ;; *) ev_usage ;; esac
          case "${2#%}" in *[!0-9]*) ev_usage ;; esac
          ev_pane="$2"; shift 2 ;;
        *) ev_usage ;;
      esac
    done
    roost_events_dir
    if [ -z "$ROOST_EVENTS_DIR" ]; then
      echo "roost events: the event log is off — ROOST_EVENTS is set to \"\" (or is not an absolute path), or kept replies are off (ROOST_RECORD_DIR=\"\") and ROOST_EVENTS names no directory." >&2
      exit 1
    fi
    ev_boot="$(t display-message -p '#{start_time}-#{pid}' 2>/dev/null || true)"
    case "$ev_boot" in
      [0-9]*-[0-9]*) ;;
      *) echo "roost events: no roost server is running on $SOCKET." >&2; exit 2 ;;
    esac
    ev_rc=0
    roost_events_read "$ev_boot" "$ev_since" "$ev_pane" "$ev_follow" || ev_rc=$?
    if [ "$ev_rc" = 4 ]; then
      echo "roost events: '$ev_since' is not a cursor — pass one that roost events printed." >&2
      exit 1
    fi
    exit "$ev_rc"
    ;;
  status)
    # --json (#41) only as the second word; any other extra word is ignored, as
    # it always was. The document reads the same tmux formats as the lines
    # below, without trusting a delimiter -- see roost_jsonout_list.
    if [ "${2:-}" = "--json" ]; then
      . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
      roost_jsonout_status
      exit 0
    fi
    if server_running; then
      echo "roost: running (socket=$SOCKET)"
      t list-sessions -F '  session #{session_name} — #{session_windows} windows#{?session_attached, [attached],}'
      # Emptiness test, not truthiness: #{?@roost-name,...} treats the string "0"
      # as false, so a pane literally named "0" would wrongly fall back to
      # #{pane_current_command} here.
      # The "/LABEL" suffix is suppressed when LABEL == window_name: `spawn NAME`
      # names the window AND the pane from the same NAME, so an unconditional
      # suffix would print "api-agent/api-agent" — an echo of the window name
      # where real signal (what's running) belongs. LABEL is inlined twice
      # (once in the #{==:} test, once as the shown suffix) rather than
      # factored through a second #{E:} indirection — see tmux/roost.conf's
      # window-status-format comment for why.
      # A pane held at working only by its own background work (#193) reads
      # [background (N)], or [background] when the count is `?`: the same
      # held test and the same count rule as @roost-pane-border in
      # tmux/roost.conf, whose comment explains both. The state underneath is
      # still `working`, and `status --json` still says so in `state`.
      t list-panes -a -F '    #{pane_id}  #{session_name}:#{window_index}.#{pane_index} #{window_name}#{?#{==:#{?#{==:#{@roost-name},},#{pane_current_command},#{@roost-name}},#{window_name}},,/#{?#{==:#{@roost-name},},#{pane_current_command},#{@roost-name}}}  [#{?@agent_state,#{?#{&&:#{==:#{@agent_state},working},#{&&:#{!=:#{@agent_since},},#{&&:#{==:#{s/ .*//:#{@roost-background}},#{@agent_since}},#{m/r:^[0-9]+ ([1-9][0-9]*|[?])$,#{@roost-background}}}}},background#{?#{m/r:^[^ ]+ [1-9][0-9]*$,#{@roost-background}}, (#{s/^[^ ]* //:#{@roost-background}}),},#{@agent_state}},-}]'
    else echo "roost: not running"; fi
    ;;
  kill|down|stop)
    # roost kill|down|stop [--yes|-y] [SESSION] (#207). With a SESSION it ends
    # that one session, exactly as it always has, with no question: the name
    # is the caller saying which. --yes is accepted there and ignored, so a
    # script can pass it to every form without caring which one it runs.
    #
    # With no SESSION it is `kill-server`: every session and every agent on
    # the server ends. "stop" reads like a fix for one stuck pane, and a
    # person who typed it for that reason lost the whole fleet with no count
    # and no question. So the bare form now asks on a terminal, and off a
    # terminal it refuses unless --yes says the caller means it.
    kl_verb="$1"; shift
    kl_yes=0; kl_name=""
    for kl_a in "$@"; do
      case "$kl_a" in
        --yes|-y) kl_yes=1 ;;
        # The first other word is the session, as before; later ones were
        # ignored before and still are.
        *) [ -z "$kl_name" ] && kl_name="$kl_a" ;;
      esac
    done
    if [ -n "$kl_name" ]; then
      t kill-session -t "=$kl_name" 2>/dev/null && echo "roost: session '$kl_name' killed." || echo "roost: no session '$kl_name'."
      exit 0
    fi
    # Not running: today's message and exit 0, before any question. There is
    # nothing to ask about, and a script stopping an already-stopped server
    # has always been a no-op.
    if ! server_running; then echo "roost: not running."; exit 0; fi
    if [ "$kl_yes" = 0 ]; then
      # What will end, counted from the server itself. An agent pane is one
      # with @agent_state set, the same test the `roost status` listing uses
      # for its [state] column; a plain shell pane is not counted, because
      # nothing of value ends with it. One character per line, so no tmux
      # field separator is involved (docs/known-gaps.md: tmux 3.4 prints a
      # tab as `_` under a C locale).
      kl_agents="$(t list-panes -a -F '#{?@agent_state,a,-}' 2>/dev/null | grep -c a || true)"
      kl_sess="$(t list-sessions -F x 2>/dev/null | grep -c x || true)"
      kl_aw=agents; [ "$kl_agents" = 1 ] && kl_aw=agent
      kl_sw=sessions; [ "$kl_sess" = 1 ] && kl_sw=session
      kl_what="This ends $kl_agents $kl_aw in $kl_sess $kl_sw."
      # #191 Part 4 adds a line here once persistence lands: a bare stop
      # records the fleet as closed on purpose, so say it will not come back
      # at login and how to restore it by hand (`roost restore --from FILE`).
      # Not before: there is no login restore to warn about yet.
      #
      # Both stdin AND stderr must be a terminal. stdin is where the answer
      # comes from; stderr is where the question goes, and a caller that
      # captured it (`out=$(roost stop 2>&1)`) would never see what it was
      # agreeing to.
      if [ -t 0 ] && [ -t 2 ]; then
        printf '%s\nType y to stop the roost server: ' "$kl_what" >&2
        kl_ans=""
        # EOF fails the read and leaves kl_ans empty: "not stopped", as
        # anything but y is. `|| true` keeps set -e from ending the run here.
        IFS= read -r kl_ans || true
        case "$kl_ans" in
          y|Y) ;;
          *) echo "roost: not stopped." >&2; exit 1 ;;
        esac
      else
        echo "roost: $kl_what Not on a terminal, so roost will not ask. To stop the roost server: roost $kl_verb --yes" >&2
        exit 1
      fi
    fi
    t kill-server 2>/dev/null && echo "roost: server stopped (all sessions)." || echo "roost: not running."
    ;;
  close)
    # roost close [--force] [--json] TGT [TIMEOUT_SEC] (#143): end ONE agent the
    # harness's own way, then close its pane. Until this existed the only way
    # to end a single agent was `tmux kill-pane` by hand, which kills the
    # process mid-write and skips whatever the harness does on a clean exit.
    #
    # The order, and why each step is where it is:
    #
    #   1. resolve TGT to exactly one pane. A window with more than one pane is
    #      refused: guessing its active pane would close the wrong agent.
    #   2. refuse the last pane of a session, even with --force. Closing it ends
    #      the session, and with it maybe the server; `roost kill` is the
    #      command for that, and it says so.
    #   3. refuse `working` and `blocked` unless --force. A working agent would
    #      be cut off mid-turn, and a blocked one is showing a human a dialog.
    #      With --force, steps 4 and 5 are skipped and the pane is closed.
    #   4. a pane with a badge is asked to leave: its harness's own exit
    #      command, from the one table in scripts/lib/roost-close.sh. A pane with
    #      no badge (a shell, a log tail) has nothing to ask.
    #   5. wait, bounded, for the agent to leave. If the pane goes `blocked`
    #      meanwhile, the harness opened a dialog on exit ("background work is
    #      running"): stop, say so, and leave it for a human. Never answer it.
    #   6. close that pane, by %N, and nothing else.
    #
    # The pane record (#74) is NOT touched: kept replies stay on disk for
    # `roost read` and for bringing the same conversation back (#57), and
    # `roost forget` is still the only thing that deletes them.
    #
    # Exit codes in the shape of wait-done: 0 closed, 1 refused or timed out
    # (the pane is still there), 2 the target was already gone.
    #
    # --force and --json go in front of the target, in either order, under
    # send's rule: a repeat is not consumed, so it falls into the target slot
    # and fails there rather than being quietly accepted.
    force=0
    json=0
    while [ "${2:-}" = "--force" ] || [ "${2:-}" = "--json" ]; do
      if [ "$2" = "--force" ]; then
        if [ "$force" -eq 1 ]; then break; fi
        force=1
      else
        if [ "$json" -eq 1 ]; then break; fi
        json=1
      fi
      shift 2
      set -- close "$@"
    done
    need_arg "${2:-}" "usage: roost close [--force] [--json] TGT [TIMEOUT_SEC]"; raw="$2"
    # One target, one bound, nothing after. A second target typed by mistake
    # would otherwise be dropped in silence while the first one is closed.
    # Found by review.
    if [ "$#" -gt 3 ]; then
      echo "roost close: too many arguments — close takes one target and one timeout" >&2
      echo "usage: roost close [--force] [--json] TGT [TIMEOUT_SEC]" >&2
      exit 1
    fi
    # TIMEOUT_SEC bounds step 5 only. Short by default: a harness at rest
    # leaves in under a second (measured for four of the five; the table in
    # scripts/lib/roost-close.sh has the numbers), so ten seconds is room for a
    # slow machine and not for a harness that has decided not to go. Validated the way wait-done validates its own — whole
    # seconds, leading zeros stripped so 08 is eight — except that 0 is refused:
    # wait-done reads 0 as "no limit", and a close that could wait for ever is
    # the one thing step 5 promises not to be.
    timeout=10
    if [ "$#" -ge 3 ]; then
      timeout="$3"
      case "$timeout" in
        ''|*[!0-9]*) timeout=bad ;;
        *) timeout="${timeout#"${timeout%%[!0]*}"}"
           case "$timeout" in ''|?????*) timeout=bad ;; esac ;;
      esac
      if [ "$timeout" = bad ]; then
        echo "roost close: TIMEOUT_SEC must be a whole number of seconds from 1 to 9999, got '$3'" >&2
        echo "usage: roost close [--force] [--json] TGT [TIMEOUT_SEC]" >&2
        exit 1
      fi
    fi
    . "$ROOST_HOME/scripts/lib/roost-close.sh"
    tgt="$(target "$raw")"
    # Step 1. A %N is matched by id out of `list-panes -a`, as wait-done's
    # snapshot does and for its reason: tmux 3.6 answers display-message for a
    # pane that is gone with exit 0 and every format empty, and `list-panes -t
    # %N` lists that pane's whole window. Anything else is a window, and has to
    # hold exactly one pane.
    #
    # Every tmux error goes to /dev/null and is replaced by one line of ours: a
    # target that is gone is an answer (exit 2), not a failure, and tmux's own
    # "can't find pane" says less than this does.
    #
    # The row: id, window, dead, pane pid, the window's pane count, the
    # session's window count, the recorded job and the state. State is last
    # because it is the only field that can be EMPTY (a pane no hook has
    # stamped), and the job carries a fixed `j` prefix so an unrecorded pane
    # never shifts it — both for the reasons wait-done's snapshot gives.
    cl_fmt='#{pane_id} #{window_id} #{pane_dead} #{pane_pid} #{window_panes} #{session_windows} j#{@roost-agent-job} #{@agent_state}'
    cl_row() {
      local _all _r
      _all="$(t list-panes -a -F "$cl_fmt" 2>/dev/null)" || return 1
      while IFS= read -r _r; do
        case "$_r" in "$1 "*) printf '%s\n' "$_r"; return 0 ;; esac
      done <<< "$_all"
      return 1
    }
    case "$tgt" in
      %*) pane="$tgt" ;;
      *)
        panes="$(t list-panes -t "$tgt" -F '#{pane_id}' 2>/dev/null || true)"
        if [ -z "$panes" ]; then
          echo "roost close: '$raw' is gone: no such pane or window" >&2; exit 2
        fi
        case "$panes" in
          *$'\n'*)
            n="$(printf '%s\n' "$panes" | grep -c .)"
            echo "roost close: '$raw' names a window with $n panes, and close takes one — pass the %N of the pane to close (roost status lists them)" >&2
            exit 1 ;;
        esac
        pane="$panes"
        ;;
    esac
    if ! row="$(cl_row "$pane")"; then
      echo "roost close: '$raw' is gone: no such pane or window" >&2; exit 2
    fi
    read -r _id cl_win cl_dead cl_pid cl_wpanes cl_swins cl_job cl_state <<< "$row"
    # Step 2. The session's last pane is its last window's only pane.
    if [ "$cl_wpanes" = 1 ] && [ "$cl_swins" = 1 ]; then
      cl_sess="$(t display-message -p -t "$pane" '#{session_name}' 2>/dev/null || true)"
      echo "roost close: '$raw' is the last pane of session '$cl_sess' — closing it would end the session. close takes one pane; roost kill $cl_sess ends a session" >&2
      exit 1
    fi
    # The harness, for every pane with a badge — even under --force, where
    # nothing is typed, because --json reports it and a reader deciding
    # whether to force needs to know what was there.
    cl_harness="" cl_exit="" cl_cmd=""
    if [ -n "$cl_state" ]; then
      cl_cmd="$(t display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
      roost_close_harness \
        "$(t show-options -p -t "$pane" -qv @roost-harness 2>/dev/null || true)" \
        "$cl_cmd" \
        "$(t show-options -p -t "$pane" -qv @roost-name 2>/dev/null || true)"
      cl_harness="$ROOST_CLOSE_HARNESS"
    fi
    # cl_done HOW: close the pane, report, exit 0. kill-pane by %N, never a
    # window or session target, so nothing but this pane can go. It failing
    # means the pane closed on its own in the meantime, which is the same
    # answer.
    cl_done() {
      t kill-pane -t "$pane" 2>/dev/null || true
      if [ "$json" -eq 1 ]; then
        . "$ROOST_HOME/scripts/lib/roost-jsonout.sh"
        roost_jsonout_emit close target s "$raw" pane s "$pane" state z "$cl_state" \
          harness z "$cl_harness" exit_command z "$cl_exit" forced b "$force" \
          || roost_jsonout_fail close
      else
        echo "roost close: closed $pane — $1"
      fi
      exit 0
    }
    # Its process has already exited (remain-on-exit): nothing is left to ask.
    if [ "$cl_dead" = 1 ]; then cl_done "its process had already exited"; fi
    # Step 3. A `blocked` badge is offered to roost_unblock_pane first, as send
    # and wait-done do: a declined Claude dialog fires no event, and a badge
    # that outlived it must not make this refusal last for ever (#38).
    case "$cl_state" in
      working|blocked)
        # A cleared badge is NOT read back. roost_unblock_pane clears by
        # UNSETTING @agent_state, and an empty state below means "no badge, not
        # an agent" — which would kill a live agent at rest without asking it
        # first (found by review). The pane is an agent whose dialog is over,
        # so it goes on to step 4, and the document reports the badge it had.
        if [ "$cl_state" = blocked ] && roost_unblock_pane "$pane"; then
          :
        elif [ "$force" -eq 0 ]; then
          if [ "$cl_state" = working ]; then
            echo "roost close: '$raw' is working — closing it now would cut its turn off mid-write" >&2
          else
            echo "roost close: '$raw' is blocked — a dialog is open, and roost does not answer it" >&2
          fi
          echo "roost close: wait for it (roost wait-done), or pass --force to close the pane anyway" >&2
          exit 1
        fi
        ;;
    esac
    if [ "$force" -eq 1 ]; then cl_done "--force: nothing was asked of it"; fi
    if [ -z "$cl_state" ]; then cl_done "no badge, so no agent to ask"; fi
    # Step 4.
    if ! roost_close_exit_command "$cl_harness"; then
      if [ -n "$cl_harness" ]; then
        echo "roost close: no exit command is known for harness '$cl_harness' in '$raw' — pass --force to close the pane without asking it" >&2
      else
        echo "roost close: cannot tell which harness runs in '$raw', so there is no exit command to send — pass --force to close the pane without asking it" >&2
      fi
      exit 1
    fi
    # Which job to watch leave. job_gone (#64) is the definition of "the agent
    # has left", shared with wait-done, and it needs a job: the one the hook
    # recorded in @roost-agent-job when the pane last went busy, or — when there
    # is none, or it belongs to an earlier pane process — the job holding the
    # pane's terminal right now. With neither (the agent IS the pane's process,
    # as under `roost spawn NAME CMD`), the only way it can leave is the pane
    # closing or going dead, which the loop below watches for anyway.
    #
    # The foreground job is read BEFORE anything is typed. After the exit
    # command lands it is the shell again, and a job read then would name the
    # shell, which job_gone rightly refuses to watch.
    cl_rec="${cl_job#j}"
    case "$cl_rec" in *":$cl_pid") ;; *) cl_rec="" ;; esac
    if [ -z "$cl_rec" ]; then
      cl_fg="$(ps -o tpgid= -p "$cl_pid" 2>/dev/null || true)"
      cl_fg="${cl_fg//[[:space:]]/}"
      case "$cl_fg" in ''|*[!0-9]*) cl_fg="" ;; esac
      if [ -n "$cl_fg" ] && [ "$cl_fg" -gt 1 ] && [ "$cl_fg" != "$cl_pid" ]; then
        cl_rec="$cl_fg:$cl_pid"
      fi
      # No job, and the pane's own process holds its terminal. If that process
      # is a BARE shell, the badge is left over from an agent that has gone:
      # only a shell is there, and /exit typed into it runs as a command and
      # then waits out the whole bound (found by review). So it is closed
      # without typing.
      #
      # A shell's NAME is not enough, and the first version of this check
      # trusted it: an agent that is itself a shell script, run as the pane's
      # own process (`roost spawn NAME ./agent.sh`), is named sh too, and it
      # was killed without being asked. So the process's whole command line is
      # read as well (one `ps`, only on this path), and the shell counts as
      # bare only when every word after its name is a flag: `sh -i`, `zsh -l`,
      # a login shell's `-zsh`, what roost-pane-shell starts. A script, a
      # `-c` command, or a word with a space in it all read as not bare, and
      # are asked — the side to be wrong on, since the worst a needless /exit
      # costs is the bound.
      if [ -z "$cl_rec" ] && [ "$cl_fg" = "$cl_pid" ]; then
        case "${cl_cmd#-}" in
          sh|bash|zsh|dash|ash|ksh|mksh|fish|tcsh|csh)
            cl_args="$(ps -o args= -p "$cl_pid" 2>/dev/null || true)"
            cl_bare=1
            set -f
            # shellcheck disable=SC2086 # split into words on purpose
            set -- $cl_args
            set +f
            if [ "$#" -eq 0 ]; then cl_bare=0; else shift; fi
            for cl_w in "$@"; do
              case "$cl_w" in -*) ;; *) cl_bare=0 ;; esac
            done
            if [ "$cl_bare" = 1 ]; then
              cl_done "only a shell holds it, so nothing was typed"
            fi
            ;;
        esac
      fi
    fi
    cl_job="j$cl_rec"
    # A badge with no agent behind it — the recorded job has already left and
    # the shell has its terminal back — is closed without typing the exit
    # command into that shell, where it would be run as a command.
    if job_gone "$cl_pid" "$cl_job"; then
      cl_done "its agent had already left, so nothing was typed"
    fi
    # Typed the way send types: the text literally, a beat, then Enter, so a
    # full-screen TUI's input box sees a paste settle before the submit. Not
    # through `roost send` itself: send waits for a new turn to begin, and an
    # exit command begins none.
    delay="$(t show-options -gqv @roost-send-enter-delay 2>/dev/null || true)"
    case "$delay" in ''|.|*.*.*|*[!0-9.]*) delay=0.3 ;; esac
    cl_exit="$ROOST_CLOSE_EXIT"
    t send-keys -t "$pane" -l "$cl_exit" 2>/dev/null || true
    sleep "$delay" 2>/dev/null || sleep 0.3
    t send-keys -t "$pane" Enter 2>/dev/null || true
    # Step 5, a quarter-second poll, as wait-done's.
    ticks=0
    while [ "$ticks" -lt $((timeout * 4)) ]; do
      sleep 0.25; ticks=$((ticks + 1))
      # Gone on its own: an agent that was the pane's process took the pane
      # with it. That is the clean exit this command asked for.
      row="$(cl_row "$pane")" || cl_done "$cl_harness left after $cl_exit"
      read -r _id _w cl_dead _pp _wp _sw _jb cl_now <<< "$row"
      if [ "$cl_dead" = 1 ]; then cl_done "$cl_harness left after $cl_exit"; fi
      if [ "$cl_now" = blocked ]; then
        echo "roost close: '$raw' went blocked after $cl_exit — $cl_harness is asking something before it exits. Nothing was answered, and the pane is still open: answer it there, or run roost close --force" >&2
        exit 1
      fi
      if job_gone "$cl_pid" "$cl_job"; then cl_done "$cl_harness left after $cl_exit"; fi
    done
    echo "roost close: timed out after ${timeout}s waiting for $cl_harness in '$raw' to leave after $cl_exit — the pane is still open" >&2
    exit 1
    ;;
  --version|-V|version)
    printf '%s\n' "$ROOST_VERSION"
    exit 0
    ;;
  *)
    # --- the extension seam -------------------------------------------------
    #
    # THE FALLBACK *IS* THE SEAM, and where it sits is the security control.
    # An installed extension is looked for here and nowhere else, so `send`,
    # `spawn`, `read`, `status` and every other label above have already
    # matched by the time control reaches this line: shadowing a core command
    # is structurally impossible, not merely refused. `roost ext install` does
    # refuse a manifest claiming a core name, and that refusal is what makes
    # the rule comprehensible to an extension author -- but it is a list
    # (roost_ext_core_commands) and lists go stale, whereas this branch
    # cannot. An extension able to intercept `roost send` would sit between
    # every message the user's agents exchange, reading and rewriting prompts
    # on their way past.
    #
    # Nothing above this line was touched to add the seam, and nothing inside
    # it changes what an unknown subcommand does: on a miss it still falls
    # through to the usage error at the bottom, on the same stream, with the
    # same exit status it had before extensions existed. The BYTES of that
    # line did change -- it gained `ext` when this arm landed, and `--version`
    # with the version flag -- so what is pinned is the line itself, written
    # out literally in tests/test-ext.sh, and it has to move in lockstep with
    # the usage string here. Ripping the whole feature out is deleting this
    # body back to that one line, which is a constraint on the implementation
    # rather than a hope -- so keep new work inside this branch.
    #
    # ROOST_NO_EXT is the cheapest rung of the design's "ripping it out"
    # ladder: with it set the seam is inert and roost behaves exactly as it
    # did before extensions existed. Non-EMPTY rather than merely set, because
    # `export ROOST_NO_EXT=` in a profile, or a launcher that exports every
    # name it knows whether or not it has a value, is not a request to turn
    # anything off -- the same distinction scripts/lib/roost-ext.sh draws over
    # an empty XDG variable.
    if [ -z "${ROOST_NO_EXT:-}" ]; then
      # Called inside an `if`, NEVER as a bare statement. This file runs under
      # `set -e` and a lookup MISS is the ORDINARY case here -- every mistyped
      # subcommand lands in this branch -- so a bare
      # `roost_ext_index_lookup "$1"` would exit the shell on the failing
      # lookup and `roost stauts` would print nothing at all where it used to
      # print the usage error.
      #
      # stdout is discarded and the answer read back out of the two variables
      # the lookup sets. A `$(...)` would put a fork on the one path that
      # function exists to keep fork-free, and would throw those variables
      # away with the subshell that set them.
      if roost_ext_index_lookup "$1" >/dev/null; then
        ext_name="$ROOST_EXT_LOOKUP_NAME"
        ext_exe="$ROOST_EXT_LOOKUP_PATH"
        # The second kill switch, `set -g @roost-ext-enabled off` in
        # roost.conf. Asked AFTER the lookup, where the design lists it
        # before: the observable behaviour is identical either way -- a miss
        # is the usage error whatever the option says -- and this order keeps
        # tmux, a fork and a round trip to a server, off the path every typo
        # takes.
        #
        # `|| true` because there may be no server running at all, and `set
        # -e` would otherwise take an ordinary mistyped command down with it.
        if [ "$(t show-options -gqv @roost-ext-enabled 2>/dev/null || true)" != "off" ]; then
          # This extension's two directories. roost_ext__roots SETS the roots
          # rather than printing them, which is the documented no-fork way to
          # build these paths; `$(roost_ext_data_dir)` would be a subshell for
          # a string the lookup has already resolved once.
          roost_ext__roots
          ext_dir="$ROOST_EXT_DATA_ROOT/ext/$ext_name"
          ext_state="$ROOST_EXT_STATE_ROOT/ext/$ext_name"

          # What authority the user consented to. It arrives in the fourth
          # column of the line the lookup has already read, and NOTHING here
          # reads ext.lock. roost_ext_index_write resolved it out of the
          # lockfile with a real JSON parser, once, at install and removal
          # time, and wrote the answer down.
          #
          # That indirection is the fix for a real bypass, not a convenience.
          # This branch used to parse ext.lock itself with shell string
          # operations, because neither python3 nor jq may be a runtime
          # dependency of roost (scripts/lib/roost-json.sh opens by saying
          # so). It matched the bytes `"needs"` anywhere in an entry and took
          # the next `[`, so an entry declaring `"needs": []` was handed the
          # fleet by two ordinary strings a manifest author controls --
          # `"description": "needs"` beside `"commands": ["fleet"]`. The user
          # read "asks for no access to your agents" at the consent prompt and
          # the extension got the run of the fleet.
          #
          # The rule that came out of it, and it is in the design now: decide
          # a grant where a real parser is available, carry the decision
          # forward, and never re-derive it somewhere cheaper. So no JSON is
          # parsed on this path, there is no assumption about the lockfile's
          # layout, and a typo costs one `while read` over a small text file.
          # Both files sit in the same 0600 state directory, so nothing about
          # the trust boundary moved when the decision did.
          ext_needs="$ROOST_EXT_LOOKUP_NEEDS"

          # roost_ext_needs_valid REFUSES an authority it does not recognise
          # rather than ignoring it, and that refusal has to be honoured here
          # too: a roost that silently granted nothing would leave the
          # extension believing it had everything, and that surfaces as
          # corrupted behaviour instead of a clean stop. `roost ext install`
          # refuses such a manifest and roost_ext_index_write will not write
          # an authority with whitespace in it, so a column that says this was
          # hand-edited or written by a newer roost than this one.
          if ! roost_ext_needs_valid "$ext_needs"; then
            echo "roost $1: extension '$ext_name' asks for an authority this roost does not know: $ROOST_EXT_NEEDS_UNKNOWN" >&2
            echo "roost $1: refusing, rather than running it with less than it expects" >&2
            # The way out, because a refusal a user cannot act on is a dead
            # end. Both of these are things they can type right now: one
            # takes the extension off the machine, the other turns the whole
            # seam off and gets every other roost command working again.
            echo "roost $1: remove it with 'roost ext remove $ext_name', or turn the seam off with ROOST_NO_EXT=1" >&2
            exit 1
          fi
          # Split, not a `*fleet*` substring test: a later contract adding an
          # authority whose name merely CONTAINS fleet would otherwise be
          # handed the fleet without asking for it. IFS is saved and put back
          # by hand because this is not inside a function and `local` is not
          # available here -- the same reason roost_ext_needs_valid restores
          # `set -f` itself. The same three separators, too: a split here that
          # disagreed with the one that VALIDATED is where an unknown value
          # gets dropped on the floor.
          #
          # No `set -f` around this unquoted expansion, unlike the split
          # inside roost_ext_needs_valid, because that call has already run:
          # every token left is the literal word `fleet`, and anything with a
          # glob character in it was refused above and never reached here.
          ext_fleet=0
          ext_saved_ifs="${IFS-}"
          IFS=$', \t\n'
          for ext_need in $ext_needs; do
            # An `if`, not `[ ... ] && ext_fleet=1`: under `set -e` a false
            # test on the LAST iteration would make the whole `for` return 1
            # and take roost down where it meant "this one is not fleet".
            if [ "$ext_need" = fleet ]; then ext_fleet=1; fi
          done
          IFS="$ext_saved_ifs"

          # Always on, whatever the extension declared.
          export ROOST_HOME ROOST_VERSION ROOST_CONTRACT
          export ROOST_EXT_DIR="$ext_dir"
          export ROOST_EXT_STATE="$ext_state"
          # Created before the exec, so an extension's first run already has
          # somewhere to write and no extension author has to repeat this. It
          # is also the ONLY path `roost ext remove --purge` knows to delete,
          # which is why an extension writing anywhere else has to say so in
          # its README. No `|| true`: handing an extension a ROOST_EXT_STATE
          # that is not there is the corrupted-behaviour shape this branch
          # keeps refusing, and mkdir has already said why on stderr.
          mkdir -p -- "$ext_state"

          if [ "$ext_fleet" -eq 1 ]; then
            # The grant, in the pieces a pane already gets: WHICH server to
            # talk to, HOW to address it, and roost's own scripts ahead of
            # PATH so that `roost read %N` and `roost send %N` resolve at all.
            export ROOST_SOCKET="$SOCKET"
            # The flag is handed over, not left for the extension to work out,
            # and that is a correction rather than a convenience. tmux needs
            # -L for a socket NAME and -S for a socket PATH; the line at the
            # top of this file that computes _SOCKET_FLAG makes exactly that
            # distinction, and scripts/roost-status, roost-switch and
            # roost-notify each make it again. An extension handed only the
            # value writes the obvious `tmux -L "$ROOST_SOCKET"`, which works
            # against the production server -- whose socket is the NAME
            # `roost` -- and silently addresses a different server everywhere
            # else, because every other one is a path: a `roost ssh` server,
            # a second server, every server the test suite builds.
            #
            # Silently talking to the wrong tmux is the failure this project
            # has already had once, and scripts/lib/roost-socket.sh's header
            # records it: roost-agent-state took the socket from $TMUX while
            # this file fell through to `-L roost`, and the result was that
            # "badges landed and replies vanished, exit 0, nothing printed."
            # Handing over the bare value would be asking every extension
            # author to rediscover that outage on their own users. It is
            # reused from _SOCKET_FLAG rather than re-derived here, so there
            # is one rule in this file and not two that can drift.
            export ROOST_SOCKET_FLAG="$_SOCKET_FLAG"
            export PATH="$ROOST_HOME/scripts:$PATH"
          else
            # UNSET, not empty, and doing it HERE is the whole point. An
            # extension that read an empty ROOST_SOCKET would address the
            # DEFAULT tmux server -- the user's own everyday tmux, the one
            # thing roost exists to leave alone -- and would do it silently.
            # Absent, the same read fails loudly instead.
            #
            # Withheld at exec time rather than checked, because a check the
            # extension runs is a check the extension can skip. There is
            # nothing here to pass and then bypass: the variable is simply not
            # in its environment.
            #
            # BOTH are withheld, together. Leaving ROOST_SOCKET_FLAG in
            # the environment would be handing out half a capability and a
            # misleading signal with it: an extension that found a flag and no
            # socket would be reading the leftovers of a grant it was refused.
            # They are one grant and they leave together.
            #
            # What this does NOT do is make the fleet unreachable, and
            # reading it that way is the mistake. `needs` governs what roost
            # HANDS OUT. It is not confinement, and the design says so in
            # "Non-goals" and in "Declared authority" -- read those before
            # relying on this line for anything.
            #
            # Two ways past it, neither of them exotic. An extension started
            # from inside a roost pane inherits that pane's $TMUX and its
            # PATH, and reaches the fleet through those. And outside a pane,
            # `tmux` is an ordinary binary that an extension may run itself:
            # the production server's socket is `-L roost`, a guessable
            # string, so withholding ROOST_SOCKET withholds a convenience and
            # a signal of intent, not access.
            #
            # What it does buy is still worth having: the accident above
            # cannot happen, and an extension that reaches the fleet anyway
            # has to contain the code that does it, in a repository the user
            # can read at the commit they pinned.
            unset ROOST_SOCKET ROOST_SOCKET_FLAG
          fi

          # The subcommand itself is dropped, so `roost mark %200` reaches
          # bin/roost-mark as `%200` -- the arguments it would have had if the
          # user had run that binary directly.
          shift
          # exec, not a call: the extension REPLACES roost in this process, so
          # its exit status is the user's unwrapped, its stdout and stderr are
          # the terminal's with nothing of roost's around them, and a signal
          # reaches it rather than a shell that would have to forward one.
          exec "$ext_exe" "$@"
        fi
      fi
    fi
    echo "usage: roost [up|session NAME|new NAME [SESSION]|spawn NAME [CMD]|split [-h|-v] [-t P] [-n NAME] [CMD]|view [-n NAME] CMD...|whoami|ssh HOST|send [--force] TGT TEXT|read [-r|--render] TGT [N]|screen TGT [N]|reply TEXT|wait-done TGT [T]|state STATE|hooks|doctor|validate|ext|install|upgrade|update|init|settings|status|kill [SESSION]|--version|help]" >&2; exit 2
    ;;
esac
