#!/usr/bin/env bash
# amux — deprecated name. amux has been renamed to roost; this stub forwards
# to it so old muscle memory (and old absolute paths) keep working.
set -euo pipefail

echo "amux has been renamed to roost; run \`roost\` instead" >&2

# Resolve this script's own directory even when invoked via a symlink on
# PATH, same readlink loop as bin/roost and scripts/roost-agent-state.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

exec "$SELF_DIR/roost" "$@"
