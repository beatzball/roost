#!/usr/bin/env bash
# amux — launch an on-demand tmux "agent view" on its own isolated server.
#
# Your normal `tmux` is untouched: amux uses a separate socket (-L amux) and its
# own config (tmux/amux.conf), so it never sees or disturbs your regular
# sessions. Run your AI coding agents inside it; Claude Code hooks badge each
# window by state (🛑 blocked · ⏳ working · ✅ done · 💤 idle).
#
# All amux sessions share one server, so the status counts and `prefix a`
# switcher roll up across every session.
#
#   amux                    start/attach the default session ("main")
#   amux session NAME       start/attach a named session (amux session a, ...)
#   amux new NAME [SESSION] open a new agent window and attach (default session "main")
#   amux spawn NAME [CMD]   open an agent window WITHOUT attaching; prints its target
#   amux whoami             print this agent's own target (session:index)
#   amux ssh HOST [ARGS]    run amux on a remote host (agents there, driven here)
#   amux send TGT TEXT      type TEXT + Enter into an agent (TGT = [SESSION:]WINDOW)
#   amux read TGT [N]       print an agent's last N non-blank lines (default 40)
#   amux wait-done TGT [T]  block until TGT is done/idle (optional T-sec timeout)
#   amux hooks              print the Claude Code hook config that powers the badges
#   amux doctor             run preflight checks (tmux version, truecolor, hooks, ...)
#   amux init               setup wizard: writes ~/.config/amux/amux.conf
#   amux settings           change theme/glyphs/separator/notifications, live
#   amux status             list running sessions + agents
#   amux kill [SESSION]     kill one session, or the whole server if none given
set -euo pipefail

# Resolve the repo root even when invoked via a symlink on PATH.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
AMUX_HOME="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Socket: a name (-L, production default "amux") or, for tests, a path (-S).
SOCKET="${AMUX_SOCKET:-amux}"
case "$SOCKET" in */*) _SOCKET_FLAG="-S" ;; *) _SOCKET_FLAG="-L" ;; esac
DEFAULT_SESSION="main"
CONF="$AMUX_HOME/tmux/amux.conf"

t() { tmux "$_SOCKET_FLAG" "$SOCKET" "$@"; }

server_running()  { t list-sessions >/dev/null 2>&1; }        # ≥1 session exists
session_exists()  { t has-session -t "=$1" 2>/dev/null; }      # exact-name match

# Create the session if missing. The first session boots the server with our
# config (server/global options + bindings apply to every later session too).
ensure_session() {
  local s="$1"
  session_exists "$s" && return 0
  if server_running; then
    t new-session -d -s "$s" -c "$PWD"
  else
    t -f "$CONF" new-session -d -s "$s" -c "$PWD"
    t set-environment -g AMUX_HOME "$AMUX_HOME"
    t set-option -g @amux-home "$AMUX_HOME"
    t set-environment -g PATH "$AMUX_HOME/scripts:$PATH"
    # User config: sourced AFTER the base conf so it overrides. -q: silent if absent.
    AMUX_USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/amux/amux.conf"
    t set-option -g @amux-user-conf "$AMUX_USER_CONF"
    t source-file -qF "#{@amux-user-conf}"
  fi
}

attach_session() { ensure_session "$1"; exec tmux "$_SOCKET_FLAG" "$SOCKET" attach -t "=$1"; }

# Resolve a send/read target: "sess:win" as-is, bare "win" → default session.
target() { case "$1" in *:*) printf '%s' "$1" ;; *) printf '%s:%s' "$DEFAULT_SESSION" "$1" ;; esac; }

case "${1:-up}" in
  up|start|"")
    attach_session "$DEFAULT_SESSION"
    ;;
  session|s)
    sess="${2:?usage: amux session NAME}"
    attach_session "$sess"
    ;;
  new)
    name="${2:-agent}"; sess="${3:-$DEFAULT_SESSION}"
    ensure_session "$sess"
    # `=$sess:` — trailing colon so a numeric session name isn't parsed as a window
    # index (matches spawn; a bare `=0` fails "index 0 in use").
    t new-window -t "=$sess:" -n "$name" -c "$PWD"
    exec tmux "$_SOCKET_FLAG" "$SOCKET" attach -t "=$sess"
    ;;
  doctor)
    exec "$AMUX_HOME/scripts/amux-doctor"
    ;;
  init)
    exec "$AMUX_HOME/scripts/amux-init"
    ;;
  settings)
    exec "$AMUX_HOME/scripts/amux-settings"
    ;;
  whoami)
    # Only meaningful inside an amux pane. $TMUX_PANE identifies the caller's pane.
    if [ -z "${TMUX_PANE:-}" ]; then echo "amux whoami: not inside an amux session" >&2; exit 1; fi
    me="$(t display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_index}' 2>/dev/null || true)"
    [ -n "$me" ] || { echo "amux whoami: not inside an amux session" >&2; exit 1; }
    printf '%s\n' "$me"
    ;;
  spawn)
    name="${2:?usage: amux spawn NAME [CMD...]}"; shift 2
    # Helper lands in the caller's own session when inside amux, else the default.
    if [ -n "${TMUX_PANE:-}" ]; then
      sess="$(t display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || echo "$DEFAULT_SESSION")"
    else
      sess="$DEFAULT_SESSION"
    fi
    ensure_session "$sess"
    # Background (-d) + non-attaching: create the window WITHOUT switching the
    # caller's focus to it (plain new-window selects it, so a client viewing the
    # session would jump there), and print its session:index target.
    # `=$sess:` — exact-match the session AND the trailing colon avoids tmux parsing
    # a numeric session name as a window index (e.g. `=0` fails "index 0 in use").
    t new-window -d -P -F '#{session_name}:#{window_index}' -t "=$sess:" -n "$name" -c "$PWD" "$@"
    ;;
  hooks)
    cat <<JSON
# Add this to ~/.claude/settings.json (merge into an existing "hooks" block).
# Then run \`claude\` inside an \`amux\` window and its badge tracks its state.
# Outside amux these hooks are silent no-ops.
# "matcher": "permission_prompt" matters — an unmatched Notification hook also
# fires for idle_prompt/auth_success, which would paint a finished agent red.
# PostToolUse is what clears the red: no hook fires when you answer a permission
# dialog, so without it the window stays blocked until the whole turn ends.
{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$AMUX_HOME/scripts/amux-agent-state working" } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt",
        "hooks": [ { "type": "command", "command": "$AMUX_HOME/scripts/amux-agent-state blocked" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "$AMUX_HOME/scripts/amux-agent-state working" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$AMUX_HOME/scripts/amux-agent-state done" } ] }
    ]
  }
}
JSON
    ;;
  ssh)
    host="${2:?usage: amux ssh HOST [ARGS...]}"; shift 2
    # Run amux on the remote (must be installed there); agents run remote,
    # you drive them from this terminal. Just SSH + a remote amux — no daemon.
    exec ssh -t "$host" amux "$@"
    ;;
  send)
    raw="${2:?usage: amux send [SESSION:]WINDOW TEXT...}"; shift 2
    tgt="$(target "$raw")"
    # Validate: a typo'd target must fail loudly, not silently deliver nothing.
    if [ -z "$(t display-message -p -t "$tgt" '#{window_id}' 2>/dev/null)" ]; then
      echo "amux send: no such target '$raw'" >&2; exit 2
    fi
    # Two-step submit: literal text, a beat, then Enter. A single
    # `send-keys "$*" Enter` can drop or race the submit in a full-screen TUI.
    delay="$(t show-options -gqv @amux-send-enter-delay 2>/dev/null)"
    # Fall back to 0.3 for unset / non-numeric / multi-dot values, AND guard the
    # sleep itself, so NO value can ever abort after the text is typed but before
    # Enter is sent (which would leave the prompt half-delivered in the input box).
    case "$delay" in ''|.|*.*.*|*[!0-9.]*) delay=0.3 ;; esac
    t send-keys -t "$tgt" -l -- "$*"
    sleep "$delay" 2>/dev/null || true
    t send-keys -t "$tgt" Enter
    ;;
  read)
    raw="${2:?usage: amux read [SESSION:]WINDOW [LINES]}"; lines="${3:-40}"
    # Drop the pane's trailing blank rows, keep the last N non-empty lines.
    t capture-pane -p -t "$(target "$raw")" | grep -v '^[[:space:]]*$' | tail -n "$lines"
    ;;
  wait-done|wait)
    raw="${2:?usage: amux wait-done [SESSION:]WINDOW [TIMEOUT_SEC]}"; timeout="${3:-0}"; waited=0
    tgt="$(target "$raw")"
    while :; do
      st="$(t show-options -wqv -t "$tgt" @agent_state 2>/dev/null || echo idle)"
      case "$st" in done|idle) exit 0 ;; esac
      sleep 1; waited=$((waited + 1))
      if [ "$timeout" -gt 0 ] && [ "$waited" -ge "$timeout" ]; then
        echo "amux: timed out waiting for '$raw' (still $st)" >&2; exit 1
      fi
    done
    ;;
  status)
    if server_running; then
      echo "amux: running (socket=$SOCKET)"
      t list-sessions -F '  session #{session_name} — #{session_windows} agents#{?session_attached, [attached],}'
      t list-windows -a -F '    #{session_name}:#I #{window_name}/#{pane_current_command}  [#{@agent_state}]'
    else echo "amux: not running"; fi
    ;;
  kill|down|stop)
    if [ -n "${2:-}" ]; then
      t kill-session -t "=$2" 2>/dev/null && echo "amux: session '$2' killed." || echo "amux: no session '$2'."
    else
      t kill-server 2>/dev/null && echo "amux: server stopped (all sessions)." || echo "amux: not running."
    fi
    ;;
  *) echo "usage: amux [up|session NAME|new NAME [SESSION]|spawn NAME [CMD]|whoami|ssh HOST|send TGT TEXT|read TGT [N]|wait-done TGT [T]|hooks|doctor|init|settings|status|kill [SESSION]]" >&2; exit 2 ;;
esac
