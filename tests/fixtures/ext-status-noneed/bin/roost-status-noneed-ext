#!/usr/bin/env bash
# roost-status-ext — `roost status`, rebuilt from scratch on contract 1.
#
# THIS IS A TEST FIXTURE, NOT AN EXTENSION ANYONE SHOULD INSTALL. A real
# roost-status extension would be a permanent duplicate of a core command —
# the exact bloat the extension seam exists to prevent. It lives under
# tests/fixtures/ and answers one question, once: was contract 1 rich enough
# to rebuild a command roost already ships? Its output is compared BYTE FOR
# BYTE against `roost status` in tests/test-ext.sh, so if the two ever drift
# the suite says so.
#
# It is deliberately INDEPENDENT. It sources nothing from $ROOST_HOME, it
# does not run `roost` at all, and everything it knows about the fleet it
# learns from $ROOST_SOCKET and tmux. A wrapper around the original would
# have proved only that `exec` works — which four other assertions in that
# file already prove — and would have hidden the one thing this fixture is
# for: whether the contract hands over enough to do the job.
set -euo pipefail

# ROOST_SOCKET and ROOST_SOCKET_FLAG, read unguarded and under `set -u`, and
# that is the point.
#
# The contract hands these over only when the manifest declares
# `"needs": ["fleet"]`; without it the dispatcher UNSETS both before exec
# rather than passing empty ones, precisely so a read like this fails loudly.
# tests/fixtures/ext-status-noneed/ is this same program with the declaration
# removed, and the suite asserts it dies HERE with an unbound variable rather
# than quietly listing the panes of whatever tmux server `tmux list-sessions`
# would have found on its own — which on a developer's machine is their own
# everyday tmux, the one thing roost exists to leave alone.
#
# So: no `${ROOST_SOCKET:-}`, no default, no `if [ -n ... ]`. Any of those
# would turn the negative half of this conformance test into silence.
# ROOST_SOCKET is read FIRST so that it is the name in the error message, which
# is what the suite asserts on: the two arrive and leave together, so either
# would do, and pinning which one is reported keeps that assertion exact.
sock="$ROOST_SOCKET"

# tmux takes a socket NAME with -L and a socket PATH with -S, and the contract
# hands over the flag rather than the bare value alone.
#
# This is the whole reason the fixture exists, so it is worth writing down
# here. The first draft of this file did NOT get a flag: contract 1 handed
# over `ROOST_SOCKET` on its own, and this program had to re-derive the rule
# with `case "$sock" in */*)`. That was the one thing the rebuild needed and
# the contract did not supply, it is what this conformance exercise was for,
# and it was a real defect rather than a documentation gap — the obvious
# `tmux -L "$ROOST_SOCKET"` an author writes works against the production
# server, whose socket is the NAME `roost`, and silently addresses a DIFFERENT
# server everywhere else, because every other one is a path. roost has had
# that outage once already; scripts/lib/roost-socket.sh's header records
# badges landing and replies vanishing, exit 0, nothing printed.
#
# So an extension addresses the fleet with both, and this fixture is the first
# consumer of the corrected contract — demonstrating the idiom rather than
# working around its absence.
flag="$ROOST_SOCKET_FLAG"

# Every tmux call goes through here, so the socket cannot be forgotten on one
# of them. AGENTS.md §2: a bare `tmux` in a test would address the developer's
# live server, and the point of naming the socket once is that there is no
# second place to get it wrong.
t() { tmux "$flag" "$sock" "$@"; }

# `list-sessions` as the liveness probe, not `has-session`: "running" here
# means at least one session exists, and tmux exits non-zero when no server
# is listening at all. stdout and stderr both go away — this is the question,
# not the answer.
if t list-sessions >/dev/null 2>&1; then
  echo "roost: running (socket=$sock)"
  t list-sessions -F '  session #{session_name} — #{session_windows} windows#{?session_attached, [attached],}'
  # The pane line, and the two conditionals in it are load-bearing:
  #
  # #{?@roost-name,...} would be wrong — that is a TRUTHINESS test, and tmux
  # reads the string "0" as false, so a pane named literally "0" would fall
  # back to #{pane_current_command}. The #{==:#{@roost-name},} form is an
  # EMPTINESS test and gets that pane right.
  #
  # The "/LABEL" suffix is suppressed when the label equals the window name,
  # because `roost spawn NAME` names the window AND the pane from one NAME
  # and an unconditional suffix would print "api-agent/api-agent" — an echo
  # of the window name standing where the real signal (what is running)
  # belongs. LABEL is inlined twice, once inside the #{==:} test and once as
  # the shown suffix, rather than factored through a second #{E:}.
  t list-panes -a -F '    #{pane_id}  #{session_name}:#{window_index}.#{pane_index} #{window_name}#{?#{==:#{?#{==:#{@roost-name},},#{pane_current_command},#{@roost-name}},#{window_name}},,/#{?#{==:#{@roost-name},},#{pane_current_command},#{@roost-name}}}  [#{?@agent_state,#{@agent_state},-}]'
else
  echo "roost: not running"
fi
